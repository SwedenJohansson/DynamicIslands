# lib_silver: pieces of Silver Screen Seas' 1-hour pass (10-26). New macros only; the shared libs stay as they are.
#
# ss_piece: one piece of a collectible set (Story_Collectible) at x z on the ground, alias al, in set
macro ss_piece x=0 z=0 al=piece set=Relics
place Story_Collectible $al at $x $z ground sit
prop $al obj.name=$al
prop $al collect.set=$set
end
#
# ss_lamp: one puzzle light (Story_Light, a post with a bulb) at x z on the ground: alias al, name nm (what `light|`
# actions and the plays name), its group, on = 1 if it starts lit
macro ss_lamp x=0 z=0 al=lamp nm=Lamp grp=Lamps on=0
place Story_Light $al at $x $z ground sit
prop $al obj.name=$nm
prop $al light.group=$grp
prop $al light.on=$on
end
#
# ss_hidden: a hidden chest (alias al) shown by a puzzle's reward, at x z on the ground
macro ss_hidden x=0 z=0 al=hiddenchest kind=Loot_ChestSmall yaw=0
place $kind $al at $x $z ground sit yaw=$yaw
prop $al obj.name=$al
prop $al beh.hidden=1
prop $al loot.refill=0
end
#
# ss_islander: an islander (Story_Islander) at x z on the ground, turned yaw: alias al, name nm (who quests and plays talk
# to), pose; the caller adds `prop <al> talk.text=...`
macro ss_islander x=0 z=0 yaw=0 al=islander nm=Islander pose=stand
place Story_Islander $al at $x $z ground yaw=$yaw
prop $al obj.name=$nm
prop $al islander.pose=$pose
end
#
# ss_pad: a level pad r m round x z, h m over the sea, the plants on it cleared (a stepped edge: the slope round it smoothed)
macro ss_pad x=0 z=0 r=10 h=3
brush flatten at $x $z r=$r s=20 frames=300 h=$h
brush smooth at $x $z r={$r+4} s=4 frames=30
brush flatten at $x $z r={$r-2} s=20 frames=300 h=$h
clear at $x $z r={$r+2}
end
