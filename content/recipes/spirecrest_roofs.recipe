# Spirecrest Roofs - an island of the library's plan The Sunken Kingdom (sea level; chapter 1, the rooftops)
# Five drowned skyscraper tops stand out of the clear sea, the city's streets 7 m below them. Fallen antenna masts are
# laid as footbridges from the middle tower (the beacon tower, the Network's surface beacon still blinking on its roof)
# to the four others: a roof garden (birch and flowers in planter boxes) to the north, a hen coop under a roof on posts
# to the south. Coral grows up the tower walls from the seabed. Quest "The Rooftops" (13 steps): the beacon roof, the
# distress card, the screechers, the Receiver plans in the beacon hut, the antenna plans on the bridge mast, the
# caretaker's diary.
#
# Points (metres over the sea): the seabed at -7 (r 28 round 0 0); every tower 4 storeys from the seabed, its roof at
# 5 m. Towers (6 x 9 m): beacon x -3..3, z -4.5..4.5; east x 12..18; west x -18..-12 (both z -4.5..4.5); garden (north)
# x -3..3, z 11.5..20.5; coop (south) z -20.5..-11.5. Bridges on the middle line of each side.
include lib_features
include lib_huts
include lib_gravity
include lib_rt
include lib_sunken
new
gen Trees=0.22 Bushes=0.28 Rocks=0.35 Harvest=0.1 BeachThings=0.2
# RESIZE 10-24: Radius 30 -> 85 (an atoll: the city's rubble ring round a drowned lagoon; the tower complex in the middle
# stays as it was - its mast bridges span at most 12 m - and the lagoon floor grows round it)
gen Seed=10101 Radius=85 Height=12 Roughness=0.3 Peaks=3 Shape=1 Style=0 BeachWidth=0.1 Cliffs=0.2 PeakShape=0.5
gen Water=0.6 SeaRocks=0.3 SeaFinds=0.3 Sunken=0.3 Hostiles=0 Friendly=0 SeaLife=0.3
generate
elevation 0

# --- Terrain: the drowned street level at -7 ---------------------------------------------------------------------------
brush flatten at 0 0 r=46 s=20 frames=400 h=-7
# discoveries: a level spot for the camp on the ring
brush flatten at 4 63 r=5 s=8 frames=40
origin
clear at 0 0 r=44
clear at 4 63 r=6

# --- The five tower tops (railing round each roof, open where a bridge or a ladder arrives) -------------------------
call tower x=3 z=0 h=-7 n=4 a=towers
call tower x=18 z=0 h=-7 n=4 a=towers
call tower x=-12 z=0 h=-7 n=4 a=towers
call tower x=3 z=16 h=-7 n=4 a=towers
call tower x=3 z=-16 h=-7 n=4 a=towers
prop towers tint.color=#7d8a8c
prop towers tint.amount=0.35
push at 3 0 h=5
call rt_railing y=0 bm=none fm=none lm=none rm=none
pop
push at 18 0 h=5
call rt_railing y=0 lm=none
pop
push at -12 0 h=5
call rt_railing y=0 lm=none rm=none
pop
push at 3 16 h=5
call rt_railing y=0 fm=none
pop
push at 3 -16 h=5
call rt_railing y=0 bm=none fm=none
pop

# --- Fallen masts as footbridges from the beacon tower to the four others ------------------------------------------
call mastbridge x1=3 x2=12 z=0 h=5
call mastbridge x1=-12 x2=-3 z=0 h=5
call mastbridgez z1=4.5 z2=11.5 x=0 h=5
call mastbridgez z1=-11.5 z2=-4.5 x=0 h=5

# --- Ladders up from the water: the coop tower's south face, the west tower's west face -------------------------------
place LandmarkLadder_6m - at 0 -20.7 h=-1.2 yaw=0
place LandmarkLadder_6m - at -18.2 0 h=-1.2 yaw=90

# --- The beacon roof: the beacon hut (distress card, the Receiver plans), the beacon mast and its light ---------------
push at -2.5 0.5 h=5
call hut w=2 d=2 y=0.05
place "Box Small" - at 0.8 2.3 y=0.05 sit
place Note_Paper distresscard at 0.8 2.3 y=1.65 drop yaw=15
place Loot_Chest beaconchest at 2.2 2.2 y=0.05 sit yaw=270
pop
place Antenna_pole - at 2.2 -3.6 h=5 sy=1
place Antenna_pole - at 2.2 -3.6 h=11.3 sy=0.6
place TP_RotatingRedLight beaconlight at 2.2 -3.6 h=15.2 drop
place Zone_Trigger beaconzone at 0 -2 h=6
place Creature_StoneBird screechers at 0 0 h=14

# --- The mast toolbox in the middle of the east bridge (the antenna plans) --------------------------------------------
place Loot_ChestSmall masttoolbox at 7.5 0 h=5 sit yaw=0

# --- The roof garden (north tower): planter boxes with birch and flowers, the caretaker's diary ----------------------
place Block_Foundation - at -1.5 13.5 h=5.68
place Block_Foundation - at 1.5 13.5 h=5.68
place Block_Foundation - at -1.5 18.5 h=5.68
place Block_Foundation - at 1.5 18.5 h=5.68
place Block_Foundation - at -1.5 16 h=5.68
place Pickup_Landmark_Tree_Birch - at -1.5 18.5 h=5.68 sit
place Pickup_Landmark_Tree_Birch - at 1.5 18.5 h=5.68 sit
place Pickup_Landmark_Flower_Red - at -1.5 13.5 h=5.68 sit
place Pickup_Landmark_Flower_Yellow - at 1.5 13.5 h=5.68 sit
place Pickup_Landmark_Flower_Red - at -1.5 16 h=5.68 sit
place Pickup_Landmark_BerryBush - at 1.8 16.2 h=5.05 sit
place "Box Small" - at 2.2 19.8 h=5.05 sit
place Note_Paper diary at 2.2 19.8 h=5.75 drop yaw=40
# STORY 10-24s: Ines's first slate on the coop roof, by the hens
place "Box Small" - at -2.2 -19.6 h=5.05 sit
place Note_Paper inesslate1 at -2.2 -19.6 h=5.75 drop yaw=-20

# --- The hen coop (south tower): a roof on four posts, hens ---------------------------------------------------------
push at -2.5 -15.5 h=5
call corners w=2 d=2 y=0.05
roof 2 2 at 0 0 y=0.05 wood
place Placeable_Lantern_Metal - at 1.5 1.5 y=0.05 sit
pop
place Creature_Chicken hens at 1.5 -18.5 h=5.3

# --- Coral up the tower walls, two reefs at the tower feet, kelp -----------------------------------------------------
call coralwall x=18.4 z=2.8 n=4 yaw=90 seed=10102
call coralwall x=-18.4 z=-2.8 n=4 yaw=270 seed=10103
call coralwall x=-2.2 z=20.9 n=3 yaw=0 seed=10104
call coralwall x=2.4 z=-20.9 n=3 yaw=180 seed=10105
scatter VP_CoralDigitate01 5 at 11 11 r=3 seed=10106 free=1
scatter VP_CoralBulb04 4 at 11 11 r=3 seed=10107 free=1
scatter VP_CoralFoliose03 5 at -11 -11 r=3 seed=10108 free=1
scatter TinyCoral 6 at -11 -11 r=3 seed=10109 free=1
scatter SeaVine3 44 at 0 0 r=44 seed=10110 free=2
scatter SeaVine3_klump 14 at 0 0 r=44 seed=10111 free=2

# --- DISCOVERIES 10-24 (optional, no quest needs them): an outlying drowned tower with a chest on its roof, a sunken
# boat in the lagoon, a castaway camp on the rubble ring (a note), a van on the ring, a viewpoint over the city ---------
call tower x=-24 z=26 h=-7 n=3 a=towers2
prop towers2 tint.color=#7d8a8c
prop towers2 tint.amount=0.35
place LandmarkLadder_6m - at -27 21.3 h=-4.2 yaw=0
place Loot_Chest annexchest at -27.5 27.5 h=2.05 sit yaw=90
place BoatStranded - at 26 -28 ground yaw=35
place Loot_ChestSmall wreckchest at 22 -24 ground sit yaw=200
scatter "Pickup_Landmark_Scrap 1_OceanBottom" 3 at 26 -28 r=6 seed=10112 free=1
place campfire_1 - at 4 63 ground sit
place Balboa_DecorationPrefabBase_SimpleTent - at 7 65 ground sit yaw=200
place "Box Small" - at 2 65.5 ground sit
place Note_Paper campnote at 2 65.5 ground y=1.6 drop yaw=20
place Van_5 ringvan at -56 -34 ground yaw=60
prop ringvan tint.color=#6b4a32
prop ringvan tint.amount=0.55
place Zone_Trigger viewzone at 48 44 ground
note annexchest Annex roof chest | A maintenance chest on the annex roof, left for later.
loot annexchest MetalIngot*2;CopperIngot*2;Rope*3;Glass*2
prop annexchest loot.refill=0
note wreckchest Wreck's chest | The sunken boat's chest, its lid swollen with salt.
loot wreckchest Scrap*4;Plastic*6;Nail*8
prop wreckchest loot.refill=0
note campnote Ring camp note | THE RING - CAMP 2\n\nWe walked the old ring road round the city. Every street goes down into the water, like stairs nobody comes back up.\nFrom the high rubble you can see the beacon blink. Teo the caretaker rowed out with eggs for us twice. He says the beacon calls the Commons home. Danni says it calls something else, and that nobody should sleep on the side that faces the trench.\nWe stopped counting the drowned towers at forty. Danni counts the nights the teal light comes instead. Nine so far. We move camp to the far side of the ring tomorrow, and Teo can keep his eggs.
prop viewzone zone.id=spirecrest_view
prop viewzone zone.radius=6
prop viewzone zone.repeat=never
prop viewzone zone.message=From the rubble ring the whole drowned city lies below you: five tower tops, the beacon's red blink - and streets running down into the blue.

# --- Areas (10-24: every story island has places all over it and its quest crosses it): the rubble ridge in the east, a rock cave in the west, the pump-man's
# ruin in the south and a courier plane in the north-west - and on each a few old signal masts (the blink code)
call sk_ridge x1=58 z1=-30 x2=72 z2=24 h=5 top=8 r=10
call sk_plants x=65 z=-3 r=16 seed=10161
call sk_zone x=65 z=-3 al=sc_ridge id=sc_ridge r=7 msg="The rubble ridge. Under the water the drowned rooftops lie in a grid - streets, once. Two masts still stand up here."
call sk_cave x=-46 z=-4 h=3 yaw=0 al=sc_caverock chest=sc_cavechest
call sk_zone x=-46 z=1 al=sc_cave id=sc_cave r=4 msg="A cave in the rock. Somebody slept here and kept a mast by the door."
call sk_ruin x=-8 z=-66 h=3 al=sc_ruin
call sk_notebox x=-5.5 z=-70.5 yaw=10 al=sc_ruinnote
call sk_plane x=-46 z=58 h=3 yaw=60 al=sc_plane crate=sc_wreckcrate
call sk_notebox x=-51 z=63.5 yaw=70 al=sc_wrecknote

# --- Unique layer (10-24): the blink code: the masts left standing at the four areas (2, 1, 3, 1) are the code of the
# pump-man's strongbox keypad on his ruin's wall
place Antenna_pole - at 64 9 ground sy=0.5
place Antenna_pole - at 68 1 ground sy=0.5
place Antenna_pole - at -52 -2 ground sy=0.5
place Antenna_pole - at -14 -62 ground sy=0.5
place Antenna_pole - at -3 -61 ground sy=0.5
place Antenna_pole - at -15 -70 ground sy=0.5
place Antenna_pole - at -38 66 ground sy=0.5
place RT_PowerBox mastpad at -5.55 -66.75 h=4.4 yaw=90
place Loot_Chest mastbox at -10.5 -70.5 ground sit yaw=180

# --- DEEP 1-HOUR (10-24): Signal Hill (a 22 m climb, a zipline down) and the drowned telephone exchange in the south-east pit
# the mountain: a stepped path spirals up from its east foot (-43.76 28) to the summit tower
call sk_peak x=-64 z=28 h=22 r=22
call sk_pit x=36 z=-60 h0=-9
call sk_cave x=24 z=36 h=3 yaw=180 al=sccave2 chest=sccave2chest
call sk_plants x=-64 z=28 r=24.2 seed=24010
call sk_reef x=46 z=-54 r=5 seed=24030

# the summit: Signal Hill - the tower (ladder inside), the locker, the note, the zone, the zipline down
call ladtower x=-64 z=28 h0=22 lv=6 a=sctower
place Loot_ChestSmall sclocker at -64.75 28.75 h=36.73 sit yaw=180
place Note_Paper scsumnote at -64.75 27.25 h=36.84 drop yaw=20
place Zone_Trigger scsummit at -64 28 h=37.73
place ZiplinePath_Landmark sczip at -63.25 27.25 h=36.73 yaw=0
zipto sczip -32 14
place Loot_ChestSmall scledge at -73.33 37.33 ground sit yaw=40
place SmallRock_02 - at -39.34 34.51 ground sit scale=0.5
place SmallRock_02 - at -39.34 34.51 ground y=0.6 sit scale=0.32 yaw=40
call treasure x=-41.84 z=34.51 r=12 n=1 seed=24011
prop treasure24011 treasure.loot=MetalIngot*2;CopperIngot*2;Bolt*2
call treasure x=-52 z=12 r=14 n=1 seed=24012
prop treasure24012 treasure.loot=Scrap*4;Nail*10;Plastic*4;Glass*2
call sk_dark x=24 z=34 h=1 r=7 al=sccave2dark

# the drowned building: the telephone exchange, its ground floor 9 m down; the deep chest at the bottom, air on storey 1
call sk_drowned x=36 z=-60 h0=-9 n=2 w=RT_WallWindowBroken a=scbld cap=0 cal=sccap
place Loot_Chest scdeep at 34.2 -62.5 h=-9 sit yaw=0
place Placeable_Table_Basic - at 34.5 -59 h=-6 sit yaw=0
place Note_Paper scbldnote at 34.5 -59 h=-4.7 drop yaw=10
call airpocketat x=35.5 z=-62 h=-6 id=sc_dair al=scdair bub=scdbub r=2.2 msg="Air trapped under the stairs of the drowned building. Breathe."
call sk_zone x=36 z=-71 al=scdeepzone id=sc_deep r=4 msg="The pit floor: the drowned building stands below you."

# --- Settings, notes, behaviours, quest ------------------------------------------------------------------------------
info title=Spirecrest Roofs
info author=Custom Islands
info description=Five drowned skyscraper tops in a clear sea, linked by fallen antenna masts: a beacon still blinking, a roof garden, a hen coop. The first island of The Sunken Kingdom.
island on.arrive=message||Roofs. Five of them, standing out of the sea - and through the clear water, the streets below.

note distresscard Pelagic Network distress card | PELAGIC NETWORK - AUTOMATED NOTICE\n\nThis is the Sealkeeper. The Commons are sealed and safe.\nStay where you are. Keep your lights low. Do not answer the deep.\nThis is the Sealkeeper. The Commons are sealed and safe...\n\n(A printout of the beacon's loop: the same three lines, again and again, down the whole page.)\n\nIn pencil at the bottom: "Then why is HIS light the only one still on? - T."\nUnder that, in a neat hand: "That is Director Rook's voice. He read the weather at the regatta once and nobody heard a word. He has found his volume now. - I.M."
note beaconchest Beacon hut chest | The beacon keeper's chest: receiver plans and a spare cable.
note masttoolbox Mast toolbox | A rigger's toolbox wedged in the fallen mast: antenna plans.
note inesslate1 Ines's slate (the coop) | DIVE SLATE - I. MARLOWE (chalk)\n\nMilo, you made me promise to write down everything I see, so here it is: the coop roof, at night, with a hen asleep on my boot.\nTeo says the beacon is a distress call. I worked the Network's cables for eleven years and I have never heard a distress call that says "do not answer".\nAnd there is something else. Out past the drowned streets, under the water, a light. Teal, small, very steady. The wind is blowing hard tonight and every fleck of foam on the sea runs before it. The light goes the other way. Against the wind. Slowly, like it is looking for something.\nI have put our lamp out. Mo the whale is in your bag - I checked twice. Sleep, love.
note diary Rooftop caretaker's diary | ROOF CARETAKER - SPIRECREST (T. Brask)\n\nDay 31 of the water. The hens lay on the coop roof and the birches don't care what floor they are on. I envy them.\nThe beacon keeps calling the Commons. Nobody calls back, except the gulls, and they are rude.\nInes went down to the street today and came back with a kettle and a face like thunder. The children's shuttle leaves from the toll booth on the overpass. She has put Milo's name down. She has knitted him a whale for the trip. It is yellow. It is the yellowest thing left in the world.\nDay 34. Shuttle gone. Ines gone after it, down the road. Somebody has to follow her with the oxygen she forgot, and it seems to be me.\nIf you read this: feed the hens, mind the screechers, and follow the road out over the water. It goes into the blue and comes up again at the toll booth.
loot beaconchest Blueprint_Reciever*1;Rope*2;Scrap*2
prop beaconchest loot.refill=0
loot masttoolbox Blueprint_Antenna*1;Bolt*2
prop masttoolbox loot.refill=0

prop beaconlight obj.name=beaconlight
prop beaconzone zone.id=beacon
prop beaconzone zone.radius=6
prop beaconzone zone.repeat=never
prop beaconzone zone.message=The beacon roof. The light on the mast still turns - and screechers nest round it!
prop screechers creature.count=3
prop screechers creature.respawn=0
prop screechers creature.zone=beacon
prop hens creature.count=3

note sc_cavechest Signalman's chest | A signalman's chest: wire, a battery, rope.
loot sc_cavechest Copper*2;Battery*1;Rope*3;CircuitBoard*1
prop sc_cavechest loot.refill=0
note sc_ruinnote Pump-man's slate | PUMP-MAN'S SLATE\n\nForty years I kept the roof pumps going. When the sea came over the parapets they were still running, I'll have you know.\nThen one night the board in my hut went from LOCAL to REMOTE all by itself, and every pump on every roof stopped at once. Not broken. Stopped. Somebody far away pressed a button, and the water came in like it had been invited.\nMy spares are in the strongbox by my wall. My wife always said I counted masts the way other men count sheep, so that is the lock: the poles still standing on the ridge, the cave, my house and the courier's plane, in that order.
note sc_wrecknote Courier's logbook | COURIER'S LOGBOOK - AIR MAIL, SUCH AS IT IS\n\nLast run to the Spirecrest roofs: one sack of mail for addresses that are now under water, two oxygen tanks, a crate of fuses, and a jar of pickled herring nobody ordered.\nPut down on the rocks. Nobody came to the lamp. The caretaker came at last, with a hen under one arm, as if that were normal.\nThe tanks were for the diver, Marlowe. She had already gone down the road after the children's shuttle. He said he would carry them after her. He is seventy if he is a day.\nI asked him what the beacon was for. He said "company". Flying home over the city I saw a teal light under the water, keeping pace with my shadow. I did not log that. I am logging it now.
note sc_wreckcrate Courier's crate | The courier's crate. The mail is pulp; the rest kept dry.
loot sc_wreckcrate Plank*4;Nail*8;Rope*2;Scrap*3
prop sc_wreckcrate loot.refill=0
prop mastpad obj.name=mastpad
prop mastpad beh.use=Key in the code
prop mastpad lock.code=2131
prop mastpad on.use=sound||event:/exploring/obstacles/keypad/keypad_correct\nsignal||mastcode\nmessage||The keypad blinks green. The strongbox by the wall clicks open.
prop mastpad else.use=message||Four digits. The pump-man counted something.
note mastbox Pump-man's strongbox | The pump-man's strongbox: pump spares, kept dry.
loot mastbox Bolt*4;Hinge*2;MetalIngot*2;Battery*1
prop mastbox loot.refill=0
prop mastbox if.open=signal|mastcode
prop mastbox else.open=message||Locked - wired to the keypad on the wall.
# --- DEEP 1-HOUR (10-24): story items, notes and checks
story sc_key|Exchange key|Hinge|The telephone exchange's key, from the chest in its drowned switch room.
story sk_crest|Kingdom crest shard|Bolt|A shard of the Sunken Kingdom's crest, from a drowned building. The Hollow's crown vault wants nine.
note scdeep Exchange strongbox | The exchange strongbox: the relay locker key and a crest shard.
loot scdeep story:sc_key*1;story:sk_crest*1;MetalIngot*2;Bolt*3;OxygenBottle*1
prop scdeep loot.refill=0
note sclocker Relay locker | The linemen's relay locker, high above the water.
loot sclocker MetalIngot*3;CopperIngot*2;Rope*3;Cooked_Potato*2
prop sclocker loot.refill=0
prop sclocker if.open=has|story:sc_key|1
prop sclocker else.open=message||Padlocked. The tag: "key in the exchange strongbox, at the bottom".
note scsumnote Ines's slate (Signal Hill) | DIVE SLATE - I. MARLOWE, SIGNAL HILL\n\nMilo, I climbed the linemen's tower to see the road, because the radio says your shuttle never reached the Yard. It says it went down on a reef. It says twelve got off and walked to the Caisson Yard. It does not say which twelve.\nFrom up here the old highway runs out of the sea and back into it, on to the toll booth on the overpass. That is where you got on. That is where I start.\nThe teal light was out there again tonight, under the road. It stopped when I lit my torch. I put the torch out and it moved on.\nThis slate is not goodbye. It is so you know which way I went. The overpass. Then the labs. Then wherever you are.
note scbldnote Switchboard log | SWITCHBOARD LOG - NIGHT SHIFT, V. OKAFOR\n\n23:10 Call from the Spire, the Director's office: keep the beacon line open whatever happens. Keep it LIT. Yes, Director.\n23:40 A woman asking which seat her boy has on the night shuttle. Seat 14. She thanked me like I had done something.\n01:05 The water is at the windows. I put the relay locker key in the strongbox downstairs, safe from thieves. Which is a joke. Who is left?\n01:30 Nobody calls now. But the line to the trench is not quiet. Something on it, very low, saying the word I say when I pick up. "Calling. Calling."\nI am going up. There is air under the stairs if the water beats me to them.
note scledge Climber's cache | A climber's cache on a ledge, off the path.
loot scledge Rope*3;Bolt*2;Feather*3
prop scledge loot.refill=0
note sccave2chest Signalman's spare chest | A second signalman's chest, at the back of the rock.
loot sccave2chest CopperOre*3;Rope*2;Battery*1
prop sccave2chest loot.refill=0
prop scsummit zone.id=sc_summit
prop scsummit zone.radius=2.5
prop scsummit zone.message=The top of Signal Hill. The whole island lies below.

