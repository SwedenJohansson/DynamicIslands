# --- RAIN 10-26 (the user: one hour per island - hills, cliffs, a cave, a house, a wreck, secrets): Smoke Hill ------
# Smoke Hill with fog lookout on it, Condensate Cave, the ruined house where Hanne Vik waits (four lamps round it: a puzzle), a crashed plane,
# a jump course, five shift tokens about the island (a set), and at the hub the fog horn that wants the fog lamp lens and the fog-line valve key
call hw_zone x=-22.05 z=38.03 al=fw_trailz id=fw_trail r=5 msg="The trail up Smoke Hill starts here - round and up."
call hw_zone x=-44 z=50 al=fw_summitz id=fw_summit r=8 h=1 msg="The top of Smoke Hill. The whole island below you."
call hw_mast x=-47 z=52 h0=20 lv=6 a=fw_mast chest=fw_topchest top=RT_Spotlight
place ZiplinePath_Landmark fw_zip at -40.8 47.4 h=21.35
zipto fw_zip -2.27 28.87
place Creature_Goat fw_goats at -18.05 41.03 ground
prop fw_goats creature.count=2
call ar_cave x=48 z=52 h=3 yaw=180 al=fw_caverock chest=fw_cavechest
call hw_zone x=49 z=43 al=fw_cavez id=fw_cave r=4 h=1 msg="Condensate Cave. Water drips somewhere in the dark."
call ar_ruin x=66 z=14 h=3 yaw=0 w=3 d=2 al=fw_ruin
call rn_islander x=65 z=9.5 yaw=200 al=fw_isl nm="Hanne Vik" pose=sit
prop fw_isl talk.text=You came through the fog? Good sailing.\n---\nI worked the night shift. When they said the fog would bring rain to the whole coast, we believed them.\n---\nThe horn by the old works wants its lens from the lookout on Smoke Hill and the valve key from the Condensate Cave. Bring both and blow it - let them hear it in town.\n---\nThe four shift lamps round my house: each wakes the next. All four lit, and look behind the back wall.
place Placeable_Chair_Basic - at 65 9.5 ground sit yaw=200
call rn_lamp x=59 z=13 al=fw_lamp1 nm="Shift lamp 1" grp="Shift lamps" on=0
call rn_lamp x=65 z=20 al=fw_lamp2 nm="Shift lamp 2" grp="Shift lamps" on=1
call rn_lamp x=72 z=13 al=fw_lamp3 nm="Shift lamp 3" grp="Shift lamps" on=1
call rn_lamp x=65 z=6 al=fw_lamp4 nm="Shift lamp 4" grp="Shift lamps" on=0
prop fw_lamp1 on.use=light|Shift lamp 2|toggle
prop fw_lamp2 on.use=light|Shift lamp 3|toggle
prop fw_lamp3 on.use=light|Shift lamp 4|toggle
prop fw_lamp4 on.use=light|Shift lamp 1|toggle
prop fw_lamp1 on.alllit=show|fw_lampchest\nmessage||All four lamps burn. Behind the back wall a stone has been lifted.
call rn_hidden x=67 z=18.6 al=fw_lampchest
place Creature_Chicken fw_hens at 74 20 ground
prop fw_hens creature.count=3
call ar_plane x=-66 z=12 h=3 yaw=40 al=fw_plane crate=fw_planecrate
place Note_Paper fw_pilot at -67.78 16.1 ground y=0.1 drop yaw=70
call hw_zone x=-66 z=12 al=fw_planez id=fw_plane r=6 h=1 msg="A plane, nose down in the grass. Nobody came for it."
# JUMP fw pad=2 at=12 66
push at 12 66
clear at 0 0 r=17 all
brush flatten at 0 0 r=14 s=20 frames=300 h=2
brush smooth at 0 0 r=18 s=4 frames=40
brush flatten at 0 0 r=12 s=20 frames=300 h=2
brush auto at 0 0 r=18 s=10 frames=25
clear at 0 0 r=18
place Block_Foundation_Tier3 jpfw at 4.24 4.24 h=2.6
place Block_Foundation_Tier3 jpfw at 5.77 1.65 h=3.35
place Block_Foundation_Tier3 jpfw at 5.85 -1.35 h=4.1
place Block_Foundation_Tier3 jpfw at 4.46 -4.01 h=4.85
