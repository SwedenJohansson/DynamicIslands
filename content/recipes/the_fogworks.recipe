# JUMP from 10
place Block_Foundation_Tier3 jpfw at -4.85 3.53 h=9.35
place Block_Foundation_Tier3 jpfw at -2.54 5.44 h=10.1 sx=2 sz=2
# JUMP end
place Block_Foundation_Tier3 jppfw at 5.77 1.65 h=2.668 sy=1.861
place Block_Foundation_Tier3 jppfw at 5.85 -1.35 h=3.418 sy=2.959
place Block_Foundation_Tier3 jppfw at 4.46 -4.01 h=4.168 sy=4.058
place Block_Foundation_Tier3 jppfw at 1.95 -5.67 h=4.918 sy=5.157
place Block_Foundation_Tier3 jppfw at -1.04 -5.91 h=5.668 sy=6.255
