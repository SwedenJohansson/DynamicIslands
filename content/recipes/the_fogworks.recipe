# The Fogworks - an island of the library's plan The Rainmakers (Nimbus Works' fourth station, large)
# A flat island with a shallow bay where Nimbus Works made fog: a street of plank boardwalks on posts across the bay, a
# dock out to the bay mouth, workers' cottages on stilts over the water, and two hourglass cooling towers of Varuna's
# motherlode pillars (one stood on the bay floor, one upside down on it) with the fog still rolling off them. On the yard
# behind the bay: the pump hall with its three fog-line valves, the control room, the cold condenser, the boiler house.
# Quest "The Fog Shift" (24 steps): the dock, the bulletin, the pump hall, the fog lines (valves and the cable hub), the
# shift chief's notes, the rats in the condenser, the control room safe (a keypad), the tower top, its cabin chest, the
# radio (Dagny Holm's first confession), the Founders' Day crate, the boilerman Mattis freed from his cage.
#
# Built by the recipe player (CIRecipe the_fogworks) through the editor's own operations.
include lib_sea
include lib_features
include lib_huts
include lib_areas
include lib_highwater
include lib_rain
# RESIZE 10-26 (the user: Raft-big, one-hour islands): Radius 90 -> 90
# RAIN 10-26: the new land - Smoke Hill with fog lookout, Condensate Cave, Hanne Vik at the ruined house (a lamp puzzle), a crashed plane, a jump course, a set of five shift tokens
new
# (nature: a sea-level island with few trees (0.1, a works yard); Bushes, Rocks, Harvest Like Raft's own)
gen Trees=0.1 Bushes=0.28 Rocks=0.43 Harvest=0.24 BeachThings=0.3
gen Seed=9601 Radius=90 Height=6 Roughness=0.3 Peaks=1 Shape=0 Style=0 PeakShape=0.3 Cliffs=0.1 BeachWidth=0.6
gen Water=0.5 SeaRocks=0.5 SeaFinds=0.5 Sunken=0.3 Hostiles=0 Friendly=0.2 SeaLife=0.3
generate
origin
# --- RAIN 10-26 terrain: Smoke Hill, the pads of the new areas ---------------------------------------------------
call hw_mount x=-44 z=50 b=24 h=20
call hw_trail x=-44 z=50 b=24 h=20 a0=118.61 turn=300 n=40 h0=3
brush flatten at 0 26 r=4 s=8 frames=60
clear at 0 26 r=7

# --- Terrain: the bay dug out of the south side (its floor 2.5 m under the sea), the works yard levelled (2 m) --------
# (the long strokes left mounds in the yard and a bank under the boardwalk: levelled again point by point, 2026-10-18)
for pz -104 -70 8
brush flatten at 0 $pz r=12 s=20 frames=60 h=-3
next
for fx -36 36 6
brush flatten at $fx -10 r=6 s=20 frames=50 h=2
next
for fx -40 40 8
brush flatten at $fx -46 r=9 s=20 frames=50 h=-2.5
brush flatten at $fx -56 r=9 s=20 frames=50 h=-2.5
brush flatten at $fx -36 r=9 s=20 frames=50 h=-2.5
brush flatten at $fx -66 r=9 s=20 frames=50 h=-2.5
brush flatten at $fx -74 r=7 s=20 frames=40 h=-2.5
brush flatten at $fx -14 r=8 s=20 frames=50 h=2
brush flatten at $fx -6 r=8 s=20 frames=50 h=2
next
for pz -44 -20 3
brush flatten at 0 $pz r=3 s=20 frames=40 h=2
next
brush smooth from -40 -26 to 40 -26 r=5 s=6 frames=30
brush seabed from -40 -52 to 40 -52 r=24 s=8 frames=60
clear from -40 -52 to 40 -52 r=27
clear from -38 -8 to 38 -8 r=15
clear from 0 -44 to 0 -20 r=4

# --- The boardwalks: the street across the bay (deck 2 m over the sea), the dock south to the bay mouth (the path north to
# the yard is cut through the bank) - Raft's wooden floor blocks on reef hut posts down to the bay floor --------------------------------------
push at -36 -46.5 h=-2.5
call boardwalk n=48 wide=2 y=4.5 rs=none
pop
push at 1.5 -72 h=-2.5 yaw=270
call boardwalk n=17 wide=2 y=4.5 rs=none rn=none
pop
place Zone_Trigger towndock at 0 -66 h=3

# --- The workers' cottages on stilts along the street's south side, their doors on the street -----------------------
push at -24 -47 h=-2.5 yaw=180
call stilt_hut y=4.5 ladder=none
pop
push at -14 -47 h=-2.5 yaw=180
call stilt_hut y=4.5 ladder=none w2=none
pop
push at 16 -47 h=-2.5 yaw=180
call stilt_hut y=4.5 ladder=none w5=ReefHuts_PlasticWall1
pop
push at 26 -47 h=-2.5 yaw=180
call stilt_hut y=4.5 ladder=none
pop
place "Box Big" - at 3.6 -44.6 h=2 sit
place Note_Paper bulletin at 3.6 -44.6 h=4 sit drop yaw=10

# --- The two cooling towers on the bay floor: a motherlode pillar standing, a second one upside down on it (an
# hourglass 30 m tall); beside the west one the watch mast - the radio tower's thick pillars stacked, a ladder up its
# face out of the water - and the watch cabin's floor from the mast's top onto the tower's ---------------------------
for tx -30 30 60
place VP_MotherlodePillar1_Stage1 towers at $tx -62 h=-2.5 sit scale=0.7
place VP_MotherlodePillar1_Stage1 towers at $tx -62 h=12.2 sit scale=0.7 rot=180,0,0
next
prop towers tint.color=#b8bcbe
prop towers on.use=message||The old fog tower stands firm, its iron cold and wet with mist.
for mh -2.5 21.5 6
place RT_PillarThick - at -30 -55.5 h=$mh
next
for ld 0 11 1
place Block_Ladder - at -30 -55.09 h={-2.5+2.42*$ld}
next
push at -31.5 -61.5 h=27.1
call floors w=2 d=4 y=0.1
pop
place Loot_Chest towerchest at -30 -60 h=27.25 sit yaw=180
place Zone_Trigger towertop at -30 -58.5 h=28.3
place Zone_Atmosphere fog at 0 -40 h=4
place Zone_Sound fogsound at 0 -40 h=4
prop fog atmo.fog=#c9cdd1
prop fog atmo.fogAmount=0.45
prop fog atmo.light=#b0b6bb
prop fog atmo.lightAmount=0.3
prop fog atmo.particles=mist
prop fog zone.radius=70
prop fogsound sound.event=event:/exploring/temperence/generator
prop fogsound sound.volume=0.35
prop fogsound zone.radius=60

