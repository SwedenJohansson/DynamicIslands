# Orrin's Sledge Camp - the fourth island of the library's plan The Frozen Horizon (storyline SL12, chapter 4: The Sledge Camp)
# A camp on the shelf ice built for animals, not people: a fodder barn and a fenced pen with goats and llamas (a woolly
# herd for the cold), insulated huts, a sledge shed with a track of plank runners down to the sea, a lookout on four
# posts - and polar bears that come for the herd. Orrin, the camp's keeper, left four notes and went north to the Whale.
# Quest "The Sledge Camp" (15 steps; story pass 10-24: daybook + the Warden's letter; DEEP 10-24: Orrin's trail - quarry, bear cave, rim): the barn, Orrin's first note, two polar bears (they come when you reach the barn),
# the engine controls' plans (sledge shed), the metal detector's plans (Orrin's hut; notes 2 and 3 in the huts), the
# firework's plans (the lookout), the zipline base's plans (the zipline crate by the pine wood). Orrin's note 4 lies
# on the crate: the plan's done-when.
#
# Built by the recipe player (CIRecipe orrins_sledge_camp) through the editor's own operations. Points (metres over the
# sea): the camp at 1.5 m (r 20 round 0 0); the barn x -16..-10 z -6..-1.5 (door south at -15.25 -6); the pen
# x -6..6 z -16..-7 (gate south); Orrin's hut x -4..0.5 z 8..11; the cook hut x 9..12 z 12..15; the sledge shed
# x 4..10 z 0..4.5; the lookout's platform at 7.5 m, x 13..19 z -6.5..2.5, its ladder at 16 -6.9; the pine wood
# round -20 18 on the shore rocks.
include lib_features
include lib_sea
include lib_huts
include lib_rt
include lib_ni7b
include lib_frozen
include lib_verdance
include lib_ni34
include lib_areas
# RESIZE 10-24: Radius 40 -> 85 (Height 4 -> 5), the old content moved -9.2 -23 as one frame (push) so its sea side stays at the coast; the island grows behind it.
new
gen Trees=0.2 Bushes=0.15 Rocks=0.25 Harvest=0.15 BeachThings=0.2
gen Seed=12401 Radius=85 Height=5 Roughness=0.35 Peaks=2 Shape=0 Style=1 BeachWidth=0.35 Cliffs=0.2 PeakShape=0.4
gen Water=0.5 SeaRocks=0.3 SeaFinds=0.3 Sunken=0.2 Hostiles=0 Friendly=0 SeaLife=0.3
generate
push at -9.2 -23

# --- Terrain: the camp on the shelf at 1.5 m, the sledge track's slope to the water --------------------------------
brush flatten at 0 0 r=20 s=20 frames=300 h=1.5
brush flatten from 7 0 to 7 -30 r=2.5 s=20 frames=250 h=1.2
# RESIZE 10-24 retest: the bigger island stands higher here - the huts' pads flattened again
brush flatten at -13 -3.75 r=5 s=20 frames=200 h=1.5
brush flatten at -1.75 9.5 r=5 s=20 frames=200 h=1.5
brush flatten at 10.5 13.5 r=5 s=20 frames=200 h=1.5
brush flatten at 7 2.25 r=5 s=20 frames=200 h=1.5
pop
brush flatten at -12.9 33.6 r=5 s=8 frames=40
origin
clear at -12.9 33.6 r=6
push at -9.2 -23
clear at 0 -2 r=20
clear from 7 0 to 7 -28 r=2.5

# --- The fodder barn: Orrin's first note on the hay, fodder sacks --------------------------------------------------
push at -16 -6 h=1.5
call hut w=4 d=3 y=0.1
place Placeable_FirewoodRack - at 5 3.9 y=0.1 sit yaw=180
place Note_Paper orrinnote1 at 3 3.4 y=0.1 drop yaw=30
place Placeable_Cropplot_Grass - at 1.5 3 y=0.1 sit
place Placeable_Cropplot_Grass - at 3 1.5 y=0.1 sit
# REDO 10-24: the first of the sledge's three harness pieces, in the barn's hay chest
place Loot_ChestSmall haychest at 4.6 1.2 y=0.1 sit yaw=180
pop
place Zone_Trigger barnzone at -13 -9 ground y=1
place TP_Moontown_TarpCrate01_Clean - at -9 -8 ground sit yaw=70

# --- The pen: goats (milk) and llamas (wool) in a fence, a hay trough -------------------------------------------------
call fencesquare x=-6 z=-16 w=12 d=9 gw=3
place Creature_Goat goats at -3 -11 ground
place Creature_Llama llamas at 3 -10 ground
place Placeable_Cropplot_Grass - at 0 -14.5 ground sit

# --- The bears: they come for the herd from the east when you reach the barn -----------------------------------------
place Creature_PolarBear bears at 24 -14 ground

# --- Orrin's hut: the metal detector's plans, note 2 ---------------------------------------------------------------
push at -4 8 h=1.5
call hut w=3 d=2 y=0.1
place Placeable_Bed_Wood - at 3.6 1.6 y=0.1 sit yaw=90
place Loot_Chest orrinschest at 1.2 2.3 y=0.1 sit yaw=180
place Note_Paper orrinnote2 at 2.5 1.2 y=0.1 drop yaw=200
place Note_Paper daybook at 3.6 1.3 y=0.1 drop yaw=80
place Note_Sign toolrack at 2.7 2.75 y=0.1 sit yaw=180
place Placeable_Lantern_Metal - at 0.6 2.6 y=0.1 drop
pop

# --- The cook hut: note 3 and the camp's stores (meat, milk pails) -------------------------------------------------
push at 9 12 h=1.5
call hut w=2 d=2 y=0.1
place Placeable_CookingStand_Food_One - at 2.2 2.3 y=0.1 sit yaw=180
place Loot_Chest cookstores at 0.9 2.4 y=0.1 sit yaw=180
place Note_Paper orrinnote3 at 2.2 1 y=0.1 drop yaw=80
pop

# --- The sledge shed: the engine controls' plans; the track of plank runners down to the sea ------------------------
push at 4 0 h=1.5
call hut w=4 d=3 y=0.1
place Loot_ChestLarge sledgeshed at 4.8 3.6 y=0.1 sit yaw=180
place Placeable_Shelf_Wood - at 1.5 4 y=0.1 sit yaw=180
pop
# REDO 10-24: the sledge winch outside the shed - three harness pieces (barn, Orrin's hut, the pine-wood crate) rig it,
#     and it hauls the motor sledge out; the shed's big chest stands behind it
call crank x=2.2 z=1.2 yaw=90 alias=sledgewinch
for tz -2 -26 -3
place Block_HorizontalPillar_Wood - at 6.2 $tz ground y=0.05
place Block_HorizontalPillar_Wood - at 7.8 $tz ground y=0.05
next
place TP_Moontown_SealedCrate01 - at 9 -24 ground sit yaw=20

# --- The lookout on four posts: the firework's plans, a view to the north ------------------------------------------
push at 19 -2 h=7.5
call rt_storey f1=none f2=none b1=none b2=none l1=none l2=none l3=none r1=none r2=none r3=none
call rt_railing y=0 fm=none
call rt_legs d=6
place Loot_Chest lookoutbox at -1 3.5 sit yaw=180
place Zone_Trigger lookzone at -3 0 y=1
pop
call ladders x=16 z=-7 h=1.5 n=3 yaw=180

# --- The zipline crate at the pine wood's edge, Orrin's last note on its lid ---------------------------------------
place Loot_Chest ziplinecrate at -16 12 ground sit yaw=135
# REDO 10-24: the machete on the main path - the pine wood's track grew shut over the crate
beside ChoppableVines pinevines ziplinecrate d=1.6
place Note_Paper orrinnote4 at -15 10.6 ground drop yaw=100
place Placeable_Lantern_Metal - at -17.5 11 ground drop
scatter "Pickup_Landmark_Tree_Pine" 6 at -22 20 r=7 seed=12411 free=3
scatter TP_SnowDrift02 3 at 0 0 r=19 seed=12412 free=3
scatter TP_SnowDrift03 3 at 0 0 r=19 seed=12413 free=3

# --- The sea: a reef, sand and ore in the shallows, snow ------------------------------------------------------------
scatter VP_CoralDigitate01 4 at -46.05 -32.25 r=4 seed=12421 wet free=1
scatter VP_CoralBulb04 3 at -46.05 -32.25 r=4 seed=12422 wet free=1
scatter SeaVine3_klump 3 at -46.05 -32.25 r=5 seed=12423 wet free=1
call shallows x=9.2 z=23 r=85 deep=5 n=1 seed=12430
call snowfall x=0 z=0 r=45 al=snow
pop

# --- DISCOVERIES 10-24 (optional, no quest needs them): camp + note; Caravan_Blue_01 + chest; hatch with a chest; buried treasure; viewpoint ---
place campfire_1 - at -12.9 33.6 ground sit
place Balboa_DecorationPrefabBase_SimpleTent - at -9.9 35.6 ground sit yaw=197
place "Box Small" - at -14.9 36.1 ground sit
place Note_Paper dnote at -14.9 36.1 ground y=0.7 drop yaw=20
note dnote Traveller's note | (on a box by a dead sledge, in a shaky hand)\n\nSeventh day out of the Coldhold. Fingers bad. Food gone yesterday.\nI was the cook down there. P. Skarr, if anyone is keeping a list. The Warden keeps lists. He kept one of who was allowed in and one of who was allowed to leave, and the second list was very short.\nThey say it is warm below the ice. It is. It is also very quiet, and the quiet gets into your teeth.\nThere is a woman down there in a cage for asking to use the radio. Fenn, her name is. Somebody should go for her.\nIf you find Orrin's camp, ask him for coffee. Don't ask him about his post.
place Caravan_Blue_01 dvan at 30.3 -24.5 ground yaw=317
prop dvan tint.color=#6a7a8a
prop dvan tint.amount=0.5
place Loot_ChestSmall dwreckchest at 26.3 -21.5 ground sit yaw=257
note dwreckchest Frozen chest | Frozen to a dead sledge: wool, rope, a tin of nails.
loot dwreckchest Wool*3;Rope*2;Nail*8
prop dwreckchest loot.refill=0
call hatchcache x=33.4 z=20.1 r=15 seed=12491 alias=dhatch chest=dhatchchest items=MetalIngot*2;Wool*3;Bolt*2
call vinecache x=20.1 z=-33.4 r=15 seed=12493 chest=dvinechest vines=dvines items=Rope*3;Wool*2;Bolt*3
call treasure x=-36.9 z=12.7 r=15 n=1 seed=12492
prop treasure12492 treasure.loot=TitaniumOre*2;MetalOre*2
place Zone_Trigger dview at 7.3 13.1 ground
prop dview zone.id=orrins_sledge_camp_view
prop dview zone.radius=7
prop dview zone.repeat=never
prop dview zone.message=Orrin's barn and the fenced pen look small on the white shelf - and the animals' breath smokes in the cold.

# --- DEEP 10-24 (one-hour pass, world frame): Orrin's trail inland - the quarry ridge (N/NE, 26 m) with an excavator on
# its quarry ledge and Orrin's cairn on its top (the climb on foot), the bear
# cave (N, Orrin's trail mark), the trapper's ruin (E), the ice-hole lake (W, a sledge truck 12 m down: the dive), two
# buried treasures. (Pillars checked 10-24: the lookout stands on rt_legs, the rim: a cairn since the story pass 10-24, no tower, no zipline.)
call ar_ridge x1=16 z1=70 x2=56 z2=50 h=18 top=8 r=9
call ar_plants_snowy x=36 z=60 r=32 seed=12441
brush flatten at 28 51 r=6 s=20 frames=300 h=12
clear at 28 51 r=7
place VP_Excavator quarrydigger at 28 51 ground sit yaw=30
prop quarrydigger tint.color=#8a7a50
prop quarrydigger tint.amount=0.4
place Loot_Crate quarrycrate at 31.5 48 ground sit yaw=60
call fz_zone x=26 z=47 al=quarryzone id=quarry r=6 msg="Orrin's quarry. The excavator stopped mid-bite; his boot prints go on up the ridge."
call fz_cairn x=36 z=60 al=rimtower chest=rimcache zal=rimzone zid=rim_top msg="The rim of the quarry ridge, and Orrin's cairn. North, far off on the white: a ship's bow on a ridge of ice. Orrin watched her from here."
place Note_Paper wardenletter at 35.4 61.2 ground y=0.05 drop yaw=40
# the bear cave (N): its mouth south to the camp, Orrin's trail mark inside, a brown bear in it
call ar_cave x=-20 z=66 h=5 yaw=180 al=bearcave chest=cavestash
place Note_Paper trailmark at -19.2 60.6 h=5.5 drop yaw=20
place Zone_Trigger cavezone at -20 61 h=6.4
prop cavezone zone.id=bear_cave
prop cavezone zone.radius=3
prop cavezone zone.message=The bear cave. Old ashes, a cut pole, three notches - Orrin sheltered here on his way up the ridge.
place Creature_Bear cavebear at -16 50 ground
prop cavebear creature.count=1
prop cavebear creature.respawn=0
# the trapper's ruin (E)
call ar_ruin x=62 z=4 h=5 yaw=0 al=trapperhut
place Note_Paper trapperlog at 61.25 4 h=6.07 drop yaw=10
place Loot_ChestSmall trapperchest at 63.3 5.1 h=5.05 sit yaw=200
# the ice-hole lake (W): a sledge truck under the ice, 12 m down
call fz_dive x=-62 z=-20 d=12 r=10 yaw=0 obj=Van_4 al=sledgetruck chest=truckchest aid=lakeair aal=lakeairz abub=lakeairb cx=4 cz=3 ax=-4 az=-3
call fz_zone x=-50 z=-8 al=lakeview id=ice_lake r=6 msg="The ice-hole lake. Under the black water, the shape of a truck - the camp's sledge truck that went through the ice."
call ar_ridge x1=-70 z1=10 x2=-46 z2=34 h=8 top=5 r=7
call ar_plants_snowy x=-58 z=22 r=18 seed=12444
call treasure x=60 z=-30 r=8 n=1 seed=12445
call treasure x=-40 z=50 r=8 n=1 seed=12446

# --- Settings, notes, behaviours, quest ----------------------------------------------------------------------------
info title=Orrin's Sledge Camp
info author=Custom Islands
info description=A camp on the shelf ice built for animals: a fodder barn, goats and llamas in a pen, a sledge shed, a lookout on four posts - and polar bears that come for the herd. Its keeper went north. The fourth island of The Frozen Horizon.
island on.arrive=message||Goats bleating in the snow. A camp - and far off on the ice, something white and big, watching the pen.

note orrinnote1 Orrin's note 1 | (on the hay, weighed down with a horseshoe)\n\nWhoever you are: feed them. Goats get the hay, llamas get the rest, and the big grey goat gets whatever she wants, because she will take it anyway.\nThe bears come whenever the herd is alone. They'll come for you too. Mind them, and mind the little ones by the pen.\nI've gone north. There is a thing up there I have to put right. The town will think I've gone for the Whale's captain. In a way I have. Let them think it.\nThe dogs are with me. They always are.\n\n- Orrin
note orrinnote2 Orrin's note 2 | (on the table in Orrin's hut)\n\nThe detector is for the ice: things the sledges lost, things the Whale dropped, a spoon I've been looking for since spring. Plans in my chest.\nI took my compass. North by the ridge, keep the sun on your left, and if there's no sun, keep the wind on your cheek and complain about it. That helps too.\nThe bed is warmer than it looks. Tuva sleeps across your feet if you let her. I'm sorry she's not here to do it.\n- O.
note orrinnote3 Orrin's note 3 | (in the cook hut, pinned over the stove)\n\nMilk the goats morning and evening, or they'll complain to the whole shelf, and the shelf is very large.\nThe lookout has the flares, and the plans for making more. If you see a flare from the north, that's me. If you see two, it's me and I've fallen into something.\nThere's salt meat in the stores. Eat it. Nobody else will: the trapper is vegetarian on Tuesdays and never knows what day it is.\nHedda Brask gave me coffee the last time I took the Whale her post. Real coffee, her last tin. I keep thinking about that.\n- O.
note orrinnote4 Orrin's note 4 | (pinned to the zipline crate)\n\nThe Whale lies on a ridge of ice to the north, her bow up as if she's trying to climb out. Her captain is still aboard - I saw her lamp from the rim.\nThe zipline gear is for her mast; you'll want it to get up her side. She's on 1100, if your set has the range, and you'll want an engine to get there.\nIf she answers you, tell her the courier is sorry. She'll know which courier. Don't tell her more than that. I want to tell her the rest myself.\n- Orrin
note daybook Orrin's daybook | ORRIN VALE - DAYBOOK\n\nDay 3. Finished the new hatchet. Carved Tuva's head on the handle, ears back like when she smells fish. Best thing I ever made. Hung it on its hook by the door where I can see it.\nDay 9. The Warden's letters again, a whole sack of them, sealed. "Post, Orrin. Just post." A berth below the ice for me and the dogs when the cold comes, he says, for faithful service.\nDay 19. Bad night at the stack. Don't ask. I'm asking myself enough.\nDay 20. Steamvent. Took all their sets. Gunnar gave me soup anyway. Couldn't eat it.\nDay 27. Another letter, for me this time. I've put it where I won't have to look at it: up on the rim, under the cairn's top stone.\nDay 30. The goats are fed for a week. I'm taking the hatchet north.
note toolrack Orrin's tool rack | TOOL RACK - each tool on its painted outline:\nSAW. ADZE. TONGS. ICE PICK.\nHATCHET (TUVA) - the hook is empty. Its outline is a hatchet with a dog's head carved on the handle.
note wardenletter The Warden's letter | (under the cairn's top stone, folded small, the Coldhold's wax seal on it)\n\nVale,\nYou have served well. The stack is quiet. Steamvent is quiet. The sealers will be quiet soon enough, one way or another.\nThe last station in the north that will not be silent is the Whale. Her captain sends every night with a hand key, a few seconds at a time, and every second she sends brings the pulse closer to all of us. To your dogs. To your goats.\nSee to it. Your berth is kept.\n\n- A. Holt, Warden\n\n(On the back, in Orrin's round hand, the pencil pressed through the paper: "North, to the Whale. Tonight.")
note orrinschest Orrin's chest | Orrin's chest: the metal detector's plans, mittens, tea.
note cookstores Camp stores | The camp's stores: milk pails, salted meat, wool.
note sledgeshed Sledge shed | The sledge shed's chest: the engine controls' plans and tools.
note lookoutbox Lookout box | The lookout's box: the firework's plans, an empty flare pistol.
note ziplinecrate Zipline crate | The zipline crate: its base's plans, cable, Orrin's note on the lid.
loot orrinschest Blueprint_MetalDetector*1;Wool*2;Rope*2;story:harness*1
prop orrinschest loot.refill=0
loot cookstores Bucket*1;Leather*2;Wool*2;Raw_GenericMeat*2
prop cookstores loot.refill=0
loot sledgeshed Blueprint_EngineControls*1;Bolt*3;Hinge*2;MetalIngot*1
prop sledgeshed loot.refill=0
prop sledgeshed obj.name=sledgeshed
prop sledgeshed beh.hidden=1
note haychest Hay chest | Under the hay: a sledge harness piece, a bag of oats.
loot haychest story:harness*1;Wool*2
prop haychest loot.refill=0
prop ziplinecrate obj.name=ziplinecrate
prop ziplinecrate beh.hidden=1
prop pinevines on.use=hide|\nshow|ziplinecrate\nmessage||The machete clears the track. Behind the vines: Orrin's zipline crate.
story harness|Harness piece|Placeable_Lantern_Metal|A piece of the sledge winch's harness. Orrin hid them so nobody took the motor sledge after him.
story sledge|The motor sledge out|Placeable_Lantern_Metal|The winch hauled the motor sledge out onto the runners.
prop sledgewinch obj.name=sledgewinch
prop sledgewinch beh.use=Rig the harness and wind the sledge winch
prop sledgewinch if.use=take|story:harness|3
prop sledgewinch on.use=give||story:sledge*1\nshow|sledgeshed\nmessage||The harness takes the strain. The motor sledge rolls out on the runners - and behind it, the shed's big chest.
prop sledgewinch else.use=message||The winch has no harness. Orrin's notes: one piece in the hay, one in my hut, one with the zipline crate.
loot lookoutbox Blueprint_Firework*1;Rope*2;Nail*6
prop lookoutbox loot.refill=0
loot ziplinecrate Blueprint_ZiplineBase*1;Rope*4;MetalIngot*2;story:harness*1
prop ziplinecrate loot.refill=0

# --- DEEP 10-24: Orrin's trail - the quarry, the bear cave, the rim, the extras ---
note trailmark Orrin's trail mark | (scratched on a cut pole by cold ashes)\n\nO. - DAY 1 NORTH.\nUp the quarry ridge to the rim, as every morning. There's no ladder; there never was. The ridge is the ladder. From the rim you see the Whale.\nI left the good things in the cache by the cairn for whoever feeds my goats. The rest is under the cairn's top stone, and I wish it weren't.\nThe bear in this cave is called Mrs Fjell. She is not friendly. I named her anyway; it seemed polite.\n- O.
note rimcache Orrin's rim cache | Orrin's cache by the cairn: a spare compass and flares.
loot rimcache MetalIngot*3;Rope*3;Leather*2;CopperIngot*1
prop rimcache loot.refill=0
note quarrycrate Quarry crate | The quarry's tool crate: a pick head, nails, a coil of cable.
loot quarrycrate Nail*10;Scrap*3;Rope*2
prop quarrycrate loot.refill=0
note cavestash Bear cave stash | Orrin's stash in the bear cave: kindling, a tin of meat.
loot cavestash Plank*4;Raw_GenericMeat*2;Wool*2
prop cavestash loot.refill=0
note trapperlog Trapper's log | TRAPPER'S HUT (old Sten)\n\nOrrin brings me hay for the traps' bait; I bring him wool. Fair trade, though my wool comes back as socks with dogs knitted on them.\nThe sledge truck went through the ice on the west lake. I marked the hole with a pole. Her toolbox is still aboard. Twelve metres down, cold as a debt.\nOrrin came by last week with the bells off his dogs. Sat by my fire and asked me, out of nowhere, whether a man can undo a thing once it's done. I said that depends on the thing. He said that was what he was afraid of, and left before the tea.
note trapperchest Trapper's chest | The trapper's chest: skins and snares.
loot trapperchest Leather*3;Rope*2;Feather*3
prop trapperchest loot.refill=0
note truckchest Sledge truck's toolbox | The sledge truck's toolbox, twelve metres under the ice.
loot truckchest MetalIngot*2;Bolt*4;Hinge*2
prop treasure12445 treasure.loot=MetalOre*3;CopperOre*2
prop treasure12446 treasure.loot=TitaniumOre*1;MetalOre*2

prop barnzone zone.id=barn
prop barnzone zone.radius=5
prop barnzone zone.message=The fodder barn. Behind you the goats go quiet - something is coming over the ice.
prop lookzone zone.id=lookout
prop lookzone zone.radius=3
prop lookzone zone.message=The lookout. North, on the white, a ridge - and on the ridge, a ship's bow.
prop goats creature.count=3
prop llamas creature.count=2
prop bears creature.count=2
prop bears creature.respawn=0
prop bears creature.zone=barn

quest title=The Sledge Camp
quest intro=A camp on the shelf ice, its herd alone. Go to the fodder barn.
step reach|barn|1|Go to the fodder barn
step read|Orrin's note 1|1|Read Orrin's note on the hay
step kill|Polar bear|2|Drive off the two polar bears that come for the herd
step blueprint|Blueprint_MetalDetector|1|Take the metal detector's plans from Orrin's hut
step read|Orrin's daybook|1|Read Orrin's daybook on his bed (his tool rack has an empty hook)
step blueprint|Blueprint_Firework|1|Climb the lookout and take the firework's plans
step blueprint|Blueprint_ZiplineBase|1|Cut through to the crate by the pine wood and take the zipline base's plans
step collect|story:harness|3|Find the sledge winch's three harness pieces (barn, Orrin's hut, the crate)
step collect|story:sledge|1|Rig the harness and wind the sledge winch
step blueprint|Blueprint_EngineControls|1|Take the engine controls' plans from the sledge shed
step reach|quarry|1|Follow Orrin's trail north to his quarry on the ridge
step read|Orrin's trail mark|1|Find Orrin's trail mark in the bear cave north-west of the quarry
step reach|rim_top|1|Climb the quarry ridge on foot to Orrin's cairn on the rim
step open|Orrin's rim cache|1|Open Orrin's cache beside the cairn
step read|The Warden's letter|1|Read what Orrin left under the cairn's top stone
quest done=The courier went north to the Whale with his hatchet and the Warden's order. She is on 1100.
quest reward=MetalIngot*2;Rope*3;Leather*2

# RESIZE 10-24 retest: the bigger island's generator rocks that floated over slopes (ground check)
clear at -7.26 13.98 r=1.5 only=TP_BigRock

save Orrin's Sledge Camp
