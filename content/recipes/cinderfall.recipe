prop jppcf tint.color=#4a4542
prop jppcf tint.amount=0.35
place Loot_Chest jccf at -1.04 -5.91 h=6.85 sit yaw=0
prop jccf loot.refill=0
place Loot_ChestSmall jbcf at -2.54 5.44 h=10.6 sit yaw=0
prop jbcf loot.refill=0
pop
call hw_zone x=10 z=58 al=cf_jumpz id=cf_jumps r=6 h=1 msg="Stone stacks, one higher than the next. Something at the top."
push at 60.5 -3.5 h=2.6
