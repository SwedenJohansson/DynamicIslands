place Block_Foundation_Tier3 jpmt at 3.02 -5.64 h=7.10
place Block_Foundation_Tier3 jpmt at 0.40 -5.64 h=6.10
place Block_Foundation_Tier3 jpmt at -2.41 -5.64 h=7.05
place Block_Foundation_Tier3 jpmt at -5.12 -5.64 h=8.00
place Block_Foundation_Tier3 jpmt at -5.12 -2.02 h=8.90 sx=2 sz=2
# JUMP from 11
place Block_Foundation_Tier3 jpmt at 1.30 -2.02 h=9.20 sx=2 sz=2
place Block_Foundation_Tier3 jpmt at 1.30 3.21 h=9.50
# JUMP end
# (each slab on one solid column of its own footprint, from under the pad up to the slab)
# (the first slab rests on the pad itself: no column)
place Block_Foundation_Tier3 jppmt at 2.92 5.64 h=2.918 sy=1.493
place Block_Foundation_Tier3 jppmt at 5.93 5.64 h=3.318 sy=2.079
place Block_Foundation_Tier3 jppmt at 5.93 3.03 h=4.218 sy=3.399
place Block_Foundation_Tier3 jppmt at 5.93 -1.21 h=4.718 sy=4.132 sx=0.3 sz=3
place Block_Foundation_Tier3 jppmt at 5.93 -5.64 h=5.518 sy=5.305
place Block_Foundation_Tier3 jppmt at 3.02 -5.64 h=6.418 sy=6.625
place Block_Foundation_Tier3 jppmt at 0.40 -5.64 h=5.418 sy=5.158
place Block_Foundation_Tier3 jppmt at -2.41 -5.64 h=6.368 sy=6.551
place Block_Foundation_Tier3 jppmt at -5.12 -5.64 h=7.318 sy=7.944
place Block_Foundation_Tier3 jppmt at -5.12 -2.02 h=8.218 sy=9.264 sx=2 sz=2
place Block_Foundation_Tier3 jppmt at 1.30 -2.02 h=8.518 sy=9.704 sx=2 sz=2
place Block_Foundation_Tier3 jppmt at 1.30 3.21 h=8.818 sy=10.144
prop jpmt tint.color=#5a6470
prop jpmt tint.amount=0.35
prop jppmt tint.color=#5a6470
prop jppmt tint.amount=0.35
place Loot_Chest jcmt at -5.12 -2.02 h=8.90 sit yaw=0
note jcmt Rooftop perch | The ferry crew raced over the drowned roofs on their day off; the winner sat up here.
loot jcmt Plank*6;Rope*3;MetalIngot*1
prop jcmt loot.refill=0
place Loot_ChestSmall jbmt at 1.30 3.21 h=9.50 sit yaw=0
note jbmt Rooftop run prize | A tin wedged on the last post: a deckhand's winnings.
loot jbmt MetalIngot*2;CopperIngot*2;TitaniumIngot*1
prop jbmt loot.refill=0
place Zone_Trigger jymt at 1.30 3.21 h=10.50
prop jymt zone.id=jump_mt_finale
prop jymt zone.radius=1.8
prop jymt zone.repeat=never
prop jymt zone.message=The top of the rooftop run - a tin is wedged on the last post.
pop
# --- end of jump course mt ---

save The Drowned Metropolis
