# Hookline Stack - the fourth island of the library's plan The City That Never Sank (SL13, Highwater, chapter 4)
# The Salvagers' Union: a half-sunk office block's top floor is the Union hall, a crane on its roof; two more cranes
# stand over the sorting yard - scrap piles, ore crates, potato planters - and a barge of clay and sand lies moored
# off the yard. A zipline runs from the hall's roof crane to the third crane. A memorial wall names the lost divers; a
# dive rope hangs off the jetty into the drowned street below. Quest "The Salvagers' Union" (18 steps): the hall, the
# Union's charter, the engine controls' plans, the zipline to crane three, the metal detector's plans, the flare
# store's firework plans, the zipline's plans in the crane cab. Contract "Lost Below" (4): the missing expedition
# notice, the dive rope, two salvage tags off the street below, the Union's receipt (unionfriend).
#
# Points: the yard 0 0 (r about 36, levelled at 2 round 0 -14 and 18 10); the Union hall x -3..3, z -22.5..-13.5
# (floor 2, roof 5, door north, ramp up its east side); crane three at 24 14; the jetty and dive rope at -34 -20; the
# barge x 30..36, z -30..-24; the skyline out at 120 -60.
include lib_sea
include lib_rt
include lib_huts
include lib_highwater
include lib_areas
include lib_features
# RESIZE 10-24b: Radius 36 -> 85 (Height 4 -> 5), the old content moved -42.3 -24.9 as one frame (push) so its sea side stays at
# DEEP 10-24: Scrapjaw Heights: a scrap mountain with an old excavator at the top of a boom ladder, the Union strongroom sixteen metres down, and three cranes woken by one console.
# the coast; the island grows behind it. The jetty and its drowned street stay on the coast (south-west); the clay barge and the two reefs were moved out to the new south and west coasts.
new
gen Trees=0.2 Bushes=0.25 Rocks=0.43 Harvest=0.24 BeachThings=0.35
gen Seed=13401 Radius=85 Height=5 Roughness=0.2 Peaks=1 Shape=0 Style=0 PeakShape=0.3 Cliffs=0.1 BeachWidth=0.6
gen Water=0.5 SeaRocks=0.2 SeaFinds=0.5 Sunken=0.3 Hostiles=0 Friendly=0.2 SeaLife=0.3
generate
push at -42.3 -24.9

# --- Terrain: the hall's and the yard's levels -------------------------------------------------------------------------
brush flatten at 0 -14 r=11 s=20 frames=300 h=2
brush flatten at 18 10 r=12 s=20 frames=300 h=2
# (REACH 10-24: the office storey with the flare store stood in the slope - a pad cut for it)
brush flatten at 2 2 r=8 s=20 frames=300 h=2
pop
# --- DEEP 10-24 terrain: Scrapjaw Heights (south, summit 36 m, base r 27), its trail, the drowned Union strongroom (-16 m) ------------
call hw_mount x=-4 z=-52 b=27 h=36
call hw_trail x=-4 z=-52 b=27 h=36 a0=4.4 turn=300 n=40 h0=3
brush flatten at 1.88 -64.26 r=2.6 s=20 frames=200 h=19.5
clear at 1.88 -64.26 r=3
call hw_basin x=70 z=-22 r=14 h=-16
brush flatten at 34 -22 r=4 s=8 frames=60
clear at 34 -22 r=6
origin
push at -42.3 -24.9
clear at 0 -16 r=10
clear at 18 10 r=10
clear from -20 -20 to -36 -20 r=4

# --- The Union hall: an office block's top floor, its roof crane, the ramp up its east side -----------------------------
push at 3 -18 h=2
call rt_storey a=office b1=RT_WallWindow1 b2=RT_WallDoor1 f1=RT_WallWindow2 f2=RT_WallWindow2 l2=RT_WallWindow1
place RT_Floor office at 0 4.5 y=3
call rt_railing y=3 rm=none
place "Table Office" - at -3 -2.5 y=0.1 sit
place Loot_Chest hallchest at -1.2 -3.4 y=0.1 sit
place Note_Board charter at -5.9 1.5 y=1.2 yaw=90
place Note_Board notice at -5.9 -3 y=1.2 yaw=90
place Zone_Trigger hallzone at -3 0 y=0.1
place Placeable_Lantern_Metal - at -3 -2.5 y=0.9 drop
place UT_ElectricityIsland_Crane02 crane1 at -3.5 3 y=3.05 sit scale=0.25 yaw=225
# (Raft's zipline brings its floor 5.72 m west, 0.97 m north and 1.35 m under the landmark: that floor on the roof at -2 -1.5)
place ZiplinePath_Landmark crane1zip at 3.72 -0.53 y=4.4
pop
zipto crane1zip 22 12
ramp Block_Floor_Wood from 4.5 -26 2 to 4.5 -18 5 len=1.5 top=0
ramp Block_Wall_Fence_Rope from 5.25 -26 2 to 5.25 -18 5 len=1.5 top=-0.1

# --- The memorial wall of lost divers, by the hall's door ------------------------------------------------------------
place RT_Wall1 memorial at -6 -8 ground yaw=0
place RT_Wall1 memorial at -9 -8 ground yaw=0
place Note_Sign memorialsign at -7.5 -7.6 ground sit yaw=180
place Placeable_Lantern_Basic - at -7.5 -7 ground drop

# --- The sorting yard: two cranes, scrap and ore, potato planters, the flare store ----------------------------------
place UT_ElectricityIsland_Crane01 crane2 at -18 10 ground sit scale=0.4 yaw=60
place UT_ElectricityIsland_Crane02 crane3 at 26 16 ground sit scale=0.4 yaw=200
place Zone_Trigger crane3zone at 22 12 ground y=1
place Loot_Chest cranecab at 26 12.5 ground sit yaw=180
place Loot_Chest foremanbox at 19 13 ground sit yaw=90
place "Table Office" - at 17 11 ground sit yaw=90
place "Pickup_Landmark_Scrap 1_Land" - at 12 4 ground sit
place "Pickup_Landmark_Scrap 2_Land" - at 13.5 6 ground sit
place "Pickup_Landmark_Scrap 3_Land" - at 11 7.5 ground sit
place "Pickup_Landmark_Scrap 4_Land" - at 14.5 3 ground sit
place "Pickup_Landmark_Iron 1" - at 20 4 ground sit
place "Pickup_Landmark_Iron 2" - at 21.5 5 ground sit
place "Pickup_Landmark_Iron 3" - at 22.5 3.5 ground sit
place "Box Small" - at 23 6 ground sit
place "Box Small" - at 23.8 6.8 ground sit
place Placeable_Cropplot_Medium - at 8 16 ground sit
place Placeable_Cropplot_Medium - at 11.5 16 ground sit
place Placeable_Cropplot_Medium - at 15 16 ground sit
place Loot_ChestSmall potatobox at 6 18.5 ground sit yaw=90
push at 2 2 h=2
call rt_storey a=office f2=RT_WallDoor1 l2=none r2=RT_WallWindowBroken
place Loot_Chest flarestore at -3 3.4 y=0.1 sit yaw=180
place "Box Small" - at -5 3.4 y=0.1 sit
place Reef_Barrel2 - at -1 3 y=0.1 sit
pop

# --- The clay and sand barge moored off the yard -------------------------------------------------------------------
line Block_Foundation from 20.37 -70.42 to 24.87 -70.42 step=1.5 h=0.35
line Block_Foundation from 20.37 -68.92 to 24.87 -68.92 step=1.5 h=0.35
line Block_Foundation from 20.37 -67.42 to 24.87 -67.42 step=1.5 h=0.35
line Block_Foundation from 20.37 -65.92 to 24.87 -65.92 step=1.5 h=0.35
# (the barge's deck, unrolled 10-24b)

place "Pickup_Landmark_Clay 1" - at 21.12 -69.17 h=1.05 sit
place "Pickup_Landmark_Clay 2" - at 22.62 -68.17 h=1.05 sit
place "Pickup_Landmark_Clay 3" - at 24.12 -69.67 h=1.05 sit
place "Pickup_Landmark_Sand" - at 21.12 -66.67 h=1.05 sit
place "Pickup_Landmark_Sand" - at 23.12 -66.17 h=1.05 sit
place RT_Pillar - at 19.12 -68.17 ground sy=0.6

# --- The jetty and the dive rope; the street below and its salvage tags ------------------------------------------------
line Block_Floor_Wood from -24 -20 to -34.5 -20 step=1.5 h=1
place Block_Ladder diverope at -35.6 -20 h=-2 yaw=90
place Zone_Trigger divezone at -34 -20 h=1.5
place RT_Clipboard tally at -26 -20.6 h=1.05 drop
place Note_Paper receipt at -27.5 -19.4 h=1.05 drop
place Loot_ChestSmall tag1 at -40 -24 ground sit
place Loot_ChestSmall tag2 at -42 -15 ground sit
place "Pickup_Landmark_Scrap 1_OceanBottom" - at -39 -18 ground sit
place "Pickup_Landmark_Scrap 3_OceanBottom" - at -43 -21 ground sit

# --- Highwater on the horizon; the sea's finds; two reefs ------------------------------------------------------------
call hw_skyline x=162.3 z=-35.1 a=skyline
call shallows x=42.3 z=24.9 r=127.5 deep=6 n=2 seed=13402
call hw_reef x=-52.7 z=29.9 r=4 seed=13403
call hw_reef x=72.3 z=-67.1 r=4 seed=13407

pop

# --- Areas (10-24: every story island has places all over it and its quest crosses it): the spoil heap east of the yard (buried
# salvage for the metal detector), the toppled crane and the excavator in the south-east, the old tally house in the
# north, the divers' drying cave in the west
call ar_ridge x1=18 z1=32 x2=55 z2=8 h=9 top=6 r=10
call ar_plants_tropical x=36 z=20 r=28 seed=13411
call hw_zone x=36 z=20 al=spoilheap id=spoil_heap r=7 msg="The spoil heap: a hill of what the street gave up and nobody wanted. The Union's cranes stand over the yard like herons."
call treasure x=36 z=20 r=14 n=2 seed=13461
prop treasure13461 treasure.loot=CopperOre*3;MetalOre*2
call hw_wreck x=46 z=-38 h=3 yaw=120 obj=UT_ElectricityIsland_Crane02 al=toppledcrane crate=cranewreckcrate r=12
place VP_Excavator salvagedigger at 28 -58 ground sit yaw=40
prop salvagedigger tint.color=#5a5048
prop salvagedigger tint.amount=0.45
call ar_ruin x=-15 z=56 h=4 yaw=0 al=tallyhouse
call hw_note x=-12.5 z=51.5 yaw=20 al=tallybook
place VP_Forklift - at 6 44 ground sit yaw=250
call ar_cave x=-62 z=26 h=3 yaw=0 al=divercave chest=divercavechest
call hw_zone x=-62 z=40 al=divercavezone id=divers_cave r=4 msg="The divers' drying cave: wetsuits on hooks, names chalked over each one. Some of the hooks are empty."
call ar_plants_tropical x=-45 z=55 r=14 seed=13421
call ar_plants_tropical x=60 z=40 r=12 seed=13431

# --- DEEP 10-24 (the user: one hour per island - real height, a big climb, a deep dive): Scrapjaw Heights: a scrap mountain with an old excavator at the top of a boom ladder, the Union strongroom sixteen metres down, and three cranes woken by one console. ------
# the climb: the trail spirals up from the north foot; on the summit the dragline's boom ladder (11 storeys, a ladder inside), its deck chest
# and a zipline down to the hub (the shortcut back); the dive: the Union strongroom on a basin floor -16 m down, an air pocket
# in its front room; the hub: the Crane console that wants both, the notice; secrets: the trail ledge cache, the summit treasure,
# the sunk boat's crate
call hw_zone x=-1.85 z=-24.08 al=hk_trailz id=hk_trail r=5 msg="The trail up Scrapjaw Heights starts here - cut into the slope, round and up."
call hw_zone x=-4 z=-52 al=hk_summitz id=hk_summit r=8 h=1 msg="The top of Scrapjaw Heights. The whole island below, the city beyond it, and the dragline's boom ladder still higher."
call hw_mast x=-7.14 z=-54.48 h0=36 lv=11 a=hk_mast chest=hk_topchest top=Placeable_Lantern_Metal
place ZiplinePath_Landmark hk_zip at 1.21 -50.63 h=37.35
zipto hk_zip 30.86 -24.48
place Loot_ChestSmall hk_ledge at 1.88 -64.26 ground sit yaw=334.4
call treasure x=-1.52 z=-55.14 r=5 n=1 seed=13478 kind=0
prop treasure13478 treasure.loot=CopperOre*2;MetalOre*2;TradeToken*1
place Creature_Goat hk_goats at 1.25 -28.01 ground
prop hk_goats creature.count=2
place Creature_Goat hk_summitgoat at -5.86 -49.65 ground
prop hk_summitgoat creature.count=1
scatter "Pickup_Landmark_Copper 1" 2 at -4 -52 r=23 seed=13482 free=2
scatter "Pickup_Landmark_Clay 1" 2 at -4 -52 r=25 seed=13483 free=2
scatter "Pickup_Landmark_Rock 1" 2 at -4 -52 r=21 seed=13484 free=2
place VP_Excavator hk_dragline at -6.19 -18.59 ground sit yaw=94.4
prop hk_dragline tint.color=#6a5a48
prop hk_dragline tint.amount=0.4
call hw_sunkhouse x=70 z=-22 h=-16 yaw=0 a=hk_sunk chest=hk_deepchest air=hk_air bub=hk_airbub dal=hk_sunkdoor
call hw_zone x=70 z=-22 al=hk_deepz id=hk_deep r=7 h=1 msg="The Union strongroom, 16 metres down. The front room still holds a pocket of air."
place RT_PlasticBoat hk_sunkboat at 78 -20 ground sit yaw=35
prop hk_sunkboat tint.color=#5a5048
prop hk_sunkboat tint.amount=0.45
place Loot_Crate hk_boatcrate at 77 -26 ground sit yaw=10
prop hk_boatcrate loot.refill=0
call hw_reef x=63 z=-17 r=3 seed=13486
place Creature_PufferFish hk_puffers at 64 -29 h=-12
prop hk_puffers creature.count=2
call hw_machine x=34 z=-22 yaw=-128.29 al=hk_machine nm="Crane console" obj=RT_PowerBox sc=1 a=hk_top b=hk_deep done=hk_fixed rew=hk_rewchest rnote=hk_rewnote msg="It works." hint="It needs the dragline ignition key from the top of Scrapjaw Heights and the strongroom ledger from the Union strongroom."
call hw_note x=33.63 z=-19.11 yaw=-108.29 al=hk_hint
story hk_top|Dragline ignition key|Bolt|The big dragline's ignition key, hung on a nail at the top of its boom ladder.
story hk_deep|Strongroom ledger|Bolt|The Union's drowned ledger, sealed in oilcloth.
story hk_fixed|Crane console working|Bolt|The crane console, working again.
story tape|Insulating tape|Bolt|A roll of the Union linesmen's insulating tape. Three of them would make a dead breaker safe.
note hk_hint Yard foreman's notice | Crane console is locked out. It wants the dragline's ignition key (top of the boom ladder on Scrapjaw Heights) and the strongroom ledger with the yard codes - the old strongroom is sixteen metres down off the east yard. Take a bottle.
note hk_topchest Dragline's boom ladder deck box | A box lashed to the deck rail at the top of the dragline's boom ladder.
loot hk_topchest story:hk_top*1;Scrap*3;Bolt*2
note hk_deepchest Union strongroom strongbox | A strongbox in the back room of the Union strongroom.
loot hk_deepchest story:hk_deep*1;story:tape*1;MetalIngot*2
note hk_rewnote Union yard codes | The console lights up and all three cranes swing. In its drawer: the Union's yard codes and a list of every diver the Union never paid.
note hk_rewchest Crane console reward | What the crane console kept.
loot hk_rewchest CopperIngot*2;CircuitBoard*1;TradeToken*2
note hk_ledge Climber's cache | A climber's cache on a ledge off the trail - rope, a flask, a few bolts.
loot hk_ledge Rope*2;Bolt*2;Scrap*2
prop hk_ledge loot.refill=0
loot hk_boatcrate Plastic*3;Scrap*2;MetalIngot*1

# --- Settings, story items, notes, behaviours, quests -----------------------------------------------------------------
info title=Hookline Stack
info author=Custom Islands
info description=The Salvagers' Union's yard on a half-sunk office block: three cranes, a zipline between them, scrap piles and ore, a barge of clay and sand, and a dive rope into the drowned street. The fourth island of The City That Never Sank.
island on.arrive=message||Three cranes stand over a yard of scrap. On the half-sunk office block a banner: SALVAGERS' UNION - WHAT WE BRING UP, WE SHARE.

story salvagetag|Salvage tag|Bolt|A diver's brass salvage tag, stamped with the Union's hook - off the drowned street.

prop office tint.color=#8c8a84
prop office tint.amount=0.3
prop skyline tint.color=#7a8088
prop skyline tint.amount=0.4

prop crane1zip obj.name=crane1zip
prop receipt obj.name=receipt
prop receipt beh.hidden=1
prop tag1 obj.name=tag1
prop tag1 beh.hidden=1
prop tag2 obj.name=tag2
prop tag2 beh.hidden=1
prop notice on.read=show|tag1\nshow|tag2
prop tally obj.name=tally
prop tally beh.use=Hand in the salvage tags
prop tally if.use=has|story:salvagetag|2\n!signal|tagsin
prop tally on.use=signal||tagsin\nshow|receipt\nmessage||The tally clerk's board takes two more marks. Next to it a receipt is waiting, already signed.
prop tally else.use=message||The tally board wants two salvage tags from the street below.
prop receipt on.read=signal||unionfriend

note charter Union charter | CHARTER OF THE SALVAGERS' UNION\n\nWhat we bring up, we share.\nNo diver goes down alone.\nNo diver is left down.\nThe Authority gets its tenth and not a nail more.\n\nThe hook is our sign. The rope is our oath.
note notice Missing expedition notice | MISSING - THE LOWSTREET EXPEDITION\n\nFive divers under Ines Marlowe went down to Lowstreet to map the old pumps. They have not come up.\n\nTheir salvage tags were found on the street below this jetty. Bring them up and hand them in at the tally.\n\nThe Union does not leave its divers down.
note memorialsign Memorial wall | THE UNION REMEMBERS\n\nA hundred names, scratched into the concrete. The newest are only chalk.
note receipt Union receipt | RECEIVED: two salvage tags, Marlowe's team.\n\nThey were alive when they dropped them. The Union owes you a diver's debt. - the foreman
note hallchest Hall desk | The hall's desk: the engine controls' plans, a foreman's whistle - and a spare diver's kit, an oxygen bottle and flippers. No diver goes down alone, and none goes down short of air.
note foremanbox Foreman's box | The yard foreman's box: the metal detector's plans, a list of what the street gave up this week.
note flarestore Flare store | The Union's flare store: the firework's plans, flares for divers in trouble.
note cranecab Crane cab | Crane three's cab: the zipline's plans, a thermos, a view over the yard.
note potatobox Planter box | Seed potatoes for the yard's planters.
note tag1 Salvage cache | A diver's cache on the street below, tied to a lamp post.
note tag2 Salvage cache | A diver's cache on the street below, wedged in a shop door.
loot hallchest Blueprint_EngineControls*1;MetalIngot*2;Bolt*4;OxygenBottle*1;Flipper*1
prop hallchest loot.refill=0
loot foremanbox Blueprint_MetalDetector*1;Scrap*4
prop foremanbox loot.refill=0
loot flarestore Blueprint_Firework*1;Rope*2
prop flarestore loot.refill=0
loot cranecab Blueprint_ZiplineBase*1;MetalIngot*2;Rope*3
prop cranecab loot.refill=0
loot potatobox Raw_Potato*4
prop potatobox loot.refill=0
loot tag1 story:salvagetag*1;Scrap*2
prop tag1 loot.refill=0
loot tag2 story:salvagetag*1;MetalOre*2
prop tag2 loot.refill=0

prop hallzone zone.id=union_hall
prop hallzone zone.radius=3
prop hallzone zone.message=The Union hall. Hooks on the walls, a board of names, and a desk nobody sits at.
prop crane3zone zone.id=crane_3
prop crane3zone zone.radius=4
prop crane3zone zone.message=Crane three. The zipline's end, and a cab up the ladder.
prop divezone zone.id=dive_rope
prop divezone zone.radius=3
prop divezone zone.message=The dive rope. Below it, in green water, the street lamps of Lowstreet.

note cranewreckcrate Toppled crane's toolbox | Crane five's toolbox. The crane came down in the last storm; the Union never had the parts to stand it up again.
loot cranewreckcrate Bolt*4;MetalIngot*2;Rope*2
note tallybook Tally book | UNION TALLY BOOK\n\nShare out: one part to the diver, one to the crane, one to the hall.\nThis week: a fridge, two doors, a tram seat. Lowstreet is picked nearly clean above the shops.\nMarlowe says the store at the east end is untouched. The Authority says it is closed. Why would a drowned shop be closed?
note divercavechest Divers' locker | A diver's locker: a spare mask strap, rope and a tin of grease.
loot divercavechest Rope*3;Scrap*3;Leather*1
prop divercavechest loot.refill=0
# --- JUMP COURSE hs (U22, 10-24): a kz-style hop course of floor slabs on its own flattened pad -----------------
# Every gap and rise is within the U22 jump limits (reach_audit/jumps.py checks them). A fall lands on the pad.
# JUMP hs pad=3 at=24 69
push at 24 69
clear at 0 0 r=17 all
brush flatten at 0 0 r=14 s=20 frames=300 h=3
brush smooth at 0 0 r=18 s=4 frames=40
brush flatten at 0 0 r=12 s=20 frames=300 h=3
brush auto at 0 0 r=18 s=10 frames=25
clear at 0 0 r=18
place Block_Foundation_Tier3 jphs at 0.10 -5.64 h=3.60
place Block_Foundation_Tier3 jphs at 2.92 -5.64 h=4.10
place Block_Foundation_Tier3 jphs at 5.93 -5.64 h=4.50
place Block_Foundation_Tier3 jphs at 5.93 -3.03 h=5.40
place Block_Foundation_Tier3 jphs at 5.93 1.21 h=5.90 sx=0.3 sz=3
place Block_Foundation_Tier3 jphs at 5.93 5.64 h=6.70
place Block_Foundation_Tier3 jphs at 3.02 5.64 h=7.60
place Block_Foundation_Tier3 jphs at 0.40 5.64 h=6.60
place Block_Foundation_Tier3 jphs at -2.41 5.64 h=7.55
place Block_Foundation_Tier3 jphs at -5.12 5.64 h=8.50
place Block_Foundation_Tier3 jphs at -5.12 2.02 h=9.40 sx=2 sz=2
# JUMP from 11
place Block_Foundation_Tier3 jphs at 1.30 2.02 h=9.70 sx=2 sz=2
place Block_Foundation_Tier3 jphs at 1.30 -3.21 h=10.00
# JUMP end
place RT_PillarThick jpphs at 2.92 -5.64 h=2.50 sy=0.153 sx=0.8 sz=0.8
place RT_PillarThick jpphs at 5.93 -5.64 h=2.50 sy=0.220 sx=0.8 sz=0.8
place RT_PillarThick jpphs at 5.93 -3.03 h=2.50 sy=0.370 sx=0.8 sz=0.8
place RT_PillarThick jpphs at 5.93 1.21 h=2.50 sy=0.453 sx=0.8 sz=0.8
place RT_PillarThick jpphs at 5.93 5.64 h=2.50 sy=0.586 sx=0.8 sz=0.8
place RT_PillarThick jpphs at 3.02 5.64 h=2.50 sy=0.736 sx=0.8 sz=0.8
place RT_PillarThick jpphs at 0.40 5.64 h=2.50 sy=0.570 sx=0.8 sz=0.8
place RT_PillarThick jpphs at -2.41 5.64 h=2.50 sy=0.728 sx=0.8 sz=0.8
place RT_PillarThick jpphs at -5.12 5.64 h=2.50 sy=0.886 sx=0.8 sz=0.8
place RT_PillarThick jpphs at -5.12 2.02 h=2.50 sy=1.036 sx=0.8 sz=0.8
place RT_PillarThick jpphs at 1.30 2.02 h=2.50 sy=1.086 sx=0.8 sz=0.8
place RT_PillarThick jpphs at 1.30 -3.21 h=2.50 sy=1.136 sx=0.8 sz=0.8
prop jphs tint.color=#8a7f70
prop jphs tint.amount=0.35
prop jpphs tint.color=#8a7f70
prop jpphs tint.amount=0.35
place Loot_Chest jchs at -5.12 2.02 h=9.40 sit yaw=0
note jchs Hook crew perch | The hook crew dried their lines up here, out of the gulls' reach.
loot jchs Rope*4;Plank*4;MetalIngot*1
prop jchs loot.refill=0
place Loot_ChestSmall jbhs at 1.30 -3.21 h=10.00 sit yaw=0
note jbhs Long line | The crew's best kept at the end of the long jumps.
loot jbhs MetalIngot*2;CopperIngot*1;Rope*2
prop jbhs loot.refill=0
place Zone_Trigger jyhs at 1.30 -3.21 h=11.00
prop jyhs zone.id=jump_hs_finale
prop jyhs zone.radius=1.8
prop jyhs zone.repeat=never
prop jyhs zone.message=The end of the long line. Not many crew made it here.
pop
# --- end of jump course hs ---

quest title=The Salvagers' Union
quest intro=The Union works the cranes on the half-sunk block. Find their hall.
step reach|union_hall|1|Go into the Union hall
step read|Union charter|1|Read the Union's charter
step blueprint|Blueprint_EngineControls|1|Take the engine controls' plans from the hall's desk
step reach|crane_3|1|Ride the zipline from the hall's roof crane to crane three
step blueprint|Blueprint_MetalDetector|1|Take the metal detector's plans from the foreman's box
step blueprint|Blueprint_Firework|1|Take the firework's plans from the flare store
step reach|spoil_heap|1|Climb the spoil heap east of the yard
step open|Toppled crane's toolbox|1|Open the toolbox of the toppled crane in the south-east
step read|Tally book|1|Read the Union's tally book in the old tally house in the north
step reach|divers_cave|1|Find the divers' drying cave in the west
step read|Yard foreman's notice|1|Read the yard foreman's notice by the crane console in the south-east
step reach|hk_trail|1|Find the foot of the trail up Scrapjaw Heights, in the south
step reach|hk_summit|1|Climb the trail to the top of Scrapjaw Heights
