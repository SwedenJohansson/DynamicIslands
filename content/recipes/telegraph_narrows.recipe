# Telegraph Narrows - an island of the library's plan The Last Post (the Coastal Post's route, the sixth stop)
# Two rocky headlands with a strait between them and eight sea stacks in a line across it, the old telegraph line: a
# telegraph pole (Balboa's antenna pole) on every stack, ziplines running downhill stack to stack from the tall west
# headland to the low east one; the first telegraph hut on the west headland (its generator outside), the wire connector
# on stack 4, screechers nesting on stack 6, the last hut on the east headland with its keypad, the telegraph cabinet,
# and the telegraphist Holger locked in a cage.
# Quest "Down the Line" (22 steps): the first hut, the code sheet, the generator, stack 4 by zipline, its wire connector,
# the screechers, the last hut, its keypad, the telegraph cabinet (four power blueprints and the cage key), Holger
# freed, his kit.
#
# Built by the recipe player (CIRecipe telegraph_narrows) through the editor's own operations.
include lib_sea
include lib_features
include lib_post
include lib_areas
include lib_highwater
include lib_lastpost
# RESIZE 10-26 (the user: Raft-big, one-hour islands): Radius 70 -> 90
# POST 10-26: the new land - Wire Hill with repeater mast, Seal Cave, Dagny Ek at the ruined house (a lamp puzzle), a crashed plane, a jump course, a set of five glass insulators
new
# (nature: rocky headlands, Like Raft's rock islands)
gen Trees=0.15 Bushes=0.25 Rocks=0.5 Harvest=0.15 BeachThings=0.25
gen Seed=4601 Radius=90 Height=12 Roughness=0.55 Peaks=1 Shape=0 Style=4 PeakShape=0.4 Cliffs=0.5 BeachWidth=0.25
gen Water=0.5 SeaRocks=0.4 SeaFinds=0.15 Sunken=0.2 Hostiles=0 Friendly=0 SeaLife=0.3
generate

# --- Terrain: the strait cut north-south through the middle, the headlands, the six stacks in it ---------------------
brush flatten from 0 -80 to 0 80 r=22 s=20 frames=300 h=-8
brush flatten at -34 0 r=7 s=20 frames=140 h=20
brush flatten at 34 0 r=7 s=20 frames=140 h=7
macro stack x=0 h=10
brush flatten at $x 0 r=3.5 s=20 frames=120 h=$h
brush rock at $x 0 r=4.5 s=8 frames=20
end
call stack x=-20 h=18
call stack x=-12 h=16.5
call stack x=-4 h=15
call stack x=4 h=13.5
call stack x=12 h=12
call stack x=20 h=10
brush rock at -34 0 r=9 s=6 frames=20
brush rock at 34 0 r=9 s=6 frames=20
origin
# --- POST 10-26 terrain: Wire Hill, the pads of the new areas ---------------------------------------------------
call hw_mount x=-50 z=-46 b=22 h=24
call hw_trail x=-50 z=-46 b=22 h=24 a0=-2.66 turn=300 n=40 h0=3
brush flatten at -54 40 r=4 s=8 frames=60
clear at -54 40 r=7
brush flatten from 0 76 to 0 104 r=22 s=20 frames=300 h=-8
brush flatten from 0 -76 to 0 -104 r=22 s=20 frames=300 h=-8
clear at -34 0 r=7
clear at 34 0 r=7
clear from -22 0 to 22 0 r=4

# --- The first hut on the west headland (stack 1), the generator by it ---------------------------------------------
push at -36.25 -2.25 h=20
call posthall w=3 d=3 al=huts
place "Table Office" - at 2.25 3.2 y=1.3 sit drop yaw=0
place Note_Paper codesheet at 2.6 3.2 y=2.2 sit drop yaw=-6
place "Chair Office" - at 2.25 2.3 y=1.3 sit drop yaw=0
place Placeable_Shelf_Small_Basic - at 0.9 1.6 y=1.3 sit drop yaw=90
place Zone_Trigger firsthutzone at 2.25 1.5 y=0.8
pop
place "VG_DecorationPrefabBase_EmergencyGenerator Variant" generator at -35.6 -4.6 ground sit yaw=0

# --- The line: a pole on every stack, a zipline from each to the next, downhill west to east ---------------------------
macro pole x=0 z=1.6
place Antenna_pole - at $x $z ground sit
end
call pole x=-31 z=3.5
call pole x=-20
call pole x=-12
call pole x=-4
call pole x=4
call pole x=12
call pole x=20
call pole x=31 z=3.5
# (Raft's zipline has no stand: its near floor is 5.72 m west, 0.97 m north of where it is put and 1.35 m under its h -
# put "ground" it hung in the air; each line is put so its near floor sits on its stack's flat top, 2026-10-23)
place ZiplinePath_Landmark zip1 at -25.78 -1.97 h=21.35
zipto zip1 -20 -0.5
place ZiplinePath_Landmark zip2 at -14.28 -1.47 h=19.35
zipto zip2 -12 -0.5
place ZiplinePath_Landmark zip3 at -6.28 -1.47 h=17.85
zipto zip3 -4 -0.5
place ZiplinePath_Landmark zip4 at 1.72 -1.47 h=16.35
zipto zip4 4 -0.5
place ZiplinePath_Landmark zip5 at 9.72 -1.47 h=14.85
zipto zip5 12 -0.5
place ZiplinePath_Landmark zip6 at 17.72 -1.47 h=13.35
zipto zip6 20 -0.5
place ZiplinePath_Landmark zip7 at 25.72 -1.47 h=11.35
zipto zip7 30.5 -1
place Zone_Trigger stack4zone at -4 0 ground
place UT_ElectricCableHub01 linehub at -4 2.6 ground sit yaw=180
place Creature_StoneBird screechers at 12 0 h=15

# --- The last hut on the east headland (stack 8): the keypad, the telegraph cabinet; Holger's cage outside ------------
push at 31.75 -2.25 h=7
call posthall w=3 d=3 al=huts
place RT_PowerBox cabinetpad at 4.35 2.25 y=1.4 yaw=270
place Loot_Chest cabinet at 2.25 3.9 y=1.3 sit drop yaw=180
place "Table Office" - at 1.5 2.4 y=1.3 sit drop yaw=90
place Zone_Trigger lasthutzone at 2.25 1.5 y=0.8
pop
place Survivor_Cage holgercage at 35 -5.5 ground yaw=0
place Loot_ChestSmall holgerkit at 32.4 -5.2 ground sit yaw=0

# --- Nature: the reefs at the stacks' feet, a treasure, a turtle --------------------------------------------------------
call shallows r=80 deep=5 n=2
call treasure x=-40 z=12 r=8 n=1 seed=4611 kind=0
call dirt x=-42 z=-14 r=8 n=2 seed=4612
place Creature_Turtle turtle at 0 -30 h=-4

# --- POST 10-26 (the user: one hour per island - hills, cliffs, a cave, a house, a wreck, secrets): Wire Hill ------
# Wire Hill with repeater mast on it, Seal Cave, the ruined house where Dagny Ek waits (four lamps round it: a puzzle), a crashed plane,
# a jump course, five glass insulators about the island (a set), and at the hub the line repeater that wants the relay coil and the relay key
call hw_zone x=-51.07 z=-23.02 al=qt_trailz id=qt_trail r=5 msg="The trail up Wire Hill starts here - round and up."
call hw_zone x=-50 z=-46 al=qt_summitz id=qt_summit r=8 h=1 msg="The top of Wire Hill. The whole island below you."
call hw_mast x=-53 z=-44 h0=24 lv=5 a=qt_mast chest=qt_topchest top=Placeable_Flag_01
place ZiplinePath_Landmark qt_zip at -46.8 -48.6 h=25.35
zipto qt_zip -50.72 34.01
place Creature_Goat qt_goats at -47.07 -20.02 ground
prop qt_goats creature.count=2
call ar_cave x=70 z=24 h=3 yaw=180 al=qt_caverock chest=qt_cavechest
call hw_zone x=71 z=15 al=qt_cavez id=qt_cave r=4 h=1 msg="Seal Cave. Water drips somewhere in the dark."
call ar_ruin x=56 z=-40 h=3 yaw=0 w=3 d=2 al=qt_ruin
call lp_islander x=55 z=-44.5 yaw=200 al=qt_isl nm="Dagny Ek" pose=sit
prop qt_isl talk.text=Holger's line? I kept the repeater for him, this side of the strait.\n---\nThe repeater takes a weak signal and sends it on strong. When the Post shut the signals stopped, and I took it apart - the coil up the mast on Wire Hill, the key into Seal Cave. I couldn't stand the silence on the tape.\n---\nPut it together. Maybe someone is still sending.\n---\nMy lamps round the house: four, each wakes its neighbour. All four lit, and look behind the back wall. And try Holger's old telescope by the repeater - you can see the whole line from there.
place Placeable_Chair_Basic - at 55 -44.5 ground sit yaw=200
call lp_lamp x=49 z=-41 al=qt_lamp1 nm="Line lamp 1" grp="Line lamps" on=0
call lp_lamp x=55 z=-34 al=qt_lamp2 nm="Line lamp 2" grp="Line lamps" on=1
call lp_lamp x=62 z=-41 al=qt_lamp3 nm="Line lamp 3" grp="Line lamps" on=0
call lp_lamp x=55 z=-48 al=qt_lamp4 nm="Line lamp 4" grp="Line lamps" on=1
prop qt_lamp1 on.use=light|Line lamp 2|toggle
prop qt_lamp2 on.use=light|Line lamp 3|toggle
prop qt_lamp3 on.use=light|Line lamp 4|toggle
prop qt_lamp4 on.use=light|Line lamp 1|toggle
prop qt_lamp1 on.alllit=show|qt_lampchest\nmessage||All four lamps burn. Behind the back wall a stone has been lifted.
call lp_hidden x=57 z=-35.4 al=qt_lampchest
place Creature_Chicken qt_hens at 64 -34 ground
prop qt_hens creature.count=3
call ar_plane x=-70 z=6 h=3 yaw=20 al=qt_plane crate=qt_planecrate
place Note_Paper qt_pilot at -73.07 9.25 ground y=0.1 drop yaw=50
call hw_zone x=-70 z=6 al=qt_planez id=qt_plane r=6 h=1 msg="A plane, nose down in the grass. Nobody came for it."
# JUMP qt pad=3 at=44 62
push at 44 62
clear at 0 0 r=17 all
brush flatten at 0 0 r=14 s=20 frames=300 h=3
brush smooth at 0 0 r=18 s=4 frames=40
brush flatten at 0 0 r=12 s=20 frames=300 h=3
brush auto at 0 0 r=18 s=10 frames=25
clear at 0 0 r=18
place Block_Foundation_Tier3 jpqt at 4.24 4.24 h=3.6
place Block_Foundation_Tier3 jpqt at 5.77 1.65 h=4.35
place Block_Foundation_Tier3 jpqt at 5.85 -1.35 h=5.1
place Block_Foundation_Tier3 jpqt at 4.46 -4.01 h=5.85
place Block_Foundation_Tier3 jpqt at 1.95 -5.67 h=6.6
place Block_Foundation_Tier3 jpqt at -1.04 -5.91 h=7.35
place Block_Foundation_Tier3 jpqt at -3.78 -4.66 h=8.1
place Block_Foundation_Tier3 jpqt at -5.56 -2.25 h=8.85
place Block_Foundation_Tier3 jpqt at -5.96 0.73 h=9.6
# JUMP from 10
place Block_Foundation_Tier3 jpqt at -4.85 3.53 h=10.35
place Block_Foundation_Tier3 jpqt at -2.54 5.44 h=11.1 sx=2 sz=2
# JUMP end
place Block_Foundation_Tier3 jppqt at 5.77 1.65 h=3.668 sy=1.861
place Block_Foundation_Tier3 jppqt at 5.85 -1.35 h=4.418 sy=2.959
place Block_Foundation_Tier3 jppqt at 4.46 -4.01 h=5.168 sy=4.058
place Block_Foundation_Tier3 jppqt at 1.95 -5.67 h=5.918 sy=5.157
place Block_Foundation_Tier3 jppqt at -1.04 -5.91 h=6.668 sy=6.255
place Block_Foundation_Tier3 jppqt at -3.78 -4.66 h=7.418 sy=7.354
place Block_Foundation_Tier3 jppqt at -5.56 -2.25 h=8.168 sy=8.453
place Block_Foundation_Tier3 jppqt at -5.96 0.73 h=8.918 sy=9.552
place Block_Foundation_Tier3 jppqt at -4.85 3.53 h=9.668 sy=10.650
place Block_Foundation_Tier3 jppqt at -2.54 5.44 h=10.418 sy=11.749 sx=2 sz=2
prop jpqt tint.color=#8a7f70
prop jpqt tint.amount=0.35
prop jppqt tint.color=#8a7f70
prop jppqt tint.amount=0.35
