place Loot_ChestSmall jbqt at -2.54 5.44 h=11.1 sit yaw=0
prop jbqt loot.refill=0
pop
call hw_zone x=44 z=54 al=qt_jumpz id=qt_jumps r=6 h=1 msg="Stone stacks, one higher than the next. Something at the top."
call lp_piece x=-36 z=-66 al=qt_piece1 set="Glass insulators"
call lp_piece x=-62 z=15 al=qt_piece2 set="Glass insulators"
call lp_piece x=64 z=-2 al=qt_piece3 set="Glass insulators"
call lp_piece x=30 z=56 al=qt_piece4 set="Glass insulators"
call lp_piece x=42 z=-24 al=qt_piece5 set="Glass insulators"
prop qt_piece1 on.set=show|qt_setchest\nmessage||All five glass insulators found.
call lp_hidden x=-49 z=36 al=qt_setchest kind=Loot_Chest
call treasure x=-34 z=72 r=10 n=1 seed=27678 kind=0
prop treasure27678 treasure.loot=CopperOre*2;MetalOre*2;TradeToken*1
call shallows x=0 z=0 r=100 deep=5 n=1 seed=27661
call ar_plants_hill x=74 z=-14 r=14 seed=27691
call ar_plants_hill x=38 z=-62 r=14 seed=27692
call ar_plants_hill x=-38 z=54 r=14 seed=27693
call ar_plants_hill x=-70 z=-18 r=13 seed=27694
call ar_plants_hill x=-66 z=30 r=12 seed=27695
call lp_scope x=-60 z=46 yaw=90 al=qt_scope path=qt_view
call lp_cam x=-70 z=20 h=40 al=qt_cam1 path=qt_view order=1 look=qt_plane speed=9 hold=2
call lp_cam x=-30 z=70 h=50 al=qt_cam2 path=qt_view order=2 look=qt_caverock speed=9 hold=0
call lp_cam x=40 z=60 h=50 al=qt_cam3 path=qt_view order=3 look=qt_caverock speed=9 hold=0
