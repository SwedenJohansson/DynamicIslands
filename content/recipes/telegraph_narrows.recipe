call lp_cam x=0 z=-88 h=60 al=qt_cam5 path=qt_view order=5 look=qt_isl speed=9 hold=2
call hw_machine x=-54 z=40 yaw=126.53 al=qt_machine nm="Line repeater" obj=TP_LaserControlPanel_lever sc=3 a=qt_top b=qt_cave done=qt_fixed rew=qt_rewchest rnote=qt_rewnote msg="It works." hint="It wants the relay coil from Wire Hill and the relay key from Seal Cave."
call hw_note x=-56.6 z=41.2 yaw=146.53 al=qt_hint

# --- Settings, notes, behaviours, quest --------------------------------------------------------------------------------
info title=Telegraph Narrows
info author=Custom Islands
info description=Two rocky headlands and eight sea stacks across the strait between them, a telegraph pole on every stack and ziplines running down the line. Power the line, ride it across, and find out who is still at the far end. The sixth stop of The Last Post.
island on.arrive=message||Two headlands and a line of sea stacks across the strait between them - and on every stack a telegraph pole, wires sagging from one to the next.

prop huts tint.color=#6f5a46
prop huts tint.amount=0.5
prop screechers creature.count=2
prop screechers creature.respawn=0
prop turtle creature.count=1

story linepower|Line power|Note_Paper|The telegraph line's generator runs again.
story linewire|Line connected|Note_Paper|Stack 4's connector is joined: the line is live to the far end.
story cagekey|Cage key|Placeable_Lantern_Metal|The key of the cage outside the last telegraph hut, from the telegraph cabinet.
note codesheet Telegraph code sheet | COASTAL POST TELEGRAPH - CODE SHEET\n\nThe line runs from this hut down eight stacks to the last hut. Generator first, then the connector on stack 4.\n\nCabinet code, in the line's own numbers:\n--... ..--- ....- .----\n(dashes count from five: --... is 7)\n\nThe screechers nest on stack 6 every spring. Take a spear.
prop generator obj.name=generator
prop generator beh.use=Start the generator
prop generator if.use=!signal|linepower
prop generator on.use=message||The generator coughs, catches and settles into a hum. Somewhere down the line a relay clicks.\nsignal||power\nsignal||linepower\ngive||story:linepower*1
prop generator else.use=message||The generator is running.
prop linehub obj.name=linehub
prop linehub beh.use=Join the line
prop linehub if.use=has|story:linepower|1\n!signal|linewire
prop linehub on.use=open|\nsignal||wire\nsignal||linewire\ngive||story:linewire*1\nmessage||The cable clicks in. Current hums along the wire, down the line to the stacks.
prop linehub else.use=message||The line is dead - the generator at the first hut is off. Or it is joined already.
prop cabinetpad obj.name=cabinetpad
prop cabinetpad beh.use=Type the cabinet code
prop cabinetpad lock.code=7241
prop cabinetpad if.use=quest|5\nhas|story:linewire|1
prop cabinetpad on.use=sound||event:/exploring/obstacles/keypad/keypad_correct\nmessage||The keypad chirps and the telegraph cabinet unlocks.\nsignal||cabinet
prop cabinetpad else.use=message||The keypad is dark: no current on the line.
note cabinet Telegraph cabinet | The telegraph cabinet: the line's power plans, and a key on a hook labelled CAGE.
loot cabinet Blueprint_WindTurbine*1;Blueprint_BatteryAdvanced*1;Blueprint_HeadLight_Advanced*1;Blueprint_ElectricGrill*1;story:cagekey*1;CopperIngot*2
prop cabinet loot.refill=0
prop cabinet if.open=signal|cabinet
prop cabinet else.open=message||The cabinet is locked from the keypad on the wall.
prop holgercage obj.name=holgercage
prop holgercage survivor.name=Holger
prop holgercage survivor.id=lastpost_holger
prop holgercage survivor.key=cagekey
prop holgercage survivor.signal=holgerfree
prop holgercage survivor.line=The line's live? Then the post goes through. I'm Holger - linesman, telegraphist, cage-sitter. The Franking Works is the next stop; I'll show you the way.
note holgerkit Holger's kit | Holger's kit bag: his tools, his tin mug, and a stamp sheet from the Franking Works.
loot holgerkit Bolt*3;Rope*2;CopperIngot*1;ExplosiveGoo*3
prop holgerkit loot.refill=0
prop holgerkit if.open=signal|holgerfree
prop holgerkit else.open=message||Holger's kit bag - and Holger is still in the cage beside it.

prop firsthutzone zone.id=first_hut
prop firsthutzone zone.radius=3
prop firsthutzone zone.message=The first telegraph hut: a table, a code sheet, and the line running out of the window towards the stacks.
prop stack4zone zone.id=stack_4
prop stack4zone zone.radius=3
prop lasthutzone zone.id=last_hut
prop lasthutzone zone.radius=3
prop lasthutzone zone.message=The last hut - and outside it, someone in a cage.

story qt_top|Relay coil|Bolt|The repeater's relay coil, hung up the repeater mast on Wire Hill.
story qt_cave|Relay key|Bolt|The repeater's brass relay key, in a chest at the back of Seal Cave.
story qt_fixed|Line repeater working|Bolt|The line repeater, working again.
note qt_hint Repeater notice | LINE REPEATER DEAD - the signals stop at the strait. Relay coil on the repeater mast up Wire Hill, relay key in Seal Cave over the strait. Dagny at the old house on the far headland keeps the line book.
note qt_topchest Repeater mast deck box | A box lashed to the deck rail at the top of the repeater mast.
loot qt_topchest story:qt_top*1;Rope*2;Scrap*2
note qt_cavechest Seal Cave chest | A chest at the back of Seal Cave, dry under the rock.
loot qt_cavechest story:qt_cave*1;Nail*6;Plank*3
note qt_rewnote Repeater tape | The repeater clicks and its paper tape starts to run: dots and dashes from very far away. The first words through in years: IS ANYONE ON THE LINE. Somebody, somewhere, is still sending.
note qt_rewchest Line repeater reward | What the line repeater kept.
loot qt_rewchest MetalIngot*2;Bolt*3;Rope*2
note qt_lampchest Dagny's line book | Dagny's line book under a stone behind the house: every message that ever came through, and her tokens.
loot qt_lampchest TradeToken*2;CopperIngot*2;Rope*2
note qt_setchest Insulator crate | The linesmen's crate: all five insulators back, and their kit.
loot qt_setchest Glass*3;MetalIngot*2;Bolt*4
note qt_planecrate Line plane's crate | The linesmen's plane crate: wire, insulators and a toolkit.
loot qt_planecrate Plastic*3;Scrap*3;Nail*6
prop qt_planecrate loot.refill=0
note qt_pilot Line patrol log | LINE PATROL - TELEGRAPH NARROWS. Followed the wire across the strait. Wind off the headland, landed hard on the shore. Line is down at stack 4.
note jcqt Pole climb | Old telegraph poles stood on end and cut short, one higher than the next.
loot jcqt Rope*3;Plank*4;MetalIngot*1
note jbqt Top of the pole stack | Somebody's stash at the very top.
loot jbqt CopperIngot*1;Bolt*2;TradeToken*1

quest title=Down the Line
quest intro=A telegraph line across the strait. Make for the tall telegraph stacks, then climb to the first hut at the start of the line.
step reach|first_hut|1|Climb to the first telegraph hut
step read|Telegraph code sheet|1|Read the telegraph code sheet
step collect|story:linepower|1|Start the generator by the first hut
step reach|stack_4|1|Ride the line's zipline to stack 4
step collect|story:linewire|1|Join the line at stack 4's connector
step kill|Screecher|2|Drive the screechers off stack 6
step reach|last_hut|1|Ride the line down to the last hut
step open|Telegraph cabinet|1|Open the telegraph cabinet with the code from the sheet
step blueprint|Blueprint_WindTurbine|1|Take the wind turbine plans
step blueprint|Blueprint_BatteryAdvanced|1|Take the advanced battery plans
step blueprint|Blueprint_HeadLight_Advanced|1|Take the advanced headlight plans
step blueprint|Blueprint_ElectricGrill|1|Take the electric grill plans
step collect|story:cagekey|1|Take the cage key from the cabinet
step read|Repeater notice|1|Read the repeater notice by the line repeater
step talk|Dagny Ek|1|Talk to Dagny Ek at the ruined house on the far headland
step reach|qt_trail|1|Find the foot of the trail up Wire Hill, below the repeater mast
step reach|qt_summit|1|Climb the trail to the top of Wire Hill
step collect|story:qt_top|1|Climb the repeater mast and take the relay coil from its deck
step reach|qt_cave|1|Find Seal Cave in the rocks across the strait
step collect|story:qt_cave|1|Take the relay key from the chest at the back of the cave
step read|Repeater tape|1|Bring both to the line repeater and read what it shows
step open|Holger's kit|1|Free Holger from the cage, then open his kit bag
quest done=Holger is free and the line is live. Over the wire, faint: the Franking Works, still stamping.
quest reward=MetalIngot*3;CopperIngot*2;Bolt*4

# Puffer fish off the shore (explosive goo)
place Creature_PufferFish puffers at 0 80 h=-3
prop puffers creature.count=3

# (CIGroundIslands 10-26: a gen rock left floating over a slope)
clear at -39.4 -4.5 r=1.5 all only=CaravanIsland_SmallRock
save Telegraph Narrows
