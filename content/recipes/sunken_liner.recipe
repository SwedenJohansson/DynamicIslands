# The Sunken Liner - a themed island, twice the size (x2, mostly under water)
# Inspiration: great-liner disaster films (a luxury liner broken in two on the sea bed, its ballroom, a famous jewel in the
#   purser's safe, survivors in a lifeboat) - the mood only, never named on the island.
# Island type: Shape 2 (Archipelago), Style 1 (snowy). Icy rock islets - the "ice-rocks" she struck - round a deep
#   channel; on the channel's floor the liner in two halves with a debris field between them.
# The liner Regina Borealis struck the ice-rocks at full speed on her first crossing and broke in two. Lifeboat 7 reached
# the biggest islet; its survivors' log tells where the chief steward kept the purser's safe combination, and what is in
# the safe: the Polar Star sapphire and the key to the ship's pay chest. Something with lamps lives in the stern now.
# Quest "The Polar Star" (19 steps): lifeboat 7's camp, the log, the steward's key, the bow, the wireless message, the
# ballroom (air under its ceiling), the steward's cabinet, the anglers in the stern, the purser's office, the safe, the pay
# chest (head light blueprint, captain's hat, trade coins).
#
# Built by the recipe player (CIRecipe sunken_liner) through the editor's own operations.
# SILVER 10-26: the new land - Ice Crown with the liner's fallen foremast, Frost Cave, Nils Ekholm at the ruined house (a lamp puzzle), a boat wreck, a jump course, a set of five deck chairs
include lib_rt
include lib_sea
include lib_areas
include lib_highwater
include lib_features
include lib_silver
new
# (nature: snowy, Like Raft's Temperance - near-bare icy islets, a few pines on the biggest)
gen Trees=0.08 Bushes=0.15 Rocks=0.25 Harvest=0.05 BeachThings=0.3
gen Seed=9011 Radius=63 Height=9 Roughness=0.5 Peaks=1 Shape=2 Style=1 BeachWidth=0.2 Cliffs=0.55 PeakShape=0.35
gen SeaFloor=0 Shelf=0.5 Seabed=1
gen Water=0.5 SeaRocks=0.5 SeaFinds=0.5 Sunken=0.4 Hostiles=0
generate
# --- SILVER 10-26 terrain: the new land - pads raised from the sea (joined to the coast), Ice Crown ------------------------
brush flatten at -42 48 r=16 s=20 frames=500 h=3
brush smooth at -42 48 r=21 s=4 frames=40
brush flatten at -42 48 r=14 s=20 frames=500 h=3
brush flatten from -42 48 to -10.39 11.88 r=9 s=20 frames=500 h=3
brush flatten at -6 -72 r=17 s=20 frames=500 h=3
brush smooth at -6 -72 r=22 s=4 frames=40
brush flatten at -6 -72 r=15 s=20 frames=500 h=3
brush flatten from -6 -72 to -3.84 -46.09 r=9 s=20 frames=500 h=3
brush flatten at 48 52 r=12 s=20 frames=500 h=2.5
brush smooth at 48 52 r=17 s=4 frames=40
brush flatten at 48 52 r=10 s=20 frames=500 h=2.5
brush flatten from 48 52 to 12.73 13.79 r=9 s=20 frames=500 h=2.5
brush flatten at 70 -14 r=19 s=20 frames=500 h=3
brush smooth at 70 -14 r=24 s=4 frames=40
brush flatten at 70 -14 r=17 s=20 frames=500 h=3
brush flatten from 70 -14 to 48.43 -9.69 r=9 s=20 frames=500 h=3
brush flatten at -50 -50 r=12 s=20 frames=500 h=2.5
brush smooth at -50 -50 r=17 s=4 frames=40
brush flatten at -50 -50 r=10 s=20 frames=500 h=2.5
brush flatten from -50 -50 to -4.75 -4.75 r=9 s=20 frames=500 h=2.5
brush flatten at 48 -44 r=11 s=20 frames=500 h=2.5
brush smooth at 48 -44 r=16 s=4 frames=40
brush flatten at 48 -44 r=9 s=20 frames=500 h=2.5
brush flatten from 48 -44 to 5.98 -5.48 r=9 s=20 frames=500 h=2.5
brush flatten at 20 72 r=10 s=20 frames=500 h=2.5
brush smooth at 20 72 r=15 s=4 frames=40
brush flatten at 20 72 r=8 s=20 frames=500 h=2.5
brush flatten from 20 72 to 5.28 19.01 r=9 s=20 frames=500 h=2.5
call hw_mount x=-64 z=-8 b=22 h=20
call hw_trail x=-64 z=-8 b=22 h=20 a0=82.87 turn=300 n=40 h0=3
brush flatten from -41.18 -5.15 to -9.42 -1.18 r=7 s=20 frames=500 h=3

# --- Terrain: the wreck's trench dug north-south between the west and east islets and out past the south islet - a bed
# 16 m down for the bow and the ballroom, 24 m down for the stern; a pad on the west islet for lifeboat 7's camp ---------
brush flatten from 8 34 to 8 -20 r=7 s=20 frames=300 h=-16
brush flatten from 10 -30 to 12 -56 r=8 s=20 frames=300 h=-24
brush smooth from 8 30 to 11 -54 r=10 s=10 frames=10
# (wider where the ballroom and the purser's office lie: a 7 m stroke flattens only its middle, and their side walls
# stood in the trench's banks)
brush flatten from 1 -6.5 to 15 -6.5 r=6.5 s=20 frames=200 h=-16
brush flatten from 1 -29 to 13 -29 r=5.5 s=20 frames=200 h=-24
brush flatten from 3 -17 to 14 -17 r=5 s=20 frames=150 h=-16
brush flatten at -14 10 r=6 s=20 frames=80 h=6.5
# (a ramp up to the camp from the low path in the north-east: the camp's pad stood 3 m over it)
brush flatten at -8.5 17.3 r=1.8 s=20 frames=150 h=4.4
brush flatten at -9.3 16 r=1.8 s=20 frames=150 h=4.9
brush flatten at -10.1 14.8 r=1.8 s=20 frames=150 h=5.4
brush flatten at -10.9 13.6 r=1.8 s=20 frames=150 h=5.9
brush smooth from -8 18 to -11.5 12.8 r=3 s=4 frames=30
clear at -14 10 r=8
clear from 8 34 to 12 -56 r=12
clear at 26 20 r=3

# --- Lifeboat 7's camp on the west islet: the lifeboat drawn up, a tarp shelter on four posts, a dead fire, two of the
# liner's deck chairs, a lantern on a crate, the survivors' log, the camp chest; a cairn with a wooden marker; drifts ---
place RT_PlasticBoat - at -9 15.5 ground yaw=40 roll=6
place ReefHuts_Pillar1 - at -17.9 6.5 ground
place ReefHuts_Pillar1 - at -14.1 6.5 ground
place ReefHuts_Pillar1 - at -17.9 8.5 ground
place ReefHuts_Pillar1 - at -14.1 8.5 ground
place ReefHuts_Tarpaulin - at -16 7.5 h=9.45 tilt=4 rot=0,0,0
place campfire_1 - at -12.5 11.5 ground
place VG_LoungeChair - at -12 8.8 ground sit y=0.15 yaw=200
place VG_LoungeChair - at -14 13 ground yaw=150 roll=80
place Crate_Big_01 - at -16.8 7.2 ground
place Placeable_Lantern_Metal - at -16.8 7.2 h=9 drop
place Note_Book survivorslog at -16 7.4 h=9 drop yaw=15 rot=0,0,0
place Loot_Chest campchest at -15.2 8.4 ground yaw=90
place SmallBoulder4 - at -18 13.5 ground scale=0.5
place SmallBoulder4 - at -17.2 14.2 ground scale=0.45 yaw=80
place SmallBoulder4 - at -18.6 14.4 ground scale=0.4 yaw=160
place Placeable_Sign - at -17.9 14 h=9 drop
place TP_SnowDrift02 - at -20 11 ground yaw=40
place TP_SnowDrift02 - at -10 6 ground yaw=210
place Zone_Trigger lifeboat at -14 10 y=1

# --- The bow upright on its bed at the trench's north end (her deck about 5 m under the surface), the wireless set and
# the operator's last message on her deck --------------------------------------------------------------------------------
place BoatStranded - at 8 20 h=-16 sit scale=1.6 yaw=180 roll=6
place Placeable_Radio - at 8 17 h=-1 drop yaw=30
place Note_Paper wireless at 8.6 17.2 h=-1 drop rot=0,0,0
place Zone_Trigger bow at 8 18 h=-6

# --- The ballroom, torn off and lying on the bed south of the bow: two of the radio tower's rooms side by side under one
# ceiling, broken windows to swim in by; the carpet, the grand piano, the fallen chandelier, tables and chairs, the bar,
# the steward's cabinet; the air under its ceiling in the north-west corner ---------------------------------------------
push at 8 -6.5 h=-15.95
push at 0 0
call rt_storey f1=RT_WallWindowBroken f2=RT_WallWindowBroken b1=RT_WallWindowBroken b2=RT_Wall1 l1=RT_WallWindowBroken l2=RT_Wall1 l3=RT_WallWindowBroken r1=none r2=none r3=none
place RT_Floor - at 0 4.5 y=3
pop
push at 6 0
call rt_storey f1=RT_WallWindowBroken f2=RT_WallWindowBroken b1=RT_Wall1 b2=RT_WallWindowBroken l1=none l2=none l3=none r1=RT_WallWindowBroken r2=RT_Wall1 r3=RT_WallWindowBroken
place RT_Floor - at 0 4.5 y=3
pop
place Carpet_01 - at 0 0 y=0.02
place Tangaroa_BallroomKit_GrandPiano - at -3.5 2.6 y=0 sit yaw=20
place Tangaroa_BallroomKit_ChandelierOn - at 0.5 -0.5 y=0 sit roll=80
place VG_LoungeTable - at 3 -2 y=0 sit
place VG_LoungeTable - at -2 -2.5 y=0 sit
place VG_LoungeTable - at 3.5 2 y=0 sit roll=85
place VG_LoungeChair - at 2.2 -2.6 y=0 sit yaw=60
place VG_LoungeChair - at -1 -3.2 y=0 sit roll=88
place VG_LoungeChair - at 4.3 -1.2 y=0 sit yaw=-40
place VG_LoungeBar2 - at 4 3.6 y=0 sit yaw=180
place Cabinet_01 stewardcab at -5.4 -1 y=0 sit yaw=90
place Zone_Trigger ballroom at 0 -5.5 y=1
place Zone_Trigger ballroomair at -4.5 3 y=2.4
place Zone_Atmosphere ballroombubbles at -4.5 3 y=2.4
pop

# --- The debris field between the halves: trunks, deck chairs, barrels, a clock and a mirror lying in the sand, the
# ship's stores, a coal barrel, coal and scrap to gather, the ship's lamps still glowing ----------------------------------
place VP_MovingBox01 trunk1 at 5 -14.5 h=-16 sit yaw=30
place VP_MovingBox02 - at 12.5 -16 ground yaw=-20 roll=80
place VP_MovingBox03 trunk2 at 9 -19 ground yaw=70
place VP_MovingBox04 - at 6.4 -20.5 ground yaw=10
place VG_LoungeChair - at 13.2 -13 h=-16 sit roll=90 yaw=20
place Reef_Barrel1 - at 4 -18 ground roll=90
place Reef_Barrel3 - at 14 -20.5 ground roll=88 yaw=40
place Placeable_Clock_Basic - at 7.5 -17 ground roll=88 yaw=110
place "VG_DecorationPrefabBase_Mirror Variant" - at 10.8 -13.8 h=-16 sit rot=90,0,0
place "Box Big" stores at 11 -22.5 ground yaw=25
place Loot_SunkenBarrel coalbarrel at 5.5 -23 ground
place "Pickup_Landmark_Scrap 2_OceanBottom" - at 8 -15.5 ground
place "Pickup_Landmark_Scrap 3_OceanBottom" - at 12 -18.5 ground
place "Pickup_Landmark_Rock 1" - at 6 -17 ground
place "Pickup_Landmark_Rock 2" - at 10 -21 ground
place UT_LightBottle01 - at 8 -14 h=-16 sit
place UT_LightBottle02 - at 10.5 -19.5 ground
place UT_LightBottle03 - at 7 -22 ground

# --- The stern on its bed at the trench's deep south end, rolled on its side; the deep's two lamps waiting in it; the
# purser's office fallen beside it (one of the radio tower's rooms, broken windows): his desk, file boxes, the safe, the
# ship's pay chest ----------------------------------------------------------------------------------------------------
place BoatStranded - at 13 -46 y=-1 sit scale=1.5 yaw=10 roll=8
place Creature_AnglerFish deeplamps at 13 -44 h=-18
place Zone_Trigger stern at 12 -40 h=-18
push at 7 -32 h=-23.95 yaw=90
call rt_storey f1=RT_WallWindowBroken f2=RT_WallWindowBroken b1=RT_Wall1 b2=RT_WallWindowBroken l2=RT_WallWindowBroken r2=RT_WallWindowBroken
place RT_Floor - at 0 4.5 y=3
place "VG_DecorationPrefabBase_Desk Variant" - at -3 2.5 y=0 sit yaw=180
place TP_FileBox01 - at -5.3 3.8 y=0 sit
place TP_FileBox01 - at -4.6 3.9 y=0 sit roll=80
place VG_Safe pursersafe at -1 3.8 y=0 sit yaw=180
place MayorsChest paychest at -4.6 -3.4 y=0 sit
place Zone_Trigger purser at -3 0 y=1
pop

# --- The box in a cleft of the east islet; cold dim water round the wreck, the hulls' creaking, the wind on the islets;
# animals: goats on the east islet, dolphins off the north ----------------------------------------------------------------
place "Box Small" isletbox at 26 20 ground yaw=15
place Zone_Atmosphere wreckdark at 8 10 h=-10
place Zone_Atmosphere wreckdark at 11 -28 h=-14
place Zone_Sound creaks at 9 -8 h=-12
place Zone_Sound wind at -10 8 y=4
place Creature_Goat goats at 26 6 ground
prop goats creature.count=2
place Creature_Dolphin dolphins at 0 60 h=-3
prop dolphins creature.count=2

# --- Things to gather, as suits the island (the user, 2026-10-05): pines, berries, flowers ----------
scatter "Pickup_Landmark_Tree_Pine" 6 at 0 0 r=44.1 seed=4490 free=5
scatter "Pickup_Landmark_BerryBush" 6 at 0 0 r=44.1 seed=4500 free=3
scatter "Pickup_Landmark_Flower_White" 4 at 0 0 r=44.1 seed=4510 free=3
scatter "Pickup_Landmark_Flower_Blue" 4 at 0 0 r=44.1 seed=4511 free=3

# --- Raft's finds in the shallows round the islets (lib_sea) ------------------------------------------------------------
call shallows r=55 deep=5 n=2

# --- SILVER 10-26 (the user: one hour per island - hills, cliffs, a cave, a house, a wreck, secrets): Ice Crown ------
# Ice Crown with the liner's fallen foremast on it, Frost Cave, the ruined house where Nils Ekholm waits (four lamps round it: a puzzle), a boat wreck,
# a jump course, five deck chairs about the island (a set), and at the house the signal lamp that wants the lookout's spyglass and the lamp carbons
call hw_zone x=-41.18 z=-5.15 al=sl_trailz id=sl_trail r=5 msg="The trail up Ice Crown starts here - round and up."
call hw_zone x=-64 z=-8 al=sl_summitz id=sl_summit r=8 h=1 msg="The top of Ice Crown. The whole island below you."
place Creature_Goat sl_goats at -37.18 -2.15 ground
prop sl_goats creature.count=2
call hw_mast x=-67 z=-6 h0=20 lv=6 a=sl_mast chest=sl_topchest top=Placeable_Lantern_Metal
call ar_cave x=-6 z=-76 h=3 yaw=0 al=sl_caverock chest=sl_cavechest
call hw_zone x=-7 z=-67 al=sl_cavez id=sl_cave r=4 h=1 msg="Frost Cave. Water drips somewhere in the dark."
call ar_ruin x=-42 z=48 h=3 yaw=0 w=3 d=2 al=sl_ruin
call ss_islander x=-43 z=43.5 yaw=200 al=sl_isl nm="Nils Ekholm" pose=lean
prop sl_isl talk.text=You see that rock out there? I saw it first. From the crow's nest. I rang the bell three times.\n---\nThe foremast came down on the next islet when she broke. My spyglass is still up there, on Ice Crown.\n---\nThe signal lamp wants its carbons too - one of us carried the tin into Frost Cave to keep it dry. Bring both and we can show a light to the next ship.\n---\nThe deck lamps round my hut: each one you turn wakes the next. Light all four and look behind the hut.
call ss_lamp x=-49 z=47 al=sl_lamp1 nm="Deck lamp 1" grp="Deck lamps" on=1
call ss_lamp x=-43 z=54 al=sl_lamp2 nm="Deck lamp 2" grp="Deck lamps" on=0
call ss_lamp x=-36 z=47 al=sl_lamp3 nm="Deck lamp 3" grp="Deck lamps" on=0
call ss_lamp x=-43 z=40 al=sl_lamp4 nm="Deck lamp 4" grp="Deck lamps" on=1
prop sl_lamp1 on.use=light|Deck lamp 2|toggle
prop sl_lamp2 on.use=light|Deck lamp 3|toggle
prop sl_lamp3 on.use=light|Deck lamp 4|toggle
prop sl_lamp4 on.use=light|Deck lamp 1|toggle
prop sl_lamp1 on.alllit=show|sl_lampchest\nmessage||All four lamps burn. Behind the back wall a stone has been lifted.
call ss_hidden x=-41 z=52.6 al=sl_lampchest
place Creature_Chicken sl_hens at -34 54 ground
prop sl_hens creature.count=3
call hw_wreck x=48 z=52 h=2.5 yaw=30 obj=BoatStranded al=sl_plane crate=sl_planecrate r=9
place Note_Paper sl_pilot at 45.54 55.73 ground y=0.1 drop yaw=60
call hw_zone x=48 z=52 al=sl_planez id=sl_plane r=6 h=1 msg="A boat, high and dry on the shore. Nobody came for it."
# JUMP sl pad=3 at=70 -14
push at 70 -14
clear at 0 0 r=17 all
brush flatten at 0 0 r=14 s=20 frames=300 h=3
brush smooth at 0 0 r=18 s=4 frames=40
brush flatten at 0 0 r=12 s=20 frames=300 h=3
brush auto at 0 0 r=18 s=10 frames=25
clear at 0 0 r=18
place Block_Foundation_Tier3 jpsl at 6 0 h=3.6
place Block_Foundation_Tier3 jpsl at 5.25 -2.91 h=4.35
place Block_Foundation_Tier3 jpsl at 3.18 -5.09 h=5.1
place Block_Foundation_Tier3 jpsl at 0.31 -5.99 h=5.85
place Block_Foundation_Tier3 jpsl at -2.63 -5.39 h=6.6
place Block_Foundation_Tier3 jpsl at -4.91 -3.44 h=7.35
place Block_Foundation_Tier3 jpsl at -5.97 -0.63 h=8.1
place Block_Foundation_Tier3 jpsl at -5.52 2.34 h=8.85
place Block_Foundation_Tier3 jpsl at -3.69 4.73 h=9.6
# JUMP from 10
place Block_Foundation_Tier3 jpsl at -0.94 5.93 h=10.35
place Block_Foundation_Tier3 jpsl at 2.05 5.64 h=11.1 sx=2 sz=2
# JUMP end
place Block_Foundation_Tier3 jppsl at 5.25 -2.91 h=3.668 sy=1.861
place Block_Foundation_Tier3 jppsl at 3.18 -5.09 h=4.418 sy=2.959
place Block_Foundation_Tier3 jppsl at 0.31 -5.99 h=5.168 sy=4.058
place Block_Foundation_Tier3 jppsl at -2.63 -5.39 h=5.918 sy=5.157
place Block_Foundation_Tier3 jppsl at -4.91 -3.44 h=6.668 sy=6.255
place Block_Foundation_Tier3 jppsl at -5.97 -0.63 h=7.418 sy=7.354
place Block_Foundation_Tier3 jppsl at -5.52 2.34 h=8.168 sy=8.453
place Block_Foundation_Tier3 jppsl at -3.69 4.73 h=8.918 sy=9.552
place Block_Foundation_Tier3 jppsl at -0.94 5.93 h=9.668 sy=10.650
place Block_Foundation_Tier3 jppsl at 2.05 5.64 h=10.418 sy=11.749 sx=2 sz=2
prop jpsl tint.color=#8a7f70
prop jpsl tint.amount=0.35
prop jppsl tint.color=#8a7f70
prop jppsl tint.amount=0.35
place Loot_Chest jcsl at -4.91 -3.44 h=7.35 sit yaw=0
prop jcsl loot.refill=0
place Loot_ChestSmall jbsl at 2.05 5.64 h=11.1 sit yaw=0
prop jbsl loot.refill=0
pop
call hw_zone x=70 z=-22 al=sl_jumpz id=sl_jumps r=6 h=1 msg="Stacks, one higher than the next. Something at the top."
call hw_machine x=-33 z=39 yaw=-45 al=sl_machine nm="Signal lamp" obj=TP_LaserControlPanel_lever sc=3 a=sl_top b=sl_cave done=sl_fixed rew=sl_rewchest rnote=sl_rewnote msg="It works." hint="It wants the lookout's spyglass from Ice Crown and the lamp carbons from Frost Cave."
call hw_note x=-35.6 z=40.2 yaw=-25 al=sl_hint
call ss_piece x=50 z=-10 al=sl_piece1 set="Deck chairs"
call ss_piece x=-7 z=-40 al=sl_piece2 set="Deck chairs"
call ss_piece x=35 z=17 al=sl_piece3 set="Deck chairs"
call ss_piece x=50 z=14 al=sl_piece4 set="Deck chairs"
call ss_piece x=38 z=-19 al=sl_piece5 set="Deck chairs"
prop sl_piece1 on.set=show|sl_setchest\nmessage||All five deck chairs found.
call ss_hidden x=-37 z=36 al=sl_setchest kind=Loot_Chest
call treasure x=2 z=-49 r=5 n=1 seed=26479 kind=0
prop treasure26479 treasure.loot=CopperOre*2;MetalOre*2;TradeToken*1
call ar_plants_snowy x=-42 z=48 r=20 seed=26492
call ar_plants_snowy x=-6 z=-72 r=21 seed=26493
call ar_plants_snowy x=48 z=52 r=16 seed=26494
