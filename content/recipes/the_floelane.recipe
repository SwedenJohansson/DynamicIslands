brush flatten at 20 -4 r=6 s=20 frames=200 h=0.5
brush flatten at 0 6 r=8 s=20 frames=200 h=0.5
brush flatten at 0 30 r=8 s=20 frames=200 h=0.5
brush flatten from 0 -16 to 0 -2 r=2.2 s=20 frames=120 h=-0.6
brush flatten at 38.3 7.4 r=5 s=8 frames=40
origin
clear at 38.3 7.4 r=6
clear at 0 -24 r=8
clear at -20 -6 r=6
clear at 20 -4 r=6
clear at 0 6 r=8
clear at 0 30 r=8
clear from -12 18 to 12 18 r=5
