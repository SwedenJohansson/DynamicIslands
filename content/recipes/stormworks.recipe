call ar_cave x=-56 z=12 h=3 yaw=0 al=orecave chest=orecavechest
call tzone x=-56 z=17 al=orecavezone id=orecave r=4 msg="An ore cave in the west hills. The walls are scored where the works' drills bit in - and stopped."
call ar_ruin x=8 z=-64 h=3 yaw=0 al=smelthouse
call notebox x=10.5 z=-68.5 yaw=20 al=smeltroll
call ar_plane x=56 z=-36 h=3 yaw=300 al=oreplane crate=orecrate
call notebox x=59.5 z=-41.5 yaw=150 al=oreplanelog
# vine cache placed by hand (scatter found no spot in run25): the chest behind Raft's choppable vines, machete
