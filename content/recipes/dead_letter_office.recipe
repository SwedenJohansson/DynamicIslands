# The Dead Letter Office - an island of the library's plan The Last Post (the Coastal Post's route, the first island)
# A low granite skerry with the Coastal Post's dead letter office on it: a brick-red hall (Raft's Tier 3 walls tinted)
# under a hipped roof on its corner pillars, its clock above the door stopped at nine; inside, a sorting counter of
# office tables, pigeon-holes of small cupboards and shelves along the back wall, canvas mail sacks (Raft's reef
# container, shrunk and tinted) on the floor; a plank jetty on posts to the south. Quest "Return to Sender" (15 steps):
# the jetty, the letter addressed to the player's raft (its reading opens the next stop: done-when note), the counter
# drawer (the Receiver's and the antenna's blueprints), the five dead letters in the pigeon-holes, the route card.
#
# Built by the recipe player (CIRecipe dead_letter_office) through the editor's own operations.
include lib_sea
include lib_features
include lib_post
include lib_areas
include lib_highwater
include lib_lastpost
# RESIZE 10-26 (the user: Raft-big, one-hour islands): Radius 40 -> 82; the old island moved 42 m south (push frames), so its south shore stays on the coast and the new land is north
# POST 10-26: the new land - Gull Knoll with old signal mast, Sack Cave, Sven Holm at the ruined house (a lamp puzzle), a crashed plane, a jump course, a maze, a set of five lost postcards
new
# (nature: a rocky skerry, Like Raft's small islands, few trees)
gen Trees=0.1 Bushes=0.22 Rocks=0.45 Harvest=0.18 BeachThings=0.25
gen Seed=4101 Radius=82 Height=9 Roughness=0.6 Peaks=1 Shape=0 Style=0 PeakShape=0.3 Cliffs=0.5 BeachWidth=0.3
gen Water=0.5 SeaRocks=0.5 SeaFinds=0.15 Sunken=0.2 Hostiles=0 Friendly=0 SeaLife=0.3
generate
# --- 10-26 relief (no flat plains): hills and ridges first, so the old island's pads cut into them after ---
call hw_mount x=-34 z=-56 b=12 h=10
call ar_ridge x1=18 z1=-30 x2=22 z2=-48 h=5 top=4 r=6
call ar_ridge x1=-40 z1=-4 x2=-62 z2=-12 h=5 top=4 r=7
push at 0 -42

# --- Terrain: a level pad for the office (2.2 m), a strip down to the jetty's foot (1.4 m) on the south shore ----------
brush flatten at 0 -12 r=10 s=20 frames=120 h=2.2
brush flatten from 0 -22 to 0 -30 r=4 s=20 frames=80 h=1.4
brush smooth from 0 -18 to 0 -30 r=6 s=6 frames=20
brush rock at 0 -12 r=12 s=6 frames=20
pop
origin
# --- POST 10-26 terrain: Gull Knoll, the pads of the new areas ---------------------------------------------------
call hw_mount x=-36 z=38 b=22 h=18
call hw_trail x=-36 z=38 b=22 h=18 a0=127.87 turn=300 n=40 h0=3
brush flatten at 0 10 r=4 s=8 frames=60
clear at 0 10 r=7
# (RESIZE 10-26: the old island, 42 m south)
push at 0 -42
clear at 0 -12 r=11
clear from 0 -20 to 0 -34 r=4

# --- The office: 4 x 3 cells, door to the south, brick-red walls, its clock above the door --------------------------
push at -3 -15 h=2.2
call posthall w=4 d=3 al=brick
place VP_DecorationPrefabBase_Clock officeclock at 2.25 -0.06 y=2.15 yaw=0
# the sorting counter: two office tables end to end across the room, the letter for the raft on the one by the door
place "Table Office" counter at 1.7 1.9 y=1.3 sit drop yaw=0
place "Table Office" - at 4.3 1.9 y=1.3 sit drop yaw=0
place Note_Paper rafletter at 1.3 1.9 y=2 sit drop yaw=10
place Loot_ChestSmall drawer at 4.6 1.9 y=2 sit drop yaw=180
place "Chair Office" - at 2.4 2.9 y=1.3 sit drop yaw=180
# the pigeon-holes: small cupboards and shelves stacked along the back wall, the dead letters on their tops
place Placeable_Cupboard_Small - at 0.7 4.15 y=1.3 sit drop yaw=180
place Placeable_Cupboard_Small - at 1.6 4.15 y=1.3 sit drop yaw=180
place Placeable_Cupboard_Small - at 2.5 4.15 y=1.3 sit drop yaw=180
place Placeable_Shelf_Small_Basic - at 3.75 4.15 y=1.3 sit drop yaw=180
place Placeable_Shelf_Small_Basic - at 5.15 4.15 y=1.3 sit drop yaw=180
place Placeable_Shelf_Small_Fine - at 3.75 4.15 y=0.78 yaw=180
place Note_Paper dlferry at 0.7 4.15 y=2 sit drop yaw=5
place Note_Paper dleskil at 1.6 4.15 y=2 sit drop yaw=-8
place Note_Paper dltelegraph at 2.5 4.15 y=2 sit drop yaw=12
place Note_Paper dllise at 5.15 4.15 y=2 sit drop yaw=-4
place Note_Paper dlada at 3.75 4.15 y=2.4 sit drop yaw=3
# the route card pinned up by the door
place Note_Paper routecard at 5.6 0.6 y=2 sit drop yaw=90
place Placeable_Cupboard_Medium - at 5.6 0.6 y=1.3 sit drop yaw=270
# mail sacks on the floor
call mailsack x=0.8 z=0.8 yaw=80 al=sacks
call mailsack x=0.6 z=2.9 yaw=10 al=sacks
pop

# --- Outside: more sacks by the door, a lantern, the postbox stand --------------------------------------------------
call mailsack x=-4.5 z=-16.5 yaw=30 al=sacks
call mailsack x=-5.2 z=-14.6 yaw=95 al=sacks
place "Box Big" - at 3.5 -17.5 ground yaw=20
place "Box Small" - at 4.4 -16.6 ground yaw=-15
place Placeable_Lantern_Metal - at 3.5 -17.5 h=6 sit drop

# --- The jetty: two plates wide from the shore strip out to sea, a bollard of the radio tower's pillar cap ---------------
call pier x=0 z1=-30 z2=-52 h=1.45
place Zone_Trigger jettyzone at 0 -47 h=2.2
place Placeable_Lantern_Metal - at 1.2 -51 h=1.6 sit drop

# --- Friendly animals and things to gather -------------------------------------------------------------------------
place Creature_Dolphin dolphins at 30 -60 h=-3
prop dolphins creature.count=2
scatter "Pickup_Landmark_Flower_Blue" 2 at 0 10 r=20 seed=4111 free=3
call dirt x=8 z=8 r=8 n=2 seed=4112
call shallows r=56 deep=5 n=2

pop

# --- POST 10-26 (the user: one hour per island - hills, cliffs, a cave, a house, a wreck, secrets): Gull Knoll ------
# Gull Knoll with old signal mast on it, Sack Cave, the ruined house where Sven Holm waits (four lamps round it: a puzzle), a crashed plane,
# a jump course, a maze, five lost postcards about the island (a set), and at the hub the night lamp that wants the night lamp lens and the lamp wick spool
call hw_zone x=-17.84 z=23.88 al=qd_trailz id=qd_trail r=5 msg="The trail up Gull Knoll starts here - round and up."
call hw_zone x=-36 z=38 al=qd_summitz id=qd_summit r=8 h=1 msg="The top of Gull Knoll. The whole island below you."
call hw_mast x=-39 z=40 h0=18 lv=5 a=qd_mast chest=qd_topchest top=Placeable_Lantern_Metal
place ZiplinePath_Landmark qd_zip at -32.8 35.4 h=19.35
zipto qd_zip -1.74 13.68
place Creature_Goat qd_goats at -13.84 26.88 ground
prop qd_goats creature.count=2
call ar_cave x=46 z=44 h=3 yaw=180 al=qd_caverock chest=qd_cavechest
call hw_zone x=47 z=35 al=qd_cavez id=qd_cave r=4 h=1 msg="Sack Cave. Water drips somewhere in the dark."
call ar_ruin x=56 z=-20 h=3 yaw=0 w=3 d=2 al=qd_ruin
call lp_islander x=55 z=-24.5 yaw=200 al=qd_isl nm="Sven Holm" pose=lean
prop qd_isl talk.text=A raft? Then the letters are moving again. I carried them on this skerry for thirty years.\n---\nWhen the Post shut they left the dead letters in the office - nobody to send them to, nobody to send them back. I stayed with them.\n---\nThe night lamp wants its lens back from the mast on Gull Knoll and the wick I hid in Sack Cave. Light it. A post boat should always find its way in.\n---\nAnd my lamps round the house: four, and each one you turn wakes its neighbour. All four lit, and look behind the back wall.
call lp_lamp x=49 z=-21 al=qd_lamp1 nm="Carrier's lamp 1" grp="Carrier's lamps" on=0
call lp_lamp x=55 z=-14 al=qd_lamp2 nm="Carrier's lamp 2" grp="Carrier's lamps" on=1
call lp_lamp x=62 z=-21 al=qd_lamp3 nm="Carrier's lamp 3" grp="Carrier's lamps" on=0
call lp_lamp x=55 z=-28 al=qd_lamp4 nm="Carrier's lamp 4" grp="Carrier's lamps" on=1
prop qd_lamp1 on.use=light|Carrier's lamp 2|toggle
prop qd_lamp2 on.use=light|Carrier's lamp 3|toggle
prop qd_lamp3 on.use=light|Carrier's lamp 4|toggle
prop qd_lamp4 on.use=light|Carrier's lamp 1|toggle
prop qd_lamp1 on.alllit=show|qd_lampchest\nmessage||All four lamps burn. Behind the back wall a stone has been lifted.
call lp_hidden x=57 z=-15.4 al=qd_lampchest
place Creature_Chicken qd_hens at 64 -14 ground
prop qd_hens creature.count=3
call ar_plane x=-56 z=-28 h=3 yaw=40 al=qd_plane crate=qd_planecrate
place Note_Paper qd_pilot at -57.78 -23.9 ground y=0.1 drop yaw=70
call hw_zone x=-56 z=-28 al=qd_planez id=qd_plane r=6 h=1 msg="A plane, nose down in the grass. Nobody came for it."
# JUMP qd pad=3 at=8 62
push at 8 62
clear at 0 0 r=17 all
brush flatten at 0 0 r=14 s=20 frames=300 h=3
brush smooth at 0 0 r=18 s=4 frames=40
brush flatten at 0 0 r=12 s=20 frames=300 h=3
brush auto at 0 0 r=18 s=10 frames=25
clear at 0 0 r=18
