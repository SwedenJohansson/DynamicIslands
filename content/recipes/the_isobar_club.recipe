# The Isobar Club - an island of the library's plan The Rainmakers (Nimbus Works' eighth station)
# The company's members' club on a granite shelf: a lower terrace by the sea with tidal pools in the rock and the wine
# cellar (a vault, its roof on pillars, against the cliff), Varuna Point's scissor lift as the club's funicular up the
# rise, and on the upper shelf the clubhouse - Tangaroa's apartment facade panels made into one low pavilion with a flat
# roof and a colonnade - pianos, a billiard table, the secretary's safe behind a keypad. Quest "Members Only" (18 steps):
# the terrace, the members' book, the funicular, the board minutes (the safe's code), the safe, the secretary's cabinet
# (the last blueprints), and the cage in the wine cellar - Dagny Holm herself.
#
# Built by the recipe player (CIRecipe the_isobar_club) through the editor's own operations.
include lib_sea
include lib_features
include lib_huts
include lib_areas
include lib_highwater
include lib_rain
# RESIZE 10-26 (the user: Raft-big, one-hour islands): Radius 50 -> 85; the old island moved 35 m south (push frames), so its south shore stays on the coast and the new land is north
# RAIN 10-26: the new land - Barometer Hill with club's weather mast, Smugglers' Cave, Lord Arvid Hale at the ruined house (a lamp puzzle), a crashed plane, a jump course, a maze, a set of five club medals
new
# (nature: grey granite, tropical shrubs, few trees; Harvest 0.2)
gen Trees=0.15 Bushes=0.3 Rocks=0.45 Harvest=0.2 BeachThings=0.3
gen Seed=9951 Radius=85 Height=12 Roughness=0.3 Peaks=1 Shape=0 Style=3 PeakShape=0.2 Cliffs=0.6 BeachWidth=0.4
gen Water=0.5 SeaRocks=0.5 SeaFinds=0.4 Sunken=0.3 Hostiles=0 Friendly=0.2 SeaLife=0.3
generate
push at 0 -35

# --- Terrain: the upper shelf at 6.2 m (the club), the lower terrace at 1.5 m by the sea, the landing; the tidal pools
# dug into the lower terrace ----------------------------------------------------------------------------------------
brush flatten at 0 -2 r=24 s=20 frames=220 h=6.14
brush flatten at 0 -25 r=3 s=20 frames=40 h=6.14
for ix -20 14 4
brush flatten at $ix -32 r=6 s=20 frames=50 h=1.44
next
brush flatten at -17 -28.5 r=3.5 s=20 frames=40 h=1.44
brush flatten at 0 -42 r=5 s=20 frames=50 h=0.8
brush flatten at 8 -35 r=2.5 s=20 frames=40 h=-0.7
brush flatten at 13 -31 r=2 s=20 frames=40 h=-0.5
pop
origin
# --- RAIN 10-26 terrain: Barometer Hill, the pads of the new areas ---------------------------------------------------
call hw_mount x=-38 z=46 b=24 h=22
call hw_trail x=-38 z=46 b=24 h=22 a0=126.38 turn=300 n=40 h0=3
brush flatten at 0 18 r=4 s=8 frames=60
clear at 0 18 r=7
# (RESIZE 10-26: the old island, 35 m south)
push at 0 -35
clear at 0 -2 r=25
clear from -20 -32 to 16 -32 r=7
clear at 0 -42 r=5

# --- The lower terrace: the landing, the members' book on its stand, rocks round the tidal pools ---------------------
place Zone_Trigger terracezone at 0 -33 h=2.5
place "Box Big" - at -4.5 -30 ground sit yaw=10
place Note_Paper membersbook at -4.5 -30 ground y=1.5 sit drop yaw=30
place SmallRock_02 poolrims at 10.6 -35 ground scale=0.45 yaw=40
place SmallRock_02 poolrims at 6 -37.2 ground scale=0.4 yaw=120
place SmallRock_02 poolrims at 15 -32.5 ground scale=0.4 yaw=200
place SmallRock_02 poolrims at 11.2 -29.3 ground scale=0.35 yaw=300
prop poolrims tint.color=#8d8a86

# --- The club's funicular: Varuna Point's scissor lift at the foot of the rise, the porter's chest at its top ---------
call lift x=0 z=-28.3 yaw=0 alias=clublift upalias=clubliftup chest=porterchest tx=3.5 tz=-23 items=Rope*2;Glass*2;Bolt*2 title="Club porter's chest"
place Zone_Trigger clubzone at 0 -24.5 h=7.2

# --- The wine cellar: a vault against the cliff west of the lift, its roof on pillars, the cage inside ---------------
push at -20 -35 h=1.5
for fx 0.75 5.25 1.5
for fz 0.75 6.75 1.5
place Block_Floor_Tier3 - at $fx $fz y=0.02
next
next
for wz 0.75 6.75 1.5
place Block_Wall_Tier3 - at 0 $wz y=0.17 yaw=90
next
for wx 0.75 5.25 1.5
place Block_Wall_Tier3 - at $wx 0 y=0.17
place Block_Wall_Tier3 - at $wx 7.5 y=0.17
next
place Block_Pillar_Tier3 - at 0 0 y=0.17
place Block_Pillar_Tier3 - at 6 0 y=0.17
place Block_Pillar_Tier3 - at 0 7.5 y=0.17
place Block_Pillar_Tier3 - at 6 7.5 y=0.17
place Block_Pillar_Tier3 - at 6 3 y=0.17
place Block_Pillar_Tier3 - at 6 4.5 y=0.17
roof 4 5 at 0 0 y=0.17
place Survivor_Cage dagnycage at 3 3.75 y=0.2 sit yaw=0 scale=0.94
place Loot_Chest dagnycase at 5.2 0.8 y=0.2 sit yaw=270
place TP_Moontown_Barrel01 cellarcasks at 0.6 6.9 y=0.2 sit
place TP_Moontown_Barrel03 cellarcasks at 1.4 6.9 y=0.2 sit
place TP_Moontown_Barrel01 cellarcasks at 0.6 0.6 y=0.2 sit
place Placeable_Lantern_Metal - at 5.4 6.9 y=0.2 sit
pop
place Zone_Trigger cellarzone at -15 -31 h=2.5

# --- The clubhouse on the upper shelf: apartment facade panels as one low pavilion (a gap for its door), a flat roof
# of floor plates, the colonnade in front on pillars; inside pianos, the billiard table, the safe and its keypad, the
# secretary's cabinet ------------------------------------------------------------------------------------------------
push at -7.5 -10 h=6.2
for fx 0.75 14.25 1.5
for fz 0.75 8.25 1.5
place Block_Floor_Tier3 - at $fx $fz y=0.02
next
next
for px 3 15 3
place Apartment_Ext_BaseMidMidWall clubwalls at $px 6 y=0.02 yaw=0
next
for pz 3 9 3
place Apartment_Ext_BaseMidMidWall clubwalls at 3 $pz y=0.02 yaw=270
next
for pz 0 6 3
place Apartment_Ext_BaseMidMidWall clubwalls at 12 $pz y=0.02 yaw=90
next
place Apartment_Ext_BaseMidMidWall clubwalls at 0 3 y=0.02 yaw=180
place Apartment_Ext_BaseMidMidWall clubwalls at 3 3 y=0.02 yaw=180
place Apartment_Ext_BaseMidMidWall clubwalls at 9 3 y=0.02 yaw=180
place Apartment_Ext_BaseMidMidWall clubwalls at 12 3 y=0.02 yaw=180
# (the panels are drawn from outside only: from inside the hall they were see-through, only their frame strips showed -
# so each has a twin turned round in the same place, its face to the room)
for px 3 15 3
place Apartment_Ext_BaseMidMidWall clubwalls at {$px-3} 12.15 y=0.02 yaw=180
next
for pz 3 9 3
place Apartment_Ext_BaseMidMidWall clubwalls at -3.15 {$pz-3} y=0.02 yaw=90
next
for pz 0 6 3
place Apartment_Ext_BaseMidMidWall clubwalls at 18.15 {$pz+3} y=0.02 yaw=270
next
place Apartment_Ext_BaseMidMidWall clubwalls at 3 -3.15 y=0.02 yaw=0
place Apartment_Ext_BaseMidMidWall clubwalls at 6 -3.15 y=0.02 yaw=0
place Apartment_Ext_BaseMidMidWall clubwalls at 12 -3.15 y=0.02 yaw=0
place Apartment_Ext_BaseMidMidWall clubwalls at 15 -3.15 y=0.02 yaw=0
for fx 0.75 14.25 1.5
for fz -3.75 8.25 1.5
place Block_Floor_Tier3 clubroof at $fx $fz y=3.22
next
next
for cx 0 15 3
place Block_Pillar_Tier3 colonnade at $cx -4.5 y=0.02 sy=1.22
next
# (the hall's own columns under the flat roof, every 3 m between the furniture: each holds the four plates round it, so
# save stands no posts through the pianos and the pool table - the user 2026-10-18)
for cx 1.5 13.5 3
place Block_Pillar_Tier3 colonnade at $cx 1.5 y=0.02 sy=1.22
place Block_Pillar_Tier3 colonnade at $cx 7.5 y=0.02 sy=1.22
next
place Placeable_Piano - at 3.2 4.5 y=0.05 sit yaw=90
place Tangaroa_BallroomKit_GrandPiano - at 11.6 5 y=0.05 sit yaw=270
place "VG_DecorationPrefabBase_Pooltable Variant" - at 7.5 5 y=0.05 sit yaw=90
place Note_Paper boardminutes at 7.5 5 y=1.6 sit drop yaw=20
place "Box Small" - at 1.2 8.2 y=0.05 sit
place RT_PowerBox safekeypad at 1.2 8.2 y=1.4 sit drop yaw=180
place VG_Safe secsafe at 2.6 8.3 y=0.05 sit yaw=180
place Locker seccabinet at 14.2 8.3 y=0.05 sit yaw=180
place Placeable_Lantern_Metal - at 0.8 0.8 y=0.05 sit
place Placeable_Lantern_Metal - at 14.2 0.8 y=0.05 sit
pop
prop clubroof tint.color=#e6e1d6
prop colonnade tint.color=#e6e1d6

# --- A Raft store on the upper shelf, east of the clubhouse: the members' shop (Raft's goods, and plans the crew missed) --
store clubshop at 12 -4 ground

# --- Things to gather, reefs ----------------------------------------------------------------------------------------
scatter "Pickup_Landmark_PineappleLandmark" 2 at 15 10 r=12 seed=9961 free=3
scatter "Pickup_Landmark_Tree_Mango" 1 at -15 10 r=10 seed=9962 free=5
scatter "Pickup_Landmark_Flower_Blue" 2 at 0 15 r=12 seed=9963 free=3
call dirt x=-25 z=15 r=8 n=3 seed=9964
call shallows r=72 deep=5 n=2

pop

# --- RAIN 10-26 (the user: one hour per island - hills, cliffs, a cave, a house, a wreck, secrets): Barometer Hill ------
# Barometer Hill with club's weather mast on it, Smugglers' Cave, the ruined house where Lord Arvid Hale waits (four lamps round it: a puzzle), a crashed plane,
# a jump course, a maze, five club medals about the island (a set), and at the hub the club signal that wants the mast barometer and the members' seal
call hw_zone x=-17.87 z=31.17 al=ic_trailz id=ic_trail r=5 msg="The trail up Barometer Hill starts here - round and up."
call hw_zone x=-38 z=46 al=ic_summitz id=ic_summit r=8 h=1 msg="The top of Barometer Hill. The whole island below you."
call hw_mast x=-41 z=48 h0=22 lv=6 a=ic_mast chest=ic_topchest top=Placeable_Flag_01
place ZiplinePath_Landmark ic_zip at -34.8 43.4 h=23.35
zipto ic_zip -1.83 21.56
place Creature_Goat ic_goats at -13.87 34.17 ground
prop ic_goats creature.count=2
call ar_cave x=46 z=50 h=3 yaw=180 al=ic_caverock chest=ic_cavechest
call hw_zone x=47 z=41 al=ic_cavez id=ic_cave r=4 h=1 msg="Smugglers' Cave. Water drips somewhere in the dark."
call ar_ruin x=58 z=-14 h=3 yaw=0 w=3 d=2 al=ic_ruin
call rn_islander x=57 z=-18.5 yaw=200 al=ic_isl nm="Lord Arvid Hale" pose=stand
prop ic_isl talk.text=A visitor! The club's been rather empty since the storms.\n---\nWe paid Nimbus Works to make it rain on our rivals' fields. Quite the sport. I've had eleven years to feel badly about it.\n---\nThe signal wants the barometer from the mast on the hill and our seal from the Smugglers' Cave - I hid it so nobody could call the members back. Call them, then. Let them see.\n---\nAnd the folly's lamps: four, each wakes its neighbour. Light them all and look behind the back wall.
call rn_lamp x=51 z=-15 al=ic_lamp1 nm="Folly lamp 1" grp="Folly lamps" on=0
call rn_lamp x=57 z=-8 al=ic_lamp2 nm="Folly lamp 2" grp="Folly lamps" on=1
call rn_lamp x=64 z=-15 al=ic_lamp3 nm="Folly lamp 3" grp="Folly lamps" on=0
call rn_lamp x=57 z=-22 al=ic_lamp4 nm="Folly lamp 4" grp="Folly lamps" on=1
prop ic_lamp1 on.use=light|Folly lamp 2|toggle
prop ic_lamp2 on.use=light|Folly lamp 3|toggle
prop ic_lamp3 on.use=light|Folly lamp 4|toggle
prop ic_lamp4 on.use=light|Folly lamp 1|toggle
prop ic_lamp1 on.alllit=show|ic_lampchest\nmessage||All four lamps burn. Behind the back wall a stone has been lifted.
call rn_hidden x=59 z=-9.4 al=ic_lampchest
place Creature_Chicken ic_hens at 66 -8 ground
prop ic_hens creature.count=3
call ar_plane x=-60 z=-26 h=3 yaw=40 al=ic_plane crate=ic_planecrate
place Note_Paper ic_pilot at -61.78 -21.9 ground y=0.1 drop yaw=70
call hw_zone x=-60 z=-26 al=ic_planez id=ic_plane r=6 h=1 msg="A plane, nose down in the grass. Nobody came for it."
