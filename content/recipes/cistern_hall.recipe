# Cistern Hall - the seventh island of the library's plan The City That Never Sank (SL13, Highwater, chapter 7)
# The Authority's main tower: its roof is the island's top (planters, a sand bed, something buried in it); at its foot
# the old cistern lies open to the sea - a basin six metres deep, walkways on stone legs over the water, the pump house
# with the oldest pump in the city, the smelter workshop on its own platform, the councillor's office, and down in the
# water the flooded valve gallery with two pockets of air. Quest "The Evidence" (25 steps, STORY 10-24: the forged valve log, Dobbs's complaints filed in the drawer, the sluice order split over four clerks' slips round the island, Ines's slate in the settling house; the sluice lever machine gone): the intake, the cistern
# ledger, the electric smelter's plans, the valve gallery, the valve log (the evidence), the advanced biofuel
# extractor's plans, the old pump (the camera on its plate), the builder's plate, the advanced anchor's plans, the
# councillor's drawer.
#
# Points: the tower roof 0 12 (levelled at 6, r 12); the cistern basin 0 -28 (levelled at -6, r 16); the intake 0 -14;
# the walkway slab x -3..3, z -26.5..-17.5 (deck 1); the pump house x -3..3, z -35.5..-26.5 (floor 1, door north);
# the smelter platform x 9..15 and the councillor's office x -15..-9 (z -26.5..-17.5), bridges at z -22; the valve
# gallery on the basin's floor under the walkway (air at -1 -22 and 0 -31).
include lib_sea
include lib_rt
include lib_huts
include lib_features
include lib_verdance
include lib_highwater
include lib_areas
# RESIZE 10-24: Radius 40 -> 85 (Height 7 -> 7), the old content moved 4.9 -24.3 as one frame (push) so its sea side stays at the coast; the island grows behind it.
# DEEP 10-24: Overflow Tor: a surge tower over the cistern, a settling house drowned in the south, and sluice gates that must be pulled in the right order.
new
gen Trees=0.1 Bushes=0.2 Rocks=0.4 Harvest=0.2 BeachThings=0.25
gen Seed=13701 Radius=85 Height=7 Roughness=0.25 Peaks=1 Shape=0 Style=0 PeakShape=0.4 Cliffs=0.3 BeachWidth=0.5
gen Water=0.5 SeaRocks=0.3 SeaFinds=0.3 Sunken=0.3 Hostiles=0 Friendly=0 SeaLife=0.2
generate
push at 4.9 -24.3

# --- Terrain: the tower's roof on top, the cistern's basin at its foot ---------------------------------------------
brush flatten at 0 12 r=12 s=20 frames=300 h=6
brush flatten at 0 -28 r=16 s=20 frames=400 h=-6
# (the smelter workshop's roof at 15 -22 stood under 2 m of the slope: a shelf cut for it - X7, 2026-10-24)
brush flatten at 13 -20 r=10 s=20 frames=400 h=0.4
# (REACH 10-24: the intake causeway with the ledger and the councillor's office stood in the basin rim)
brush flatten from 0 -10 to 0 -17 r=3 s=20 frames=200 h=0.3
brush flatten at -9 -22 r=7 s=20 frames=300 h=0.95
pop
# --- DEEP 10-24 terrain: Overflow Tor (south-west, summit 40 m, base r 28), its trail, the drowned settling house (-16 m) ------------
call hw_mount x=-42 z=-38 b=28 h=40
call hw_trail x=-42 z=-38 b=28 h=40 a0=47.86 turn=300 n=40 h0=3
brush flatten at -46.32 -51.42 r=2.6 s=20 frames=200 h=21.5
clear at -46.32 -51.42 r=3
call hw_basin x=22 z=-80 r=14 h=-16
brush flatten at -10 -72 r=4 s=8 frames=60
clear at -10 -72 r=6
brush flatten at -34 11.7 r=5 s=8 frames=40
origin
clear at -34 11.7 r=6
push at 4.9 -24.3
clear at 0 12 r=11
clear at 0 -28 r=17
clear from 0 -10 to 0 -16 r=4

# --- The intake: a causeway down off the shore, the reef at its mouth -------------------------------------------------
line Block_Foundation from 0 -11.75 to 0 -16.75 step=1.5 h=0.35
place Note_Board ledger at -1.4 -13 h=1.05 yaw=270
place Zone_Trigger intakezone at 0 -14 h=1.5
call hw_reef x=7 z=-14 r=3 seed=13702

# --- The walkway over the water, bridges to the workshop and the office ------------------------------------------------
push at 3 -22 h=1
call hw_roof d=8 a=stone bm=none fm=none lm=none rm=none
call hw_bridge n=4 y=0
place Placeable_Lantern_Metal - at -3 0 y=0.05 drop
pop
push at -9 -22 h=1
# (a wide doorstep under the office door - the door's sill is wider than the bridge - then the plank bridge)
place Block_Floor_Wood - at 0.75 0 y=0 sz=1.4
for bx 2.25 5.25 1.5
place Block_Floor_Wood - at $bx 0 y=0
place Block_Wall_Fence_Rope - at $bx -0.75 y=0
place Block_Wall_Fence_Rope - at $bx 0.75 y=0
next
pop

# --- The smelter workshop on its own platform -------------------------------------------------------------------
push at 15 -22 h=1
call hw_roof d=8 a=stone lm=none
place Placeable_CookingStand_Smelter_Electric - at -4.35 2.5 y=0.05 sit yaw=180
place Placeable_CookingStand_Smelter - at -4.5 -2.5 y=0.05 sit
place Loot_Chest smelterbench at -1.4 3.4 y=0.05 sit yaw=180
place "Box Small" - at -1.4 -3.6 y=0.05 sit
pop

# --- The councillor's office: a storey on legs, its door on the walkway's side ---------------------------------------
push at -9 -22 h=1
call hw_penthouse d=8 a=stone r2=RT_WallDoor1 l2=RT_WallWindow1 f2=RT_Wall1 b1=RT_WallWindow1
place "Table Office" - at -4.5 3 y=0.4 sit yaw=180
place Loot_ChestSmall drawer at -3 3.4 y=0.1 sit yaw=180
place RT_Clipboard - at -4.5 3 y=0.9 drop
place Placeable_Lantern_Metal - at -3 0 y=0.1 drop
pop

# --- The pump house: the oldest pump, its builder's plate, the camera on it ------------------------------------------
push at 3 -31 h=1
call hw_penthouse d=8 a=stone b2=RT_WallDoor1 f2=RT_Wall1 l2=RT_Wall1 r2=RT_Wall1
place "VG_DecorationPrefabBase_Engine Variant" oldpump at -3 -1 y=0.1 sit
prop oldpump obj.name=oldpump
place Note_Sign plate at -3 -2.6 y=0.1 sit yaw=180
place Loot_Chest anchorlocker at -5.2 3.4 y=0.1 sit yaw=180
place Zone_Trigger pumpzone at -3 1.5 y=0.1
place Placeable_Lantern_Metal pumpcam at -0.8 3.6 y=0.1 drop
pop

# --- The valve gallery: the basin's floor under the walkway, flooded, two pockets of air -------------------------------
call hw_airpocket x=-1 z=-22 id=valve_gallery al=valveair bub=valvebub msg="The valve gallery. Three great wheels on the pillars - and air, trapped under the walkway."
call hw_airpocket x=0 z=-31 id=gallery_air2 al=valveair2 bub=valvebub2
call crank x=2 z=-20 yaw=0 alias=valve1
call crank x=-3 z=-20 yaw=0 alias=valve2
call crank x=2 z=-24.5 yaw=180 alias=valve3
place Note_Paper valvelog at 0 -22.5 ground drop
place Loot_Chest gallerychest at -2.5 -25 ground sit yaw=90
place "Pickup_Landmark_Mushroom 1" - at -12 -36 ground sit
place "Pickup_Landmark_Mushroom 2" - at -11 -37.5 ground sit
place "Pickup_Landmark_Mushroom 3" - at -13 -38 ground sit
place "Pickup_Landmark_Mushroom 1" - at -9.5 -38.5 ground sit
place "Pickup_Landmark_Copper 1" - at 12 -34 ground sit
place "Pickup_Landmark_Copper 2" - at 14 -31 ground sit
place "Pickup_Landmark_Copper 1" - at -14 -28 ground sit
place Creature_PufferFish puffers at 6 -36 ground y=2

# --- The tower's roof: planters, the sand bed, something buried --------------------------------------------------------
place Placeable_Cropplot_Medium - at -13.5 16.5 ground sit
place Placeable_Cropplot_Medium - at -13.5 20.5 ground sit
place Loot_ChestSmall seedbox at -9 19 ground sit yaw=90
place "Pickup_Landmark_Sand" - at 4 8 ground sit
place "Pickup_Landmark_Sand" - at 6 10 ground sit
place "Pickup_Landmark_Sand" - at 3 12 ground sit
place Antenna_pole - at 8 18 ground sit
place RT_Spotlight - at 9 15 ground sit yaw=200
call treasure x=0 z=10 r=8 n=1 seed=13051
prop treasure13051 treasure.loot=TitaniumOre*3
scatter "Pickup_Landmark_Tree_Palm 1" 2 at -14 6 r=10 seed=13703 free=3
call shallows x=-4.9 z=24.3 r=119 deep=5 n=2 seed=13704
call hw_skyline x=-60 z=120 a=skyline
pop

# --- DISCOVERIES 10-24 (optional, no quest needs them): camp + note; Van_4 + chest; hatch with a chest; buried treasure; viewpoint ---
place campfire_1 - at -34 11.7 ground sit
place Balboa_DecorationPrefabBase_SimpleTent - at -31 13.7 ground sit yaw=57
place "Box Small" - at -36 14.2 ground sit
place Note_Paper dnote at -36 14.2 ground y=1.6 drop yaw=20
note dnote Fleet runner's note | Waiting for the Free Fleet's boat. Three days now.\nI hid my share where the Authority won't look. You won't either, unless you dig.
place Van_4 dvan at 36.9 -12.7 ground yaw=177
prop dvan tint.color=#6b4a32
prop dvan tint.amount=0.5
place Loot_ChestSmall dwreckchest at 32.9 -9.7 ground sit yaw=117
note dwreckchest Salvage chest | A salvager's chest: copper, bolts and a coil of rope.
loot dwreckchest CopperIngot*2;Bolt*2;Rope*2
prop dwreckchest loot.refill=0
call hatchcache x=12.7 z=36.9 r=4 seed=13791 alias=dhatch chest=dhatchchest items=MetalIngot*2;CopperIngot*2;Bolt*3
call treasure x=-18.9 z=-34.1 r=6 n=1 seed=13792
prop treasure13792 treasure.loot=CopperOre*3;TitaniumOre*1
place Zone_Trigger dview at -1.7 8.8 ground
prop dview zone.id=cistern_hall_view
prop dview zone.radius=7
prop dview zone.repeat=never
prop dview zone.message=The Authority's tower stands over the water, planters on its roof - and the city's roofs all round it under the sea.

# --- Areas (10-24: every story island has places all over it and its quest crosses it): aqueduct hill in the north-west (buried salvage),
# the records van and its wagon in the east, the waterman's lodge in the north-east, the drowned-lamp cave in the west
# (dark: a headlight), the oldest pump's engine (the second gas tank opens its locker)
call ar_ridge x1=-45 z1=45 x2=-5 z2=62 h=11 top=6 r=9
call ar_plants_hill x=-25 z=53 r=26 seed=13711
call hw_zone x=-25 z=53 al=aqueducthill id=aqueduct_hill r=7 msg="Aqueduct hill: the old water line ran over here on arches. Two arches still stand; the rest lies in the grass."
call treasure x=-25 z=53 r=12 n=2 seed=13761
prop treasure13761 treasure.loot=CopperOre*2;MetalOre*2
call hw_wreck x=50 z=30 h=5 yaw=200 obj=Van_1 al=recordsvan crate=recordscrate r=9
place VP_Wagon01 recordswagon at 44 40 ground sit yaw=110
call ar_ruin x=40 z=58 h=5 yaw=0 al=watermanlodge
call hw_note x=42.5 z=53.5 yaw=-20 al=watermandiary
call ar_cave x=-60 z=8 h=4 yaw=0 al=lampcave chest=drownedlampchest
call hw_hazard x=-60 z=18 al=lampcavedark kind=dark r=4 dmg=0 safe=wears|HeadLight* msg="The lamps in here drowned years ago. A headlight would show the way in."
call hw_zone x=-60 z=30 al=lampcavemouth id=lamp_cave r=4 msg="A cave under the aqueduct: the cistern's lamp men kept their stores here."
beside Loot_ChestLarge pumpvault oldpump d=1.8 yaw=90
prop oldpump beh.use=Start the oldest pump's engine
prop oldpump on.use=message||The old engine drinks the gas, coughs twice and turns over. The pump groans - and its rusted locker drops open.\nsignal||engine\nshow|pumpvault
prop pumpvault obj.name=pumpvault
prop pumpvault beh.hidden=1
call ar_plants_hill x=55 z=-30 r=14 seed=13721
place Creature_Chicken hens at 30 48 ground

# --- DEEP 10-24 (the user: one hour per island - real height, a big climb, a deep dive): Overflow Tor: a surge tower over the cistern, a settling house drowned in the south, and sluice gates that must be pulled in the right order. ------
# the climb: the trail spirals up from the north-east foot; on the summit the surge tower (10 storeys, a ladder inside), its deck chest
# and a zipline down to the hub (the shortcut back); the dive: the settling house on a basin floor -16 m down, an air pocket
# in its front room; the hub: the Sluice lever that wants both, the notice; secrets: the trail ledge cache, the summit treasure,
# the sunk boat's crate
call hw_zone x=-20.5 z=-18.54 al=ch_trailz id=ch_trail r=5 msg="The trail up Overflow Tor starts here - cut into the slope, round and up."
call hw_zone x=-42 z=-38 al=ch_summitz id=ch_summit r=8 h=1 msg="The top of Overflow Tor. The whole island below, the city beyond it, and the surge tower still higher."
brush flatten at -44.74 -35.09 r=3.5 s=20 frames=300 h=40
call hw_mast x=-44.74 z=-35.09 h0=40 lv=10 a=ch_mast chest=ch_topchest top=RT_CommRadio
place ZiplinePath_Landmark ch_zip at -37.08 -40.67 h=41.35
zipto ch_zip -12.74 -69.09
place Loot_ChestSmall ch_ledge at -46.32 -51.42 ground sit yaw=17.86
call treasure x=-44.91 z=-40.74 r=5 n=1 seed=13778 kind=0
prop treasure13778 treasure.loot=CopperOre*2;MetalOre*2;TradeToken*1
place Creature_Goat ch_goats at -24.14 -21.97 ground
prop ch_goats creature.count=2
place Creature_Goat ch_summitgoat at -39.82 -35.94 ground
prop ch_summitgoat creature.count=1
scatter "Pickup_Landmark_Copper 1" 2 at -42 -38 r=24 seed=13782 free=2
scatter "Pickup_Landmark_Clay 1" 2 at -42 -38 r=26 seed=13783 free=2
scatter "Pickup_Landmark_Rock 1" 2 at -42 -38 r=22 seed=13784 free=2
call hw_sunkhouse x=22 z=-80 h=-16 yaw=0 a=ch_sunk chest=ch_deepchest air=ch_air bub=ch_airbub dal=ch_sunkdoor
call hw_zone x=22 z=-80 al=ch_deepz id=ch_deep r=7 h=1 msg="The settling house, 16 metres down. The front room still holds a pocket of air."
place RT_PlasticBoat ch_sunkboat at 30 -78 ground sit yaw=35
prop ch_sunkboat tint.color=#5a5048
prop ch_sunkboat tint.amount=0.45
place Loot_Crate ch_boatcrate at 29 -84 ground sit yaw=10
prop ch_boatcrate loot.refill=0
call hw_reef x=15 z=-75 r=3 seed=13786
place Creature_PufferFish ch_puffers at 16 -87 h=-12
prop ch_puffers creature.count=2
call hw_note x=-7.15 z=-71.38 yaw=-23.26 al=ch_hint
call hw_note x=-22 z=50 yaw=30 al=quillslip
call hw_note x=37.5 z=54 yaw=-40 al=hollisslip
call hw_note x=45 z=25 yaw=200 al=faneslip
call hw_note x=-57 z=31 yaw=90 al=abernethyslip
# the sluices (mech 10-24: moveto + state checks): four levers by the hub, each dropping its sluice gate, in the
# pump-keeper's order (3-1-4-2, the reward note). Out of turn a lever jams; the reset lever by the hub lifts all gates.
place RT_Pillar - at -3.95 -73.17 ground sit sy=0.4
place TP_LaserControlPanel_lever ch_g1 at -3.95 -73.17 ground y=1.25 scale=3 yaw=47.86
prop ch_g1 obj.name=ch_g1
prop ch_g1 beh.use=Pull sluice 1
place Block_Wall_Tier3 ch_gate1 at -2.93 -74.27 ground yaw=47.86
prop ch_gate1 obj.name=ch_gate1
place Zone_Trigger ch_up1 at -2.93 -74.27 ground yaw=47.86
prop ch_up1 obj.name=ch_up1
place Zone_Trigger ch_dn1 at -2.93 -74.27 ground y=-2.2 yaw=47.86
prop ch_dn1 obj.name=ch_dn1
place Zone_Trigger ch_s1 at -3.95 -73.17 ground y=0.2
prop ch_s1 obj.name=ch_s1
prop ch_s1 beh.hidden=1
prop ch_g1 if.use=state|ch_s3|shown\nstate|ch_s1|hidden
prop ch_g1 on.use=show|ch_s1\nmoveto|ch_gate1|ch_dn1,3\nmessage||Sluice gate 1 grinds down into its slot.
prop ch_g1 else.use=message||The lever jams - the water still pushes against that gate. The order matters; the reset lever by the hub lifts the gates again.
place RT_Pillar - at -5.7 -74.82 ground sit sy=0.4
place TP_LaserControlPanel_lever ch_g2 at -5.7 -74.82 ground y=1.25 scale=3 yaw=47.86
prop ch_g2 obj.name=ch_g2
prop ch_g2 beh.use=Pull sluice 2
place Block_Wall_Tier3 ch_gate2 at -4.68 -75.92 ground yaw=47.86
prop ch_gate2 obj.name=ch_gate2
place Zone_Trigger ch_up2 at -4.68 -75.92 ground yaw=47.86
prop ch_up2 obj.name=ch_up2
place Zone_Trigger ch_dn2 at -4.68 -75.92 ground y=-2.2 yaw=47.86
prop ch_dn2 obj.name=ch_dn2
place Zone_Trigger ch_s2 at -5.7 -74.82 ground y=0.2
prop ch_s2 obj.name=ch_s2
prop ch_s2 beh.hidden=1
prop ch_g2 if.use=state|ch_s4|shown\nstate|ch_s2|hidden
prop ch_g2 on.use=show|ch_s2\nmoveto|ch_gate2|ch_dn2,3\ngive||story:ch_gates*1\nshow|ch_pumpchest\nsound||event:/exploring/obstacles/keypad/keypad_correct\nmessage||The last sluice gate sinks into its slot - the old pump hall drains, and its keeper's chest stands dry.
prop ch_g2 else.use=message||The lever jams - the water still pushes against that gate. The order matters; the reset lever by the hub lifts the gates again.
place RT_Pillar - at -7.45 -76.46 ground sit sy=0.4
place TP_LaserControlPanel_lever ch_g3 at -7.45 -76.46 ground y=1.25 scale=3 yaw=47.86
prop ch_g3 obj.name=ch_g3
prop ch_g3 beh.use=Pull sluice 3
place Block_Wall_Tier3 ch_gate3 at -6.43 -77.56 ground yaw=47.86
prop ch_gate3 obj.name=ch_gate3
place Zone_Trigger ch_up3 at -6.43 -77.56 ground yaw=47.86
prop ch_up3 obj.name=ch_up3
place Zone_Trigger ch_dn3 at -6.43 -77.56 ground y=-2.2 yaw=47.86
prop ch_dn3 obj.name=ch_dn3
place Zone_Trigger ch_s3 at -7.45 -76.46 ground y=0.2
prop ch_s3 obj.name=ch_s3
prop ch_s3 beh.hidden=1
prop ch_g3 if.use=state|ch_s3|hidden
prop ch_g3 on.use=show|ch_s3\nmoveto|ch_gate3|ch_dn3,3\nmessage||Sluice gate 3 grinds down into its slot.
prop ch_g3 else.use=message||The lever jams - the water still pushes against that gate. The order matters; the reset lever by the hub lifts the gates again.
place RT_Pillar - at -9.19 -78.11 ground sit sy=0.4
place TP_LaserControlPanel_lever ch_g4 at -9.19 -78.11 ground y=1.25 scale=3 yaw=47.86
prop ch_g4 obj.name=ch_g4
prop ch_g4 beh.use=Pull sluice 4
place Block_Wall_Tier3 ch_gate4 at -8.17 -79.21 ground yaw=47.86
prop ch_gate4 obj.name=ch_gate4
place Zone_Trigger ch_up4 at -8.17 -79.21 ground yaw=47.86
prop ch_up4 obj.name=ch_up4
place Zone_Trigger ch_dn4 at -8.17 -79.21 ground y=-2.2 yaw=47.86
prop ch_dn4 obj.name=ch_dn4
place Zone_Trigger ch_s4 at -9.19 -78.11 ground y=0.2
prop ch_s4 obj.name=ch_s4
prop ch_s4 beh.hidden=1
prop ch_g4 if.use=state|ch_s1|shown\nstate|ch_s4|hidden
prop ch_g4 on.use=show|ch_s4\nmoveto|ch_gate4|ch_dn4,3\nmessage||Sluice gate 4 grinds down into its slot.
prop ch_g4 else.use=message||The lever jams - the water still pushes against that gate. The order matters; the reset lever by the hub lifts the gates again.
place RT_Pillar - at -2.2 -71.52 ground sit sy=0.4
place TP_LaserControlPanel_lever ch_reset at -2.2 -71.52 ground y=1.25 scale=3 yaw=47.86
prop ch_reset obj.name=ch_reset
prop ch_reset beh.use=Pull the reset lever
prop ch_reset if.use=state|ch_s2|hidden
prop ch_reset on.use=hide|ch_s1\nhide|ch_s3\nhide|ch_s4\nmoveto|ch_gate1|ch_up1,3\nmoveto|ch_gate2|ch_up2,3\nmoveto|ch_gate3|ch_up3,3\nmoveto|ch_gate4|ch_up4,3\nmessage||Chains rattle - all four sluice gates lift back up. Start again.
prop ch_reset else.use=message||The cistern is drained; the gates stay down.
place Loot_Chest ch_pumpchest at -4.52 -77.83 ground sit yaw=47.86
prop ch_pumpchest obj.name=ch_pumpchest
prop ch_pumpchest beh.hidden=1
prop ch_pumpchest loot.refill=0
story ch_top|Surge gauge|Bolt|The surge tower's gauge - its chalk marks show the cistern brim full the night Lowstreet drowned.
story ch_deep|Ines's diving slate|Note_Paper|Ines Marlowe's diving slate, grease pencil, left in the settling house strongbox.
story ch_gates|Sluices open|Bolt|The four sluices of the pump hall, opened in the keeper's order.
note ch_hint Sluicekeeper's notice | SLUICE OFFICE - STANDING ORDER\n\nThe pump hall sluices are to be pulled in one order only. Out of turn, the water holds the gate and the lever jams.\n\nBy the Councillor's rule, no one clerk holds the whole order. Each of the four sluice clerks keeps one line of it, in his own head, and the clerks are to be posted apart.\n\n(Under it, in chalk, a hand you know from Lowstreet: He split it so nobody could open the hall without him. So the clerks wrote their lines down - clerks always do. Quill on the hill, Hollis by the lodge, Fane at the van, Nell by the lamp cave. First, second, third, fourth. - I.M.)
prop ch_topchest on.open=message||The surge gauge, still bolted to the rail. The cistern's mark is chalked on it by date. The night Lowstreet drowned, the cistern stood brim full - and Pumpcrown's main ran the other way. The city's water was not short. It was being kept.
prop ch_deepchest on.open=message||A diver's slate in the strongbox, grease pencil: VALVE LOG REAL. SIGNATURES FORGED - ONE HAND. BARGES TO THE PILES. GONE UP TO THE ROOKERY WITH THE LEDGER PAGE. IF YOU READ THIS, YOU'RE THE ONE I'VE BEEN WRITING TO. - I.M.
note ch_topchest Surge tower deck box | A box lashed to the deck rail at the top of the surge tower.
loot ch_topchest story:ch_top*1;Scrap*2;Rope*2
note ch_deepchest Settling house strongbox | A strongbox in the back room of the settling house.
loot ch_deepchest story:ch_deep*1;MetalIngot*2;Plastic*1
note ch_ledge Climber's cache | A climber's cache on a ledge off the trail - rope, a flask, a few bolts.
loot ch_ledge Rope*2;Bolt*2;Scrap*2
prop ch_ledge loot.refill=0
loot ch_boatcrate Plastic*3;Scrap*2;MetalIngot*1
note ch_pumpchest Pump-keeper's chest | The pump-keeper's chest, dry for the first time in years.
prop ch_pumpchest on.open=message||Under the tins, a chalk drawing of a ladder of roofs, a row of barrels, a small girl with a tram - and Ines's hand, from her first week out: The page I tore from the ledger is on the Rookery, band 800, high up where nobody climbs. Maud Penn keeps the lowest roofs; she'll know you by my chalk. Read the page and you'll see what Crane is weighing. - I.M.
loot ch_pumpchest TradeToken*3;MetalIngot*2;Glass*2
prop ch_ledge if.open=has|Tangaroa_KeyCard|1
prop ch_ledge else.open=message||A card lock on the box - a Tangaroa keycard would open it.

# --- Settings, story items, notes, behaviours, quest ------------------------------------------------------------------
info title=Cistern Hall
info author=Custom Islands
info description=The Authority's main tower and the old cistern at its foot: walkways over dark water, a smelter workshop, the councillor's office, the oldest pump in the city - and a flooded valve gallery that holds the evidence. The seventh island of The City That Never Sank.
island on.arrive=message||The Authority's tower stands over an open cistern. Walkways cross the black water on stone legs. Somewhere below, a wheel creaks.

prop stone tint.color=#8a8270
prop stone tint.amount=0.35
prop skyline tint.color=#7a8088
prop skyline tint.amount=0.4
prop puffers creature.count=2
prop pumpcam obj.name=pumpcam
prop pumpzone on.enter=camera|pumpcam|oldpump|5|8
prop valvelog on.read=signal||evidence

note ledger Cistern ledger | CISTERN HALL - LEDGER\n\nIntake: full. Southern district (Lowstreet): supply cut, by order.\nValves 1-3: closed for repairs.\n\nThe order is signed. The page with the name on it has been torn out.\n\n(In pencil, along the torn edge, small and neat: I have the page. It's safe where the children count barrels. The rest of what you need is in the valve gallery - Fane put it back. - I.M.)
note valvelog Valve log | VALVE LOG - THE NIGHT LOWSTREET DROWNED\n\nValves 1, 2 and 3 opened by hand. The sea let into the southern district. Two thousand moved to the roofs.\n\nOrdered: Councillor Aldous Crane, Harbor Authority.\nCountersigned: for the Free Fleet - T. Varga.\nCountersigned: for the Salvagers' Union - the foreman.\n\nAll three factions, it says. Every faction knew.\n\nBut the ink is one ink. The T of Varga leans the same way as the C of Crane, and the foreman's mark is a neat little B - Bram Hask signs with a hook, everyone knows that. One hand wrote all three names.\n\nCrane didn't buy the factions. He signed for them.
note plate Builder's plate | A brass plate on the oldest pump, green with age. A ring of waves round a tower:\n\nCONCORD WORKS.\nStation 7 of the southern network.
note smelterbench Smelter workshop | The workshop's chest: the electric smelter's plans, a pair of tongs.
note gallerychest Valve gallery chest | A diver's chest chained to a pillar: the advanced biofuel extractor's plans.
note anchorlocker Pump house locker | The pump house locker: the advanced anchor's plans - the pump's own mooring.
note drawer Councillor's drawer | Councillor Crane's drawer. A seal, a pen with a very fine nib, and a list of who was paid to keep quiet - the waterman, two Authority guards, a harbourmaster who refused.\n\nUnder them, tied with ribbon, two hundred and ninety-nine complaints from W. Dobbs, Foreman, Pumpcrown Works. Every one stamped in red: FILED - A.C.\n\nNone has been opened. On the top one, in the Councillor's hand: The man is right about the pumps. That is why he must never be answered.
note quillslip Clerk Quill's slip | Rolled in a bottle and wedged between the arch stones -\n\nI am Clerk Quill, first line of the sluice order, and I am writing it down because I am sixty-one and my head is not the safe it was.\n\nFIRST: SLUICE THREE.\n\nThe Councillor says a clerk who writes his line down will be posted to the Piles. I have been posted to this hill, which is nearly as bad and has more goats. A goat ate my first copy. This is my second. If a goat eats this one, it is the goat who knows the order, and good luck to the Council getting it out of him.\n\n- A. Quill
note hollisslip Clerk Hollis's slip | Pinned under a stone by the lodge wall -\n\nSECOND: SLUICE ONE.\n\nThat's my line. I've kept it nine years, through a wedding, two children and a fever where I apparently sang it to the doctor. He didn't understand. Nobody ever does.\n\nThe waterman says the pumps ran backwards the night Lowstreet went. He told the Councillor and the Councillor paid him to stop telling. Nobody paid me. I'm telling you for nothing, which is about what my silence was worth anyway.\n\n- J. Hollis, second clerk
note faneslip Clerk Fane's slip | Taped inside the van's door, behind the mirror -\n\nTHIRD: SLUICE FOUR.\n\nI drove the records van the morning after. Councillor's orders: take every valve book on the island out to the Piles barge and see it sunk. I took them. I sank them. All but one, which I put back in the gallery where it was written, because my mother was on Lowstreet and she got out with one shoe and a kettle.\n\nIf you've read that valve log, you've read the one I kept. Look at the signatures. Look at them hard.\n\n- P. Fane
note abernethyslip Clerk Abernethy's slip | Tucked into a lamp bracket at the cave mouth -\n\nFOURTH: SLUICE TWO. Then the hall drains, and the old keeper's chest stands dry.\n\nI'm Nell Abernethy, night clerk. I won't be here when you read this: the Councillor has reassigned me to the Crown, where he can keep an eye on me, which is a compliment of a kind. I have a father on Bellow Street who thinks I work in an office with a nice window. Let him.\n\nThe woman with the chalk came through at midnight and asked me for my line. I gave it to her. She asked who else knew. I said: now, you. She said: not for long.\n\n- N. Abernethy
note seedbox Planter box | The roof garden's seeds.
loot smelterbench Blueprint_SmelterElectric*1;Blueprint_BatteryCharger*1;CopperIngot*2;MetalIngot*2
prop smelterbench loot.refill=0
loot gallerychest Blueprint_BiofuelExtractorAdvanced*1;Plastic*2
prop gallerychest loot.refill=0
loot anchorlocker Blueprint_AnchorStationaryAdvanced*1;Blueprint_ZiplineTool*1;MetalIngot*3
prop anchorlocker loot.refill=0
loot drawer TradeToken*6;Glass*2
prop drawer loot.refill=0
loot seedbox Raw_Beet*2;Raw_Potato*2
prop seedbox loot.refill=0

prop intakezone zone.id=intake
prop intakezone zone.radius=3
prop intakezone zone.message=The intake. The sea comes in here - and the city's water goes out.
prop pumpzone zone.id=old_pump
prop pumpzone zone.radius=3
prop pumpzone zone.message=The oldest pump in Highwater. On its side, a brass plate with a ring of waves.

note recordscrate Records van's crate | The Authority's records van, run aground with the flood. The crate holds what they did not want read.
loot recordscrate Plastic*3;Rope*2;CircuitBoard*1
note watermandiary Waterman's diary | The waterman's diary.\n\nDay 3: Crane wants the pumps run backwards. He says it lowers the sea gates' strain.\nDay 4: It raises the water in Lowstreet instead. I told him. He paid me to stop telling him.
note drownedlampchest Lamp men's chest | Lamp oil, wicks and the lamp men's tools, dry at the back of the cave.
loot drownedlampchest Battery*1;Glass*2;MetalIngot*2
prop drownedlampchest loot.refill=0
note pumpvault Pump engine locker | The pump house's spare parts, behind a locker that only opened when the engine ran.
loot pumpvault MetalIngot*3;Bolt*3;CopperIngot*2
prop pumpvault loot.refill=0
quest title=The Evidence
quest intro=Ines Marlowe's chalk led here: the cistern under the Authority's tower, where the valves under Lowstreet were turned by hand. Find the record - and the four clerks who kept the sluice order between them.
step reach|intake|1|Make for the Authority's tower, then go down the causeway to the cistern's intake
step read|Cistern ledger|1|Read the cistern ledger at the intake
step reach|valve_gallery|1|Dive down to the flooded valve gallery
step read|Valve log|1|Read the valve log in the gallery
step blueprint|Blueprint_BiofuelExtractorAdvanced|1|Take the advanced biofuel extractor's plans from the gallery's chest
step blueprint|Blueprint_SmelterElectric|1|Take the electric smelter's and battery charger's plans from the workshop
step blueprint|Blueprint_BatteryCharger|1|Take the battery charger's plans from the workshop too
step open|Councillor's drawer|1|Open the councillor's drawer in his office
step reach|old_pump|1|Go into the pump house and look at the oldest pump
step read|Builder's plate|1|Read the builder's plate on the pump
step blueprint|Blueprint_AnchorStationaryAdvanced|1|Take the advanced anchor's and zipline's plans from the pump house locker
step blueprint|Blueprint_ZiplineTool|1|Take the zipline's plans from the pump house locker too
step read|Sluicekeeper's notice|1|Read the sluicekeeper's notice by the four sluice levers, behind the pump house
step reach|aqueduct_hill|1|Climb aqueduct hill, the hill with the two old arches
step read|Clerk Quill's slip|1|Find Clerk Quill's slip on aqueduct hill
step read|Waterman's diary|1|Read the waterman's diary in his ruined lodge inland
step read|Clerk Hollis's slip|1|Find Clerk Hollis's slip by the waterman's lodge
step open|Records van's crate|1|Open the crate in the Authority's records van on the shore
step read|Clerk Fane's slip|1|Find Clerk Fane's slip by the records van
step read|Clerk Abernethy's slip|1|Find Clerk Abernethy's slip at the mouth of the lamp men's cave in the shore rocks
step reach|ch_trail|1|Find the foot of the trail up Overflow Tor, the tall tor with the surge tower
step reach|ch_summit|1|Climb the trail to the top of Overflow Tor
step collect|story:ch_top|1|Climb the surge tower and read its gauge on the deck
step reach|ch_deep|1|Dive to the settling house, sunk off the shore below the tor
step collect|story:ch_deep|1|Find what was left in its back room strongbox
step collect|story:ch_gates|1|Pull the four sluices by the hub in the clerks' order
step open|Pump-keeper's chest|1|Open the pump-keeper's chest in the drained pump hall
quest done=One hand signed for every faction - Crane's. Ines Marlowe is waiting on the Rookery's lowest roofs with the torn ledger page. Band 800.
quest reward=CopperOre*3;CaveMushroom*2

