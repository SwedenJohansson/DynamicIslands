# Marrow Key Museum - an island of the library's plan Relic of the Seventh Tide (the opening heist)
# A coral key with a small colonial museum of sandstone on a terrace: a portico of pillars, display rooms with glass
# cases (Varuna Point's glass bridge, made small, as museum glass on plinths), Tangaroa's founder statue as an exhibit
# and a smashed skylight, its glass on the floor below. Quest "Someone Got Here First" (11 steps): the museum steps, the
# curator's report, the Exhibit 7 card (a cipher: three letters back), Signal Hill in the north-east and the curator's
# note and safe key on its mast, the Syndicate's launch on the east beach and their orders, the curator's safe (keypad +
# key), Kett's field journal, and the Syndicate's hyenas waiting outside on the way out.
# DEEP 10-25 (Relic deep pass): Radius 54 -> 82, as big as Raft's own big islands; the landing moved out to the new south
# coast. Signal Hill (24 m, trail + the curator's signal mast) in the north-east, the Syndicate's beached launch in the
# east, a smugglers' cave in the south-west, the old customs house drowned off the north-west (-10 m, an air pocket).
# Voices: the curator Ambrose Vell, the Syndicate's field captain Silas Grey, a Syndicate diver, Kett.
#
# Built by the recipe player (CIRecipe marrow_key_museum) through the editor's own operations.
include lib_sea
include lib_features
include lib_areas
include lib_highwater
new
# (nature: a tropical key at Raft's density - palms, bushes, a few rocks; a reef ring round it)
gen Trees=0.3 Bushes=0.4 Rocks=0.35 Harvest=0.3 BeachThings=0.3
gen Seed=9201 Radius=82 Height=7 Roughness=0.3 Peaks=1 Shape=0 Style=0 PeakShape=0.2 Cliffs=0.2 BeachWidth=0.7
gen Water=0.5 SeaRocks=0.4 SeaFinds=0.2 Sunken=0.3 Hostiles=0 Friendly=0.2 SeaLife=0.3
generate

# --- Terrain: the museum terrace at 3 m, the path up from the landing in the south ---------------------------------
brush flatten at 0 0 r=20 s=20 frames=200 h=3
brush flatten from 0 -72 to 0 -16 r=4 s=20 frames=160 h=3
brush flatten at 0 -80 r=6 s=20 frames=60 h=1
brush flatten at 0 -76 r=3 s=20 frames=40 h=2
brush smooth from 0 -80 to 0 -72 r=3 s=6 frames=20
# --- DEEP 10-25 terrain: Signal Hill (north-east, summit 24 m, base r 22) and its trail, the smugglers' cave (south-west),
# the old customs house's basin off the north-west (-10 m), the Syndicate launch's pad on the east beach --------------
call hw_mount x=40 z=38 b=22 h=24
call hw_trail x=40 z=38 b=22 h=24 a0=225 turn=300 n=34 h0=4
call ar_cave x=-55 z=-30 h=3 yaw=180 al=smugglerrock chest=smugglerchest
call hw_basin x=-62 z=52 r=12 h=-10
origin
clear at 0 0 r=22
clear from 0 -82 to 0 -16 r=5

# --- The museum: sandstone walls (Raft's tier 3 blocks, tinted), a portico of pillars in front, a flat roof of plates
# with a hole where the skylight was smashed (its pillars hold the hole's corners) --------------------------------------
push at -7.5 -6 h=3
for fx 0.75 14.25 1.5
for fz -2.25 8.25 1.5
place Block_Floor_Tier3 museumfloor at $fx $fz y=0.08
next
next
# front wall with a double door in the middle; back wall; side walls
for fx 0.75 5.25 1.5
place Block_Wall_Tier3 museumwalls at $fx 0 y=0.2 sy=1.5
next
place Block_Wall_Door_Tier3 museumwalls at 6.75 0 y=0.2 sy=1.5
place Block_Wall_Door_Tier3 museumwalls at 8.25 0 y=0.2 sy=1.5
for fx 9.75 14.25 1.5
place Block_Wall_Tier3 museumwalls at $fx 0 y=0.2 sy=1.5
next
for fx 0.75 14.25 1.5
place Block_Wall_Tier3 museumwalls at $fx 9 y=0.2 sy=1.5
next
for fz 0.75 8.25 1.5
place Block_Wall_Tier3 museumwalls at 0 $fz y=0.2 yaw=90 sy=1.5
place Block_Wall_Tier3 museumwalls at 15 $fz y=0.2 yaw=90 sy=1.5
next
# pillars: every 3 m along the walls, the portico row in front, the skylight's four corners
for px 0 15 3
place Block_Pillar_Tier3 museumpillars at $px 0 y=0.2 sy=1.5
place Block_Pillar_Tier3 museumpillars at $px 9 y=0.2 sy=1.5
place Block_Pillar_Tier3 museumpillars at $px -3 y=0.2 sy=1.5
next
for pz 3 6 3
place Block_Pillar_Tier3 museumpillars at 0 $pz y=0.2 sy=1.5
place Block_Pillar_Tier3 museumpillars at 15 $pz y=0.2 sy=1.5
place Block_Pillar_Tier3 museumpillars at 6 $pz y=0.2 sy=1.5
place Block_Pillar_Tier3 museumpillars at 9 $pz y=0.2 sy=1.5
next
# the roof plates, all but the 3 x 3 m skylight hole over the middle of the hall (x 6..9, z 3..6)
for fx 0.75 14.25 1.5
for fz -2.25 2.25 1.5
place Block_Floor_Tier3 museumroof at $fx $fz y=4.05
next
for fz 6.75 8.25 1.5
place Block_Floor_Tier3 museumroof at $fx $fz y=4.05
next
next
for fz 3.75 5.25 1.5
for fx 0.75 5.25 1.5
place Block_Floor_Tier3 museumroof at $fx $fz y=4.05
next
for fx 9.75 14.25 1.5
place Block_Floor_Tier3 museumroof at $fx $fz y=4.05
next
next
pop
prop museumwalls tint.color=#c9a77a
prop museumpillars tint.color=#e6d3b0
prop museumroof tint.color=#a8875e
prop museumfloor tint.color=#b8a58a

# --- Inside: the glass cases (Varuna Point's glass bridge sections, small, laid on plinths), the empty Sunstaff case
# under the broken skylight, the founder statue as an exhibit, the Exhibit 7 card, the curator's desk and his safe -----
push at -7.5 -6 h=3
place "Box Big" plinths at 2.4 2.4 y=0.05 sit
place "Box Big" plinths at 2.4 6.6 y=0.05 sit
place "Box Big" plinths at 12.6 6.6 y=0.05 sit
place "Box Big" plinths at 7.5 7.8 y=0.05 sit
place VP_GlassBridge cases at 2.4 2.4 y=0.92 sit scale=0.16
place VP_GlassBridge cases at 2.4 6.6 y=0.92 sit scale=0.16
place VP_GlassBridge cases at 12.6 6.6 y=0.92 sit scale=0.16
place VP_GlassBridge sunstaffcase at 7.5 7.8 y=0.92 sit scale=0.16
place VP_GlassBridge_Broken brokenglass at 7.2 4.4 y=0.06 sit scale=0.16 yaw=30
place VP_GlassBridge_Broken brokenglass at 8.1 5.1 y=0.06 sit scale=0.12 yaw=110
place TangaroaFounderStatue exhibit at 12.6 2.6 y=0.05 sit scale=0.6 yaw=270
place Note_Sign exhibit7 at 6.2 7.9 y=0.05 sit yaw=180
place "Box Big" desk at 13.6 0.9 y=0.05 sit
place Note_Paper report at 13.6 0.9 y=1.4 sit drop yaw=10
place VG_Safe cursafe at 14.2 2.6 y=0.05 sit yaw=270
place "Box Small" - at 14.2 4.0 y=0.05 sit
place RT_PowerBox safekeypad at 14.2 4.0 y=1.2 sit drop yaw=270
place Placeable_Lantern_Metal - at 0.8 0.8 y=0.05 sit
place Placeable_Lantern_Metal - at 14.2 8.2 y=0.05 sit
pop
place Zone_Trigger steps at 0 -11 h=3
place Note_Sign banner at 2.2 -10 h=3 sit yaw=180

# --- The ambush: the Syndicate's hyenas, tan and lean, waiting by the landing path once the journal is out -----------
place Zone_Trigger ambushzone at 0 -16 h=3
place Creature_Hyena hyenas at -10 -24 ground

# --- Things to gather, reefs ----------------------------------------------------------------------------------------
scatter "Pickup_Landmark_PineappleLandmark" 2 at 22 -24 r=12 seed=9211 free=3
scatter "Pickup_Landmark_Flower_Blue" 2 at -24 20 r=12 seed=9212 free=3
call dirt x=-28 z=-18 r=8 n=3 seed=9213
call shallows r=104 deep=5 n=3
call hw_reef x=-40 z=70 r=5 seed=31004
call hw_reef x=70 z=-50 r=5 seed=31005
call hw_reef x=-75 z=-30 r=4 seed=31006

# --- DEEP 10-25: Signal Hill - its foot and top as zones, the curator's signal mast (his note, the safe's key) --------
call hw_zone x=23.7 z=21.7 al=hillfootz id=signalfoot r=5 msg="Signal Hill. A path of flat stones winds up round it to a mast with a lamp on top."
call hw_zone x=40 z=38 al=hilltopz id=signaltop r=7 h=1 msg="The top of Signal Hill. The whole key below you - the museum, the beach, a grey boat pulled up on the sand."
call hw_mast x=40 z=38 h0=24 lv=3 a=vellmast chest=vellbox top=Placeable_Lantern_Metal
place Note_Paper vellnote at 36.5 35 h=24.1 drop yaw=225
loot vellbox story:safekey*1;Rope*2;Battery*1
prop vellbox loot.refill=0
note vellbox Curator's signal box | The curator's box on the mast: the safe's brass key on a ribbon, a spare battery for the signal lamp, rope.
scatter "Pickup_Landmark_PineappleLandmark" 2 at 40 38 r=26 seed=31007 free=3
call treasure x=18 z=52 r=12 n=1 seed=31001 kind=0
prop treasure31001 treasure.loot=MetalOre*3;CopperOre*2;Glass*2
# --- The Syndicate's launch, beached on the east shore: Silas Grey's orders by its crate ------------------------------
call hw_wreck x=60 z=-30 h=1.2 yaw=300 obj=BoatStranded al=synlaunch crate=launchcrate r=7
call hw_zone x=60 z=-30 al=launchz id=launch r=7 msg="A grey launch pulled up on the sand, its engine still warm. The Syndicate's."
place Note_Paper synorders at 57 -34 ground drop yaw=300
loot launchcrate Rope*3;Nail*8;Scrap*3;Plastic*3
note launchcrate Syndicate launch crate | The launch's crate: rope, nails, a crowbar's empty sling - and a museum floor plan with the skylight circled.
# --- The smugglers' cave (south-west): a secret -----------------------------------------------------------------------
call hw_zone x=-55 z=-35 al=smugglerz id=smugglercave r=4 msg="A cave behind the dunes. Someone has been sleeping here - a blanket, a lamp, wet diving fins."
place Note_Paper divernote at -56.5 -35.5 h=3.45 drop yaw=180
loot smugglerchest Rope*2;Battery*1;CopperIngot*1;Scrap*2
prop smugglerchest loot.refill=0
note smugglerchest Diver's stash | A Syndicate diver's stash: rope, a battery, a copper ingot he was keeping for himself.
call treasure x=-46 z=-46 r=12 n=1 seed=31002 kind=0
prop treasure31002 treasure.loot=Scrap*4;Bolt*2;Hinge*1
# --- The old customs house, drowned off the north-west point (-10 m): Kett's dive log, an air pocket ------------------
call hw_sunkhouse x=-62 z=52 h=-10 yaw=0 a=customshouse chest=customschest air=customsair bub=customsbub dal=customsdoor
call hw_zone x=-62 z=52 al=customsz id=customshouse r=7 h=1 msg="The old customs house, ten metres down. The front room still holds a breath of air."
place Note_Paper kettdive at -61.4 50.8 h=-9.5 drop yaw=0
loot customschest Glass*3;CopperOre*2;MetalIngot*1;Rope*2
prop customschest loot.refill=0
note customschest Customs strongbox | The customs strongbox: duty paid in copper and iron, and three panes of old green glass.
call treasure x=-40 z=58 r=12 n=1 seed=31003 kind=0
prop treasure31003 treasure.loot=MetalOre*2;Glass*3;Rope*2

# --- Settings, story items, notes, behaviours, quest ----------------------------------------------------------------
info title=Marrow Key Museum
info author=Custom Islands
info description=A coral key as big as Raft's own big islands, with a small sandstone museum: a portico of pillars, glass cases on plinths, a founder's statue and a smashed skylight. Signal Hill and the curator's mast, the Syndicate's launch on a beach, a smugglers' cave and a customs house drowned off a headland. Someone got here first. The first island of Relic of the Seventh Tide.
island on.arrive=message||A white museum on a coral key, its doors standing open. Glass glitters on the steps.

story safekey|Curator's safe key|Placeable_PaperBundle|The curator's brass safe key on a ribbon, from his signal mast on Signal Hill.
story journal|Kett's field journal|Placeable_PaperBundle|Professor Isadora Kett's field journal: sketches of a mesa, a sundial and a machine with seven wheels.

note banner Banner | MARROW KEY MUSEUM OF THE SEA - NEW EXHIBITION: THE SEVENTH TIDE.\n\nUnder it, in red paint, fresh: SOMEONE GOT HERE FIRST.
note report Curator's report | CURATOR'S REPORT - NIGHT OF THE BREAK-IN\n\nThey came through the skylight. Men in grey coats - the Syndicate, the salvage people with the dredgers. They knew what they wanted: the Sunstaff, Exhibit 9, the brass rod from the mesa dig. They took it and left its case.\n\nThey did NOT get the professor's journal. Kett left it in my safe before she sailed. I wrote the code where only she would read it: on the Exhibit 7 card, the way she taught me.\n\nThe safe's second lock wants my own key. I have taken it up to the signal mast on the hill, to watch for her boat.
note exhibit7 Exhibit 7 card | EXHIBIT 7 - A TIDE TABLET, SEVENTH DYNASTY OF THE SEA KINGS.\n\nOn the back, in the curator's hand: "For the professor - three letters back, as always."\n\nQLQH IRXU WZR VHYHQ
note cursafe Curator's safe | The curator's safe: Professor Kett's field journal, wrapped in oilcloth, and the museum's petty cash.
loot cursafe story:journal*1;Glass*2;Rope*2
prop cursafe loot.refill=0
prop cursafe if.open=quest|8\nsignal|safe\nhas|story:safekey|1
prop cursafe else.open=message||The safe has two locks: a keypad beside it (four digits) and a keyhole for the curator's own key.
prop cursafe on.open=show|ambushzone\nmessage||Kett's journal. On its first page, a sketch of a sundial on a flat-topped mesa - and under it: "the Sunstaff casts the way".

note vellnote Curator Ambrose Vell's note | A. VELL, CURATOR - WRITTEN ON THE MAST\n\nThird night up here. The lamp is lit for the professor's boat; no boat. Only theirs, the grey one, pulled up on the beach below like it owns the sand.\n\nI watched them go in through the roof. Six men and three dogs. I could not have stopped them with a broom, and a broom is what I had. They took the Sunstaff and left the case - they did not know what else was worth having. They never do.\n\nThe safe will hold. It has my code and my key, and the key is here in the signal box with me. If you are the professor: take it, and go down to the hall. If you are not the professor - and I hope you are not one of THEM - then for pity's sake take the journal to her before they work out where it is.
note synorders Syndicate orders | SYNDICATE - ORDERS FOR THE MARROW KEY JOB\n\nIn by the skylight after dark. Take Exhibit 9 (the brass rod, 'Sunstaff') and nothing else; the boss does not pay for vases.\n\nThe woman Kett had a journal. It is NOT in the cases. Search the curator's office, the desk, the floor. If it is in his safe, leave the safe: the dogs will watch the door and we come back with the cutter.\n\nThe curator is not to be hurt. He is to be frightened. He is an old man who likes rules.\n\nThe mesa next. Then the dunes.\n\n- S. Grey, field captain
note divernote Syndicate diver's note | (Pencil, on the back of a pay slip)\n\nGrey says the job's done, back to the boat by morning. Grey can row himself. I've found something better than a brass stick.\n\nThe old customs house went down off the far headland in the big storm, with the duty still in it. Ten metres, maybe a bit more. The front room holds air - you can feel it on your face when you swim through the door.\n\nSomebody beat me to it, mind. Fresh scratches on the strongbox and a slate left inside with a woman's handwriting. K, it's signed. Same as the journal they're all after.\n\nNot telling Grey any of this.
note kettdive Kett's dive log | KETT - DIVE LOG, MARROW KEY\n\nDived the customs house for the second tablet. The tide tablet in the museum - Exhibit 7 - has a twin; the dynasty always cut them in pairs. The twin is not here. Someone took it out of the strongbox years ago, by the rust.\n\nWhat IS here: the old tide marks scratched into the doorframe, seven of them, each one higher. The house went under at the sixth.\n\nSo the sea is rising in steps, and the steps are not natural. Somewhere a machine counts tides.\n\nLeaving the journal with Vell; he will keep it safe and keep it boring. I go to the mesa. The Sunstaff shows the way, if the Syndicate do not find it first.\n\n- I.K.
prop safekeypad obj.name=safekeypad
prop safekeypad beh.use=Type the safe's code
prop safekeypad lock.code=9427
prop safekeypad on.use=sound||event:/exploring/obstacles/keypad/keypad_correct\nmessage||The keypad chirps and the safe's bolts slide back.\nsignal||safe
prop sunstaffcase obj.name=sunstaffcase
prop exhibit obj.name=exhibit

prop steps zone.id=museum_steps
prop steps zone.radius=5
prop steps zone.message=A banner over the museum's door. Under its gold letters, in red paint: SOMEONE GOT HERE FIRST.
prop ambushzone zone.id=ambush
prop ambushzone zone.radius=7
prop ambushzone zone.repeat=never
prop ambushzone obj.name=ambushzone
prop ambushzone beh.hidden=1
prop ambushzone zone.message=Lean tan dogs on the path - Syndicate hyenas, left to watch the door!
prop hyenas creature.count=3
prop hyenas creature.respawn=0
prop hyenas creature.zone=ambush
prop hyenas tint.color=#c8a46a
prop hyenas tint.amount=0.5

quest title=Someone Got Here First
quest intro=A museum on a coral key, its doors open. Make for the sandstone museum with the pillars and go up the steps.
step reach|museum_steps|1|Make for the sandstone museum and go up its steps
step read|Curator's report|1|Read the curator's report on his desk
step read|Exhibit 7 card|1|Read the Exhibit 7 card by the empty case
step reach|signalfoot|1|Find the path up Signal Hill, the hill with the curator's mast and lamp
step reach|signaltop|1|Climb Signal Hill to the curator's mast
step read|Curator Ambrose Vell's note|1|Read the curator's note on the hilltop
step collect|story:safekey|1|Climb the mast and take the safe's key from the signal box on top
step read|Syndicate orders|1|Find the Syndicate's grey launch pulled up on the beach and read their orders
step open|Curator's safe|1|Open the curator's safe (the card hides its code; the key is its second lock)
step collect|story:journal|1|Take Kett's field journal from the safe
step kill|Hyena|3|Deal with the Syndicate's hyenas outside
quest done=Kett's journal is yours. Its first page: a mesa with a sundial on top - and a call sign, 800 on the Receiver.
quest reward=Rope*4;Nail*10;Plank*6

save Marrow Key Museum
