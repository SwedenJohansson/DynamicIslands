place Zone_Trigger embryozone at 11 6 h=5

# --- Area C: the control room behind its keypad door, the three switches, the verdicts, the gifts, Hedda's call ------------
push at 3 27 h=4
call rt_storey a=vaultice f1=none
place RT_Floor vaultice at 0 4.5 y=3
place DoorMetal controldoor at -4.5 -4.5 y=0.05 sit yaw=0
place Note_Sign interlockplate at -1.5 -5.3 ground sit yaw=180
place UT_JumpPuzzle_LiftMechanism_Lever keeplever at -4.5 3.4 y=0.1 sit yaw=180
place UT_JumpPuzzle_LiftMechanism_Lever carrylever at -3 3.4 y=0.1 sit yaw=180
place UT_JumpPuzzle_LiftMechanism_Lever broadcastlever at -1.5 3.4 y=0.1 sit yaw=180
place Note_Sign switches at -3 2.4 y=0.1 sit yaw=180
place Note_Paper verdictkeep at -5.2 0 y=0.1 drop yaw=10
place Note_Paper verdictcarry at -5.2 0.8 y=0.1 drop yaw=40
place Note_Paper verdictbroadcast at -5.2 -0.8 y=0.1 drop yaw=70
place Loot_Chest keepchest at -0.9 1 y=0.1 sit yaw=270
place Loot_Chest broadcastchest at -0.9 -1 y=0.1 sit yaw=270
place RT_CommRadio - at -3 -2.4 y=0.1 sit yaw=0
place Note_Paper heddacall at -2.2 -2.4 y=0.1 drop yaw=0
# STORY 10-24: the Warden in his chair before KEEP, his desk with the ledger (the twist) and Sparks' confiscated card
place "Chair Office" wardenchair at -4.5 2.3 y=0.1 sit yaw=0
# (box agent 10-25: the desk went 0.3 m into the partition wall - moved 0.35 m off it)
place Balboa_DecorationPrefabBase_Desk wardendesk at -1.35 -2.8 y=0.1 sit yaw=90
place Note_Book wardenledger at -1.35 -3.2 y=1.4 drop yaw=80
place Note_Paper qslcard at -1.45 -2.3 y=1.4 drop yaw=110
pop
place Zone_Trigger controlzone at 0 27 h=5
call fz_hazard x=3 z=10 al=coldrun kind=cold r=13 dmg=1 msg="The vents blow freezing air through the vault - hurry."
prop vaultice tint.color=#dcebf5
prop vaultice tint.amount=0.6

# --- The flood door at the vault's north end, its lever ------------------------------------------------------------------
place DoorMetal flooddoor at 0 35 ground sit yaw=0 scale=1.6
place UT_JumpPuzzle_LiftMechanism_Lever floodlever at 2.6 34.4 ground sit yaw=180
place Zone_Trigger floodzone at 0 33 ground y=1

# --- The ice cap: ice rock round the vault floor on ice-tinted pillars, frost inside, snow on the slope ------------------
for ca 0 345 15
place SmallRock_02 ice at {25*sin($ca)} {10+25*cos($ca)} ground y=-2 scale=3 yaw=$ca
next
for pa 0 300 60
place RT_PillarThick icepillar at {21*sin($pa)} {10+21*cos($pa)} ground
next
call icetint al=ice
prop icepillar tint.color=#dcebf5
prop icepillar tint.amount=0.7
place Zone_Atmosphere frost at 0 10 h=7
prop frost atmo.particles=snow
prop frost atmo.fog=#e4eef6
prop frost atmo.fogAmount=0.4
prop frost atmo.light=#cfe4f2
prop frost atmo.lightAmount=0.4
prop frost zone.radius=26
call snowfall x=0 z=-40 r=22 al=snow

# --- The sea ---------------------------------------------------------------------------------------------------------
scatter VP_CoralDigitate01 4 at -50 -51.33 r=4 seed=12921 wet free=1
scatter VP_CoralBulb04 3 at -50 -51.33 r=4 seed=12922 wet free=1
scatter SeaVine3_klump 3 at 50 -51.33 r=5 seed=12923 wet free=1
call shallows x=0 z=22 r=100 deep=6 n=1 seed=12930
pop

# --- DISCOVERIES 10-24 (optional, no quest needs them): camp + note; BoatStranded + chest; hatch with a chest; buried treasure; viewpoint ---
place campfire_1 - at -39.4 21.8 ground sit
place Balboa_DecorationPrefabBase_SimpleTent - at -36.4 23.8 ground sit yaw=337
place "Box Small" - at -41.4 24.3 ground sit
place Note_Paper dnote at -41.4 24.3 ground y=1.6 drop yaw=20
note dnote Survey note | ICE SURVEY, SHEET 4 (and on the back, a sealer's scrawl)\n\nPressure ridge moving 2 m a day. Crack under the tent this morning. Moved camp.\n\nHalvorsen here, borrowing the surveyors' paper because ours went in the sea. We came up the ice to trade seal oil for seed and found the vault's door shut and nobody answering. Ivo from the relay is with us, listening to his little set every night with his eyes closed, like a man in church. He says the stack never fell on its own. He heard sledge bells the night the mast bent, and there was no wind.\nWe are going back to the steam harbour. The sea under the ice is warmer than it should be.
place BoatStranded dvan at 39.4 -21.8 ground yaw=97
prop dvan tint.color=#5a6670
prop dvan tint.amount=0.5
place Loot_ChestSmall dwreckchest at 35.4 -18.8 ground sit yaw=37
note dwreckchest Driver's box | The driver's box under the seat: bolts, glass, a scrap of leather.
loot dwreckchest Bolt*2;Glass*2;Leather*2
prop dwreckchest loot.refill=0
call hatchcache x=21.8 z=39.4 r=15 seed=12991 alias=dhatch chest=dhatchchest items=MetalIngot*2;Wool*3;Bolt*2
call vinecache x=39.4 z=-21.8 r=15 seed=12993 chest=dvinechest vines=dvines items=Rope*3;Wool*2;Bolt*3
call treasure x=-38.6 z=-23.2 r=15 n=1 seed=12992
prop treasure12992 treasure.loot=TitaniumOre*2;MetalOre*2
place Zone_Trigger dview at -4 20.6 ground
prop dview zone.id=coldhold_vault_view
prop dview zone.radius=7
prop dview zone.repeat=never
prop dview zone.message=The Coldhold's entrance hall looks out over the landing, the glacier pressing down behind it.

# --- DEEP 10-24 (one-hour pass): the ice cap's vent shaft (the big climb, on foot: story pass 10-24 swapped the tower for a cairn, R9), the vent keeper's cave, the flooded crevasse
# (dive, -16 m), the ridges. The flood door's lever now also wants the interlock from the chest at the vent shaft's head.
include lib_areas
call fz_mount x=-42 z=55 h=34 r=8
call ar_plants_snowy x=-42 z=55 r=30 seed=12961
call fz_cairn x=-42 z=55 al=ventcairn chest=ventchest zal=ventzone zid=vent_top msg="The vent shaft's head on the ice cap: a cairn over a grille, warm air breathing out of it - the vault, far below, breathing."
place RT_PillarThick ventshaft at -43.4 56.8 ground y=-0.7 sy=0.25 sx=1.2 sz=1.2
prop ventshaft tint.color=#4a4038
prop ventshaft tint.amount=0.4
call fz_zone x=-30 z=34 al=capfootzone id=cap_foot r=6 msg="The foot of the ice cap. On its top, 34 m up, a cairn marks the vault's vent shaft."
# the vent keeper's cave (its mouth north-east, to the cap)
call ar_cave x=-64 z=28 h=12 yaw=0 al=ventcave chest=ventcavechest
place Note_Paper ventnote at -63.2 33.4 h=12.5 drop yaw=200
# the flooded crevasse (east): an old survey boat 16 m down, its strongbox, an air pocket
call fz_dive x=56 z=22 d=16 r=12 yaw=0 obj=BoatStranded al=crevboat chest=crevchest aid=crevair aal=crevairz abub=crevairb cx=6 cz=2 ax=-6 az=-3
call fz_zone x=44 z=12 al=crevzone id=flooded_crevasse r=6 msg="The crevasse has flooded to the brim. Deep down, green in the ice light, a boat."
call ar_ridge x1=20 z1=60 x2=55 z2=48 h=13 top=8 r=8
call ar_plants_snowy x=38 z=54 r=24 seed=12964
call ar_ridge x1=-75 z1=-10 x2=-55 z2=-40 h=10 top=6 r=7
call treasure x=30 z=70 r=12 n=1 seed=12971
call treasure x=-70 z=0 r=10 n=1 seed=12972
place Creature_PolarBear capbear at -30 50 ground
prop capbear creature.count=1
prop capbear creature.respawn=0

# --- Settings, story items, notes, behaviours, quest ----------------------------------------------------------------------
# the generator's rocks that floated over the slope (ground check, 2026-10-23)
clear at -26.8 -21.26 r=1.5 only=TP_BigRock
clear at -22.4 -32.87 r=1.5 only=TP_BigRock

info title=The Coldhold Vault
info author=Custom Islands
info description=A seed bank under the glacier: an entrance hall, a crevasse crossed by an electric zipline, three wings of seeds, records and embryos under an ice cap - and a control room with three switches: KEEP, CARRY, BROADCAST. The ninth island of The Frozen Horizon.
island on.arrive=message||A door in the glacier, frost on its frame. Above it, cut small and neat: a ring, a wave through it.

story power|The vault's power|Placeable_Lantern_Metal|The Coldhold's generator, running again.
story odakey|Oda's cage key|Placeable_Lantern_Metal|The key to the cage on the far side, from the keeper's hooks.
story canister|Seed canister|Placeable_Lantern_Metal|One of the seed wing's sealed canisters.
story cooling|The cooling, restarted|Placeable_Lantern_Metal|The embryo wing's cooling, cranked back to life.
story controlcode|The control room's code|Placeable_Lantern_Metal|You ran the three terminals - snowflake, leaf, drop - and the control room's door opened.
story choice|The Coldhold's choice|Placeable_Lantern_Metal|One of the three switches, pulled. The vault's way is chosen.
story flooddoor|The flood door, open|Placeable_Lantern_Metal|The flood door is open. Below it, the Seed Ark.

note charter Coldhold charter | THE COLDHOLD - CHARTER\n\nWhat grew before the water is kept here: seeds, records, the beginnings of animals.\nThe vault keeps them for the day the world is green again. Until that day, it keeps itself.\nThe power is on the lever by the generator. The far side is over the crevasse; the line is electric.
note keepershooks Keeper's hooks | The keepers' hooks: a ring of keys, one tagged cage, far side.
note odanotes Oda's notes | (Oda Fenn's notebook, from Verdance)\n\nI came alone. Somebody had to see where the seeds went, and the gardeners at home argued so long about who should go that I simply went.\nThe door came down behind me when the ice moved. I put myself in the keepers' cage, the only thing in here still standing straight, and wrote by the light of the screechers' eyes. They are not friendly eyes.\nThe vault went silent on purpose. Nobody here was starving and nobody was sick: they chose to stop talking. There is an old man in the control room who has not answered me in four days.\nThe records will say why. Read them before you touch anything.\n\n- O. F.
note odapack Oda's pack | Oda's pack: rations, her seed tin, and rope she won't need now.
note canister1 Seed canister crate | A sealed crate: one seed canister, labelled in a neat hand.
note canister2 Seed canister crate | A sealed crate: one seed canister, frost on its lid.
note canister3 Seed canister crate | A sealed crate: one seed canister, its seal unbroken.
note foundersrecord Founders' record | THE FOUNDERS' RECORD\n\nWe cut the vault under the glacier the year the water came, with picks and with a great deal of arguing.\nWe set the Ringwave over the door - the old sign, the one on the sea doors and the glacier wall. We did not invent it. We found it wherever the old world had left a door, and we only knew it meant: keep.\nWe kept barley and rye, apple pips and the pine. We kept the names of everyone who carried a crate in, so that someone would remember them. We kept a radio too, because a seed nobody hears about is only a stone.\nOne day the world will be green again. When it is, tell them we are here.\n\n- the founders, year one
note commsoff Why the comms went off | (the Warden's memo, typed, a copy for every station)\n\nTO SAGA DRIFT, THE STEAM HARBOUR, THE SEALERS, THE RELAY, THE IRON WHALE.\nFrom tonight every set is cold. No weather, no music, no post on the air.\nThere is a signal from the south: a slow pulse, once a minute, older than this vault. I have listened to it for thirty winters. When a town talks, the pulse changes. It is looking for us, and it finds whoever answers.\nThe founders kept a radio so the world would hear of us. The founders were wrong. A seed that nobody hears of is a seed that survives.\nThe courier carries this order. Obey it, and he will carry your post as before.\n\n- A. Holt, Warden of the Coldhold
note keepersentry Keeper's last entry | THE WARDEN'S LOG - LAST ENTRY\n\nThe cooling is failing. I have cranked it by hand for a week, and my hands are finished. The others left in the autumn. Oda Fenn shouts at me from her cage; she is right, and I cannot answer her.\nI am going to the control room to hold KEEP down until the cold takes care of me. Tape will hold it after.\nIf you are reading this, you are past my door, and the choice is yours now - which I never wanted anyone to have. The drop terminal answers to 2240, the day the water came by the founders' count. The other two are on the wings' boards; the founders never could keep a secret.\nKeep it. Please. Do not let the south hear us.\n\n- A. Holt, Warden
note switches Three switches | THREE SWITCHES\n\nKEEP - seal the vault, power on. It waits for a better day.\nCARRY - open the seed store to the sea. Take what grows.\nBROADCAST - send the records on every band. Let the world know.\n\nOne only.\n\n(pencilled underneath, in the Warden's hand, words he heard on the air and could not stop hearing: Choose for the ones still talking. - the Whale, H. B.)
note verdictkeep The verdict | THE VERDICT - KEEP\n\nThe vault seals. The lights stay on. The seeds wait, and so do the records - for a better day, or for the south.\nThe vault gives you metal for the road.
note verdictcarry The verdict | THE VERDICT - CARRY\n\nThe seed store opens to the sea. A crate of every seed waits at the entrance hall.\nWhat grows now is up to the ones who plant it.
note verdictbroadcast The verdict | THE VERDICT - BROADCAST\n\nEvery band at once: the founders' record, the seed lists, the keepers' names. The silence is over.\nThe vault gives you copper for the radios.
note heddacall Hedda's radio call | (the radio crackles on - the Whale's band)\n\n\"This is Hedda Brask, Iron Whale. I heard the vault wake.\nListen. The glacier shifted when the power came on, and the lowest level is flooding - the old Seed Ark, on 400. If anyone went down there before you, he went down to dead pumps. Open the flood door, take air, and go after him.\nI am not coming. I have the Whale's launch fuelled and pointed south. That pulse the Warden was so afraid of - once a minute, for thirty years - somebody has to go and knock on its door. I would rather knock than hide.\nChoose for the ones still talking, I told him once, on the hand key. I am still talking. Out.\"
note keepchest The vault's gift | The vault's gift for KEEP: metal for the road.
note carrychest The vault's gift | The vault's gift for CARRY: every seed the vault kept.
note broadcastchest The vault's gift | The vault's gift for BROADCAST: copper for the radios.
note wardenledger The Warden's ledger | THE WARDEN'S LEDGER - STATIONS SILENCED\n\nSaga Drift: the council agreed, day 4. One exception, the radio ham Hallen: banished on a raft with his llama.\nSteamvent: agreed, day 6.\nThe sealers: their set taken for repair, day 11. Vale.\nSignalstack: the operator refused. Day 19, the stack's guys loosened in the night. Vale. The ice will get the blame.\nThe Iron Whale: still talking, a woman on a hand key, never long enough to fix. Day 31, the line, cut with his own hatchet - the dog-head one. Vale.\nPaid: one berth in the Coldhold, for O. Vale and two dogs.\nHe has not come to claim it. Yesterday he asked me where the ark's pumps are, and I told him. Let him go down with his conscience. The silence holds.\n\n- A. H.
note qslcard Sparks' QSL card | (a postcard with a llama drawn on it, CONFISCATED stamped across it in red)\n\nQSL - CONFIRMING OUR CONTACT\nTo: the Warden, Coldhold. From: Tor Hallen, Good Morning, Ice!, Saga Drift.\nDate: the day you told everyone to be quiet. Band: all of them. Signal: loud and clear, sadly for you.\nYou came in on my set at seven sharp, reading the Silence Order like a weather report. I logged you as Caller 58. Caller 57 was a penguin; it was better company.\nThank you for listening. Everyone else seems to have stopped. Bramble sends her regards and a small bite.\n73s, Sparks\n\n(on the back, in the Warden's hand: Hallen - banished. One raft, one llama. Let the sea keep him quiet.)
loot keepershooks story:odakey*1;Rope*2
prop keepershooks loot.refill=0
loot odapack Raw_GenericMeat*2;Seed_Strawberry*2;Rope*3
prop odapack loot.refill=0
loot canister1 story:canister*1;Seed_Birch*1
prop canister1 loot.refill=0
loot canister2 story:canister*1;Seed_Grass*1
prop canister2 loot.refill=0
loot canister3 story:canister*1;Seed_Palm*1
prop canister3 loot.refill=0
