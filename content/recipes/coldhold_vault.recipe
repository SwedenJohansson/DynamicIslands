prop odacage survivor.id=frozen_oda
prop odacage survivor.key=odakey
prop odacage survivor.signal=odafree
prop odacage survivor.line=You! From Verdance - you came all this way too? Thank you. My notes are on the floor; read them. Then the records.
prop odapack obj.name=odapack
prop odapack if.open=signal|odafree
prop odapack else.open=message||Oda's pack is in the cage with her. Free her first - the keepers' hooks by the door have the key.
