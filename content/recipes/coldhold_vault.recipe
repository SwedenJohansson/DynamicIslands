# The Coldhold Vault - the ninth island of the library's plan The Frozen Horizon (storyline SL12, finale part 1)
# A seed bank under the glacier: the entrance hall on a terrace above the landing (the charter, the generator's lever,
# a Raft store outside), a crevasse across the island crossed by an electric zipline, and on the far side the vault
# floor ringed by an ice cap on pillars: Oda Fenn (from Verdance) caged behind a collapsed door, the three wings
# (Seeds, Records, Embryos), the control room behind its keypad door with three switches - KEEP, CARRY, BROADCAST - and
# at the vault's north end the flood door down to the Ark. Quest "Beneath the Glacier" (29 steps; DEEP 10-24: the three-terminal run, the vent shaft, the interlock; story pass 10-24: the Warden's ledger): the entrance, the
# charter, the power, the zipline to the far side, Oda's pack, Oda's notes, three screechers; the seed wing and its
# three canisters, the record wing and its two papers, the embryo wing's cooling crank and the keeper's last entry, the
# control room's code; the control room, the three switches, one pulled, the verdict, the vault's gift, Hedda's radio
# call, the flood door and its lever (signal "flooddoor": the Seed Ark).
#
# Built by the recipe player (CIRecipe coldhold_vault) through the editor's own operations. Points (metres over the
# sea): the landing slope from 0 -52 up to the terrace at 4 m (r 10 round 0 -27); the entrance hall x -3..3,
# z -28.5..-19.5; the crevasse along z -15 (water at its floor); the zipline from the terrace's edge at 0 -18.5 to
# 0 -6; the vault floor at 4 m (r 24 round 0 10); the seed wing x -14..-8, z 1.5..10.5; the record wing x -3..3,
# z 9.5..18.5; the embryo wing x 8..14, z 1.5..10.5; the control room x -3..3, z 22.5..31.5; the flood door at 0 35.
# (Adapted: the ice cap is a ring of ice rock on ice-tinted pillars round the vault floor, and the wings are roofed
# radio tower rooms tinted ice-white - Raft has no pieces for a closed ice roof that size.)
include lib_sea
include lib_rt
include lib_features
include lib_frozen
# RESIZE 10-24: Radius 60 -> 100 (Height 12 -> 12), the old content moved 0 -22 as one frame (push) so its sea side stays at the coast; the island grows behind it.
new
gen Trees=0 Bushes=0.05 Rocks=0.3 Harvest=0.05 BeachThings=0.15
gen Seed=12901 Radius=100 Height=12 Roughness=0.4 Peaks=2 Shape=0 Style=1 BeachWidth=0.25 Cliffs=0.6 PeakShape=0.5
gen Water=0.5 SeaRocks=0.3 SeaFinds=0.3 Sunken=0.2 Hostiles=0 Friendly=0 SeaLife=0.3
generate
push at 0 -22

# --- Terrain: the landing slope, the terrace, the crevasse, the vault floor -----------------------------------------------
brush flatten from 0 -54 to 0 -44 r=3 s=20 frames=80 h=1
brush flatten from 0 -44 to 0 -36 r=3 s=20 frames=80 h=2.5
brush flatten at 0 -27 r=10 s=20 frames=300 h=4
brush flatten at 0 10 r=24 s=20 frames=400 h=4
brush flatten from -30 -15 to 30 -15 r=3.5 s=20 frames=300 h=-5
# RESIZE 10-24 retest: the terrace's edge over the crevasse fell away on the bigger island - built up again under
# the hall's north side and the zipline's start
brush flatten from -5 -20.5 to 5 -20.5 r=2 s=20 frames=200 h=4
# (and under four of the ice cap's rocks at the vault's north end, where the new ground falls away)
brush flatten at 12.5 31.65 r=3.5 s=20 frames=200 h=4
brush flatten at -21.65 22.5 r=3.5 s=20 frames=200 h=4
brush flatten at -12.5 31.65 r=3.5 s=20 frames=200 h=4
brush flatten at -17.68 27.68 r=3.5 s=20 frames=200 h=4
brush flatten at -6.47 34.15 r=3.5 s=20 frames=200 h=4
pop
brush flatten at -39.4 21.8 r=5 s=8 frames=40
origin
clear at -39.4 21.8 r=6
push at 0 -22
clear from 0 -54 to 0 -36 r=3
clear at 0 -27 r=10
clear at 0 10 r=24
clear from -30 -15 to 30 -15 r=4

# --- Area A: the entrance hall (the charter, the generator, the keeper's hooks), the store outside ---------------------
push at 3 -24 h=4
call rt_storey a=vaultice f1=RT_WallDoor1 b1=none
place RT_Floor vaultice at 0 4.5 y=3
place UT_Generator01 - at -3 1.1 y=0.1 sit yaw=90
place UT_JumpPuzzle_LiftMechanism_Lever powerlever at -5.6 0.6 y=0.1 sit yaw=90
place Placeable_Table_Basic - at -1.5 -2 y=0.1 sit yaw=90
place Note_Book charter at -1.5 -2 y=1 drop yaw=20
place Loot_Chest keepershooks at -0.9 2.5 y=0.1 sit yaw=270
place Loot_ChestLarge carrychest at -3 3.6 y=0.1 sit yaw=180
pop
place Zone_Trigger entrancezone at 0 -31 ground y=1
store vaultshop at -8 -26 ground
place ZiplinePath_Landmark vaultzip at 5.72 -20.27 h=5.35
# (RESIZE 10-24 retest: the start's floor at the hall's door, level with the hall, on a post down into the crevasse's lip)
place ReefHuts_Pillar3 - at 0 -19.3 h=-0.9
zipto vaultzip 0 -6
call treasure x=14 z=-36 r=15 n=1 seed=12053

# --- The far side: Oda's cage behind the collapsed door, her pack and notes; screechers under the cap --------------------
place Zone_Trigger farzone at 0 -7 ground y=1
place Survivor_Cage odacage at 9 -6 ground sit yaw=200
place DoorMetal - at 11.5 -4.5 ground sit rot=0,30,80
call icerock x=12 z=-7 s=1.6 yaw=40
call icerock x=7 z=-8.5 s=1.2 yaw=200
place Loot_Chest odapack at 7.2 -4.6 ground sit yaw=160
place Note_Paper odanotes at 8.4 -3.8 ground y=0.1 drop yaw=30
place Creature_StoneBird screechers at 0 4 h=14

# --- Area B: the seed wing (three canister crates among the shelves) ---------------------------------------------------
push at -8 6 h=4
call rt_storey a=vaultice r2=RT_WallDoor1
place RT_Floor vaultice at 0 4.5 y=3
place Shelf_Empty_02 - at -3 3.9 y=0.1 sit yaw=180
place Shelf_Empty_02 - at -5.4 0 y=0.1 sit yaw=90
place Loot_Chest canister1 at -1.2 3.6 y=0.1 sit yaw=180
place Loot_Chest canister2 at -5.2 2.8 y=0.1 sit yaw=90
place Loot_Chest canister3 at -4.8 -3.6 y=0.1 sit yaw=0
place RT_Pillar - at -3 -1.2 y=0 sy=0.4
place RT_PowerBox term1 at -3 -1.2 y=1.25 yaw=180
place Note_Sign seedboard at -2.6 -4.1 y=0.1 sit yaw=0
pop
place Zone_Trigger seedzone at -11 6 h=5
# --- the record wing: the founders' record, why the comms went off --------------------------------------------------
push at 3 14 h=4
call rt_storey a=vaultice f1=RT_WallDoor1
place RT_Floor vaultice at 0 4.5 y=3
place "VG_DecorationPrefabBase_Bookshelf Filled 1 Variant" - at -4.5 3.6 y=0.1 sit yaw=180
place "VG_DecorationPrefabBase_Bookshelf Filled 2 Variant" - at -1.5 3.6 y=0.1 sit yaw=180
place TP_CabinetCharts01 - at -0.5 0 y=0.1 sit yaw=270
place Note_Book foundersrecord at -5.2 0 y=0.1 drop yaw=90
place Note_Paper commsoff at -0.6 -2.6 y=0.1 drop yaw=200
# REDO 10-24 (optional): the flotilla council's box - Saga Drift's founding year (1909) on its keypad
place Loot_Chest councilbox at -4.8 -3.2 y=0.1 sit yaw=90
place RT_PowerBox councilpad at -5.95 -1.8 y=1.2 yaw=90
place RT_Pillar - at -3 1.4 y=0 sy=0.4
place RT_PowerBox term2 at -3 1.4 y=1.25 yaw=0
place Note_Sign recordboard at -3 3.9 y=0.1 sit yaw=180
pop
