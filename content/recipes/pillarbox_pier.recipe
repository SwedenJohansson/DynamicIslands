# Pillarbox Pier - an island of the library's plan The Last Post (the Coastal Post's route, the second stop)
# A low sandy island with palms, and from its south shore a ferry pier of plank plates on posts running ninety metres out
# to sea, lined with red pillar boxes (Temperance's ice pillars, shrunk and tinted post-box red, a tin cap of Raft's
# lamp on each), a ferry waiting room on posts at its head; at the land end the pier master's cottage and the sorting
# shed. Quest "The Ferry Master's Wife" (17 steps): the pier head, the ferry timetable, the dead letter posted in pillar
# box 7 (the Ferry Master's reply shows), the reply, the waiting room locker (the motor wheel's and the steering wheel's
# blueprints), the sorting shed (done-when zone:sorting).
#
# Built by the recipe player (CIRecipe pillarbox_pier) through the editor's own operations.
include lib_sea
include lib_features
include lib_post
include lib_areas
include lib_highwater
include lib_lastpost
# RESIZE 10-26 (the user: Raft-big, one-hour islands): Radius 46 -> 85; the old island moved 39 m south (push frames), so its south shore stays on the coast and the new land is north
# POST 10-26: the new land - Ferry Hill with ferry signal mast, Tide Cave, Nils at the ruined house (a lamp puzzle), a crashed plane, a jump course, a set of five ferry tickets
new
# (nature: a low sand island with palms, Like Raft's tropical islets)
gen Trees=0.22 Bushes=0.3 Rocks=0.15 Harvest=0.25 BeachThings=0.4
gen Seed=4201 Radius=85 Height=5 Roughness=0.3 Peaks=1 Shape=0 Style=0 PeakShape=0.6 Cliffs=0 BeachWidth=0.7
gen Water=0.6 SeaRocks=0.25 SeaFinds=0.15 Sunken=0.15 Hostiles=0 Friendly=0 SeaLife=0.4
generate
push at 0 -39

# --- Terrain: the pier's root on the south shore at 1.4 m, a yard for the cottage and the sorting shed ----------------
brush flatten from 0 -16 to 0 -34 r=5 s=20 frames=100 h=1.4
brush flatten at 9 -14 r=7 s=20 frames=80 h=2.2
brush flatten at -11 -16 r=7 s=20 frames=80 h=2.2
brush smooth from -16 -14 to 16 -14 r=6 s=6 frames=20
brush sand from 0 -18 to 0 -36 r=5 s=8 frames=20
pop
origin
# --- POST 10-26 terrain: Ferry Hill, the pads of the new areas ---------------------------------------------------
call hw_mount x=40 z=44 b=24 h=20
call hw_trail x=40 z=44 b=24 h=20 a0=-124.99 turn=300 n=40 h0=3
brush flatten at 0 16 r=4 s=8 frames=60
clear at 0 16 r=7
call ar_ridge x1=-36 z1=-66 x2=-56 z2=-50 h=9 top=4 r=9
# (RESIZE 10-26: the old island, 39 m south)
push at 0 -39
clear from 0 -14 to 0 -40 r=4
clear at 9 -14 r=7
clear at -11 -16 r=7

# --- The pier: two plates wide from the shore out to sea, ninety metres -----------------------------------------------
call pier x=0 z1=-30 z2=-122 h=1.45
# the ferry waiting room at the pier head: a wider deck, a roof on posts, benches, the timetable, the locker
push at -2.25 -127.25 h=1.4
call openhall w=3 d=3
place Bench_01 - at 0.8 2.25 y=1.3 sit drop yaw=90
place Bench_01 - at 3.7 2.25 y=1.3 sit drop yaw=270
place Note_Paper timetable at 2.25 4.2 y=2 sit drop yaw=0
place Placeable_Cupboard_Small - at 2.25 4.2 y=1.3 sit drop yaw=180
place Loot_ChestSmall locker at 3.8 0.6 y=1.3 sit drop yaw=0
place Zone_Trigger headzone at 2.25 2.25 y=0.8
pop
# the pillar boxes along the pier, alternate sides, every ten metres: number 7 takes the Ferry Master's letter
macro pillarbox al=pbox x=0 z=0 yaw=0
place TP_IcePillar04_Snow $al at $x $z h=3 sit drop yaw=$yaw scale=0.42
place Lamp - at $x $z h=4.5 sit drop yaw=$yaw scale=0.9
end
call pillarbox al=pbox1 x=1.25 z=-44 yaw=90
call pillarbox al=pbox2 x=-1.25 z=-54 yaw=-90
call pillarbox al=pbox3 x=1.25 z=-64 yaw=90
call pillarbox al=pbox4 x=-1.25 z=-74 yaw=-90
call pillarbox al=pbox5 x=1.25 z=-84 yaw=90
call pillarbox al=pbox6 x=-1.25 z=-94 yaw=-90
call pillarbox al=pbox7 x=1.25 z=-104 yaw=90
call pillarbox al=pbox8 x=-1.25 z=-114 yaw=-90
place Note_Paper ferryreply at 1.25 -103 h=3 sit drop yaw=90
place Placeable_Lantern_Metal - at -1.3 -84 h=3 sit drop
place Placeable_Lantern_Metal - at 1.3 -122 h=3 sit drop

# --- The pier master's cottage at the land end (door to the south) ---------------------------------------------------
push at 5.25 -16.25 h=2.2
call posthall w=3 d=3 al=cottage
place "Table Office" - at 2.25 3.2 y=1.3 sit drop yaw=0
place "Chair Office" - at 2.25 2.3 y=1.3 sit drop yaw=0
place Placeable_Shelf_Small_Basic - at 0.9 1.6 y=1.3 sit drop yaw=90
place Placeable_Cupboard_Small - at 3.9 1 y=1.3 sit drop yaw=270
place Note_Paper masterlog at 2.6 3.2 y=2 sit drop yaw=-5
pop

# --- The sorting shed: an open hall on posts, sorting tables and mail sacks ------------------------------------------
push at -14 -19.25 h=2.2
call openhall w=4 d=2
place "Table Office" - at 3 1.5 y=1.3 sit drop yaw=0
place "Box Big" - at 1.1 0.9 y=1.3 sit drop yaw=10
place "Box Small" - at 5 1.2 y=1.3 sit drop yaw=-20
call mailsack x=4.6 z=2.3 yaw=40 al=sacks
call mailsack x=1.3 z=2.4 yaw=-70 al=sacks
place Zone_Trigger sortingzone at 3 1.5 y=0.8
pop

# --- Nature: things to gather, a turtle and dolphins, the reefs either side of the pier ------------------------------
scatter "Pickup_Landmark_Tree_Mango" 2 at 0 10 r=28 seed=4211 free=4
scatter "Pickup_Landmark_PineappleLandmark" 2 at 0 6 r=28 seed=4212 free=3
call dirt x=4 z=12 r=12 n=3 seed=4213
call hives x=-6 z=10 r=14 n=1 seed=4214
place Creature_Dolphin dolphins at 30 -80 h=-3
prop dolphins creature.count=2
call shallows r=64 deep=5 n=2

pop

# --- POST 10-26 (the user: one hour per island - hills, cliffs, a cave, a house, a wreck, secrets): Ferry Hill ------
# Ferry Hill with ferry signal mast on it, Tide Cave, the ruined house where Nils waits (four lamps round it: a puzzle), a crashed plane,
# a jump course, five ferry tickets about the island (a set), and at the hub the ferry bell that wants the bell clapper and the bell rope
call hw_zone x=19.52 z=29.66 al=qp_trailz id=qp_trail r=5 msg="The trail up Ferry Hill starts here - round and up."
call hw_zone x=40 z=44 al=qp_summitz id=qp_summit r=8 h=1 msg="The top of Ferry Hill. The whole island below you."
call hw_mast x=37 z=46 h0=20 lv=5 a=qp_mast chest=qp_topchest top=Placeable_Flag_01
place ZiplinePath_Landmark qp_zip at 43.2 41.4 h=21.35
zipto qp_zip 7.92 19.44
place Creature_Goat qp_goats at 23.52 32.66 ground
prop qp_goats creature.count=2
call ar_cave x=-48 z=48 h=3 yaw=180 al=qp_caverock chest=qp_cavechest
call hw_zone x=-47 z=39 al=qp_cavez id=qp_cave r=4 h=1 msg="Tide Cave. Water drips somewhere in the dark."
call ar_ruin x=-60 z=-16 h=3 yaw=0 w=3 d=2 al=qp_ruin
call lp_islander x=-61 z=-20.5 yaw=200 al=qp_isl nm="Nils" pose=sit
prop qp_isl talk.text=You came in on a raft? There's been no ferry since the Post shut.\n---\nI rang the ferry bell. Three rings, and the Ferry Master came round the point. Then one evening he didn't. His wife rang it every night after.\n---\nThe clapper's up the signal mast on Ferry Hill and the rope's in Tide Cave - I put them there myself, I couldn't stand the ringing. Ring it again, if you like. Somebody should.\n---\nMy lamps: four round the house, and each one you turn wakes its neighbour. All four lit, and look behind the back wall.
place Placeable_Chair_Basic - at -61 -20.5 ground sit yaw=200
call lp_lamp x=-67 z=-17 al=qp_lamp1 nm="Ferry lamp 1" grp="Ferry lamps" on=0
call lp_lamp x=-61 z=-10 al=qp_lamp2 nm="Ferry lamp 2" grp="Ferry lamps" on=0
call lp_lamp x=-54 z=-17 al=qp_lamp3 nm="Ferry lamp 3" grp="Ferry lamps" on=0
call lp_lamp x=-61 z=-24 al=qp_lamp4 nm="Ferry lamp 4" grp="Ferry lamps" on=0
prop qp_lamp1 on.use=light|Ferry lamp 2|toggle
prop qp_lamp2 on.use=light|Ferry lamp 3|toggle
prop qp_lamp3 on.use=light|Ferry lamp 4|toggle
prop qp_lamp4 on.use=light|Ferry lamp 1|toggle
prop qp_lamp1 on.alllit=show|qp_lampchest\nmessage||All four lamps burn. Behind the back wall a stone has been lifted.
call lp_hidden x=-59 z=-11.4 al=qp_lampchest
place Creature_Chicken qp_hens at -52 -10 ground
prop qp_hens creature.count=3
call ar_plane x=60 z=-24 h=3 yaw=220 al=qp_plane crate=qp_planecrate
place Note_Paper qp_pilot at 61.78 -28.1 ground y=0.1 drop yaw=250
call hw_zone x=60 z=-24 al=qp_planez id=qp_plane r=6 h=1 msg="A plane, nose down in the grass. Nobody came for it."
# JUMP qp pad=3 at=-6 66
push at -6 66
clear at 0 0 r=17 all
brush flatten at 0 0 r=14 s=20 frames=300 h=3
brush smooth at 0 0 r=18 s=4 frames=40
brush flatten at 0 0 r=12 s=20 frames=300 h=3
brush auto at 0 0 r=18 s=10 frames=25
clear at 0 0 r=18
place Block_Foundation_Tier3 jpqp at 4.24 4.24 h=3.6
place Block_Foundation_Tier3 jpqp at 5.77 1.65 h=4.35
place Block_Foundation_Tier3 jpqp at 5.85 -1.35 h=5.1
place Block_Foundation_Tier3 jpqp at 4.46 -4.01 h=5.85
place Block_Foundation_Tier3 jpqp at 1.95 -5.67 h=6.6
place Block_Foundation_Tier3 jpqp at -1.04 -5.91 h=7.35
place Block_Foundation_Tier3 jpqp at -3.78 -4.66 h=8.1
place Block_Foundation_Tier3 jpqp at -5.56 -2.25 h=8.85
place Block_Foundation_Tier3 jpqp at -5.96 0.73 h=9.6
# JUMP from 10
place Block_Foundation_Tier3 jpqp at -4.85 3.53 h=10.35
place Block_Foundation_Tier3 jpqp at -2.54 5.44 h=11.1 sx=2 sz=2
# JUMP end
place Block_Foundation_Tier3 jppqp at 5.77 1.65 h=3.668 sy=1.861
place Block_Foundation_Tier3 jppqp at 5.85 -1.35 h=4.418 sy=2.959
place Block_Foundation_Tier3 jppqp at 4.46 -4.01 h=5.168 sy=4.058
place Block_Foundation_Tier3 jppqp at 1.95 -5.67 h=5.918 sy=5.157
place Block_Foundation_Tier3 jppqp at -1.04 -5.91 h=6.668 sy=6.255
place Block_Foundation_Tier3 jppqp at -3.78 -4.66 h=7.418 sy=7.354
place Block_Foundation_Tier3 jppqp at -5.56 -2.25 h=8.168 sy=8.453
place Block_Foundation_Tier3 jppqp at -5.96 0.73 h=8.918 sy=9.552
place Block_Foundation_Tier3 jppqp at -4.85 3.53 h=9.668 sy=10.650
place Block_Foundation_Tier3 jppqp at -2.54 5.44 h=10.418 sy=11.749 sx=2 sz=2
prop jpqp tint.color=#8a7f70
prop jpqp tint.amount=0.35
prop jppqp tint.color=#8a7f70
prop jppqp tint.amount=0.35
place Loot_Chest jcqp at -1.04 -5.91 h=7.35 sit yaw=0
prop jcqp loot.refill=0
place Loot_ChestSmall jbqp at -2.54 5.44 h=11.1 sit yaw=0
prop jbqp loot.refill=0
pop
call hw_zone x=-6 z=58 al=qp_jumpz id=qp_jumps r=6 h=1 msg="Stone stacks, one higher than the next. Something at the top."
call lp_piece x=26 z=24 al=qp_piece1 set="Ferry tickets"
call lp_piece x=52 z=-15 al=qp_piece2 set="Ferry tickets"
call lp_piece x=-54 z=22 al=qp_piece3 set="Ferry tickets"
call lp_piece x=-20 z=60 al=qp_piece4 set="Ferry tickets"
call lp_piece x=-46 z=0 al=qp_piece5 set="Ferry tickets"
prop qp_piece1 on.set=show|qp_setchest\nmessage||All five ferry tickets found.
call lp_hidden x=5 z=12 al=qp_setchest kind=Loot_Chest
call treasure x=24 z=74 r=10 n=1 seed=27278 kind=0
prop treasure27278 treasure.loot=CopperOre*2;MetalOre*2;TradeToken*1
call shallows x=0 z=0 r=95 deep=5 n=1 seed=27261
call ar_plants_hill x=-25 z=-5 r=14 seed=27291
call ar_plants_hill x=27 z=-5 r=14 seed=27292
call ar_plants_hill x=-69 z=15 r=14 seed=27293
call ar_plants_hill x=43 z=-53 r=14 seed=27294
call ar_plants_hill x=67 z=7 r=14 seed=27295
call ar_plants_hill x=-17 z=31 r=14 seed=27296
call hw_machine x=0 z=16 yaw=180 al=qp_machine nm="Ferry bell" obj=TP_LaserControlPanel_lever sc=3 a=qp_top b=qp_cave done=qp_fixed rew=qp_rewchest rnote=qp_rewnote msg="It works." hint="It wants the bell clapper from Ferry Hill and the bell rope from Tide Cave."
call hw_note x=-2.6 z=17.2 yaw=200 al=qp_hint

# --- Settings, notes, behaviours, quest --------------------------------------------------------------------------------
info title=Pillarbox Pier
info author=Custom Islands
info description=A low sandy island and its ferry pier, ninety metres of planks lined with red pillar boxes, a waiting room at its head. The ferry never came back - but the Ferry Master is still waiting for a letter. The second stop of The Last Post.
island on.arrive=message||A long pier runs out from a sandy island, red pillar boxes all along it like a row of buttons.

prop pbox1 tint.color=#b3221c
prop pbox1 tint.amount=0.85
prop pbox2 tint.color=#b3221c
prop pbox2 tint.amount=0.85
prop pbox3 tint.color=#b3221c
prop pbox3 tint.amount=0.85
prop pbox4 tint.color=#b3221c
prop pbox4 tint.amount=0.85
prop pbox5 tint.color=#b3221c
prop pbox5 tint.amount=0.85
prop pbox6 tint.color=#b3221c
prop pbox6 tint.amount=0.85
prop pbox7 tint.color=#b3221c
prop pbox7 tint.amount=0.85
prop pbox8 tint.color=#b3221c
prop pbox8 tint.amount=0.85
prop cottage tint.color=#d9cfb8
prop cottage tint.amount=0.5
prop sacks tint.color=#b8a478
prop sacks tint.amount=0.75

prop pbox7 obj.name=pbox7
prop pbox7 beh.use=Post the letter
prop pbox7 if.use=take|story:dl_ferry|1
prop pbox7 on.use=message||Delivered. The letter drops into box 7 - and a folded note slides out of the slot below.\ngive||story:ferrydelivered*1\nshow|ferryreply
prop pbox7 else.use=message||Pillar box 7. "FERRY MASTER - LETTERS ONLY". You have nothing addressed to him.
prop pbox3 obj.name=pbox3
prop pbox3 on.use=message||Pillar box 3 is stuffed full of seaweed.

note timetable Ferry timetable | COASTAL POST FERRY - PILLARBOX PIER\n\nDeparts 07:00, 12:00, 17:00 - weather allowing.\n\nUnder it, in pencil: "Last sailing cancelled. Ferry Master waits for post in box 7."
note ferryreply Ferry Master's reply | You found her letter. Thank you.\n\nMy wife wrote it the morning the water came - she was on the other side, at the sorting rock. She says she got a place on the last boat out and that I should not wait for the ferry.\n\nI waited anyway. Now I know.\n\nThe locker in the waiting room is yours - the ferry's spare wheel plans. Build something that goes where the ferry couldn't.\n\n- Jon, Ferry Master
prop ferryreply obj.name=ferryreply
prop ferryreply beh.hidden=1
note masterlog Pier master's log | Day 1: Ferry out at 07:00, never back.\nDay 3: Still no ferry. Moved the waiting room locker key to the locker itself - nobody here to steal it.\nDay 9: Post sorted in the shed. Nothing for me.\nDay 30: I keep checking box 7.
note locker Waiting room locker | The ferry's spare parts locker: the motor wheel's and the steering wheel's plans, rolled in oilcloth.
loot locker Blueprint_MotorWheel*1;Blueprint_SteeringWheel*1;Blueprint_HeadLight*1;Cooked_Potato*3;Cooked_Beet*2;Coconut*3
prop locker loot.refill=0

prop headzone zone.id=pier_head
prop headzone zone.radius=4
prop headzone zone.message=The pier head: a waiting room on posts, the sea all round, and no ferry.
prop sortingzone zone.id=sorting
prop sortingzone zone.radius=5
prop sortingzone zone.message=The sorting shed: tables, sacks and a chalkboard route - the next stop is the airstrip in the canopy.

story qp_top|Bell clapper|Bolt|The clapper of the ferry bell, hung up the signal mast so nobody could ring it.
story qp_cave|Bell rope|Bolt|The ferry bell's rope, coiled up in a chest at the back of Tide Cave.
story qp_fixed|Ferry bell working|Bolt|The ferry bell, working again.
note qp_hint Bell ringer's notice | FERRY BELL OUT OF USE. The clapper is up the ferry signal mast on Ferry Hill and the rope is in Tide Cave, in the rocks past Nils' house. No ferry comes in without the bell. Ask Nils at the old house on the shore.
note qp_topchest Ferry signal mast deck box | A box lashed to the deck rail at the top of the ferry signal mast.
loot qp_topchest story:qp_top*1;Rope*2;Scrap*2
note qp_cavechest Tide Cave chest | A chest at the back of Tide Cave, dry under the rock.
loot qp_cavechest story:qp_cave*1;Nail*6;Plank*3
note qp_rewnote Bell ringer's card | The bell rings out over the water, once, twice, three times - the ferry's call. Tied to the frame, the ringer's card: 'Three rings for the ferry. The Ferry Master's wife rang it every evening after he stopped coming.'
note qp_rewchest Ferry bell reward | What the ferry bell kept.
loot qp_rewchest MetalIngot*2;Bolt*3;Rope*2
note qp_lampchest Nils's tin | Nils's tin behind the house: ferry tickets he never used, and his tokens.
loot qp_lampchest TradeToken*2;CopperIngot*1;Rope*2
note qp_setchest Ticket box | The ferry's ticket box, every ticket back in it, and the takings.
loot qp_setchest TradeToken*3;Plank*4;MetalIngot*1
note qp_planecrate Seaplane's crate | A seaplane's cargo crate: parcels for the pier, canvas and a toolkit.
loot qp_planecrate Plastic*3;Scrap*3;Nail*6
prop qp_planecrate loot.refill=0
note qp_pilot Seaplane log | COASTAL POST SEAPLANE - the Pier run. Swell too high to land on the water, set her down on the dunes. Float gone. The pier master says the ferry has not come for a week.
note jcqp Bollard climb | The dock hands' climb of old mooring stones, a wager from the ferry days.
loot jcqp Rope*3;Plank*4;MetalIngot*1
note jbqp Top of the bollards | The wager's stake, still at the top.
loot jbqp CopperIngot*1;Bolt*2;TradeToken*1

quest title=The Ferry Master's Wife
quest intro=A ferry pier with a row of pillar boxes. Make for the ferry signal mast on the hill, then walk out to the head of the pier.
step reach|pier_head|1|Walk out to the head of the pier
step read|Ferry timetable|1|Read the ferry timetable in the waiting room
step collect|story:ferrydelivered|1|Post the Ferry Master's letter in pillar box 7
step read|Ferry Master's reply|1|Read the Ferry Master's reply
step open|Waiting room locker|1|Open the waiting room locker
step blueprint|Blueprint_MotorWheel|1|Take the motor wheel plans from the locker
step blueprint|Blueprint_SteeringWheel|1|Take the steering wheel plans from the locker
step blueprint|Blueprint_HeadLight|1|Take the head light plans from the locker
step read|Bell ringer's notice|1|Read the bell ringer's notice by the ferry bell
step talk|Nils|1|Talk to Nils at the ruined house on the shore
step reach|qp_trail|1|Find the foot of the trail up Ferry Hill, below the signal mast
step reach|qp_summit|1|Climb the trail to the top of Ferry Hill
step collect|story:qp_top|1|Climb the ferry signal mast and take the bell clapper from its deck
step reach|qp_cave|1|Find Tide Cave in the rocks, past Nils' ruined house
step collect|story:qp_cave|1|Take the bell rope from the chest at the back of the cave
step read|Bell ringer's card|1|Bring both to the ferry bell and read what it shows
step reach|sorting|1|Go to the sorting shed at the land end of the pier
quest done=One letter delivered. The sorting shed's chalkboard gives the next stop: Eskil's airstrip in the canopy.
quest reward=Cooked_Potato*3;Cooked_Beet*2;Plank*4

save Pillarbox Pier
