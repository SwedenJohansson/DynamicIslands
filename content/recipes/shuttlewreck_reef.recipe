# Shuttlewreck Reef - a side island of the library's plan The Sunken Kingdom (sunken 10 m; km 4, off the route)
# A Pelagic Network transit shuttle lying on a reef: a long cabin of windowed stone walls on a rock shelf, its nose in the
# coral, its cabin still an air pocket. A luggage rack inside, the manifest on the bulkhead, a commuter's note on a
# seat. Puffers in the reef (goo), silver algae, giant clams, a buoy on the surface over it. Quest "The Night Shuttle"
# (5 steps).
#
# Points (metres over the reef's zero; the surface at 10): the shelf at 2, r 7 round 0 0; the shuttle x -2.25..2.25,
# z -6..6 (floor at 2, roof at 4.85), its door in the south end; the buoy over -6 6.
include lib_sea
include lib_gravity
include lib_sunken
new
gen Trees=0 Bushes=0 Rocks=0.4 Harvest=0 BeachThings=0
gen Seed=11101 Radius=26 Height=5 Roughness=0.4 Peaks=2 Shape=0 Style=0 BeachWidth=0.1 Cliffs=0.3 PeakShape=0.4
gen Water=0.5 SeaRocks=0.5 SeaFinds=0.5 Sunken=0.4 Hostiles=0 Friendly=0 SeaLife=0.5
generate
elevation -10

brush flatten at 0 0 r=7 s=25 frames=260 h=2
brush sand at 0 -9 r=4 s=20 frames=20
origin
clear at 0 0 r=8

# --- The shuttle: a cabin 3 cells wide, 8 long, windows down both sides, a door at the south end -----------------------
push at -2.25 -6 h=2
for fx 0.75 3.75 1.5
for fz 0.75 11.25 1.5
place Block_Floor_Tier3 shuttle at $fx $fz y=0
place Block_Floor_Tier3 shuttle at $fx $fz y=2.635
next
next
for fz 0.75 11.25 1.5
place Block_Wall_Window_Tier3 shuttle at 0 $fz y=0 yaw=90
place Block_Wall_Window_Tier3 shuttle at 4.5 $fz y=0 yaw=90
next
place Block_Wall_Tier3 shuttle at 0.75 0 y=0
place Block_Wall_Door_Tier3 shuttle at 2.25 0 y=0
place Block_Wall_Tier3 shuttle at 3.75 0 y=0
place Block_Wall_Tier3 shuttle at 0.75 12 y=0
place Block_Wall_Window_Tier3 shuttle at 2.25 12 y=0
place Block_Wall_Tier3 shuttle at 3.75 12 y=0
place Placeable_Lantern_Metal - at 2.25 6 y=0 sit
place Placeable_Lantern_Metal - at 2.25 10.5 y=0 sit
place Note_Board manifest at 2.25 11.8 y=1.3 yaw=180
place Loot_Chest luggage at 0.5 7.5 y=0 sit yaw=90
place Note_Paper commuter at 3.6 3 y=0 drop yaw=40
pop
prop shuttle tint.color=#7a8a90
prop shuttle tint.amount=0.5
call airpocketat x=0 z=0 h=2 id=cabin al=cabinair bub=cabinbub r=3.5 msg="Air in the shuttle's cabin - stale, but air."
call ringwave x=0 z=6.3 h=4.35 yaw=0 s=1 al=shuttlewave
call buoychain x=-6 z=6 h=10 n=2 al=buoy zal=buoyzone id=surface_buoy

# --- The reef: puffers, coral, algae, clams ------------------------------------------------------------------------------
place Creature_PufferFish puffers at 7 -6 h=3
prop puffers creature.count=2
prop puffers creature.respawn=0
call coralwall x=5 z=8 n=4 yaw=30 seed=11102
call coralwall x=-7 z=-6 n=4 yaw=-40 seed=11103
scatter VP_CoralBulb04 6 at 8 -4 r=4 seed=11104 free=1
scatter TinyCoral 8 at 8 -4 r=4 seed=11105 free=1
scatter VP_CoralFoliose01 4 at -8 2 r=3 seed=11106 free=1
scatter Pickup_Landmark_SilverAlgae 5 at -4 -10 r=5 seed=11107 free=1
scatter Pickup_Landmark_GiantClam 3 at 6 10 r=4 seed=11108 free=1
scatter SeaVine3 5 at -10 -2 r=4 seed=11109 free=1
call shallows x=0 z=0 r=34 deep=4 n=1 seed=11110

# --- Settings, notes, quest --------------------------------------------------------------------------------------------
info title=Shuttlewreck Reef
info author=Custom Islands
info description=A Network transit shuttle on a reef 10 m down, its cabin still holding air - a luggage rack, a manifest and a commuter's note. A side island of The Sunken Kingdom.
island on.arrive=message||A buoy over a reef. Under it, the long shape of a shuttle with windows down its sides.

note manifest Shuttle manifest | NIGHT SHUTTLE 7 - THALASSA TO THE COMMONS\n\n14 passengers, 2 crew, 31 bags.\nDeparted 22:40. Arrived: - \n\nSomeone has written underneath: we went the long way round the reef. The doors were shut.
note commuter Commuter's note | Left on a seat:\n\nTo whoever finds the shuttle - we got out through the roof hatch and swam for the Yard. Twelve of us made it.\nThe luggage is yours. Some of it explodes, mind.
note luggage Luggage rack | Bags, still dry inside the rack.
loot luggage ExplosiveGoo*2;Seed_Grass*2;Leather*2
prop luggage loot.refill=0

quest title=The Night Shuttle
quest intro=A shuttle on the Receiver's side band, lost on the night run. Find its cabin.
step reach|cabin|1|Get into the shuttle's cabin
step read|Shuttle manifest|1|Read the shuttle manifest
step kill|Puffer fish|2|Drive off the puffers in the reef
step open|Luggage rack|1|Open the luggage rack
step read|Commuter's note|1|Read the commuter's note
quest done=Twelve made it to the Yard. The shuttle stays on its reef.
quest reward=CopperIngot*2;Battery*1

save Shuttlewreck Reef
