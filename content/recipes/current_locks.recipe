place UT_WaterChallengeWheel1 cl_wheel2 at -67.4 17.1 ground y=0.1 scale=0.4 yaw=80
prop cl_wheel2 obj.name=cl_wheel2
prop cl_wheel2 beh.use=Turn the sluice wheel
prop cl_wheel2 on.use=message||The wheel grinds round. Water gurgles somewhere down in the lock chamber (2 of 3).\nsignal||lw2
place UT_WaterChallengeWheel1 cl_wheel3 at -54.1 43.6 ground y=0.1 scale=0.4 yaw=120
prop cl_wheel3 obj.name=cl_wheel3
