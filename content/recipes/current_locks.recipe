call notebox x=9 z=32.67 yaw=200 al=inesnote
place Note_Paper keepercl at 10.5 31.4 ground drop yaw=60
push at -12 34.67 h=2
call hut w=2 d=2 y=0.1
place Loot_Chest kitchen at 2.2 2.4 y=0.1 sit yaw=180
