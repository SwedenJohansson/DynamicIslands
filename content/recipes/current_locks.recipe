# Current Locks - the sixth island of The End of the Ocean (SL14, the Concord Engine's canal)
# A long island cut through by a straight canal with three iron lock gates in it, a crank for each on the east bank. The
# engine's water ran through here once, lock by lock, south to the ring. The lock keeper's rules still hang on the first
# gate, anglers have the deep basin under it, a bear has the path to the third. In the keeper's kitchen at the north end
# a note from Ines: she has seen three rings before. Quest "Three Locks" (17 steps): lock 1, the rules, the lock house's
# wind turbine plans, crank 1, the anglers in the basin, the advanced battery plans, crank 2, the bear, the headlight
# plans, crank 3, the keeper's kitchen.
#
# Built by the recipe player (CIRecipe current_locks) through the editor's own operations. Points (metres over the sea):
# the banks at 2 m either side of the canal (x -4..4, bed at -3 m, z -30..30), the basin under lock 1 at -8 m (z -14..-4),
# the gates at z -16, 0 and 16, the cranks at 6 -18, 6 -2, 6 14, the lock house x 8..11, z -23..-20, the bear's den round
# 12 8, the keeper's kitchen x -12..-9, z 20..23, the planters round -8 12.
include lib_sea
include lib_features
include lib_huts
include lib_gravity
include lib_concord
include lib_areas
include lib_deep14
new
# (nature 10-24: hills and Raft-like trees over the whole island - the coordinator's check after the resize)
gen Trees=0.4 Bushes=0.42 Rocks=0.55 Harvest=0.35 BeachThings=0.3
gen Seed=14121 Radius=92 Height=14 Roughness=0.3 Peaks=2 Shape=0 Style=0 PeakShape=0.4 Cliffs=0.5 BeachWidth=0.6
gen Water=0.5 SeaRocks=0.4 SeaFinds=0.3 Sunken=0.3 Hostiles=0 Friendly=0.2 SeaLife=0.35
generate

# --- Terrain: the two banks, the canal, the deep basin under lock 1 ------------------------------------------------------
brush flatten from 8 -57.5 to 8 57.5 r=5 s=20 frames=600 h=2
brush flatten from -8 -57.5 to -8 57.5 r=5 s=20 frames=600 h=2
brush flatten at -10.5 36.17 r=4 s=20 frames=120 h=2
brush flatten from 0 -65.17 to 0 65.17 r=4 s=20 frames=600 h=-3
brush flatten from 0 -26 to 0 -5 r=4 s=20 frames=600 h=-8
# RESIZE 10-24: the strokes are twice as long, so twice the frames; a level pad under each gate
brush flatten at 0 -30.72 r=3.5 s=20 frames=150 h=-3
brush flatten at 0 0 r=3.5 s=20 frames=150 h=-3
brush flatten at 0 30.72 r=3.5 s=20 frames=150 h=-3
brush flatten at -10.5 36.17 r=5.5 s=20 frames=200 h=2
origin
clear from 8 -57.5 to 8 57.5 r=5
clear from -8 -57.5 to -8 57.5 r=5
clear from 0 -65.17 to 0 65.17 r=4
clear at -13.5 25.17 r=2

# --- The three lock gates: iron walls across the canal between thick posts, three high, hidden when cranked -------------
macro lockgate z=0 al=gate1
place RT_PillarThick lockposts at -4 $z ground
place RT_PillarThick lockposts at 4 $z ground
push at 0 $z h=-3
place RT_Wall1 $al at 0 0 y=0
place RT_Wall1 $al at 3 0 y=0
place RT_Wall1 $al at 0 0 y=3
place RT_Wall1 $al at 3 0 y=3
pop
prop $al obj.name=$al
prop $al tint.color=#5b4a3c
prop $al tint.amount=0.6
end
call lockgate z=-30.72 al=gate1
call lockgate z=0 al=gate2
call lockgate z=30.72 al=gate3
prop lockposts tint.color=#4e5358
prop lockposts tint.amount=0.6
call wheel x=6 z=-32.67 yaw=270 al=crank1
call wheel x=6 z=-2 yaw=270 al=crank2
call wheel x=6 z=28.67 yaw=270 al=crank3
call loopsound x=0 z=0 al=canalsound ev=event:/raft/engine/waterwheel r=20 vol=0.3 h=0

# --- Lock 1: its zone, the rules on the gate post, the lock house with the turbine plans -----------------------------------
call tzone x=7 z=-34.67 al=lock1zone id=lock_1 r=5 msg="Lock 1. An iron gate across the canal, a crank on the bank - and the keeper's rules nailed to the post."
place Note_Sign lockrules at 5.5 -31.47 ground sit yaw=270
push at 8 -37.67 h=2
call hut w=2 d=2 y=0.1
place Loot_Chest lockhouse at 2.2 2.4 y=0.1 sit yaw=180
pop
place Placeable_WindTurbine - at 12 -32.67 ground sit

# --- The basin under lock 1: anglers, the air pocket under the gate, the sunk tool chest ---------------------------------
