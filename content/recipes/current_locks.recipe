call ar_cave x=44 z=36 h=5 yaw=0 al=lockcave chest=lockcavechest
call tzone x=44 z=41 al=lockcavezone id=lockcave r=4 msg="A cave in the north-east bank. Water marks on the walls - the canal ran through here once, before the locks."
call ar_ruin x=-16 z=-64 h=3 yaw=0 al=bunkhouse
call notebox x=-13.5 z=-68.5 yaw=20 al=diggerlist
call ar_plane x=-36 z=60 h=2.5 yaw=210 al=canalplane crate=canalcrate
