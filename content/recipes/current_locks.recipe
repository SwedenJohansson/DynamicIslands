prop anglers creature.respawn=0
prop anglers creature.zone=lock_basin
call tzone x=0 z=-23.67 al=basinzone id=lock_basin r=4 h=1 msg="The basin under lock 1, deep and dark - and something with a light on its head."
call airpocket x=0 z=-28.67 id=gate_air al=gateair bub=gatebub r=2.5 msg="An air pocket trapped under the gate's lip. Breathe."
place Loot_Chest basinchest at 0.8 -12 ground sit yaw=270

# --- Lock 2 and the bear's den on the way to lock 3 ---------------------------------------------------------------------
