place Loot_Chest cldivechest at -72.48 40.04 ground sit yaw=116.57
call dp_air x=-75.52 z=33.96 id=cl_air al=clair msg="Air trapped under the wreck - breathe."
place Loot_ChestSmall cldivesecret at -78.47 39.24 ground sit yaw=26.57
