call tzone x=-57.01 z=28.5 al=clrim id=cl_rim r=5 msg="The lock chamber's rim." h=1
call treasure x=-53.43 z=26.71 r=2 n=1 seed=14952
prop treasure14952 treasure.loot=MetalIngot*2;CopperIngot*2;Bolt*2
# the three sluice wheels on the chamber rim (M29 fallback: signals; UPGRADE-AFTER-MECH M39 dredge drive)
place UT_WaterChallengeWheel1 cl_wheel1 at -76.4 16.1 ground y=0.1 scale=0.4 yaw=40
prop cl_wheel1 obj.name=cl_wheel1
