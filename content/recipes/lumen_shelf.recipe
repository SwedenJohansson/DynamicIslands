# Lumen Shelf - an island of the library's plan The Sunken Kingdom (sunken 25 m; chapter 6, the glowing shelf)
# The edge of the continental shelf: a long seabed terrace that drops into the dark, glowing water over it, silver
# algae and giant clams along it, a survey line of lamps on stone posts running out to the edge. The wind spar stands
# on the shelf and pokes out of the sea: a hollow pillar of stone walls with a ladder up its inside (air pockets in it),
# Varuna's wind turbine on a small platform on top - the only part above water. The survey hut (battery plans), the
# team's mess (the grill plans), the survey sled (the head light plans), a rock arch at the edge with air under it, and
# anglers hunting the dark below. Quest "The Glowing Shelf" (19 steps).
#
# Points (metres over the island's own water line; in the world it all lies 25 m lower): the shelf at 0 (x -26..12),
# the drop past x 14 down to -14; the spar round -10 -4 (walls 0..26.6, its platform at 26.8, the surface at 25), air in
# it at 8 and 17; the survey line of five lamps along z 2 from x -16 to 12 (lamp 3 at 0 2, an air pocket there); the
# survey hut x -6..-1.5, z -14..-11; the mess x 3..7.5, z -13..-9; the arch at 16 8 over the edge (air under it).
include lib_features
include lib_sea
include lib_gravity
include lib_sl1
include lib_sunken
# RESIZE 10-24: Radius 40 -> 85 (Height 4 -> 6), the old content moved 24.8 0 as one frame (push) so its sea side stays at the coast; the island grows behind it.
new
gen Trees=0 Bushes=0 Rocks=0.35 Harvest=0 BeachThings=0
gen Seed=10601 Radius=85 Height=6 Roughness=0.35 Peaks=2 Shape=0 Style=0 BeachWidth=0.1 Cliffs=0.4 PeakShape=0.4
gen Water=0.5 SeaRocks=0.5 SeaFinds=0.4 Sunken=0.4 Hostiles=0 Friendly=0 SeaLife=0.4
generate
elevation -25
push at 24.8 0

# --- Terrain: the shelf, the drop into the dark --------------------------------------------------------------------------
# (the strokes 2.5 m west of their places: they run before origin, and the drop cut at 26 0 moves the land's middle 2.5 m,
# 2026-10-23)
brush flatten at -9.5 0 r=22 s=20 frames=240 h=0
brush flatten at 23.5 0 r=12 s=20 frames=240 h=-14
brush sand at -9.5 0 r=14 s=20 frames=20
pop
brush flatten at -28.9 16 r=4 s=8 frames=40
origin
clear at -28.9 16 r=5
push at 24.8 0
clear at -7 0 r=18

# --- The wind spar: a hollow stone pillar, a ladder inside, air in it, the turbine on top -------------------------------
push at -10 -4 h=0
for k 0 10
place Block_Wall_Tier3 spar at 0 0.75 y={$k*2.42}
place Block_Wall_Tier3 spar at -0.75 0 y={$k*2.42} yaw=90
place Block_Wall_Tier3 spar at 0.75 0 y={$k*2.42} yaw=90
place Block_Ladder_Tier3 - at 0 0.55 y={$k*2.42} yaw=180
next
for k 1 10
place Block_Wall_Tier3 spar at 0 -0.75 y={$k*2.42}
next
place Block_Floor_Tier3 spartop at -1.5 -1.5 y=26.8
place Block_Floor_Tier3 spartop at 0 -1.5 y=26.8
place Block_Floor_Tier3 spartop at 1.5 -1.5 y=26.8
place Block_Floor_Tier3 spartop at -1.5 0 y=26.8
place Block_Floor_Tier3 spartop at 1.5 0 y=26.8
place Block_Floor_Tier3 spartop at -1.5 1.5 y=26.8
place Block_Floor_Tier3 spartop at 0 1.5 y=26.8
place Block_Floor_Tier3 spartop at 1.5 1.5 y=26.8
place Placeable_WindTurbine - at 1.0 1.6 y=26.8 sit
place Loot_ChestSmall sparchest at -1.5 1.5 y=26.8 sit yaw=90
pop
prop spar tint.color=#6e6a64
prop spar tint.amount=0.55
prop spartop tint.color=#5b6266
prop spartop tint.amount=0.45
call airpocketat x=-10 z=-4 h=8 id=spar_air1 al=sparair1 bub=sparbub1 r=1.5 msg="Air, trapped in the spar."
call airpocketat x=-10 z=-4 h=17 id=spar_air2 al=sparair2 bub=sparbub2 r=1.5 msg="Air again, higher up the spar."
place Zone_Trigger sparfoot at -10 -6.5 h=1.5
place Placeable_Table_Basic - at -12.5 -7 h=0 sit yaw=20
place Note_Paper surveynotes at -12.5 -7 h=1.3 drop yaw=30

# --- The survey line: five lamps to the edge, air at lamp 3 -------------------------------------------------------------
call stonelamp x=-16 z=2
call stonelamp x=-8 z=2
call stonelamp x=0 z=2 al=lamp3
call stonelamp x=6 z=2
call stonelamp x=12 z=2
call airpocket x=0 z=4 id=lamp_3 al=lamp3air bub=lamp3bub r=2.5 msg="Lamp 3 - and an air pocket at its foot. Past the last lamps the shelf drops away."
place Creature_AnglerFish anglers at 18 2 h=-8
place Zone_Atmosphere glowshelf at -7 0 h=6
place Zone_Atmosphere darkedge at 24 0 h=-6

# --- The survey hut, the mess, the sled ---------------------------------------------------------------------------------
push at -6 -14 h=0
call shed w=3 d=2 door=1
place Loot_Chest surveyhut at 3.6 2.2 y=0.2 sit yaw=180
place Placeable_Lantern_Metal - at 0.6 2.3 y=0.2 sit
pop
push at 3 -13 h=0
call shed w=3 d=3 door=1
place Placeable_Table_Basic - at 2.25 2.6 y=0.2 sit yaw=0
place Loot_Chest messchest at 3.7 3.7 y=0.2 sit yaw=180
place Note_Paper lastnote at 2.25 2.6 y=1.5 drop yaw=15
place "Box Small" - at 0.7 3.8 y=0.2 sit
pop
place Loot_SunkenBarrel - at 9 -4 ground sit
place Loot_Chest sledbox at 8 -6 ground sit yaw=300
place Antenna_pole - at 7 -5 ground rot=0,0,-80 sy=0.5

# --- The arch at the edge, air under it ---------------------------------------------------------------------------------
place SmallRock_02 - at 14.5 8 ground sit scale=2.6
place SmallRock_02 - at 18.5 8.5 ground sit scale=2.4 yaw=120
place Block_Foundation archtop at 16.5 8 h=2.95 sx=3.2 sz=1.6 yaw=5
prop archtop tint.color=#56514a
prop archtop tint.amount=0.75
call airpocket x=16.5 z=8 id=edge al=edgeair bub=edgebub r=2.5 msg="Under the arch, at the very edge: air. Below, nothing but dark."

# --- Seabed life: algae, clams, ores, reefs, vines, the marker buoy over the spar ----------------------------------------
scatter Pickup_Landmark_SilverAlgae 6 at -6 0 r=16 seed=10602 free=2
scatter Pickup_Landmark_GiantClam 3 at 6 6 r=8 seed=10603 free=2
scatter "Pickup_Landmark_Copper 2" 3 at -18 -12 r=4 seed=10604 free=1
scatter "Pickup_Landmark_Iron 1" 2 at -67.3 21.25 r=4 seed=10605 free=1
scatter VP_CoralBulb04 5 at -20 -2 r=3 seed=10606 free=1
scatter VP_CoralDigitate01 5 at -14 12 r=3 seed=10607 free=1
scatter TinyCoral 6 at 4 14 r=3 seed=10608 free=1
scatter VP_CoralFoliose01 4 at -2 -20 r=3 seed=10609 free=1
scatter SeaVine3 30 at -7 0 r=24 seed=10610 free=2
scatter SeaVine3_klump 12 at -7 0 r=24 seed=10611 free=2
place Creature_PufferFish puffers at -18 -6 h=3
call shallows x=-39.67 z=0 r=106 deep=6 n=1 seed=10612
pop

# --- DISCOVERIES 10-24 (optional, no quest needs them): diver's cache + slate + air pocket; Van3 + chest; hatch with a chest; buried treasure; viewpoint ---
place "Box Small" dcampbox at -28.9 16 ground sit
place Note_Paper dnote at -28.9 16 ground y=1.6 drop yaw=30
place Loot_ChestSmall dcamp at -26.9 17.5 ground sit yaw=197
call airpocket x=-31.4 z=14 id=lumen_shelf_dair al=dairzone bub=dairbub r=2.5 msg="Air trapped in a diver's bell-tent. Breathe."
note dnote Ines's slate (the shelf) | DIVE SLATE - I. MARLOWE, ON A LANYARD\n\nLAST DIVE - LIGHTS OUT BELOW 40.\nLeft the spare kit here for whoever comes next. Probably Teo. Teo, go back up, I mean it.\n\nMilo, the shelf is beautiful. You would hate the cold and love the fish. There are lamps on poles all along the bottom like a street with no houses, and the survey people walk between them holding hands.\nTheir lead says your group came along the lamp line two weeks ago with a man in a warden's cap - singing, she says, very badly, to keep you all brave. That will be Fennick. He sang at the regatta too. Nobody forgave him.
note dcamp Diver's cache | A diver's spare kit, wired shut against the current.
loot dcamp Rope*2;Glass*3;Plastic*4
prop dcamp loot.refill=0
place Van3 dvan at 20.1 -33.4 ground yaw=317
prop dvan tint.color=#6b4a32
prop dvan tint.amount=0.5
place Loot_ChestSmall dwreckchest at 16.1 -30.4 ground sit yaw=257
note dwreckchest Driver's locker | The driver's locker, still dry inside: a torch's glass, plastic, a few bolts.
loot dwreckchest Glass*2;Plastic*5;Bolt*2
prop dwreckchest loot.refill=0
call hatchcache x=18.9 z=34.1 r=4 seed=10691 alias=dhatch chest=dhatchchest items=MetalIngot*2;CopperIngot*2;Bolt*2
call treasure x=-24.5 z=-30.3 r=6 n=1 seed=10692
prop treasure10692 treasure.loot=TitaniumOre*2;CopperOre*2
place Zone_Trigger dview at -7.4 38.3 ground y=1.5
prop dview zone.id=lumen_shelf_view
prop dview zone.radius=7
prop dview zone.repeat=never
prop dview zone.message=The shelf runs on and on - lamp after lamp - and then just stops, and below it there is only dark.

# --- Areas (10-24: every story island has places all over it and its quest crosses it): on the shelf floor - the coral ridge in the north, the dark cave
# in the west at the end of the lamp line, the surveyor's hut in the south-east, a sunk caravan in the south-west
call sk_ridge x1=30 z1=56 x2=46 z2=70 h=4 top=4 r=8
call sk_reef x=38 z=63 r=6 seed=10661
call sk_reef x=46 z=70 r=5 seed=10671
call sk_zone x=38 z=63 al=lu_ridge id=lu_ridge r=7 msg="The coral ridge on the shelf. One way, the lamps; the other, the drop into the dark."
call sk_cave x=-68 z=-4 h=2 yaw=0 al=lu_caverock chest=lu_cavechest
call sk_zone x=-68 z=1 al=lu_cave id=lu_cave r=4 msg="The lamp line ends at this cave. Inside, it is darker than the sea."
call sk_dark x=-68 z=1 h=1 r=7 al=lu_dark
call airpocketat x=-65.4 z=0 h=3.6 id=lu_air al=lu_air bub=lu_airbub r=2.2 msg="Air under the rock - breathe."
call sk_ruin x=40 z=-64 h=2 al=lu_ruin
call sk_notebox x=42.5 z=-68.5 yaw=10 al=lu_ruinnote
call sk_wreck x=-50 z=-40 h=2 yaw=70 v=Caravan_Green_01 al=lu_wreck crate=lu_wreckcrate scale=1
call sk_notebox x=-44 z=-44 yaw=70 al=lu_wrecknote

# --- Unique layer (10-24): the lamp line: five survey lamps lead west to the dark cave, each one keeps the anglers at bay
# (beh.repel, gaps-1024); the cave itself is dark (a dark hazard zone: the advanced headlight from step 7 sees in it)
call stonelamp x=-20 z=0 al=lulamp1
call stonelamp x=-32 z=-1 al=lulamp2
call stonelamp x=-44 z=-2 al=lulamp3
call stonelamp x=-54 z=-2 al=lulamp4
call stonelamp x=-62 z=0 al=lulamp5
place Zone_Trigger lucavedark at -68 3 ground y=1

# --- DEEP 1-HOUR (10-24): the survey rock (27.5 m from the floor, a beacon on top) and the drowned survey office in the north-west pit - a light gate holds off its puffers
# the rock that breaks the surface (27.5 m up from the floor), a beacon tower on its dry top
call sk_seamount x=-6 z=-66 top=27.5 r=22
call sk_pit x=-36 z=60 h0=-8
call sk_cave x=66 z=-30 h=2 yaw=0 al=lucave2 chest=lucave2chest
call sk_reef x=13.8 z=-66 r=6 seed=24510
call sk_reef x=-21.4 z=-52.8 r=6 seed=24520
call sk_reef x=-26 z=66 r=5 seed=24530

# the summit: the survey rock - the tower (ladder inside), the locker, the note, the zone
# (REACH 10-29: the top's south rim rose 2.7 m in 2 (24.6 at z -57, 27.3 at -59) - climbers stalled at 23.7: a ramp of
# flattened steps up the south face to the tower's door, 0.6 m a step)
for k 0 5 1
brush flatten at -6 {-54+(-1)*$k} r=1.8 s=20 frames=200 h={24.3+0.6*$k}
next
# (REACH 10-29 (2): walkers come up the north side (stalled at 23.7, z -72.5) - steps there too (24.2 at z -72, 27 at -71))
for k 0 4 1
brush flatten at -6 {-75+$k} r=1.8 s=20 frames=200 h={23.2+0.8*$k}
next
call ladtower x=-6 z=-66 h0=27.5 lv=3 a=lutower
place Loot_ChestSmall lulocker at -6.75 -65.25 h=34.98 sit yaw=180
place Note_Paper lusumnote at -6.75 -66.75 h=35.08 drop yaw=20
place Zone_Trigger lusummit at -6 -66 h=35.98
place Loot_ChestSmall luledge at -18.1 -66 ground sit yaw=40
place SmallRock_02 - at -1 -64 ground sit scale=0.5
place SmallRock_02 - at -1 -64 ground y=0.6 sit scale=0.32 yaw=40
call treasure x=-3.5 z=-64 r=12 n=1 seed=24511
prop treasure24511 treasure.loot=MetalIngot*2;CopperIngot*2;Bolt*2
call treasure x=50.52 z=-22.97 r=5 n=1 seed=24512
prop treasure24512 treasure.loot=Scrap*4;Nail*10;Plastic*4;Glass*2
call sk_dark x=66 z=-28 h=1 r=7 al=lucave2dark

# the drowned building: the survey office, its ground floor 33 m down; the deep chest at the bottom, air on storey 1
call sk_drowned x=-36 z=60 h0=-8 n=4 w=RT_WallWindowBroken a=lubld cap=0 cal=lucap
place Loot_Chest ludeep at -37.8 57.5 h=-8 sit yaw=0
place Placeable_Table_Basic - at -37.5 61 h=-5 sit yaw=0
place Note_Paper lubldnote at -37.5 61 h=-3.7 drop yaw=10
call airpocketat x=-36.5 z=58 h=-5 id=lu_dair al=ludair bub=ludbub r=2.2 msg="Air trapped under the stairs of the drowned building. Breathe."
call sk_zone x=-36 z=49 al=ludeepzone id=lu_deep r=4 msg="The pit floor: the drowned building stands below you."

# M20 the light gate: the puffers by the drowned office; the switch on the rim lights the floodlight for 25 s (it keeps
# them off), and the broken floodlight across the pit lights for good once its four lens glasses are fitted
place Creature_PufferFish lupuff at -36 51 ground y=3
place VP_Spotlight luflood1 at -24 54 ground sit yaw=250
place TP_LaserControlPanel_lever luswitch1 at -23 50 ground sit yaw=270
place RT_Floodlight_WithoutLightSource luflood2x at -48 55 ground sit yaw=90
place VP_Spotlight luflood2 at -48 57 ground sit yaw=100
place Loot_ChestSmall lulens1 at -34.8 57 h=-5 sit yaw=0
place Loot_ChestSmall lulens2 at -37.8 57.5 h=-2 sit yaw=90
place Loot_ChestSmall lulens3 at -34.8 61 h=1 sit yaw=180

# --- Settings, notes, behaviours, quest ---------------------------------------------------------------------------------
info title=Lumen Shelf
info author=Custom Islands
info description=A glowing seabed terrace 25 m down, a survey line of lamps to its edge and a stone wind spar breaking the surface. Below the edge, anglers. The sixth island of The Sunken Kingdom.
island on.arrive=message||A wind turbine standing on the sea, on a stone pillar that goes straight down into green light.

note surveynotes Survey line notes | SURVEY LINE - NOTES (K. Lindqvist, survey lead)\n\nFive lamps, shelf foot to the edge, one every forty metres, because I am a romantic. Lamp 3 has air.\nThe turbine on the spar charges the lamps. Climb inside the spar - it holds air in two places, and it hums when the current is up, which the new boy thinks is ghosts.\nBatteries in the hut. Headlights in the sled. Nobody walks the shelf outside the light.\nNew order from the Spire this week: "Survey lamps to half, then off." Off? The lamps are the only reason any of us are alive down here. I have put them to half and written a polite letter. I will put them to off when the Director comes down here and walks the shelf in the dark himself.
note lastnote Last survey note | LAST SURVEY NOTE\n\nLights off below the edge. It comes to the lights. It comes to the noise. It sings back the noises it hears - the bell, the beacon, our radio's line tone. "Calling. Calling."\nWe have turned the line down to half. The diver, Marlowe, came down the bell yesterday and said it's only anglers. Then she saw the teal lamp walking against the current and she stopped saying that.\nWe are leaving the shelf for the Caisson Yard over the trench, where the children went. The warden says there are cranes there and a sealed office, and the Yard's lights still run on their own generator.\nFix the big floodlight if you can. Then follow us. Keep low.
note sparchest Spar platform chest | A chest on the spar's platform: wind turbine plans.
note surveyhut Survey hut chest | The survey hut's chest: advanced battery plans, lamp wicks.
note sledbox Survey sled box | The survey sled's box: advanced head light plans.
note messchest Mess chest | The mess chest: electric grill plans, two clean plates.
loot sparchest Blueprint_WindTurbine*1;Bolt*2
prop sparchest loot.refill=0
loot surveyhut Blueprint_BatteryAdvanced*1;CopperIngot*1
prop surveyhut loot.refill=0
loot sledbox Blueprint_HeadLight_Advanced*1;Scrap*2
prop sledbox loot.refill=0
loot messchest Blueprint_ElectricGrill*1;Plank*2
prop messchest loot.refill=0

prop sparfoot zone.id=spar_foot
prop sparfoot zone.radius=3.5
prop sparfoot zone.message=The foot of the wind spar. A door in its side, a ladder inside.
prop lamp3 obj.name=lamp3
prop anglers creature.count=3
prop anglers creature.respawn=0
prop anglers creature.zone=lamp_3
prop glowshelf atmo.particles=fireflies
prop glowshelf atmo.fog=#2f8f86
prop glowshelf atmo.fogAmount=0.25
prop glowshelf zone.radius=20
prop darkedge atmo.fog=#04121a
prop darkedge atmo.fogAmount=0.7
prop darkedge atmo.lightAmount=0.2
prop darkedge zone.radius=12
prop puffers creature.count=2

note lu_cavechest Lamp-man's box | The lamp-man's box: wicks, lamp glass, copper wire.
loot lu_cavechest Glass*2;Copper*2;Rope*2;Battery*1
prop lu_cavechest loot.refill=0
note lu_ruinnote Surveyor's hut note | SURVEYOR'S HUT (K. Lindqvist)\n\nThe anglers keep out of the lamplight. So we lit a line of lamps to the cave, and we walked inside the light like children on the cracks in a pavement.\nPast the lamps we never went without a headlight. Past the cave we never went at all.\nThen the Spire turned the shelf feed to half from a hundred miles away, and the anglers started coming to the edge of the light and waiting there. Not attacking. Waiting.\nSomething bigger comes behind them some nights. You only see its lure: one teal lamp that is not ours, walking the line the wrong way.
note lu_wrecknote Caravan logbook | CARAVAN LOGBOOK - SURVEY TEAM\n\nThe survey team's caravan, lowered on the crane from Thalassa. Bunks for four, kettle for one, arguments for everybody.\nWe slept in it the first week. Then the lights started going out.\nWeek three: a party of children came through on the lamp line with the door warden from the Commons. Twelve. We gave them cocoa and the warden ate three biscuits per child "for morale".\nOne little boy was crying because he had left his whale on the shuttle. The warden promised him he'd see it again. I don't know why people promise things down here.
note lu_wreckcrate Survey team's crate | The survey team's crate: a spare battery and the team's rope.
loot lu_wreckcrate Battery*1;Rope*3;Copper*2;Scrap*2
prop lu_wreckcrate loot.refill=0
prop lulamp1 beh.repel=8
prop lulamp2 beh.repel=8
prop lulamp3 beh.repel=8
prop lulamp4 beh.repel=8
prop lulamp5 beh.repel=8
prop lucavedark zone.radius=5
prop lucavedark zone.hazard=dark
prop lucavedark zone.hazardMsg=Pitch dark. A headlight would show the way.
# --- DEEP 1-HOUR (10-24): story items, notes and checks
story lu_key|Survey office key|Hinge|The survey office key, from the chest at the bottom of the drowned office.
story sk_crest|Kingdom crest shard|Bolt|A shard of the Sunken Kingdom's crest, from a drowned building. The Hollow's crown vault wants nine.
note ludeep Survey office chest | The office chest: the fourth lens glass and a crest shard.
loot ludeep story:sk_crest*1;TradeToken*2;story:lu_lens*1;Glass*2;OxygenBottle*1
prop ludeep loot.refill=0
note lulocker Survey beacon locker | The surveyors' locker on the rock: lamp oil, spare kit.
loot lulocker MetalIngot*3;CopperIngot*2;Rope*3;Cooked_Potato*2
prop lulocker loot.refill=0
note lusumnote Surveyor's card | THE SURVEY ROCK\n\nThe shelf lamps were ours. The big floodlight by the office kept the puffers out of the pit until somebody smashed its glass to keep it dark - the Spire sent a man down with a hammer, and he apologised all the way through.\nFrom up here you see the whole lamp line: five dots of light on the black, and beyond them, over the trench, the Yard's cranes with their red lamps still on. Somebody there still has power. Somebody there still has a choice.
note lubldnote Survey office notice | NETWORK NOTICE - POSTED BY G. FENNICK, DOOR WARDEN\n\nThe puffers come up the pit at night. The floodlight switch on the rim gives you half a minute of light, which is long enough if you do not stop to admire anything.\nSpare lens glasses: one on each floor. The broken floodlight takes four. The fourth is in the chest at the bottom, with the old crown shard, because I put it there, because I am thorough.\nTo the Stalker, if you can read: this is a survey office. There is nothing here for you. Go home.
note luledge Lamp fitter's cache | A lamp fitter's cache on the rock's shelf.
loot luledge Rope*3;Bolt*2;Feather*3
prop luledge loot.refill=0
note lucave2chest Shelf mapper's chest | A shelf mapper's chest in the rock cave.
loot lucave2chest CopperOre*3;Rope*2;Battery*1
prop lucave2chest loot.refill=0
prop lusummit zone.id=lu_summit
prop lusummit zone.radius=2.5
prop lusummit zone.message=Out of the water: the survey rock. The shelf lamps glow green far below.
story lu_lens|Lens glass|Glass|A floodlight lens glass from the survey office. The broken floodlight takes four.
story lu_gate|Light gate|Placeable_Lantern_Metal|You threw the floodlight switch: half a minute of light over the pit.
story lu_lit|Floodlight mended|Placeable_Lantern_Metal|The broken floodlight burns again: the pit is lit for good.
prop lupuff creature.count=5
prop lupuff creature.respawn=0
prop lupuff creature.zone=lu_deep
prop luflood1 obj.name=luflood1
prop luflood1 beh.hidden=1
prop luflood1 beh.repel=10
prop luswitch1 obj.name=luswitch1
prop luswitch1 beh.use=Throw the floodlight switch
prop luswitch1 on.use=show|luflood1\ngive||story:lu_gate*1\nmessage||The floodlight blazes over the pit - the puffers scatter. Half a minute!\nwait|25\nhide|luflood1\nmessage||The floodlight dies.
prop luflood2x obj.name=luflood2x
prop luflood2x beh.use=Fit the lens glasses
prop luflood2x if.use=take|story:lu_lens|4
prop luflood2x else.use=message||The big floodlight's four lens glasses are smashed. The survey office keeps spares, one on each floor.
prop luflood2x on.use=hide|luflood2x\nshow|luflood2\ngive||story:lu_lit*1\nmessage||Four new glasses, and the floodlight burns again: the pit is lit, and the puffers keep away for good.
prop luflood2 obj.name=luflood2
prop luflood2 beh.hidden=1
prop luflood2 beh.repel=10
note lulens1 Lens box (first floor) | A box of spare lens glass on the office's first floor.
loot lulens1 story:lu_lens*1;Glass*1
note lulens2 Lens box (second floor) | A box of spare lens glass on the second floor.
loot lulens2 story:lu_lens*1;Glass*1
note lulens3 Lens box (top floor) | A box of spare lens glass on the top floor.
loot lulens3 story:lu_lens*1;Glass*1
prop lulens1 loot.refill=0
prop lulens2 loot.refill=0
prop lulens3 loot.refill=0

quest title=The Glowing Shelf
quest intro=Ines rode the bell down to these survey lamps, 25 m deep. Find the wind spar's foot.
step reach|spar_foot|1|Dive to the foot of the wind spar
step read|Survey line notes|1|Read the survey line notes
step blueprint|Blueprint_WindTurbine|1|Climb the spar from inside: wind turbine plans on its platform
step reach|lamp_3|1|Follow the survey line to lamp 3
step kill|Angler fish|3|Fight off the three anglers from the dark
step blueprint|Blueprint_BatteryAdvanced|1|Find the battery plans in the survey hut
step blueprint|Blueprint_HeadLight_Advanced|1|Dig out the survey sled's box: head light plans
step read|Surveyor's hut note|1|Read the note in the surveyor's old hut on the shelf
