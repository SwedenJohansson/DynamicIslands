call hw_trail x=12 z=56 b=30 h=42 a0=-167.91 turn=300 n=40 h0=3
brush flatten at 7.36 70.37 r=2.6 s=20 frames=200 h=22.5
clear at 7.36 70.37 r=3
call hw_basin x=82 z=32 r=14 h=-18
brush flatten at 50 32 r=4 s=8 frames=60
clear at 50 32 r=6
brush flatten at -23.2 38.6 r=5 s=8 frames=40
origin
clear at -23.2 38.6 r=6
push at 26.4 0
clear at 24 0 r=12
clear at -16 0 r=23

