# The Tide Engine - the last island of the library's plan Relic of the Seventh Tide (the finale)
# A ring of desert rock round a vast well, and in the well the Engine's heart: Temperance's reactor controls as its
# core, a laser panel fed through two of Temperance's turning mirrors, the Seventh lever. On the ring, three machine
# halls of sandstone and brass - the wheel hall with three tide wheels and the sluice lever, the crane hall where
# Utopia's cranes are the Engine's arms, the piston hall on the way to the ring's top - and in the south the landing
# with Kett's last camp. Quest "The Seventh Tide" (36 steps) in four parts: the landing (the ambush, the supply crate,
# the radio codes, the Syndicate's radio); the tide wheels (the diagram, three wheels, the sluice, the stingrays in
# the flooded sluice gallery, its cache); the arms (the claw, the tablet, the crane cab, the zipline across the well,
# Kett in her cage, her warning); the heart (the boss's beast, the beam, the inscription, the Seventh lever, the
# treasury, the relic, the ring's top); then the epilogue (8 more steps, 36 in all): the Watch Hill in the north-west
# and Silas Grey's last log and the tide vault key on his mast, Nell Okafor's note in her cave on the east shore, the
# 1931 expedition's tide-gauge house drowned off the south-west (its tide vault needs the key) and Dr. Ostrander's
# last letter in it.
# DEEP 10-25 (Relic deep pass): Radius 70 -> 110, the finale as big as Raft's biggest islands: the ring and its halls
# unchanged in the middle, a wide desert skirt round it; the landing path runs on out to the new south shore and the
# sluice channel on out to the east. The Watch Hill (26 m, trail + Grey's last lookout mast), Okafor's cave on the east
# shore, the tide-gauge house drowned off the south-west (-10 m, an air pocket), three buried caches (one titanium).
# Voices: Silas Grey, Nell Okafor, Dr. Hal Ostrander (1931).
#
# Built by the recipe player (CIRecipe the_tide_engine) through the editor's own operations.
include lib_sea
include lib_features
include lib_areas
include lib_highwater
new
# (nature: desert rock at Raft's density - cacti and dry grass, a few rocks; three reefs round the ring)
gen Trees=0.5 Bushes=0.8 Rocks=0.6 Harvest=0.25 BeachThings=0.3
gen Seed=9701 Radius=110 Height=6 Roughness=0.3 Peaks=1 Shape=0 Style=2 PeakShape=0.3 Cliffs=0.4 BeachWidth=0.6
gen Water=0.5 SeaRocks=0.4 SeaFinds=0.2 Sunken=0.3 Hostiles=0 Friendly=0.1 SeaLife=0.3
generate

# --- Terrain: the ring at 5 m, the well (the heart) at 2 m with a ramp down from the south rim, the ring's top in the
# west, the landing path in the south, the sluice channel from the wheel hall out to the sea in the east --------------
brush flatten at 0 0 r=50 s=20 frames=400 h=5
brush flatten at 0 0 r=13 s=20 frames=200 h=2
brush smooth from 0 -22 to 0 -10 r=3 s=8 frames=40
brush flatten at -44.5 0 r=3.8 s=20 frames=300 h=9.5
# (10-25: pads 0.5 m apart and 5 m wide - on the 3 m ramp the walker slid off its side at -40.7 and caught on a step)
# (later 10-25: each pad a 0.5 m-wide line across the ramp, 0.25 m apart - round pads 2.5 m wide set each spot to the
# highest pad over it, which left a 1.5 m step at the ramp's foot)
for k 0 6.5 0.25
brush flatten from {-34-$k} -2.5 to {-34-$k} 2.5 r=0.5 s=20 frames=150 h={5.6+0.6*$k}
next
brush smooth from -41 0 to -33.5 0 r=2.5 s=6 frames=20
brush flatten from 0 -106 to 0 -54 r=4 s=20 frames=300 h=1.2
brush smooth from 0 -56 to 0 -48 r=4 s=6 frames=30
brush flatten from 36 -12 to 114 -12 r=4 s=20 frames=420 h=-3
# --- DEEP 10-25 terrain: the Watch Hill (north-west, summit 26 m, base r 20) and its trail from the south, Okafor's cave
# on the east shore, the tide-gauge house's basin off the south-west (-10 m) ------------------------------------------
call hw_mount x=-60 z=45 b=20 h=26
call hw_trail x=-60 z=45 b=20 h=26 a0=180 turn=300 n=36 h0=4
call ar_cave x=66 z=44 h=2 yaw=180 al=okarock chest=okachest
call hw_basin x=-62 z=-84 r=12 h=-10
origin
clear at 0 0 r=24
clear from 0 -106 to 0 -24 r=5
clear at 0 -44 r=12
clear at 28.5 0 r=8
clear at 0 32 r=10
clear at -28.5 0 r=8
clear at -42 0 r=6
clear from -40 0 to -33.5 0 r=2.5
clear at 18 -44 r=6

# --- The machine halls: sandstone walls 9 x 9 m with a 3 m gap in the middle of every side, brass pillars ----------
macro hall x=0 z=0
push at {$x-4.5} {$z-4.5} h=5
for hw 0.75 2.25 1.5
place Block_Wall_Tier3 hallwalls at $hw 0 y=0.2
place Block_Wall_Tier3 hallwalls at $hw 9 y=0.2
place Block_Wall_Tier3 hallwalls at 0 $hw y=0.2 yaw=90
place Block_Wall_Tier3 hallwalls at 9 $hw y=0.2 yaw=90
next
for hw 6.75 8.25 1.5
place Block_Wall_Tier3 hallwalls at $hw 0 y=0.2
place Block_Wall_Tier3 hallwalls at $hw 9 y=0.2
place Block_Wall_Tier3 hallwalls at 0 $hw y=0.2 yaw=90
place Block_Wall_Tier3 hallwalls at 9 $hw y=0.2 yaw=90
next
for hp 0 9 3
place Block_Pillar_Tier3 hallpillars at $hp 0 y=0.2 sy=1.2
place Block_Pillar_Tier3 hallpillars at $hp 9 y=0.2 sy=1.2
next
for hp 3 6 3
place Block_Pillar_Tier3 hallpillars at 0 $hp y=0.2 sy=1.2
place Block_Pillar_Tier3 hallpillars at 9 $hp y=0.2 sy=1.2
next
pop
end
call hall x=28.5 z=0
call hall x=0 z=28.5
call hall x=-28.5 z=0
prop hallwalls tint.color=#c9a77a
prop hallpillars tint.color=#a8743c

# --- Area A, the landing: Kett's last camp, the Syndicate's supply crate and radio, their dogs ----------------------
place Zone_Trigger landing at 0 -44 h=5
place Balboa_DecorationPrefabBase_SimpleTent - at -8 -50 ground sit yaw=15
place "Box Small" campdesk at 3 -46 ground sit
place Note_Paper camplog at 3 -46 h=6 sit drop yaw=10
place Loot_Chest supplycrate at -4 -48 ground sit yaw=160
place "Box Big" - at 6 -40 ground sit yaw=10
place RT_CommRadio radio at 6 -40 h=7 sit drop yaw=190
place Creature_Hyena ambushdogs at -10 -38 ground
store engineshop at 18 -44 ground

# --- Area B, the wheel hall (east): three tide wheels on their axles, the engine diagram, the sluice lever; the sluice
# gate on the channel to the south-east, the flooded sluice gallery with its stingrays and its cache ------------------
for wx 25.5 31.5 3
place RT_Pillar - at $wx 2.5 h=5 sy=0.6
next
place UT_WaterChallengeWheel3 wheel1 at 25.5 2.75 h=6.6 rot=90,0,0 scale=0.4
place UT_WaterChallengeWheel3 wheel2 at 28.5 2.75 h=6.6 rot=90,0,0 scale=0.4
place UT_WaterChallengeWheel3 wheel3 at 31.5 2.75 h=6.6 rot=90,0,0 scale=0.4
place Zone_Trigger wheelhall at 28.5 0 h=5
place Note_Sign diagram at 27 -3.5 ground sit yaw=0
place RT_Pillar - at 31.5 -2.5 h=5 sy=0.4
place TP_LaserControlPanel_lever sluicelever at 31.5 -2.5 h=6.25 sit scale=3 yaw=180
place UT_Drawbridge sluicegate at 37.5 -12 h=-3 sit yaw=90 sx=2.6
place Zone_Trigger sluicezone at 46 -12 h=-1
place Creature_Stingray rays at 50 -12 h=-2.4
place Loot_Chest sluicecache at 54 -12 h=-3 sit yaw=270
prop wheel1 tint.color=#a8743c
prop wheel2 tint.color=#a8743c
prop wheel3 tint.color=#a8743c

# --- Area C, the crane hall (north): the Engine's arm (Utopia's cranes; the claw swaps the lowered arm for the raised
# one), the Seventh Tide tablet, the crane cab on its legs north of the hall, the zipline across the well -------------
place UT_ElectricityIsland_Crane02 armlow at 1 30 ground sit scale=0.5 yaw=180
place UT_ElectricityIsland_Crane01 armhigh at 1 30 ground sit scale=0.4 yaw=180
place RT_Pillar - at -3 26 h=5 sy=0.4
place TP_LaserControlPanel_lever claw at -3 26 h=6.25 sit scale=3 yaw=180
place Zone_Trigger cranehall at 0 28.5 h=5
place Note_Sign tidetablet at 3 25 ground sit yaw=0
for cx -1.5 1.5 3
place RT_PillarThick cablegs at $cx 36.5 h=5
place RT_PillarThick cablegs at $cx 39.5 h=5
next
place RT_Floor cabplate at 1.95 39.85 h=11 sit sx=0.66 sz=0.44
place Loot_Chest cablocker at 0.3 38 h=11.15 sit yaw=180
place LandmarkLadder_6m cabladder at 0 35.85 h=5 sit yaw=0
place Zone_Trigger armtop at -0.8 37.6 h=11.2
# (its near floor - 5.72 m west, 0.97 m north of where it is put, 1.35 m under its h - on the cab plate, clear of the locker)
place ZiplinePath_Landmark zipacross at 7.12 35.83 h=12.3
zipto zipacross 6 -18
prop armlow tint.color=#a8743c
prop armhigh tint.color=#a8743c
prop cablegs tint.color=#7a6a50
prop cabplate tint.color=#5d646b

# --- The piston hall (west) on the way to the ring's top: two of Utopia's small cranes as the Engine's pistons -----
place UT_ElectricityIsland_Crane02 - at -32 5 ground sit scale=0.4 yaw=90
place Zone_Trigger ringtop at -42 0 h=9.5
place Placeable_Lantern_Metal - at -42 2 ground

# --- The south rim: Kett in the Syndicate's cage, her satchel, her warning ------------------------------------------
place Zone_Trigger heartrim at 4 -18 h=5
place Survivor_Cage kettcage at 8 -20 ground yaw=0
place Loot_Chest kettsatchel at 2 -22 ground sit yaw=30
place "Box Small" - at 11 -18 ground sit
place Note_Paper kettwarning at 11 -18 h=6 sit drop yaw=20

# --- Area D, the heart in the well: the core (Temperance's reactor controls), its glow, the beam (emitter, two turning
# mirrors, the panel), the inscription, the Seventh lever, the treasury; the boss's beast -----------------------------
place TP_SeleneReactorControls core at 0 0 h=2 sit
place RT_Floodlight coreglow at 2.5 -2.5 h=2 sit yaw=-45
place RT_Floodlight coreglow at -2.5 -2.5 h=2 sit yaw=45
place RT_Floodlight coreglow at 2.5 2.5 h=2 sit yaw=-135
place RT_Floodlight coreglow at -2.5 2.5 h=2 sit yaw=135
place Placeable_Lantern_Metal coldlights at 1.5 -1.8 h=2 sit
place Placeable_Lantern_Metal coldlights at -1.5 -1.8 h=2 sit
place TP_LaserEmitter emitter at -6.8 -6 h=2 sit yaw=0
place TP_MirrorHousing_Rotating mirror1 at -6 -2 h=2 sit yaw=0
place TP_MirrorHousing_Rotating mirror2 at 6 -2 h=2 sit yaw=270
place "Box Big" - at 6 6.8 h=2 sit
place TP_LaserDoorPanel reactorpanel at 6 6 h=2 sit scale=2 yaw=180
place Note_Sign heartinscription at -3 9 h=2 sit yaw=180
place RT_Pillar - at -6 6 h=2 sy=0.4
place TP_LaserControlPanel_lever seventhlever at -6 6 h=3.25 sit scale=3 yaw=180
place Loot_ChestLarge treasury at 3.5 -8.5 h=2 sit yaw=-30
place Zone_Trigger heartzone at 0 -6 h=2
place Placeable_Lantern_Metal wellcam at 10 -12 h=5 sit
# (10-25: rubble fallen from the rim along the well's north and side walls - the floor was a bare sand plain; kept off
# the ramp (south), the beam's line and the inscription; the big one by the east wall sunk 2.4 m - with drop alone it
# stood 2.4 m over the floor, and one by the west wall left out: it hung over the wall's foot)
place SmallRock_02 - at 11.2 2 ground sit drop y=-2.4 scale=1.3 yaw=30
place SmallRock_02 - at 3.1 11 ground sit drop scale=1.3 yaw=220
place SmallRock_02 - at 0.3 9.8 ground sit drop scale=0.55 yaw=90
place SmallRock_02 - at 9.4 -1.6 ground sit drop scale=0.5 yaw=150
place SmallRock_02 - at -8.5 4.5 ground sit drop scale=0.55 yaw=10
place SmallRock_02 - at -11.6 -1 ground sit drop scale=1.1 yaw=70
place SmallRock_02 - at 11.6 -6.5 ground sit drop scale=1.0 yaw=200
place SmallRock_02 - at -10.4 -8 ground sit drop scale=0.5 yaw=15
# (south of the beam line, 10-25: killed by the core its body lay between the mirrors and stopped the beam)
place Creature_PolarBear beast at 0 -10 h=2.2
prop core tint.color=#a8743c
prop core tint.amount=0.4

# --- Things to gather, reefs ----------------------------------------------------------------------------------------
scatter "Pickup_Landmark_PineappleLandmark" 2 at -24 -30 r=10 seed=9711 free=3
call dirt x=30 z=30 r=10 n=3 seed=9712
call shallows r=118 deep=5 n=3
call hw_reef x=-96 z=-40 r=5 seed=31041
call hw_reef x=92 z=60 r=5 seed=31042

# --- DEEP 10-25 epilogue: the Watch Hill - its foot and top as zones, Silas Grey's last lookout mast (his log, the key) -
call hw_zone x=-60 z=24 al=watchfootz id=watchfoot r=5 msg="The Watch Hill, the highest ground on the Engine's island. A path of flat stones winds up it to a mast with a grey flag, torn."
call hw_zone x=-60 z=45 al=watchtopz id=watchtop r=7 h=1 msg="The top of the Watch Hill. The ring and its well below, quiet now - and out to sea, a grey launch heading away, very small."
call hw_mast x=-60 z=45 h0=26 lv=3 a=greymast chest=greybox top=Placeable_Lantern_Metal
place Note_Paper greylast at -63.5 41.5 h=26.1 drop yaw=200
loot greybox story:vaultkey*1;Rope*2;Battery*1;Cooked_GenericMeat*2
prop greybox loot.refill=0
note greybox Grey's last lookout box | Silas Grey's box on his last lookout: his spyglass, left behind, rope - and a long brass key with seven teeth on its bit.
scatter "Pickup_Landmark_Flower_Red" 2 at -60 45 r=22 seed=31043 free=3
call treasure x=-80 z=28 r=12 n=1 seed=31038 kind=0
prop treasure31038 treasure.loot=TitaniumIngot*2;MetalOre*2;Glass*2
# --- Nell Okafor's cave on the east shore: her note, her tool chest (a secret) ---------------------------------------
call hw_zone x=66 z=39 al=okaz id=okafor_cave r=4 msg="A cave on the east shore, and in it a small airship's gondola on blocks, half rebuilt. Nell Okafor got here before you."
place Note_Paper okalast at 64.5 38.5 h=2.45 drop yaw=180
loot okachest Bolt*4;Hinge*2;MetalIngot*2;CopperIngot*1
prop okachest loot.refill=0
note okachest Okafor's tool chest | Nell Okafor's tool chest: bolts, hinges, ingots - and a note pinned inside the lid: "TAKE WHAT YOU NEED. - N."
call treasure x=82 z=58 r=12 n=1 seed=31039 kind=0
prop treasure31039 treasure.loot=Scrap*4;Bolt*2;Hinge*1
# --- The 1931 expedition's tide-gauge house, drowned off the south-west (-10 m): Ostrander's last letter, an air pocket
call hw_sunkhouse x=-62 z=-84 h=-10 yaw=0 a=gaugehouse chest=tidevault air=gaugeair bub=gaugebub dal=gaugedoor
call hw_zone x=-62 z=-84 al=gaugez id=gaugehouse r=7 h=1 msg="A stone house on the sea floor, ten metres down, a brass tide gauge still bolted to its wall. Its front room still holds a breath of air."
place Note_Paper ostrlast at -61.4 -85.2 h=-9.5 drop yaw=0
loot tidevault TitaniumIngot*2;TradeToken*6;CopperIngot*2;Glass*2
prop tidevault loot.refill=0
prop tidevault if.open=has|story:vaultkey|1
prop tidevault else.open=message||The tide vault is shut with a lock of seven brass teeth. It wants the tide vault key.
note tidevault Tide vault | The 1931 expedition's tide vault: their pay, their titanium samples, the gauge's spare glass.
call treasure x=-48 z=-76 r=12 n=1 seed=31040 kind=0
prop treasure31040 treasure.loot=MetalOre*3;CopperOre*2;Glass*2

# --- Settings, story items, notes, behaviours, quest ----------------------------------------------------------------
info title=The Tide Engine
info author=Custom Islands
info description=A ring of desert rock round a vast well, in an island as big as Raft's biggest: three machine halls of sandstone and brass - tide wheels, Utopia's cranes as the Engine's arms - and in the well the Engine's heart, its reactor core, its beam and the Seventh lever. The Watch Hill and Silas Grey's last lookout, Nell Okafor's cave on the east shore, the 1931 expedition's tide-gauge house drowned off the south-west. The finale of Relic of the Seventh Tide.
island on.arrive=message||A ring of rock round a well as wide as a lagoon, and in it something humming. The sea round the ring is drawn in, wave by wave.

story radiocodes|Syndicate radio codes|Placeable_PaperBundle|A card of call signs and codes from the Syndicate's supply crate.
story taunt|The boss's broadcast|Placeable_PaperBundle|The Syndicate's boss, on the radio: the Engine wakes at the seventh tide.
story wheelturn|Tide wheel turned|Bolt|A tide wheel set turning. Three of them drive the sluice.
story sluiceopen|Sluice opened|Bolt|The sluice gate is up; the gallery floods.
story clawmoved|The Engine's arm raised|Bolt|The claw lever raised the Engine's arm off the well.
story cagekey|Cage key|Placeable_Lantern_Metal|The key of the Syndicate's cage, from the crane cab's locker.
story heartbeam|Beam on the reactor panel|Battery|The beam runs through two mirrors onto the reactor panel.
story enginestopped|The Engine stopped|Bolt|The Seventh lever is down and the Engine is quiet.
story vaultkey|Tide vault key|Placeable_PaperBundle|A long brass key with seven teeth: the 1931 expedition's tide vault, from Silas Grey's last lookout box.
story relic|The Seventh Tide|Bolt|The relic: a brass ring of seven teeth, cold now. The Engine will never wake again.|raft=Placeable_TrophyBoard_Medium

note camplog Kett's final camp log | KETT - FIELD LOG, LAST ENTRY\n\nThe Engine is real. A ring of rock round a well, and it pulls the sea in - one finger's width every seventh tide, for a thousand years.\n\nThe Syndicate got here before me. They want it running: higher seas, more wrecks to salvage. I am going into the heart. If you are reading this, come after me - and watch for the dogs.
note supplycrate Syndicate supply crate | The Syndicate's supplies: batteries, rope - and a card of radio codes.
loot supplycrate story:radiocodes*1;Battery*2;Rope*3;CopperIngot*2
prop supplycrate loot.refill=0
note diagram Engine diagram | THE ENGINE OF THE SEVENTH TIDE (carved, with brass inlay)\n\nThree wheels turn the sluice. The sluice floods the gallery. The arm lifts from the well. The beam wakes the heart. The Seventh lever sleeps it.\n\nScratched under it in pencil: "turn all three wheels first - I. K."
note sluicecache Sluice cache | A cache in the flooded gallery: titanium, scrap and a sealed tin of the builders' copper.
loot sluicecache TitaniumIngot*2;CopperIngot*3;Scrap*4
prop sluicecache loot.refill=0
note tidetablet The Seventh Tide tablet | THE SEVENTH TIDE\n\nWe built the Engine to hold the sea back from our coasts. Every seventh tide it drank.\n\nBut the sea it drank went somewhere. Our coasts stayed dry; every other coast drowned. When we understood, we sealed the gears in the tombs and put a giant to watch it. Never wake it.
note cablocker Crane cab locker | The crane operator's locker: a heavy iron key on a ring stamped CAGE - and some tools.
loot cablocker story:cagekey*1;Scrap*2;Bolt*3
prop cablocker loot.refill=0
note kettsatchel Kett's satchel | Kett's satchel: her compass, her notebook - and a bundle of trade tokens "for the one who followed".
loot kettsatchel TradeToken*6;Rope*2;Feather*3
prop kettsatchel loot.refill=0
prop kettsatchel if.open=signal|kettfree
prop kettsatchel else.open=message||Kett's satchel is in the cage with her. The cage key first.
note kettwarning Kett's warning | Kett, out of the cage, her voice hoarse:\n\n"Turn it off. It was never meant to hold the sea back - it raised it. Every seventh tide, a finger's width, for a thousand years. The beam wakes the heart; the Seventh lever puts it to sleep. And mind the beast - the Syndicate's boss left it in the well."
note heartinscription Heart inscription | HERE SLEEPS THE HEART OF THE ENGINE.\n\nWake it with light. Put it to sleep with the Seventh lever, and take its seventh tooth so that no one wakes it again.
note treasury Engine treasury | The Engine's treasury: the builders' gold-work, titanium - and in the middle, on a cushion gone to dust, a brass ring with seven teeth. The Seventh Tide.
loot treasury story:relic*1;TitaniumIngot*4;TradeToken*10;MetalIngot*4
prop treasury loot.refill=0
prop treasury if.open=signal|stopped
prop treasury else.open=message||The treasury's lid is locked to the Engine. While the Engine runs, it stays shut.

prop landing zone.id=landing
prop landing zone.radius=8
prop landing zone.repeat=never
prop landing zone.message=Kett's camp - torn tents - and dogs coming out of the rocks. It's a Syndicate ambush!
prop ambushdogs creature.count=6
prop ambushdogs creature.respawn=0
prop ambushdogs creature.zone=landing
prop ambushdogs tint.color=#c8a46a
prop ambushdogs tint.amount=0.5
prop radio obj.name=radio
prop radio beh.use=Use the Syndicate's radio
prop radio if.use=has|story:radiocodes|1
prop radio else.use=message||The radio hisses. Without the Syndicate's codes it is just noise.
prop radio on.use=signal||radio\ngive||story:taunt*1\nmessage||A voice through the static: "So the professor's little helper made it. Too late. At the seventh tide the Engine wakes - and the sea rises for us."

