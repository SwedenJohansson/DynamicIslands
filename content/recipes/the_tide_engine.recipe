prop kettcage survivor.name=Isadora Kett
prop kettcage survivor.id=seventhtide_kett
prop kettcage survivor.key=cagekey
prop kettcage survivor.signal=kettfree
prop kettcage survivor.line=At last! The gears, the giant - you followed me all the way. Listen: the Engine must be turned off. I'll wait on your raft.

