for _vx 0.8 6.7 5.9
place TP_Moontown_Barrel01 hcvat at $_vx 0.9 y=0.3 sit drop
place TP_Moontown_Barrel01 hcvat at $_vx 5.2 y=0.3 sit drop
next
place Zone_Atmosphere hcvatmist at 3.75 3.2 y=1.2
place Zone_Trigger hcvats at 3.75 3.6 y=1
place Loot_ChestSmall hcvatlocker at 3.75 3.9 y=0.6 sit drop yaw=180
pop
