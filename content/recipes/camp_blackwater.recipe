call shallows r=72 deep=5 n=2
call shallows x=12 z=38 r=14 deep=3 seed=90

# --- SILVER 10-26 (the user: one hour per island - hills, cliffs, a cave, a house, a wreck, secrets): Pike Knob ------
# Pike Knob with the ranger's radio mast on it, Bear Hollow, the ruined house where Walt Pruitt waits (four lamps round it: a puzzle), a plane wreck,
# a jump course, five camp badges about the island (a set), and at the house the camp loudspeaker that wants the radio valve and the amplifier fuse
call hw_zone x=55.07 z=4.35 al=cb_trailz id=cb_trail r=5 msg="The trail up Pike Knob starts here - round and up."
call hw_zone x=76 z=6 al=cb_summitz id=cb_summit r=8 h=1 msg="The top of Pike Knob. The whole island below you."
place Creature_Goat cb_goats at 59.07 7.35 ground
prop cb_goats creature.count=2
call hw_mast x=73 z=8 h0=18 lv=6 a=cb_mast chest=cb_topchest top=Placeable_Lantern_Metal
call ar_cave x=-10 z=-80 h=3 yaw=0 al=cb_caverock chest=cb_cavechest
call hw_zone x=-11 z=-71 al=cb_cavez id=cb_cave r=4 h=1 msg="Bear Hollow. Water drips somewhere in the dark."
call ar_ruin x=-78 z=-4 h=3.5 yaw=0 w=3 d=2 al=cb_ruin
call ss_islander x=-79 z=-8.5 yaw=200 al=cb_isl nm="Walt Pruitt" pose=lean
prop cb_isl talk.text=You came in by boat? Then you missed the ranger too. He came once a week. Then he stopped.\n---\nI'm the caretaker. Thirty summers. I stay when the kids go home - somebody has to mend the canoes.\n---\nThe loudspeaker wants its valve back from the radio mast on Pike Knob, and the fuse the kids hid in Bear Hollow. Bring both and we hear the old reel again.\n---\nAnd my porch lamps - four round the cottage. Each one you turn wakes the next one too. Light all four and look behind the back wall.
call ss_lamp x=-85 z=-5 al=cb_lamp1 nm="Porch lamp 1" grp="Porch lamps" on=0
call ss_lamp x=-79 z=2 al=cb_lamp2 nm="Porch lamp 2" grp="Porch lamps" on=1
call ss_lamp x=-72 z=-5 al=cb_lamp3 nm="Porch lamp 3" grp="Porch lamps" on=0
call ss_lamp x=-79 z=-12 al=cb_lamp4 nm="Porch lamp 4" grp="Porch lamps" on=1
prop cb_lamp1 on.use=light|Porch lamp 2|toggle
prop cb_lamp2 on.use=light|Porch lamp 3|toggle
prop cb_lamp3 on.use=light|Porch lamp 4|toggle
prop cb_lamp4 on.use=light|Porch lamp 1|toggle
prop cb_lamp1 on.alllit=show|cb_lampchest\nmessage||All four lamps burn. Behind the back wall a stone has been lifted.
call ss_hidden x=-77 z=0.6 al=cb_lampchest
place Creature_Chicken cb_hens at -70 2 ground
prop cb_hens creature.count=3
call ar_plane x=-34 z=82 h=3 yaw=160 al=cb_plane crate=cb_planecrate
place Note_Paper cb_pilot at -29.56 81.49 ground y=0.1 drop yaw=190
call hw_zone x=-34 z=82 al=cb_planez id=cb_plane r=6 h=1 msg="A plane, nose down in the grass. Nobody came for it."
# JUMP cb pad=2.5 at=-34 -40
push at -34 -40
clear at 0 0 r=17 all
brush flatten at 0 0 r=14 s=20 frames=300 h=2.5
brush smooth at 0 0 r=18 s=4 frames=40
brush flatten at 0 0 r=12 s=20 frames=300 h=2.5
brush auto at 0 0 r=18 s=10 frames=25
clear at 0 0 r=18
place Block_Foundation_Tier3 jpcb at 4.24 4.24 h=3.1
place Block_Foundation_Tier3 jpcb at 5.77 1.65 h=3.85
place Block_Foundation_Tier3 jpcb at 5.85 -1.35 h=4.6
place Block_Foundation_Tier3 jpcb at 4.46 -4.01 h=5.35
place Block_Foundation_Tier3 jpcb at 1.95 -5.67 h=6.1
place Block_Foundation_Tier3 jpcb at -1.04 -5.91 h=6.85
place Block_Foundation_Tier3 jpcb at -3.78 -4.66 h=7.6
place Block_Foundation_Tier3 jpcb at -5.56 -2.25 h=8.35
place Block_Foundation_Tier3 jpcb at -5.96 0.73 h=9.1
# JUMP from 10
place Block_Foundation_Tier3 jpcb at -4.85 3.53 h=9.85
place Block_Foundation_Tier3 jpcb at -2.54 5.44 h=10.6 sx=2 sz=2
# JUMP end
place Block_Foundation_Tier3 jppcb at 5.77 1.65 h=3.168 sy=1.861
place Block_Foundation_Tier3 jppcb at 5.85 -1.35 h=3.918 sy=2.959
place Block_Foundation_Tier3 jppcb at 4.46 -4.01 h=4.668 sy=4.058
place Block_Foundation_Tier3 jppcb at 1.95 -5.67 h=5.418 sy=5.157
place Block_Foundation_Tier3 jppcb at -1.04 -5.91 h=6.168 sy=6.255
place Block_Foundation_Tier3 jppcb at -3.78 -4.66 h=6.918 sy=7.354
place Block_Foundation_Tier3 jppcb at -5.56 -2.25 h=7.668 sy=8.453
place Block_Foundation_Tier3 jppcb at -5.96 0.73 h=8.418 sy=9.552
place Block_Foundation_Tier3 jppcb at -4.85 3.53 h=9.168 sy=10.650
place Block_Foundation_Tier3 jppcb at -2.54 5.44 h=9.918 sy=11.749 sx=2 sz=2
prop jpcb tint.color=#8a7f70
prop jpcb tint.amount=0.35
prop jppcb tint.color=#8a7f70
prop jppcb tint.amount=0.35
place Loot_Chest jccb at -1.04 -5.91 h=6.85 sit yaw=0
prop jccb loot.refill=0
place Loot_ChestSmall jbcb at -2.54 5.44 h=10.6 sit yaw=0
prop jbcb loot.refill=0
pop
