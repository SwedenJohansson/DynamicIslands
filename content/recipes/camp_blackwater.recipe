call hw_machine x=-69 z=-13 yaw=-45 al=cb_machine nm="Camp loudspeaker" obj=RT_PowerBox sc=1 a=cb_top b=cb_cave done=cb_fixed rew=cb_rewchest rnote=cb_rewnote msg="It works." hint="It wants the radio valve from Pike Knob and the amplifier fuse from Bear Hollow."
call hw_note x=-71.6 z=-11.8 yaw=-25 al=cb_hint
call ss_piece x=62 z=-19 al=cb_piece1 set="Camp badges"
call ss_piece x=-1 z=56 al=cb_piece2 set="Camp badges"
