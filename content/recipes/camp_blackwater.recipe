call ss_piece x=26 z=14 al=cb_piece5 set="Camp badges"
prop cb_piece1 on.set=show|cb_setchest\nmessage||All five camp badges found.
call ss_hidden x=-73 z=-16 al=cb_setchest kind=Loot_Chest
