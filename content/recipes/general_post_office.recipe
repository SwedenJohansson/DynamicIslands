call hw_machine x=0 z=44 yaw=180 al=qg_machine nm="Square fountain" obj=RT_PowerBox sc=1 a=qg_top b=qg_cave done=qg_fixed rew=qg_rewchest rnote=qg_rewnote msg="It works." hint="It wants the fountain valve from Postmaster's Hill and the fountain spout from Crab Cave."
call hw_note x=-2.6 z=45.2 yaw=200 al=qg_hint

# --- Settings, notes, behaviours, quest --------------------------------------------------------------------------------
info title=The General Post Office
info author=Custom Islands
info description=The Coastal Post's grand head office on a half-drowned square: a white colonnade, a clock tower, a sorting hall, the archive above and the roof over all. Ada Lind is waiting there with the last of the post. The finale of The Last Post.
island on.arrive=message||A white colonnade over a drowned square, a clock tower stopped at ten to nine - the General Post Office. On its roof, a flag is still flying.

prop clocktower tint.color=#cfc6b4
prop clocktower tint.amount=0.5
prop gpo tint.color=#d8d2c4
prop gpo tint.amount=0.55
prop colonnade tint.color=#f2f0ea
prop colonnade tint.amount=0.85
prop archive tint.color=#cfc6b4
prop archive tint.amount=0.5
prop sacks tint.color=#b8a478
prop sacks tint.amount=0.75
prop hyenas creature.count=4
prop hyenas creature.respawn=0
prop rats creature.count=6
prop rats creature.respawn=0
prop rats creature.zone=archive
prop broodmother creature.count=1
prop broodmother creature.respawn=0
prop broodmother creature.zone=roof
prop broodmother creature.size=1.8
prop broodmother creature.health=6
prop broodmother creature.damage=1.5
prop broodmother boss.phase=0.5
prop broodmother boss.summon=4
prop broodmother boss.summonKind=Creature_StoneBird
prop broodmother tint.color=#3a3632
prop broodmother tint.amount=0.6
prop turtle creature.count=1

story clockset|Clock set|Note_Paper|The General Post Office's clock, wound and set: the doors unbolt.
story gpoweighed|Parcel weighed|Note_Paper|A registered parcel weighed at the General Post Office.
story routed|Router set|Note_Paper|The sorting hall's pneumatic router, sending to the vault again.
story vaultcard|Vault combination card|Note_Paper|The registered mail vault's combination, on a card from the capsule.
story vaultopen|Vault keypad open|Note_Paper|The vault keypad, unlocked.
story arvidkey|Arvid's cage key|Placeable_Lantern_Metal|The key of Postman Arvid's cage in the archive, from the registered mail vault.
story liftridden|Lift ridden|Note_Paper|The porters' lift up to the archive.
story staffletter|Staff letter|Note_Paper|A letter from the General Post Office's last staff.
story cratelifted|Crate lifted|Note_Paper|The archive claw has lifted the crate of the letters of the world.
story lastletter|The Last Letter|Note_Paper|The last letter of the Coastal Post, addressed in Ada's hand: "To whoever carries the post now".
story semaphore|Semaphore sent|Note_Paper|The roof's semaphore mast has signalled: post delivered.
story adajoined|Ada joins|Note_Paper|Ada Lind, postmistress, has joined the crew.

note notice Notice of closure | GENERAL POST OFFICE - NOTICE OF CLOSURE\n\nOwing to the rising water this office is closed until further notice. Registered mail is held in the vault.\n\nThe front doors are bolted on the clock: wind the tower's crank and set the clock, and they unbolt as at opening time.\n\nBeware: dogs in the arcade.
note kiosk Kiosk | The news kiosk's till and its last papers: "POST TO CONTINUE BY BOAT". A few coins of the old money and a tin of biscuits.
loot kiosk TradeToken*3;Cooked_Potato*2;Rope*2
prop kiosk loot.refill=0
prop clockcrank obj.name=clockcrank
prop clockcrank beh.use=Wind and set the clock
prop clockcrank if.use=!signal|clockset
prop clockcrank on.use=sound||event:/raft/radar/lever\nmessage||The crank grinds round and round; up on the tower the hands swing to nine o'clock and a bell strikes. Across the square, the post office doors unbolt.\nsignal||crank\nsignal||clockset\ngive||story:clockset*1
prop clockcrank else.use=message||The clock is set and running.
prop frontdoors obj.name=frontdoors
prop frontdoors beh.use=Open the front doors
prop frontdoors if.use=signal|clockset
prop frontdoors on.use=hide|\nmessage||The bolts are drawn back: the front doors swing open on the sorting hall.
prop frontdoors else.use=message||The front doors are bolted. A brass plate: "OPENS AT NINE BY THE TOWER CLOCK".

note rules Sorting hall rules | GENERAL POST OFFICE - SORTING HALL\n\n1. Every registered parcel is weighed before it goes to the vault. Three were waiting at closing.\n2. The router sends the weighed parcels' slip to the vault by tube - throw it once the scales are done.\n3. The vault sends its combination back by capsule. Destroy the card after use. (Nobody ever does.)
macro scaleuse al=gposcale1
prop $al obj.name=$al
prop $al beh.use=Weigh a registered parcel
prop $al if.use=!signal|$al
prop $al on.use=message||The scales tip, sway and settle. Weighed and logged.\nsignal||scales\nsignal||$al\ngive||story:gpoweighed*1
prop $al else.use=message||This scale's parcel is weighed already.
end
push at 0 -20
call scaleuse al=gposcale1
call scaleuse al=gposcale2
call scaleuse al=gposcale3
prop router obj.name=router
prop router beh.use=Throw the pneumatic router
prop router if.use=has|story:gpoweighed|3\n!signal|routed
prop router on.use=open|\nsignal||wire\nsignal||routed\ngive||story:routed*1\nshow|capsule\nmessage||The router clacks over. Tubes hiss along the ceiling - and a minute later a capsule drops into the rack by the vault.
prop router else.use=message||The router won't throw: three parcels must be weighed first. Or it is thrown already.
note capsule Capsule from the vault | (A brass capsule from the vault's tube. Inside, a card:)\n\nREGISTERED MAIL VAULT - COMBINATION\n1 8 4 0\n(the year of the first stamp)
prop capsule obj.name=capsule
prop capsule beh.hidden=1
prop capsule on.read=give||story:vaultcard*1
prop vaultpad obj.name=vaultpad
prop vaultpad beh.use=Type the vault combination
prop vaultpad lock.code=1840
prop vaultpad if.use=has|story:vaultcard|1
prop vaultpad on.use=sound||event:/exploring/obstacles/keypad/keypad_correct\nmessage||The keypad chirps and the registered mail vault unbolts.\nsignal||regvault\ngive||story:vaultopen*1
prop vaultpad else.use=message||The keypad wants the vault's combination. The vault sends it by capsule.
note regvault Registered mail vault | The registered mail vault: parcels never collected, insured letters - and a key on a tag: ARCHIVE, CAGE 2.
loot regvault story:arvidkey*1;TradeToken*6;MetalIngot*3;Battery*1;TitaniumIngot*3
prop regvault loot.refill=0
prop regvault if.open=signal|regvault
prop regvault else.open=message||The registered mail vault is bolted from the keypad by it.

prop gpolift on.use=switch|\nwait|5\nshow|gpoliftup\nhide|\ngive||story:liftridden*1
note staff1 Staff letter: Night porter | To whoever is left - I've gone home. The archive is full of rats and the lift jams at the top. Arvid went up after the crate and hasn't come down. - Porter Nils
prop staff1 on.read=give||story:staffletter*1
note staff2 Staff letter: Head sorter | The letters of the world are in the big crate - everything we never delivered. The claw can lift it, if anyone still knows how to run it. I locked Arvid in for his own good; the key is in the vault. - Head sorter Greta
prop staff2 on.read=give||story:staffletter*1
note staff3 Staff letter: Postman Arvid | I'm in the cage by the claw. Greta locked it for my own good - the rats, she says. The last letter is in the crate, on top. Bring the key. - Arvid
prop staff3 on.read=give||story:staffletter*1
prop archivezone zone.id=archive
prop archivezone zone.radius=4
prop archivezone zone.repeat=never
prop archivezone zone.message=The archive: shelves, letters everywhere - and in the dark between the shelves, rats. Lots of rats.
prop arvidcage obj.name=arvidcage
prop arvidcage survivor.name=Arvid
prop arvidcage survivor.id=lastpost_arvid
prop arvidcage survivor.key=arvidkey
prop arvidcage survivor.signal=arvidfree
prop arvidcage survivor.line=Ada sent you? Then it's nearly done. The claw's controls are by the crate - the last letter's on top. She's up on the roof.
note arvidbag Arvid's satchel | Postman Arvid's satchel: his cap, his route book and a flask of cold tea.
loot arvidbag Bolt*3;Rope*2;Cooked_Potato*2
prop arvidbag loot.refill=0
prop arvidbag if.open=signal|arvidfree
prop arvidbag else.open=message||Arvid's satchel - and Arvid is still in the cage beside it.
prop claw obj.name=claw
prop claw beh.use=Run the archive claw
prop claw if.use=signal|arvidfree\n!signal|cratelifted
prop claw on.use=sound||event:/raft/radar/lever\nmessage||The claw swings out over the archive, drops, grips and lifts the great crate down on to the terrace.\nsignal||claw\nsignal||cratelifted\ngive||story:cratelifted*1\nshow|lettercrate
prop claw else.use=message||Arvid knows how to run the claw - and Arvid is in the cage. Or the crate is down already.
note lettercrate Letters of the world | The crate of the letters of the world: everything the Coastal Post never delivered. On top, one letter in Ada's handwriting.
loot lettercrate story:lastletter*1;Rope*2;TradeToken*4
prop lettercrate obj.name=lettercrate
prop lettercrate beh.hidden=1
prop lettercrate loot.refill=0

prop semlever obj.name=semlever
prop semlever beh.use=Work the semaphore
prop semlever if.use=!signal|semaphore
prop semlever on.use=sound||event:/raft/radar/lever\nmessage||The semaphore arms swing: POST - DELIVERED. From behind the flag, someone laughs.\nsignal||semaphore\ngive||story:semaphore*1\nshow|adawelcome
prop semlever else.use=message||The semaphore says it already: POST DELIVERED.
note adawelcome Ada's welcome | So you came. Every letter, every stop - I knew the post would get through.\n\nI'm Ada Lind. I kept the Coastal Post running as long as there was water to row on, and then I waited up here for whoever would carry it on.\n\nYou have the last letter? Sound the post-horn, then, and I'll come with you. There's a whole sea that wants its post.
prop adawelcome obj.name=adawelcome
prop adawelcome beh.hidden=1
prop posthorn obj.name=posthorn
prop posthorn beh.use=Sound the post-horn
prop posthorn if.use=signal|semaphore\ntake|story:lastletter|1
prop posthorn on.use=sound||event:/raft/radar/lever\nmessage||The post-horn rings out over the drowned square. Ada takes the last letter, reads it, smiles - and picks up her bag. Ada Lind has joined the crew.\ncharacter||Mayu\ngive||story:adajoined*1\nsignal||adajoined
prop posthorn else.use=message||The post-horn. Ada's welcome first - and you'll need the last letter from the archive's crate.

prop squarezone zone.id=square
prop squarezone zone.radius=6
prop squarezone zone.message=The square: drowned to the south, a stopped clock tower, and the post office behind its white colonnade.
prop hallzone zone.id=main_hall
prop hallzone zone.radius=3
prop hallzone zone.message=The sorting hall: tables, scales, the tubes along the ceiling, and the vault at the back.
prop stairzone zone.id=stair
prop stairzone zone.radius=3
prop stairzone zone.message=The porters' lift to the archive terrace.
prop roofzone zone.id=roof
prop roofzone zone.radius=4
prop roofzone zone.repeat=never
prop roofzone zone.message=The roof. A flag, a semaphore mast - and the screechers' brood mother rising off her nest.
prop flagzone zone.id=flag
prop flagzone zone.radius=3
prop flagzone on.enter=camera|flagcam||6|50
prop flagcam obj.name=flagcam

story qg_top|Fountain valve|Bolt|The square's fountain valve, carried up the weather mast on Postmaster's Hill.
story qg_cave|Fountain spout|Bolt|The fountain's brass spout, a fish with its mouth open, in a chest at the back of Crab Cave.
story qg_fixed|Square fountain working|Bolt|The square fountain, working again.
note qg_hint Fountain notice | FOUNTAIN OFF. Valve on the weather mast up Postmaster's Hill (north-west), spout in Crab Cave (north-east). Sigge, the old porter, at the house in the east knows the rest.
note qg_topchest Weather mast deck box | A box lashed to the deck rail at the top of the weather mast.
loot qg_topchest story:qg_top*1;Rope*2;Scrap*2
note qg_cavechest Crab Cave chest | A chest at the back of Crab Cave, dry under the rock.
loot qg_cavechest story:qg_cave*1;Nail*6;Plank*3
note qg_rewnote Letter in the basin | Water rises from the brass fish and falls into the basin. On the bottom, among the coins, a letter in a bottle: 'To whoever turns the fountain on again: the Post will open again. - A.'
note qg_rewchest Square fountain reward | What the square fountain kept.
loot qg_rewchest MetalIngot*3;Bolt*3;Rope*2
note qg_lampchest Sigge's tin | Sigge's tin behind the house: forty years of tips.
loot qg_lampchest TradeToken*3;CopperIngot*2;Rope*2
note qg_setchest Seal case | The counter's seal case: all five wax seals back, and the registered fees.
loot qg_setchest TradeToken*3;MetalIngot*2;Glass*2
note qg_planecrate Air mail crate | The air mail plane's crate: letters for the whole coast, and the pilot's tools.
loot qg_planecrate Plastic*3;Scrap*3;Nail*6
prop qg_planecrate loot.refill=0
note qg_pilot Air mail manifest | COASTAL POST AIR MAIL - INBOUND, GENERAL POST OFFICE. The square is under water. Landed on the hill road. Letters in the crate. Nobody to sign for them.
note jcqg Column climb | Broken columns from the old colonnade, stood one higher than the next.
loot jcqg Rope*3;Plank*4;MetalIngot*1
note jbqg Top of the columns | Somebody's stash at the very top.
loot jbqg CopperIngot*1;Bolt*2;TradeToken*1
note qg_mazechest Returned parcel | A parcel at the heart of the wall maze, returned to sender eleven times.
loot qg_mazechest TradeToken*2;Glass*2;CopperIngot*2

quest title=The Last Post
quest intro=The General Post Office, on its drowned square. Walk into the square.
step reach|square|1|Walk into the square
step read|Notice of closure|1|Read the notice of closure
step kill|Hyena|4|Drive the dogs out of the arcade
step open|Kiosk|1|Open the news kiosk
step collect|story:clockset|1|Wind the clock tower's crank
step reach|main_hall|1|Go into the sorting hall
step read|Sorting hall rules|1|Read the sorting hall rules
step collect|story:gpoweighed|3|Weigh the three registered parcels
step collect|story:routed|1|Throw the pneumatic router
step read|Capsule from the vault|1|Read the capsule from the vault
step collect|story:vaultcard|1|Keep the vault combination card
step collect|story:vaultopen|1|Open the vault keypad
step open|Registered mail vault|1|Open the registered mail vault
step reach|stair|1|Go out the back to the porters' lift
step collect|story:liftridden|1|Ride the lift up to the archive
step collect|story:staffletter|3|Read the three staff letters in the archive
step kill|Rat|6|Clear the rats from the archive
step open|Arvid's satchel|1|Free Postman Arvid from his cage and open his satchel
step collect|story:cratelifted|1|Run the archive claw
step collect|story:lastletter|1|Take the last letter from the crate
step reach|roof|1|Ride the second lift to the roof
step kill|Screecher|1|Defeat the screechers' brood mother
step collect|story:semaphore|1|Work the semaphore mast
step read|Ada's welcome|1|Read Ada's welcome
step collect|story:adajoined|1|Sound the post-horn with the last letter
step read|Fountain notice|1|Read the fountain notice by the square fountain
step talk|Sigge|1|Talk to Sigge at the ruined house in the east
step reach|qg_trail|1|Find the foot of the trail up Postmaster's Hill, in the north-west
step reach|qg_summit|1|Climb the trail to the top of Postmaster's Hill
step collect|story:qg_top|1|Climb the weather mast and take the fountain valve from its deck
step reach|qg_cave|1|Find Crab Cave in the north-east
step collect|story:qg_cave|1|Take the fountain spout from the chest at the back of the cave
step read|Letter in the basin|1|Bring both to the square fountain and read what it shows
step reach|flag|1|Go to the flag
quest done=The last post is delivered. Ada Lind sails with you now - and there is a whole sea that wants its post.
quest reward=MetalIngot*4;Battery*2;TradeToken*8

# Buried treasure (one of the story line's last islands): titanium ore on top of Raft's own treasure loot - the metal detector finds it, the shovel digs it
call treasure x=0 z=0 r=40 n=1 seed=8820
prop treasure8820 treasure.loot=TitaniumOre*3

# --- Raft's vehicles (VI4, 2026-10-23): parked on open ground, clear of paths and quest objects ---
place VP_Forklift - at 6 -37 ground sit yaw=90
pop
save The General Post Office
