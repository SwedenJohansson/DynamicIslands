prop treasure27978 treasure.loot=TitaniumOre*3;MetalOre*2;TradeToken*1
call shallows x=0 z=0 r=108 deep=5 n=1 seed=27961
call ar_plants_hill x=82 z=18 r=14 seed=27991
call ar_plants_hill x=-82 z=10 r=14 seed=27992
call ar_plants_hill x=26 z=50 r=14 seed=27993
call ar_plants_hill x=82 z=-10 r=14 seed=27994
call ar_plants_hill x=58 z=30 r=14 seed=27995
