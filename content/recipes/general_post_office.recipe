place Block_Foundation_Tier3 jppqg at 4.85 -3.53 h=9.668 sy=10.650
place Block_Foundation_Tier3 jppqg at 2.54 -5.44 h=10.418 sy=11.749 sx=2 sz=2
prop jpqg tint.color=#8a7f70
prop jpqg tint.amount=0.35
prop jppqg tint.color=#8a7f70
prop jppqg tint.amount=0.35
place Loot_Chest jcqg at 1.04 5.91 h=7.35 sit yaw=0
prop jcqg loot.refill=0
place Loot_ChestSmall jbqg at 2.54 -5.44 h=11.1 sit yaw=0
prop jbqg loot.refill=0
pop
