call lp_piece x=-54 z=-21 al=qg_piece2 set="Registered seals"
call lp_piece x=50 z=34 al=qg_piece3 set="Registered seals"
call lp_piece x=-4 z=74 al=qg_piece4 set="Registered seals"
call lp_piece x=56 z=-72 al=qg_piece5 set="Registered seals"
prop qg_piece1 on.set=show|qg_setchest\nmessage||All five registered seals found.
call lp_hidden x=5 z=40 al=qg_setchest kind=Loot_Chest
