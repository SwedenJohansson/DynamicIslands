pop
call airpocket x=-3 z=0 id=captains_room al=captair bub=captbub r=2.5 msg="The captain's room - dry air, stale and cold. Someone has been breathing it."
push at 6 0 h=8
call rt_storey a=whalehull l1=none l2=none l3=none f1=RT_WallWindowBroken
place RT_Floor whalehull at 0 4.5 y=3
