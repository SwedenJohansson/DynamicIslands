prop room3air zone.radius=2.5
prop room3air zone.repeat=1
prop room3air zone.air=1
prop room3air zone.message=Pressure room 3. Charts on the wall, air under the roof.
prop room4air zone.id=room_4
prop room4air zone.radius=2.5
prop room4air zone.repeat=1
prop room4air zone.air=1
prop room4air zone.message=Pressure room 4. The ark valve, and a radio still on.
prop surfacezone zone.id=surface_hole
prop surfacezone zone.radius=6
prop surfacezone zone.message=The surface hole: daylight through the ice. Up, and home.
prop iceanglers creature.count=3
prop iceanglers creature.respawn=0
prop iceanglers creature.zone=ark_anglers
prop puffers creature.count=3
prop puffers creature.respawn=0

prop gatelever obj.name=gatelever
prop gatelever beh.use=Pull the ice gate's lever
prop gatelever on.use=hide|gate\nmessage||The ice gate grinds aside. Forty breaths - swim!\nwait|40\nshow|gate
prop arkvalve obj.name=arkvalve
prop arkvalve beh.use=Turn the ark valve
prop arkvalve if.use=!signal|arkvalve\nhas|story:pumpsrun|1\ntake|story:arkseal|3
prop arkvalve else.use=message||The valve's seal plate has three empty sockets. The manifest says: seals in rooms 1, 2 and 3. And the valve is dead while the pumps are: the pump engineer's log lies by it.
story arkseal|An ark seal|Placeable_Lantern_Metal|A brass seal for the ark valve's plate.
story rackcode|The last rack's code|Placeable_Lantern_Metal|The Coldhold's control code opened the last rack.
note seal1 Room 1 seal box | A box under the roof of pressure room 1: an ark seal in wax, and spare filters.
loot seal1 story:arkseal*1;Plastic*3;Glass*2
prop seal1 loot.refill=0
note seal2 Room 2 seal box | A box under the roof of pressure room 2: an ark seal in wax, a dry torch.
loot seal2 story:arkseal*1;Bolt*2;Rope*2
prop seal2 loot.refill=0
note seal3 Room 3 seal box | A box under the roof of pressure room 3: an ark seal in wax, the keeper's pencil.
loot seal3 story:arkseal*1;CopperIngot*2;Scrap*2
prop seal3 loot.refill=0
note lastrack Last rack locker | Rack 96's locker: the keepers' own seeds and their pay.
loot lastrack TradeToken*5;TitaniumIngot*1;Seed_Flower_Blue*2;Seed_Flower_Red*2
prop lastrack loot.refill=0
prop lastrack obj.name=lastrack
prop lastrack if.open=signal|rackcode
prop lastrack else.open=message||Locked. The keypad wants four digits - the same as the vault above, says a scratched note.
prop rackpad obj.name=rackpad
prop rackpad beh.use=Type the last rack's code
prop rackpad lock.code=2240
prop rackpad on.use=sound||event:/exploring/obstacles/keypad/keypad_correct\nmessage||The keypad beeps. The last rack's locker opens.\nsignal||rackcode\ngive||story:rackcode*1
prop rackpad else.use=message||Four digits. The keepers used the control room's code for everything.
prop arkvalve on.use=signal||arkvalve\ngive||story:arkvalve*1\nshow|racklights\nshow|closingnote\nmessage||The valve turns. Down every hall, the racks' lights come on, one after another.

quest title=The Ark
quest intro=Down through the flood door. Dive to the Seed Ark.
step reach|drop|1|Dive down the flood door's shaft to the Seed Ark
step reach|room_1|1|Get to pressure room 1 and breathe
step read|Ark manifest|1|Read the Ark manifest
step kill|Angler fish|3|Deal with the three ice anglers
step reach|room_2|1|Pull the ice gate's lever and get through to pressure room 2 before it shuts
step reach|room_3|1|Swim on to pressure room 3
step read|The Ringwave file|1|Read the Ringwave file
step reach|room_4|1|Swim on to pressure room 4
step collect|story:arkseal|3|Find the valve's three seals (pressure rooms 1, 2 and 3)
step read|Pump engineer's log|1|The valve won't turn on dead pumps. Read the pump engineer's log in room 4
step reach|pump_islet|1|Swim up and out to the pump islet in the south-east
step collect|story:rodset|3|Bring the three cooling rods from the flooded halls (east, west, north) and set them in the sockets
step collect|story:pumpkey|1|Pull the cooling station's lever for the pump key
step collect|story:valveturned|3|Open the islet's three valves (the gas: take a suit from a cabinet)
step reach|pump_top|1|Climb the pump tower
step collect|story:pumpsrun|1|Throw the pump switch
step collect|story:arkvalve|1|Turn the ark valve
step read|The closing note|1|Read the closing note
step reach|surface_hole|1|Swim up to the surface hole
quest done=The Ark is turned, the vault's way finished. Up through the ice, and home.
quest reward=MetalIngot*4;CopperIngot*4;TradeToken*8

prop closingnote obj.name=closingnote
prop gate obj.name=gate
prop racklights obj.name=racklights
