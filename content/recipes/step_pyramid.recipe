place RT_GroundPillarCap rainstones at 23.9 0 h=23.85 sy=1.68 scale=0.75
place RT_GroundPillarCap rainstones at 25.5 0 h=23.85 sy=1.68 scale=0.75
place RT_GroundPillarCap rainstones at 27.1 0 h=23.85 sy=1.68 scale=0.75
place RT_GroundPillarCap rainstones at 28.7 0 h=23.85 sy=1.68 scale=0.75
brush flatten from 29 0 to 33 0 r=3.2 s=20 frames=300 h=23.85
push at 29 -1.5 h=23.85
place RT_Wall1 - at 3 0 y=0
place RT_Wall1 - at 3 3 y=0
place RT_Wall1 - at 3 0 y=0 yaw=90
place RT_Floor - at 3 3 y=3 sx=0.5 sz=0.3333
place Loot_ChestSmall rainchest at 1.9 1.5 y=0 sit yaw=270
place Placeable_BeeHive - at 2.5 2.4 y=0 sit
place Creature_BugSwarm_Bee bees at 2.5 2.4 y=1.8
pop

# --- The ruined terraces round the plaza: low walls of stone blocks sunk to show a metre, stumps of columns, rubble, the
# collapsed storehouse's box; the warthogs ---------------------------------------------------------------------------------
place RT_GroundPillar - at -20 18 h=24.8
place RT_GroundPillar - at -17.6 18 h=24.8
place RT_GroundPillar - at 18 -20 h=24.8
place RT_GroundPillar - at 20.4 -20 h=24.8
