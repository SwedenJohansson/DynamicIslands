place VP_RubblePile_Small02 - at -22 -14 ground yaw=-20
place "Box Small" storebox at 20.5 20.5 ground yaw=15
place Creature_Boar hogs at 16 22 ground
place Zone_Trigger terraces at 12 22 y=1

# --- The sacred well south of the pyramid: vines down its wall, the offering pots and the box on its floor, the guardian
# in its deep water, green-blue light in the shaft; the way out is the gorge to the sea ---------------------------------
place CaveVine1 - at -8 -20.6 h=23.6
place CaveVine3 - at -4.2 -20.5 h=23.6
place UT_EndRoom_Pot02 offeringpot at -7.5 -27.5 h=-10 sit
place UT_EndRoom_Pot03 - at -4.5 -25 h=-10 sit yaw=60
place Loot_ChestSmall offeringbox at -6 -26.5 h=-10 sit yaw=30
place Creature_AnglerFish guardian at -6 -26 h=-6
place Zone_Trigger cenote at -6 -19 h=24.8
place Zone_Atmosphere wellight at -6 -26 h=4

# --- Off the beach 4 m down: the explorers' lost barrel; animals: jungle fowl by the camp, turtles off the beach,
# dolphins out in the bay ------------------------------------------------------------------------------------------------
place Loot_SunkenBarrel beachbarrel at -26 62 ground
place Creature_Chicken fowl at -17 45 ground
prop fowl creature.count=3
place Creature_Turtle turtles at 10 62 h=-1
prop turtles creature.count=2
place Creature_Dolphin dolphins at 0 -78 h=-3
prop dolphins creature.count=2

# --- Raft's special features (lib_features; the user, 2026-10-10: every Raft feature on more than one island): two sun
# mirrors on the plaza (east and south of the pyramid) and the king's sun-locked chest between them
call mirrors x1=19.5 z1=-8 yaw1=0 x2=6 z2=-19.5 yaw2=90 a1=sunglass1 a2=sunglass2 chest=kingschest cx=16.8 cz=-17.2 cyaw=315 items=Glass*3;TradeToken*4;Seed_Flower_Red*2 title="The king's sun chest"
prop kingschest else.open=message||A gold eye in the lid, dark. The glyph around it: two suns. Both plaza mirrors must face it.

# --- Things to gather, as suits the island (the user, 2026-10-05): palms, bananas, melons ----------
scatter "Pickup_Landmark_Tree_Palm 1" 4 at 0 0 r=44.1 seed=4310 free=5
scatter "Pickup_Landmark_Tree_Palm 3" 4 at 0 0 r=44.1 seed=4311 free=5
scatter "Banana_Bush_2" 6 at 0 0 r=44.1 seed=4320 free=3
scatter "Pickup_Landmark_WatermelonLandmark" 6 at 0 0 r=44.1 seed=4330 free=3

# --- Raft's finds in the shallows round the island (lib_sea) ---------------------------------------------------------
call shallows r=72 deep=5 n=2

# --- SILVER 10-26 (the user: one hour per island - hills, cliffs, a cave, a house, a wreck, secrets): Jaguar Hill ------
# Jaguar Hill with the explorer's survey tower on it, Serpent Cave, the ruined house where Mateo Ruiz waits (four lamps round it: a puzzle), a plane wreck,
# a jump course, a maze, five jade beads about the island (a set), and at the house the calendar stone that wants the sun disc and the moon disc
call hw_zone x=-43.74 z=43.74 al=sp_trailz id=sp_trail r=5 msg="The trail up Jaguar Hill starts here - round and up."
call hw_zone x=-60 z=60 al=sp_summitz id=sp_summit r=8 h=1 msg="The top of Jaguar Hill. The whole island below you."
place Creature_Goat sp_goats at -39.74 46.74 ground
prop sp_goats creature.count=2
call hw_mast x=-63 z=62 h0=20 lv=6 a=sp_mast chest=sp_topchest top=Placeable_Flag_01
call ar_cave x=-20 z=90 h=3 yaw=180 al=sp_caverock chest=sp_cavechest
call hw_zone x=-19 z=81 al=sp_cavez id=sp_cave r=4 h=1 msg="Serpent Cave. Water drips somewhere in the dark."
call ar_ruin x=84 z=2 h=3 yaw=0 w=3 d=2 al=sp_ruin
call ss_islander x=83 z=-2.5 yaw=200 al=sp_isl nm="Mateo Ruiz" pose=sit
prop sp_isl talk.text=The doctora paid us to carry her boxes up the causeway. When the rains came, the others went home. I stayed.\n---\nThe calendar stone by the village tells the rain days - but only with its two discs. The sun disc hangs on her survey tower on Jaguar Hill, the moon disc is in Serpent Cave.\n---\nAnd the maze by the shore? The Rain Kings made it for their priests. There is something in the middle.\n---\nThe four torches round my house: each one you light wakes the next. Light all four and look behind the back wall.
place Placeable_Chair_Basic - at 83 -2.5 ground sit yaw=200
call ss_lamp x=77 z=1 al=sp_lamp1 nm="Torch post 1" grp="Torch posts" on=0
call ss_lamp x=83 z=8 al=sp_lamp2 nm="Torch post 2" grp="Torch posts" on=0
call ss_lamp x=90 z=1 al=sp_lamp3 nm="Torch post 3" grp="Torch posts" on=0
call ss_lamp x=83 z=-6 al=sp_lamp4 nm="Torch post 4" grp="Torch posts" on=0
prop sp_lamp1 on.use=light|Torch post 2|toggle
prop sp_lamp2 on.use=light|Torch post 3|toggle
prop sp_lamp3 on.use=light|Torch post 4|toggle
prop sp_lamp4 on.use=light|Torch post 1|toggle
prop sp_lamp1 on.alllit=show|sp_lampchest\nmessage||All four lamps burn. Behind the back wall a stone has been lifted.
call ss_hidden x=85 z=6.6 al=sp_lampchest
place Creature_Chicken sp_hens at 92 8 ground
prop sp_hens creature.count=3
call ar_plane x=-62 z=-28 h=1.5 yaw=60 al=sp_plane crate=sp_planecrate
place Note_Paper sp_pilot at -62.27 -23.54 ground y=0.1 drop yaw=90
call hw_zone x=-62 z=-28 al=sp_planez id=sp_plane r=6 h=1 msg="A plane, nose down in the grass. Nobody came for it."
