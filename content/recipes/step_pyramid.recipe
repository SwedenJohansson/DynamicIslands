# The Step Pyramid - a themed island, twice the size (x2)
# Inspiration: jungle-temple adventure films (a stepped pyramid on a jungle plateau, a sacred sinkhole full of offerings,
#   spiked doorways, hidden levers, a pit you cannot cross) - the mood only, never named on the island.
# Island type: Shape 4 (Plateau), Style 0 (tropical). A jungle-topped mesa (23.8 m) with sheer cliffs; the Rain Kings'
#   causeway cut up its west face; the pyramid on a plaza on top, a sinkhole beside it straight down past sea level.
# The Rain Kings farmed the plateau and threw jade into their sacred well to bring the rain. Three jade tablets were kept
# apart: in the Sun shrine (its doorway spiked), in the well (with its guardian), in the Rain shrine (beyond a moat of
# stakes). An explorer mapped it all and left her notes at the base camp. Lay the three on the summit altar.
# Quest "The Rain Kings" (20 steps): the base camp, the field notes, the causeway, the warthogs, the Sun shrine (a hidden
# lever), the sinkhole and its guardian, the well's tablet (a dive), the Rain shrine (the path appears), the summit, the
# carvings, the offering chest (medium crop plot blueprint, trade coins, spices).
#
# Built by the recipe player (CIRecipe step_pyramid) through the editor's own operations.
# SILVER 10-26: the new land - Jaguar Hill with the explorer's survey tower, Serpent Cave, Mateo Ruiz at the ruined house (a lamp puzzle), a plane wreck, a jump course, a maze, a set of five jade beads
include lib_sea
include lib_features
include lib_areas
include lib_highwater
include lib_silver

# tierwall: the face of one of the pyramid's tiers - the radio tower's stone blocks (2.4 m square, 3 m tall, their tops
# level with the tier) all round a square of half-size a (a = 1.2 + 1.2 x n), so each tier ends in a straight wall and not
# in a slope: the terrain behind them is the tier
macro tierwall a=15.6 h=26.22
for t {1.2-$a} {$a-1.2} 2.4
place RT_GroundPillar - at $t {$a-1.2} h=$h
place RT_GroundPillar - at $t {1.2-$a} h=$h
next
for t {3.6-$a} {$a-3.6} 2.4
place RT_GroundPillar - at {$a-1.2} $t h=$h
place RT_GroundPillar - at {1.2-$a} $t h=$h
next
end

new
# (nature: a jungle where the theme says so - the plateau's top a little denser than Raft's tropical islands, like
# Ironreef Caverns' jungle; the cliffs and beaches Like Raft)
gen Trees=0.38 Bushes=0.38 Rocks=0.43 Harvest=0.24 BeachThings=0.3
gen Seed=9013 Radius=63 Height=24 Roughness=0.35 Peaks=1 Shape=4 Style=0 BeachWidth=0.5 Cliffs=0.85 PeakShape=0.3
gen Water=0.5 SeaRocks=0.5 SeaFinds=0.5 Sunken=0.4 Hostiles=0
generate
# --- SILVER 10-26 terrain: the new land - pads raised from the sea (joined to the coast), Jaguar Hill ------------------------
brush flatten at 84 2 r=16 s=20 frames=500 h=3
brush smooth at 84 2 r=21 s=4 frames=40
brush flatten at 84 2 r=14 s=20 frames=500 h=3
brush flatten from 84 2 to 51.01 1.21 r=9 s=20 frames=500 h=3
brush flatten at -20 86 r=17 s=20 frames=500 h=3
brush smooth at -20 86 r=22 s=4 frames=40
brush flatten at -20 86 r=15 s=20 frames=500 h=3
brush flatten from -20 86 to -12.53 53.86 r=9 s=20 frames=500 h=3
brush flatten at -62 -28 r=17 s=20 frames=500 h=1.5
brush smooth at -62 -28 r=22 s=4 frames=40
brush flatten at -62 -28 r=15 s=20 frames=500 h=1.5
brush flatten at 38 -36 r=19 s=20 frames=500 h=2.5
brush smooth at 38 -36 r=24 s=4 frames=40
brush flatten at 38 -36 r=17 s=20 frames=500 h=2.5
call hw_mount x=-78 z=-52 b=12 h=8
brush flatten at 70 58 r=12 s=20 frames=500 h=3
brush smooth at 70 58 r=17 s=4 frames=40
brush flatten at 70 58 r=10 s=20 frames=500 h=3
brush flatten from 70 58 to 43.82 36.31 r=9 s=20 frames=500 h=3
call hw_mount x=-60 z=60 b=22 h=20
call hw_trail x=-60 z=60 b=22 h=20 a0=135 turn=300 n=40 h0=3
brush flatten from -43.74 43.74 to -40.2 40.2 r=7 s=20 frames=500 h=3

# --- Terrain: the pyramid raised out of the plateau's top in four square tiers 2.42 m high (a stair of Raft's fits each)
# and 3.6 m deep, painted stone (their faces are walls of stone blocks, below); the moat of stakes round the Rain shrine's pedestal on the east; the sacred well dug south of the pyramid
# down to 10 m under the sea; the causeway in two legs up the west face from the base camp's lowland (about 1:3) ---------
for zz -14 14 2.2
brush flatten from -14 $zz to 14 $zz r=2 s=20 frames=40 h=26.22
next
for zz -10.4 10.4 2.08
brush flatten from -10.4 $zz to 10.4 $zz r=2 s=20 frames=40 h=28.64
next
for zz -6.8 6.8 2.27
brush flatten from -6.8 $zz to 6.8 $zz r=2 s=20 frames=40 h=31.06
next
for zz -3.2 3.2 2.13
brush flatten from -3.2 $zz to 3.2 $zz r=2 s=20 frames=40 h=33.48
next
brush rock at 0 0 r=17 s=20 frames=30
brush flatten from 24 -4.5 to 37 -4.5 r=2 s=20 frames=120 h=19.8
brush flatten from 24 4.5 to 37 4.5 r=2 s=20 frames=120 h=19.8
brush flatten from 25 -4.5 to 25 4.5 r=2 s=20 frames=120 h=19.8
brush flatten from 36 -4.5 to 36 4.5 r=2 s=20 frames=120 h=19.8
brush flatten at -6 -26 r=6 s=20 frames=500 h=-10
# (a gorge from the well's south side through the cliff to the sea: the sea fills the well, and its way out is a swim)
brush flatten from -6 -31 to -6 -44 r=1.6 s=20 frames=300 h=-3
brush rock at -6 -26 r=8 s=20 frames=30
brush rock from -6 -31 to -6 -42 r=3 s=20 frames=20
for i 0 16 1
brush flatten at {-28-$i*0.8125} {42-$i*1.25} r=4.5 s=20 frames=20 h={3+$i*0.5}
next
for i 0 25 1
brush flatten at {-41+$i*0.08} {22-$i*1.52} r=4.5 s=20 frames=20 h={11+$i*0.508}
next
brush flatten from -39 -16 to -35 -16 r=4.5 s=20 frames=40 h=23.8
brush smooth from -28 42 to -41 22 r=4.5 s=10 frames=12
brush smooth from -41 22 to -39 -16 r=4.5 s=10 frames=12
brush flatten at -24 46 r=6 s=20 frames=60 h=3
# (no "origin": the set pieces keep the frame the strokes above used, the generated land's exact middle)
clear at 0 0 r=24
clear at -28 0 r=6
clear from 22 0 to 38 0 r=8
clear at -6 -26 r=10
clear from -6 -31 to -6 -46 r=3
clear from -28 42 to -41 22 r=5
clear from -41 22 to -37 -16 r=5
clear at -24 46 r=9

# --- The base camp on the lowland at the causeway's foot: two tents, the chart table with the field notes, crates and a
# lantern, the camp box, the explorers' boat on the beach ------------------------------------------------------------------
place Balboa_DecorationPrefabBase_SimpleTent - at -27 49 ground yaw=160
place Balboa_DecorationPrefabBase_SimpleTent - at -20 49.5 ground yaw=200
place MapTable - at -24 45 ground centred scale=0.6
place Note_Book fieldnotes at -24 45 h=6 drop yaw=10 rot=0,0,0
place Crate_Big_01 - at -21 44 ground yaw=30
place Placeable_Lantern_Metal - at -21 44 h=5 drop
place "Box Small" campbox at -27.5 44.5 ground yaw=-20
place RT_PlasticBoat - at -21 55 ground yaw=80
place Zone_Trigger basecamp at -24 46 y=1

# --- The causeway: stone pillars along it, two fallen; the zone at its top --------------------------------------------
place Pillar_01 - at -31.5 38.5 ground
place Pillar_01 - at -37.5 33 ground
place Pillar_01 - at -44.5 16 ground
place Pillar_01 - at -43.8 4 ground
place Pillar_01 - at -36.6 6 ground roll=90 yaw=20
place Pillar_01 - at -43 -8 ground
place Pillar_01 - at -35.4 -6 ground roll=88 yaw=-15
place Zone_Trigger causeway at -35 -16 y=1

# --- The pyramid's tier walls, and its stairway up the north face: one of Raft's stone stairs against each tier's wall --
call tierwall a=15.6 h=26.22
call tierwall a=12 h=28.64
call tierwall a=8.4 h=31.06
call tierwall a=4.8 h=33.48
# (four tiers with ledges 3.6 m deep: one of Raft's stairs, 3.07 m long, fits each - on 2.4 m ledges each stair's foot
# reached over the top of the one below, and shortened they were too steep to walk up)
place Block_Stair_Tier3 - at 0 17.135 h=23.8 sit centred yaw=180
place Block_Stair_Tier3 - at 0 13.535 h=26.22 sit centred yaw=180
place Block_Stair_Tier3 - at 0 9.935 h=28.64 sit centred yaw=180
place Block_Stair_Tier3 - at 0 6.335 h=31.06 sit centred yaw=180

# --- The summit shrine on the top tier, open to the sky: the altar with its three hollows, the carvings, the Kings'
# offering chest (columns at the tier's corners stood half off its edge) -----------------------------------------------------------------------------------
place UT_EndRoom_Table altar at 0 -0.8 h=33.53 sit scale=0.5
place Note_Sign carvings at 0 -2.6 h=33.53 sit
place MayorsChest offering at 0 1.4 h=33.53 sit yaw=180
place Zone_Trigger summit at 0 0 h=34.6

# --- The Sun shrine on the west terrace: a stone room, its doorway (east) filled with stakes that sink into the floor;
# the tablet chest inside; the jaguar's-paw lever hidden at the plateau's west rim among bushes -----------------------
push at -29.5 -1.5 h=23.85
place RT_Wall1 - at 3 0 y=0
place RT_Wall1 - at 3 3 y=0
place RT_Wall1 - at 0 0 y=0 yaw=90
place RT_Floor - at 3 3 y=3 sx=0.5 sz=0.3333
place "Balboa_DecorationPrefabBase_Wooden Spikes" sunspikes at 3.2 1.5 y=0 sit scale=0.22 yaw=90
place Loot_ChestSmall sunchest at 2.4 1.5 y=0 sit yaw=90
pop
place UT_JumpPuzzle_LiftMechanism_Lever sunlever at -34.5 9 ground yaw=90
place "Balboa_Bush_01 Variant" - at -35.2 10.6 ground
place Bush - at -33.6 7.6 ground

# --- The Rain shrine on its pedestal in the east, ringed by a moat of stakes: stepping stones (shown when the Sun's tablet
# is taken) across the moat's west arm; the room as the Sun's, its doorway open (west); the chest; bees in its roof ----
place "Balboa_DecorationPrefabBase_Wooden Spikes" - at 25 -2.9 h=19.8 sit scale=0.22 yaw=90
place "Balboa_DecorationPrefabBase_Wooden Spikes" - at 25 2.9 h=19.8 sit scale=0.22 yaw=90
place "Balboa_DecorationPrefabBase_Wooden Spikes" - at 30.5 -4.5 h=19.8 sit scale=0.3
place "Balboa_DecorationPrefabBase_Wooden Spikes" - at 30.5 4.5 h=19.8 sit scale=0.3
