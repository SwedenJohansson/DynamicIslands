# lib_abyss: pieces of The Abyss Expedition's 1-hour pass (10-26). New macros only; the shared libs stay as they are.
#
# ab_plants_forest: the plants put back on new land of a wooded island (pines, birches, berries, bushes, low stones -
# Old Mine Islet's own kinds), about Raft's density for the area
macro ab_plants_forest x=0 z=0 r=20 seed=1
scatter "Pickup_Landmark_Tree_Pine" 4 at $x $z r=$r seed=$seed free=4
scatter "Pickup_Landmark_Tree_Birch" 3 at $x $z r=$r seed={$seed+1} free=4
scatter "Pickup_Landmark_BerryBush" 2 at $x $z r=$r seed={$seed+2} free=2
scatter Bush 8 at $x $z r=$r seed={$seed+3} free=1
scatter Bush2 5 at $x $z r=$r seed={$seed+4} free=1
scatter SmallBoulder4 5 at $x $z r=$r seed={$seed+5} free=2
end
#
# ab_piece: one piece of a collectible set (Story_Collectible) at x z on the ground, alias al, in set
macro ab_piece x=0 z=0 al=piece set=Relics nm=Relic
place Story_Collectible $al at $x $z ground sit
prop $al collect.set=$set
prop $al obj.name=$nm
end
#
# ab_lamp: one puzzle light (Story_Light, a post with a bulb) at x z on the ground: alias al, name nm (what `light|`
# actions and the plays name), its group, on = 1 if it starts lit. What using it switches as well: the caller's own `prop <al> on.use=light|<other>|toggle`.
macro ab_lamp x=0 z=0 al=lamp nm=Lamp grp=Lamps on=0
place Story_Light $al at $x $z ground sit
prop $al obj.name=$nm
prop $al light.group=$grp
prop $al light.on=$on
end
#
# ab_hidden: a hidden chest (alias al, title) shown by a puzzle's reward, at x z on the ground
macro ab_hidden x=0 z=0 al=hiddenchest kind=Loot_ChestSmall yaw=0
place $kind $al at $x $z ground sit yaw=$yaw
prop $al obj.name=$al
prop $al beh.hidden=1
prop $al loot.refill=0
end
#
# ab_ruin: ar_ruin (lib_areas) with its table standing on the floor (ar_ruin's table sits at the frame, 0.25 m into its floor);
# the table top is at local 1.5 1.5 y=1.35 for w=3 d=2
macro ab_ruin x=0 z=0 h=3 yaw=0 w=3 d=2 al=ruin
brush flatten at {$x} {$z} r={$w*1.5+4} s=20 frames=300 h=$h
clear at $x $z r={$w*1.5+4}
push at {$x-($w*0.75)*cos($yaw)-($d*0.75)*sin($yaw)} {$z+($w*0.75)*sin($yaw)-($d*0.75)*cos($yaw)} h=$h yaw=$yaw
for fx 0.75 {$w*1.5-0.75} 1.5
for fz 0.75 {$d*1.5-0.75} 1.5
place Block_Floor_Tier3 $al at $fx $fz y=0.05
next
next
place Block_Wall_Door_Tier3 $al at 0.75 0 y=0.05
for fx 2.25 {$w*1.5-0.75} 1.5
place Block_Wall_Tier3 $al at $fx 0 y=0.05
next
place Block_Wall_Window_Tier3 $al at 0.75 {$d*1.5} y=0.05
place Block_Wall_Tier3 $al at {$w*1.5-0.75} {$d*1.5} y=0.05
for fz 0.75 {$d*1.5-0.75} 1.5
place Block_Wall_Tier3 $al at 0 $fz y=0.05 yaw=90
next
place Block_Wall_Tier3 $al at {$w*1.5} 0.75 y=0.05 yaw=90
place SmallBoulder4 - at {$w*1.5+2.2} {$d*1.5-0.3} ground yaw=30 scale=0.5
place SmallBoulder4 - at {$w*0.75} {$d*1.5+1.6} ground yaw=80 scale=0.6
place SmallBoulder4 - at -2.4 0.8 ground yaw=10 scale=0.5
place Placeable_Table_Basic - at 1.5 1.5 y=0.3 sit yaw=0
pop
prop $al tint.color=#5b5650
prop $al tint.amount=0.55
end
