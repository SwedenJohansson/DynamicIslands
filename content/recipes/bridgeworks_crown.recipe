# Bridgeworks Crown - the ninth island of the library's plan The City That Never Sank (SL13, Highwater, chapter 9, the finale)
# The city's crown on the night of the storm: off a small key, the tallest towers' roofs joined by bridges - the landing
# roof, the Authority's roof (its post and spotlight), the Fleet's roof (its mast), the Union's roof (its crane) - and in
# the middle the council house, its door on a keypad. Rain, wind, screechers; an electric zipline from the Union's crane
# down to the key; on the key a trader and, at its west shore, the stair down to the city's foundation piles. The
# factions meet to settle the city's water, and the stranger who has seen all three secrets decides: Authority, Fleet,
# Union, expose them all, or free the Rookery. Quest "The Council in the Storm" (35 steps, STORY 10-24: five recordings on the roofs - Pip, Crane, Teo, Bram, Nell - and Dobbs's Complaint No. 400 before the council; the beacon climb lights the way to it; Crane walks out into the storm; the archive dive optional and the storm-bell machine gone).
#
# Points: the key 0 0 (r about 36, levelled at 2 round 0 -2); the causeway along x 0 from z 12 to 20; the landing roof
# x -3..3, z 20.5..29.5; the Authority's roof x -15..-9 and the Fleet's x 9..15 (z 20.5..29.5), bridges at z 25; the
# council house x -3..3, z 29.5..38.5 (floor 1, door south on a keypad, roof 4); the Union's roof x 9..15, z 29.5..38.5
# (north of the Fleet's); the zipline from the Union's crane to the key's west shore (-20 6); the pile stair -22 10, the
# pile head -27 14 under water.
include lib_sea
include lib_rt
include lib_huts
include lib_features
include lib_concord
include lib_highwater
include lib_areas
# RESIZE 10-24: Radius 36 -> 95 (Height 4 -> 4), the old content moved -9.3 31.1 as one frame (push) so its sea side stays at the coast; the island grows behind it.
# DEEP 10-24: Crown Fell: a fifty-metre fell with an eighty-metre storm mast, the council archive drowned under the west cliffs, and a hidden button to the sealed records floor.
new
gen Trees=0.1 Bushes=0.2 Rocks=0.3 Harvest=0.2 BeachThings=0.3
gen Seed=13901 Radius=95 Height=4 Roughness=0.25 Peaks=1 Shape=0 Style=0 PeakShape=0.3 Cliffs=0.1 BeachWidth=0.6
gen Water=0.5 SeaRocks=0.3 SeaFinds=0.4 Sunken=0.3 Hostiles=0 Friendly=0.2 SeaLife=0.3
generate
push at -9.3 31.1

# --- Terrain: the key levelled; the way out to the roofs and down to the piles cleared --------------------------------
brush flatten at 0 -2 r=12 s=20 frames=300 h=2
brush flatten at -27 14 r=4 s=20 frames=150 h=-6
# (REACH 10-28: the pile stair (ramp, below) lay buried in the key's sand - the pit a 4 m well with no way out; a cut
# along the stair, just under its planks)
brush flatten at -19.5 7.8 r=2 s=20 frames=150 h=1.8
brush flatten at -21 9 r=2 s=20 frames=150 h=1.2
brush flatten at -22.5 10.2 r=2 s=20 frames=150 h=0.2
brush flatten at -24 11.3 r=2 s=20 frames=150 h=-0.8
brush flatten at -25.5 12.5 r=2 s=20 frames=150 h=-1.8
# (PQ11 10-27: the RESIZE buried the roofs and the council house in sand - dug back down to a low sand flat 0.8 m under the roof tops; dug to -1.2 they stood 2.3 m over the sea floor, too high to climb)
brush flatten at 0 33 r=21 s=20 frames=600 h=0.3
brush smooth at 0 33 r=25 s=5 frames=70
# the causeway's sand bar: its foundations (h 0.35) start where the key's slope meets the bar, not over open water
brush flatten at 0 12.5 r=3 s=20 frames=300 h=0.1
brush smooth at 0 11.5 r=5 s=5 frames=40
pop
# --- DEEP 10-24 terrain: Crown Fell (west, summit 50 m, base r 28), its trail, the drowned council archive (-17 m) ------------
call hw_mount x=-74 z=28 b=28 h=50
# (PQ11 10-27: 62 pads, not 40: a 1.18 m rise per pad was more than a jump near the top)
call hw_trail x=-74 z=28 b=28 h=50 a0=110.73 turn=300 n=62 h0=3
brush flatten at -87.92 25.73 r=2.6 s=20 frames=200 h=26.5
clear at -87.92 25.73 r=3
call hw_basin x=-82 z=-32 r=14 h=-17
brush flatten at -52 -12 r=4 s=8 frames=60
clear at -52 -12 r=6
# the sealed records room's pad (no door: the button by the summer house is the way in)
brush flatten at 50 66 r=5 s=20 frames=200 h=3
clear at 50 66 r=6
brush flatten at 23.3 -18.9 r=5 s=8 frames=40
origin
clear at 23.3 -18.9 r=6
push at -9.3 31.1
clear at 0 -2 r=12
clear from 0 10 to 0 50 r=18
clear from -20 6 to -28 14 r=4

# --- The storm: grey and wet over the whole crown ----------------------------------------------------------------------
call weather x=0 z=18 al=storm r=60 fog=#3a4048 fa=0.5 light=#8a96a2 la=0.35 parts=mist h=4
place Zone_Sound stormsound at 0 18 ground y=3

# --- The landing roof: the storm bulletin, the shutters' crank ----------------------------------------------------------
line Block_Foundation from 0 12.25 to 0 19.75 step=1.5 h=0.35
push at 3 25 h=1
call hw_roof d=12 a=crown fm=none bm=none lm=none rm=none
place Note_Board bulletin at -5.9 -3 y=1.2 yaw=90
place RT_Pillar - at -0.6 -3.5 y=0.05 sy=0.6
place TP_Selene_DoorCrankWheel shutters at -0.6 -3.59 y=1.25 yaw=0
place Loot_ChestSmall rec_pip at -4 2.5 y=0.05 sit yaw=90
place Loot_ChestSmall rec_nell at 3 3 y=0.05 sit yaw=200
place Zone_Trigger landingzone at -3 -2 y=0.1
pop

# --- The Authority's roof: its post, its spotlight, the alarm bell --------------------------------------------------
push at -9 25 h=1
call hw_roof d=12 a=crown rm=none
call hw_bridge n=4 y=0
place RT_Spotlight - at -5 3.5 y=0.05 sit yaw=30
place Placeable_Flag_01 - at -5.5 -3.8 y=0.05 sit
place Loot_ChestSmall rec_crane at -3 -3.6 y=0.05 sit yaw=0
place Note_Board authdemand at -5.9 0 y=1.2 yaw=90
place RT_Pillar - at -1.2 3.6 y=0.05 sy=0.6
place TP_LaserControlPanel_lever alarmbell at -1.2 3.3 y=1.2 scale=3 yaw=180
place Zone_Trigger authzone at -3 0 y=0.1
pop

# --- The Fleet's roof: its mast and the gull flag; the Union's roof beyond it: the crane, the letters, the zipline ---------
push at 15 25 h=1
call hw_roof d=12 a=crown lm=none bm=none
place Antenna_pole - at -3 0 y=0.05 sit
place Placeable_Flag_02 - at -2.2 0.5 y=0.05 sit
place Loot_ChestSmall rec_teo at -4 2.8 y=0.05 sit yaw=180
place Note_Board fleetdemand at -0.1 -2 y=1.2 yaw=270
place Zone_Trigger fleetzone at -3 -2 y=0.1
pop
push at 3 25 h=1
call hw_bridge n=4 y=0
pop
push at 15 34 h=1
call hw_roof d=12 a=crown fm=none
place UT_ElectricityIsland_Crane02 unioncrane at -4.5 3 y=0.05 sit scale=0.25 yaw=135
place Note_Board uniondemand at -0.1 0 y=1.2 yaw=270
place Loot_ChestSmall rec_bram at -5 -1 y=0.05 sit yaw=90
place Loot_Chest letters at -3 3.4 y=0.05 sit yaw=180
place Note_Paper authsecret at -4.5 2 y=0.2 drop
place Note_Paper fleetsecret at -3 2 y=0.2 drop
place Note_Paper unionsecret at -1.5 2 y=0.2 drop
place ZiplinePath_Landmark crownzip at -1.5 -2.5 y=0.05
place Zone_Trigger unionzone at -3 -2 y=0.1
pop
zipto crownzip -20 6

# --- The council house: a storey between the roofs, its door on a keypad; five levers, five verdicts --------------------
push at 3 34 h=1
call hw_penthouse d=12 a=crown f2=none l2=RT_WallWindow1 r2=RT_WallWindow1 b1=RT_WallWindow1 b2=RT_WallWindow1
place "Table Office" - at -3 1 y=0.1 sit
place "Table Office" - at -3 2.6 y=0.1 sit
place Note_Board fiveways at -5.9 -1.5 y=1.2 yaw=90
place Placeable_Lantern_Metal - at -3 1.8 y=0.9 drop
place TP_LaserControlPanel_lever wayauthority at -5.7 1.5 y=1.2 scale=3 yaw=90
place TP_LaserControlPanel_lever wayfleet at -5.7 3.5 y=1.2 scale=3 yaw=90
place TP_LaserControlPanel_lever wayunion at -0.3 3.5 y=1.2 scale=3 yaw=270
place TP_LaserControlPanel_lever wayexpose at -0.3 1.5 y=1.2 scale=3 yaw=270
place TP_LaserControlPanel_lever wayfree at -3 4.35 y=1.2 scale=3 yaw=180
place Note_Paper verdictauthority at -3.6 1 y=0.9 drop
place Note_Paper verdictfleet at -3.6 1 y=0.9 drop
place Note_Paper verdictunion at -3.6 1 y=0.9 drop
place Note_Paper verdictexpose at -3.6 1 y=0.9 drop
place Note_Paper verdictfree at -3.6 1 y=0.9 drop
place Loot_Chest councilchest at -1.2 -3.4 y=0.1 sit
place Note_Paper teomsg at -2.4 2.6 y=0.9 drop
place Zone_Trigger councilzone at -3 0 y=0.1
pop
place PlantationDoor councilgate at 1.5 29.5 h=1 sit yaw=0
place RT_PowerBox councilpad at 3.2 28.6 h=2.3 yaw=90
place Zone_Trigger doorzone at 1.5 28 h=1.5
place Creature_StoneBird screechers at 0 30 h=12

# --- The key: the trader, the pile stair and the pile engineer's map ----------------------------------------------
store crownshop at 8 -14 ground
place Note_Sign pilemap at -18 8 ground sit yaw=240
place Note_Sign dobbs400 at -15 11 ground sit yaw=200
ramp Block_Floor_Wood from -21 9 1.5 to -25.5 12.5 -1.5 len=1.5 top=0
