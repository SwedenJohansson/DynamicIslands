# --- DISCOVERIES 10-24 (optional, no quest needs them): camp + note; Van_2 + chest; hatch with a chest; buried treasure; viewpoint ---
place campfire_1 - at 23.3 -18.9 ground sit
place Balboa_DecorationPrefabBase_SimpleTent - at 26.3 -16.9 ground sit yaw=257
place "Box Small" - at 21.3 -16.4 ground sit
place Note_Paper dnote at 21.3 -16.4 ground y=1.6 drop yaw=20
note dnote Squatter's note | Moved out of the tower when the water reached the 30th floor.\nIt's quieter here. No Union men, no Authority men.\nThe city lights still come on at dusk - nobody knows who pays for them.
place Van_2 dvan at -36.7 20.4 ground yaw=17
prop dvan tint.color=#5a5048
prop dvan tint.amount=0.5
place Loot_ChestSmall dwreckchest at -40.7 23.4 ground sit yaw=317
note dwreckchest Salvage chest | A salvager's chest: copper, bolts and a coil of rope.
loot dwreckchest CopperIngot*2;Bolt*2;Rope*2
prop dwreckchest loot.refill=0
call hatchcache x=26.4 z=32.6 r=4 seed=13991 alias=dhatch chest=dhatchchest items=MetalIngot*2;CopperIngot*2;Bolt*3
call treasure x=-26.4 z=-32.6 r=6 n=1 seed=13992
prop treasure13992 treasure.loot=CopperOre*3;TitaniumOre*1
place Zone_Trigger dview at -5.7 2 ground
prop dview zone.id=bridgeworks_crown_view
prop dview zone.radius=7
prop dview zone.repeat=never
prop dview zone.message=The crown of the city: the tallest roofs joined by bridges, and the storm coming in over all of them.

# --- Areas (10-24: every story island has places all over it and its quest crosses it): storm ridge in the south (buried salvage), the
# fallen bridgeworks crane in the south-east, the councillor's summer house in the west (the keycard opens his strongbox),
# the cipher cave in the east (dark: a headlight; the full council code), the live cable bed in the south (shock: the
# breaker lever cuts it)
call ar_ridge x1=-45 z1=-50 x2=5 z2=-68 h=12 top=7 r=9
call ar_plants_hill x=-20 z=-59 r=28 seed=13911
call hw_zone x=-20 z=-59 al=stormridge id=storm_ridge r=7 msg="Storm ridge: the storm is close now. From here the four council roofs stand dark against the sky."
call treasure x=-20 z=-59 r=14 n=2 seed=13961
prop treasure13961 treasure.loot=TitaniumOre*2;CopperOre*2
call hw_wreck x=50 z=-45 h=4 yaw=-30 obj=UT_ElectricityIsland_Crane01 al=bridgecrane crate=bridgecrate r=11
call ar_ruin x=-68 z=-12 h=4 yaw=0 w=4 al=summerhouse
call hw_note x=-65.5 z=-16.5 yaw=10 al=councilnotebook
place Loot_ChestLarge strongbox at -68 -11 ground sit yaw=180
prop strongbox if.open=has|Tangaroa_KeyCard|1
call ar_cave x=62 z=0 h=4 yaw=0 al=ciphercave chest=cipherchest
call hw_hazard x=62 z=10 al=ciphercavedark kind=dark r=4 dmg=0 safe=wears|HeadLight* msg="Black as the bottom of the sea. A headlight would show you what is written on the walls."
call hw_zone x=62 z=24 al=ciphermouth id=cipher_cave r=4 msg="A cave under the Crown's cliff. Someone carved numbers by the entrance and scratched them out again."
brush flatten at 25 -74 r=5 s=20 frames=200 h=2
call hw_hazard x=25 z=-74 al=shockcoil kind=shock r=4 dmg=8 safe=none msg="The cable bed is live: the old bridge's power still runs through the wet ground."
place Loot_Chest cablechest at 25 -74 ground sit yaw=0
place RT_Pillar - at 16 -66 ground sit sy=0.4
place TP_LaserControlPanel_lever breaker at 16 -66 ground y=1.25 scale=3 yaw=-45
prop breaker beh.use=Pull the old breaker
prop breaker on.use=message||The breaker drops with a bang. The hum in the cable bed dies.\nhide|shockcoil
call ar_plants_hill x=-60 z=-40 r=14 seed=13921

# --- DEEP 10-24 (the user: one hour per island - real height, a big climb, a deep dive): Crown Fell: a fifty-metre fell with an eighty-metre storm mast, the council archive drowned under the west cliffs, and a hidden button to the sealed records floor. ------
# the climb: the trail spirals up from the east foot; on the summit the storm beacon mast (12 storeys, a ladder inside), its deck chest
# and a zipline down to the hub (the shortcut back); the dive: the council archive on a basin floor -17 m down, an air pocket
# in its front room; the hub: the Storm bell that wants both, the notice; secrets: the trail ledge cache, the summit treasure,
# the sunk boat's crate
call hw_zone x=-46.88 z=17.74 al=bc_trailz id=bc_trail r=5 msg="The trail up Crown Fell starts here - cut into the slope, round and up."
call hw_zone x=-74 z=28 al=bc_summitz id=bc_summit r=8 h=1 msg="The top of Crown Fell. The whole island below, the city beyond it, and the storm beacon mast still higher."
call hw_mast x=-75.93 z=31.5 h0=50 lv=12 a=bc_mast chest=bc_topchest top=RT_Spotlight
place ZiplinePath_Landmark bc_zip at -69.69 24.88 h=51.35
zipto bc_zip -53.93 -8.5
place Loot_ChestSmall bc_ledge at -87.92 25.73 ground sit yaw=80.73
call treasure x=-77.5 z=26.07 r=5 n=1 seed=13978 kind=0
prop treasure13978 treasure.loot=CopperOre*2;MetalOre*2;TradeToken*1
place Creature_Goat bc_goats at -51.26 15.33 ground
prop bc_goats creature.count=2
place Creature_Goat bc_summitgoat at -71.37 29.45 ground
prop bc_summitgoat creature.count=1
scatter "Pickup_Landmark_Copper 1" 2 at -74 28 r=24 seed=13982 free=2
scatter "Pickup_Landmark_Clay 1" 2 at -74 28 r=26 seed=13983 free=2
scatter "Pickup_Landmark_Rock 1" 2 at -74 28 r=22 seed=13984 free=2
call hw_sunkhouse x=-82 z=-32 h=-17 yaw=0 a=bc_sunk chest=bc_deepchest air=bc_air bub=bc_airbub dal=bc_sunkdoor
call hw_zone x=-82 z=-32 al=bc_deepz id=bc_deep r=7 h=1 msg="The council archive, 17 metres down. The front room still holds a pocket of air."
place RT_PlasticBoat bc_sunkboat at -74 -30 ground sit yaw=35
prop bc_sunkboat tint.color=#5a5048
prop bc_sunkboat tint.amount=0.45
place Loot_Crate bc_boatcrate at -75 -36 ground sit yaw=10
prop bc_boatcrate loot.refill=0
call hw_reef x=-89 z=-27 r=3 seed=13986
place Creature_PufferFish bc_puffers at -88 -39 h=-13
prop bc_puffers creature.count=2
call hw_note x=-49.09 z=-12.11 yaw=-8.81 al=bc_hint
# the unmarked button by the councillor's summer house; it moves you into a sealed room (no door) in the
# north-east with the council's records; a lever there slides one wall panel aside (moveto, mech 10-24) - a
# secret door you walk out of, which stays open so the room can be found again from outside
place RT_Pillar - at -59 -4 ground sit sy=0.4
place RT_PowerBox bc_button at -59 -4 ground y=1.25 scale=0.6 yaw=90
prop bc_button obj.name=bc_button
prop bc_button beh.use=Press the unmarked button
prop bc_button on.use=sound||event:/exploring/zipline/zipline_engine\nmessage||The floor drops away -\nwait|2\nteleport|bc_records\nmessage||- a dark room. No door.
place Zone_Trigger bc_btnback at -59 -7 ground y=1
prop bc_btnback obj.name=bc_btnback
prop bc_btnback zone.id=bc_btnback
push at 50 66 h=3
# (pillars in the corners carry the roof: CIGroundIslands 10-25)
place Block_Pillar_Wood bc_sealed at -1.35 -1.35
place Block_Pillar_Wood bc_sealed at 1.35 -1.35
place Block_Pillar_Wood bc_sealed at -1.35 1.35
place Block_Pillar_Wood bc_sealed at 1.35 1.35
place Block_Wall_Tier3 bc_sealed at -0.75 -1.5
place Block_Wall_Tier3 bc_sealed at -0.75 1.5
place Block_Wall_Tier3 bc_sealed at -1.5 -0.75 yaw=90
place Block_Wall_Tier3 bc_sealed at 1.5 -0.75 yaw=90
place Block_Floor_Tier3 bc_sealed at -0.75 -0.75 y=2.635
place Block_Floor_Tier3 bc_sealed at 0.75 -0.75 y=2.635
place Block_Wall_Tier3 bc_sealed at 0.75 -1.5
place Block_Wall_Tier3 bc_secret at 0.75 1.5
prop bc_secret obj.name=bc_secret
place Zone_Trigger bc_secretopen at 2.25 1.5
prop bc_secretopen obj.name=bc_secretopen
place Block_Wall_Tier3 bc_sealed at -1.5 0.75 yaw=90
place Block_Wall_Tier3 bc_sealed at 1.5 0.75 yaw=90
place Block_Floor_Tier3 bc_sealed at -0.75 0.75 y=2.635
place Block_Floor_Tier3 bc_sealed at 0.75 0.75 y=2.635
place Zone_Trigger bc_records at 0 0 y=0.6
prop bc_records obj.name=bc_records
place Note_Paper bc_sealednote at 0.6 0.6 y=0.1 drop
place Placeable_Lantern_Metal - at -0.6 0.6 y=0.1 drop
place RT_Pillar - at -0.6 -0.9 y=0.05 sy=0.6
place TP_LaserControlPanel_lever bc_climbout at -0.6 -0.9 y=1.2 yaw=0
prop bc_climbout obj.name=bc_climbout
prop bc_climbout beh.use=Pull the lever
prop bc_climbout if.use=!signal|bc_doorout
prop bc_climbout on.use=signal||bc_doorout\nsound||event:/exploring/zipline/zipline_engine\nmoveto|bc_secret|bc_secretopen,3\nmessage||Stone grinds on stone - one wall panel slides aside. Daylight, and the shore.
prop bc_climbout else.use=message||The panel is already open.
pop
prop bc_sealed tint.color=#5c5850
prop bc_sealed tint.amount=0.5
prop bc_secret tint.color=#5c5850
prop bc_secret tint.amount=0.5
story bc_top|Storm beacon lamp|Bolt|The storm beacon's lamp, eighty metres over the sea.
story bc_deep|Archive seal|Bolt|The council's archive seal, under seventeen metres of water.
note bc_hint Storm warden's notice | STORM WARDEN - STANDING ORDER\n\nBy the old law, the council may not sit in a storm until the beacon on Crown Fell is lit, so the boats at sea know the city is still speaking.\n\nThe warden's post has been vacant three years. The Councillor says the beacon is a superstition. The Councillor has never been at sea in the dark.\n\n(Under it, in a clerk's neat hand: Light it. He would rather sit in the dark, and that is reason enough. Then ring the Authority's bell and they must all come in. - N.A.)
prop bc_topchest on.open=message||You strike the beacon's lamp and it catches - a white eye opening over the storm. Down on the four roofs, one by one, the factions' lanterns turn toward the council house. The bell is all that's left.
prop bc_deepchest on.open=message||The council's old archive seal, and under it the minutes of the night the piles were last surveyed: CRACKS IN ALL FOUR. MOTION TO TELL THE CITY - DEFEATED, ONE VOTE TO NONE. The one vote was Crane's.
note bc_topchest Storm beacon mast deck box | A box lashed to the deck rail at the top of the storm beacon mast.
loot bc_topchest story:bc_top*1;Scrap*2;Bolt*3
note bc_deepchest Council archive strongbox | A strongbox in the back room of the council archive.
loot bc_deepchest story:bc_deep*1;MetalIngot*2;CircuitBoard*1
note bc_ledge Climber's cache | A climber's cache on a ledge off the trail - rope, a flask, a few bolts.
loot bc_ledge Rope*2;Bolt*2;Scrap*2
prop bc_ledge loot.refill=0
loot bc_boatcrate Plastic*3;Scrap*2;MetalIngot*1
note bc_sealednote Sealed records | SEALED - COUNCIL ONLY\n\nEvery vote the Authority bought, every name, every price. If the crown takes the AUTHORITY's side these pages stay here; if it chooses to EXPOSE them, this is what the city reads.
prop bc_ledge if.open=has|Tangaroa_KeyCard|1
prop bc_ledge else.open=message||A card lock on the box - a Tangaroa keycard would open it.

# --- Settings, story items, notes, behaviours, quest ------------------------------------------------------------------
info title=Bridgeworks Crown
info author=Custom Islands
info description=The city's crown on the night of the storm: four tower roofs joined by bridges, the council house between them, the Authority, the Fleet and the Union each with their demand - and a stranger who has read all three secrets. The finale of The City That Never Sank.
island on.arrive=message||Rain, wind, and lights on the four highest roofs in Highwater. The council meets tonight. Everyone has come to be heard - except the people the water was taken from.

story shutters|Storm shutters closed|Bolt|The landing roof's storm shutters, cranked shut.
story alarm|Alarm rung|Bolt|You rang the Authority's alarm bell - every roof knows the storm is here.
story councilcode|Council door opened|Bolt|The council house door, opened with the factions' own code.
story plea|Recording played|Bolt|One of the five recordings left on the Crown's roofs for the stranger.
story choice|The city's choice|Note_Paper|What you chose for Highwater, in front of all three factions.

prop crown tint.color=#7c8288
prop crown tint.amount=0.4
prop skyline tint.color=#5a6068
prop skyline tint.amount=0.5
prop stormsound sound.event=event:/amb/rain_ocean
prop stormsound sound.volume=0.7
prop stormsound zone.radius=60
prop screechers creature.count=4
prop screechers creature.respawn=0
prop authsecret obj.name=authsecret
prop authsecret beh.hidden=1
prop fleetsecret obj.name=fleetsecret
prop fleetsecret beh.hidden=1
prop unionsecret obj.name=unionsecret
prop unionsecret beh.hidden=1
prop letters on.open=show|authsecret\nshow|fleetsecret\nshow|unionsecret\nmessage||Three letters, three seals - one for each faction. The rain has made the seals soft.
prop teomsg beh.hidden=1

prop shutters obj.name=shutters
prop shutters beh.use=Crank the storm shutters shut
prop shutters if.use=!signal|shutters
prop shutters on.use=signal||shutters\ngive||story:shutters*1\nsound||event:/raft/radar/lever\nmessage||The shutters rattle down over the landing's windows. The wind screams round them.
prop shutters else.use=message||The shutters are shut.

prop alarmbell obj.name=alarmbell
prop alarmbell beh.use=Ring the alarm bell
prop alarmbell if.use=!signal|storm
prop alarmbell on.use=signal||storm\ngive||story:alarm*1\nsound||event:/raft/radar/lever\nmessage||The bell clangs over the roofs. On every bridge, lanterns turn toward the council house.
prop alarmbell else.use=message||The bell is still ringing in your ears.

prop councilpad obj.name=councilpad
prop councilpad beh.use=Type the council door's code
prop councilpad lock.code=4719
