call hatchcache x=-17 z=-21 r=4 seed=14051 alias=dhatch chest=dhatchchest items=MetalIngot*2;CopperIngot*2;Bolt*3
place Zone_Trigger dview at -9.7 25.2 ground
prop dview zone.id=freehold_shoal_view
prop dview zone.radius=7
prop dview zone.repeat=never
prop dview zone.message=A small free place on a big sea - and behind it, the drowned city, quiet now.

# --- Areas (10-24: every story island has places all over it and its quest crosses it): the dune in the north (buried salvage), the
# hauled-up van in the east, the old squatter's shack in the west
call ar_ridge x1=-35 z1=32 x2=-5 z2=45 h=7 top=4 r=7
call ar_plants_hill x=-20 z=38 r=18 seed=13181
call hw_zone x=-20 z=38 al=dunetop id=dune_top r=6 msg="The dune: the highest ground on the shoal. From here you can see the Crown's roofs - small now, and far behind you."
call treasure x=-20 z=38 r=10 n=2 seed=13183
prop treasure13183 treasure.loot=TitaniumOre*2;CopperOre*1
call hw_wreck x=42 z=-8 h=2 yaw=100 obj=Van_5 al=hauledvan crate=hauledcrate r=9
call ar_ruin x=-40 z=-16 h=3 yaw=0 al=squattershack
call hw_note x=-37.5 z=-20.5 yaw=10 al=squatterslate
call ar_plants_hill x=30 z=35 r=12 seed=13182

# --- DEEP 10-24 (the user: one hour per island - real height, a big climb, a deep dive): Lookout Hill: Freehold's first watch on a hill over the shoal, the first squatters' hut drowned off the beach, and a founding bell. ------
# the climb: the trail spirals up from the north-east foot; on the summit the Freehold lookout (7 storeys, a ladder inside), its deck chest
# and a zipline down to the hub (the shortcut back); the dive: the squatters' hut on a basin floor -12 m down, an air pocket
# in its front room; the hub: the Founding bell that wants both, the notice; secrets: the trail ledge cache, the summit treasure,
# the sunk boat's crate
call hw_zone x=-15.15 z=-31.47 al=fh_trailz id=fh_trail r=5 msg="The trail up Lookout Hill starts here - cut into the slope, round and up."
call hw_zone x=-26 z=-54 al=fh_summitz id=fh_summit r=8 h=1 msg="The top of Lookout Hill. The whole island below, the city beyond it, and the Freehold lookout still higher."
call hw_mast x=-23.17 z=-56.83 h0=26 lv=7 a=fh_mast chest=fh_topchest top=Placeable_Flag_05
place ZiplinePath_Landmark fh_zip at -25.26 -52.37 h=27.35
zipto fh_zip -55.17 -24.83
place Loot_ChestSmall fh_ledge at -25.09 -66.07 ground sit yaw=355.71
call treasure x=-23.17 z=-51.17 r=5 n=1 seed=14038 kind=0
prop treasure14038 treasure.loot=CopperOre*2;MetalOre*2;TradeToken*1
place Creature_Goat fh_goats at -11.62 -27.94 ground
prop fh_goats creature.count=2
place Creature_Goat fh_summitgoat at -28.12 -56.12 ground
prop fh_summitgoat creature.count=1
scatter "Pickup_Landmark_Copper 1" 2 at -26 -54 r=20 seed=14042 free=2
scatter "Pickup_Landmark_Clay 1" 2 at -26 -54 r=22 seed=14043 free=2
scatter "Pickup_Landmark_Rock 1" 2 at -26 -54 r=18 seed=14044 free=2
call hw_sunkhouse x=-74 z=6 h=-12 yaw=0 a=fh_sunk chest=fh_deepchest air=fh_air bub=fh_airbub dal=fh_sunkdoor
call hw_zone x=-74 z=6 al=fh_deepz id=fh_deep r=7 h=1 msg="The squatters' hut, 12 metres down. The front room still holds a pocket of air."
place RT_PlasticBoat fh_sunkboat at -66 8 ground sit yaw=35
prop fh_sunkboat tint.color=#5a5048
prop fh_sunkboat tint.amount=0.45
place Loot_Crate fh_boatcrate at -67 2 ground sit yaw=10
prop fh_boatcrate loot.refill=0
call hw_reef x=-81 z=11 r=3 seed=14046
place Creature_PufferFish fh_puffers at -80 -1 h=-8
prop fh_puffers creature.count=2
story fh_top|Ines's spyglass|Bolt|Ines Marlowe's brass spyglass, left in the Freehold lookout's deck box.
story fh_deep|Squatters' cash tin|Bolt|The first squatters' cash tin, drowned with their hut - Freehold's first purse.
note fh_topchest Freehold lookout deck box | A box lashed to the deck rail at the top of the Freehold lookout.
loot fh_topchest story:fh_top*1;Scrap*2;Bolt*2
prop fh_topchest on.open=message||Ines's brass spyglass, wrapped in her diving shirt, and a chalk note: For you. Look out past the piles on a clear day - there is a light on the old Concord band that nobody in Highwater ever answered. I am going to answer it. Come if you like. - I.M.
note fh_deepchest Squatters' hut strongbox | A strongbox in the back room of the squatters' hut.
loot fh_deepchest story:fh_deep*1;TradeToken*2;Plastic*2
prop fh_deepchest on.open=message||The cash tin, rusted shut and still heavy. Scratched on the lid: FREEHOLD - FOR WHOEVER COMES NEXT. Thirty years ago the first squatters had the same idea, and the Authority drowned their hut for it. Maud will want it on the founding board.
note fh_ledge Climber's cache | A climber's cache on a ledge off the trail - rope, a flask, a few bolts.
loot fh_ledge Rope*2;Bolt*2;Scrap*2
prop fh_ledge loot.refill=0
loot fh_boatcrate Plastic*3;Scrap*2;MetalIngot*1
prop fh_ledge if.open=has|Tangaroa_KeyCard|1
prop fh_ledge else.open=message||A card lock on the box - a Tangaroa keycard would open it.

# --- Settings, story items, notes, behaviours, quest ------------------------------------------------------------------
info title=Freehold Shoal
info author=Custom Islands
info description=A sandy shoal outside Highwater, where the Rookery's people start over: hut frames on posts, a well, a hen coop, berries, and boats pulled up on the beach. The epilogue of The City That Never Sank.
island on.arrive=message||Boats on the beach. Hammering. Somebody is singing. The Rookery has come ashore.

story plankbundle|Plank bundle|Placeable_PaperBundle|A bundle of planks for the Freehold's huts.
story wellwater|Well running|Bolt|You wound the Freehold's well crank - the first clean water of their own.

prop skyline tint.color=#8a9098
prop skyline tint.amount=0.3
prop hens creature.count=2
prop wildhens creature.count=2
prop firstnight beh.hidden=1
prop firstnight obj.name=firstnight

prop wellcrank beh.use=Wind the well crank
prop wellcrank if.use=!signal|well
prop wellcrank on.use=signal||well\ngive||story:wellwater*1\nshow|firstnight\nsound||event:/raft/radar/lever\nmessage||The rope creaks round. The bucket comes up full - fresh water, nobody's but theirs.
prop wellcrank else.use=message||The well is running.

note founding Freehold founding | FREEHOLD - FOUNDED THE NIGHT OF THE STORM\n\nNo Authority. No Fleet. No Union.\n\nEveryone here owns a share of the well, the coop and the boats. Bring planks. Mind the hens.\n\n(Under it, chalked in a careful old hand: Stranger - you spoke for us on the roofs, and they heard you, which is more than they ever did for me. We took the boats the same night. Two thousand of us went up to the Rookery from Lowstreet; nine hundred came on to the shoal. The rest will follow when the roofs stop shaking.\n\nThe well wants winding, the huts want planks, and the hens want catching, in that order of temper. Pip wants all three and a tram line. Ask her - she is at the end of the driftwood rails, by the boats. - Maud Penn)
note firstnight Freehold's first night | Pinned by the first fire, in two hands, one careful and old, one large and wobbly -\n\nOur first night on our own shoal. The children drank from our own well. Nobody counted the cups.\n\nThe Crown sent a boat at dusk: Nell Abernethy, with the Councillor's last page and a pardon nobody asked for. We gave her soup. She is staying the night. She says the Fleet and the Union are still arguing on the roofs, and that the piles hold.\n\nJonah would have liked this place. He liked anywhere with a straight line in it.\n\n(The wobbly hand: THE TRAM RAN NINE TIMES. NAN RODE IT ONCE. SHE SAYS SHE DID NOT BUT SHE DID.)\n\nWhoever you were - stranger, the one who spoke for us - there's a hut here with your name on it, and a seat on the tram that is always yours.\n\n- Maud and Pip Penn
note bundle1 Plank bundle | Planks tied with rope, a bundle saved from the city.
note bundle2 Plank bundle | Planks tied with rope, a bundle saved from the city.
note bundle3 Plank bundle | Planks tied with rope, a bundle saved from the city.
loot bundle1 story:plankbundle*1;Plank*4
prop bundle1 loot.refill=0
loot bundle2 story:plankbundle*1;Plank*4
prop bundle2 loot.refill=0
loot bundle3 story:plankbundle*1;Plank*4;Egg*2;Feather*2
prop bundle3 loot.refill=0

prop landingzone zone.id=landing
prop landingzone zone.radius=4
prop landingzone zone.message=Freehold Shoal. The Rookery's boats, pulled up on the sand.

note hauledcrate Rook's van crate | The Freeholders hauled this van out of the shallows with ropes and oxen. In the crate, on top of the rope and the ingots, wrapped in a clean handkerchief: a little blue tin tram, with a dent.\n\nA card is tied to it, in a pedlar's flourish -\n\nFor the Tramway Manager, with the compliments of Rook. Paid in full.\n\nI took a tram for a flask of water when water was dear. Water is not dear on the shoal - they have a well, and nobody counts the cups. So the tram goes back. If anybody asks, Rook was robbed, and it was a very large stranger with a chalk hook, and there were six of them.\n\n- R.
story tintram|Pip's tin tram|Bolt|A little blue tin tram with a dent - Pip Penn's, back from Rook the pedlar.
story tramrun|Freehold tramway running|Bolt|Pip's tin tram, running on the driftwood line from the beach to Nan's hut.
loot hauledcrate story:tintram*1;Plastic*2;Rope*3;MetalIngot*2
note pipline Pip's tram line | Weighed down with a shell -\n\nTHE FREEHOLD TRAMWAY. Route 1: Beach to Nan's hut. Stops: Boats, Board, Well, Nan.\n\nI have laid the rails out of driftwood. Mr Carver from the Union helped with the hard bits and said tramways are not built in a day. I said this one is.\n\nThere is only one problem. I have no tram. My tram is the little blue one with the dent, and Rook the pedlar has it, because I swapped it for Nan's water. Rook has a van somewhere on this shoal - the Freeholders hauled it out of the sea. If you find him, tell him I can pay. I have nine buttons and a gull egg (empty).\n\nThe crank at the end of the line is the engine. You wind it. I do the shouting.\n\n- Pip Penn, Tramway Manager
prop tramcrank beh.use=Wind the tramway crank
prop tramcrank if.use=has|story:tintram|1\n!signal|tram
prop tramcrank on.use=signal||tram\ngive||story:tramrun*1\nsound||event:/raft/radar/lever\nmessage||You set the little blue tram on the driftwood rails and wind. It rattles all the way down the line to the boats, and Pip runs beside it shouting the stops - Boats! Board! Well! Nan!
prop tramcrank else.use=message||A crank at the end of a driftwood tram line - and no tram on it. Pip's note says Rook the pedlar has it.
note squatterslate Old squatter's slate | Chalked on a slate inside the shack:\n\nI lived here eleven years before any of them came. Nobody counted my cups either.\nWelcome, Freehold. Mind the well - it is sweet at low tide only.
quest title=Freehold
quest intro=The Rookery has left the city for a shoal of its own - Maud Penn's boats, nine hundred people, and Pip with a tram line to build. Land with them.
step reach|landing|1|Land on Freehold Shoal
step read|Freehold founding|1|Read the founding board - and Maud's chalk under it
step read|Pip's tram line|1|Read Pip's note at the end of her driftwood tram line
step collect|story:plankbundle|3|Find three plank bundles in the small chests around the shoal
step collect|story:wellwater|1|Wind the well crank
step catch|Chicken|1|Catch a hen for the coop
step read|Old squatter's slate|1|Read the slate in the old squatter's shack, the ruin on the shoal
step reach|fh_deep|1|Dive to the first squatters' hut, drowned off the shore
step collect|story:fh_deep|1|Bring up their cash tin from its back room - Freehold's first purse
step reach|dune_top|1|Climb the dune, the highest sand on the shoal, and look back at the Crown
step open|Rook's van crate|1|Find Rook the pedlar's van, hauled up on the beach, and open its crate
step collect|story:tramrun|1|Set Pip's tin tram on the driftwood line and wind the tramway crank
step reach|fh_summit|1|Climb Lookout Hill, the tall hill on the shoal
step collect|story:fh_top|1|Climb the Freehold lookout and take what Ines left in its deck box
step read|Freehold's first night|1|Read the note by the first fire
quest done=The Freehold has its first night, its first purse and its first tram. Highwater is behind you - and somewhere out on the old Concord band, the light Ines saw is still calling.
quest reward=HoneyComb*2;TradeToken*4

