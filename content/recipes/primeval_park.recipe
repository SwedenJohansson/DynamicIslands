place Balboa_DecorationPrefabBase_Fence_EndBroken - at 4 37.5 ground yaw=90
line Balboa_DecorationPrefabBase_Fence_Mid from 4 41 to 4 45 step=2.98
place Balboa_DecorationPrefabBase_Fence_Sign - at 4.5 32 y=1 yaw=90
place Balboa_DecorationPrefabBase_Fence_Sign - at -8 28.6 y=1 yaw=180
place Creature_Boar ironbacks at -8 38 ground
place Zone_Trigger boarpaddock at -4 36 y=1
push at 8 43 h=3.5
call stilt_hut y=2.6
place Balboa_DecorationPrefabBase_SmallLocker fuse2box at 2.25 4.1 y=2.6 sit yaw=180
pop

# --- The river ride: the channel from the bay into the south horn, tour boats on it, one sunk by the station; the
# station's platform over the channel's end ------------------------------------------------------------------------------
place RT_PlasticBoat - at 53 -27 h=0.3 yaw=25
place RT_PlasticBoat - at 59 -40 h=0.3 yaw=15
place RT_PlasticBoat - at 60.5 -53 h=-2.8 drop roll=160 yaw=5
place "Box Small" fuse3box at 60.3 -52.4 h=-2 drop yaw=10
push at 62.5 -63 h=-3 yaw=-90
call boardwalk n=4 wide=2 y=5.1
place Sign_02 - at 3 2.5 y=6 yaw=90
pop
place Zone_Trigger river at 61 -62 y=1.5

# --- The power house: a yard in Balboa's chain-link with Utopia's big generator, cable hubs, the master switch on a
# crate, a crate of cable -------------------------------------------------------------------------------------------------
line Balboa_DecorationPrefabBase_Fence_Mid from 31 -60 to 49 -60 step=2.98
line Balboa_DecorationPrefabBase_Fence_Mid from 31 -44 to 37 -44 step=2.98
line Balboa_DecorationPrefabBase_Fence_Mid from 43 -44 to 49 -44 step=2.98
line Balboa_DecorationPrefabBase_Fence_Mid from 31 -60 to 31 -44 step=2.98
line Balboa_DecorationPrefabBase_Fence_Mid from 49 -60 to 49 -44 step=2.98
place UT_Generator01 - at 40 -54 ground sit
place UT_ElectricCableHub01 parkcable at 34 -48 ground sit
# (scenery: the generator yard's cable hubs; the gate panel is the lock - the ready piece's lock taken off)
prop parkcable beh.use=
prop parkcable if.use=
prop parkcable else.use=
prop parkcable on.use=
place UT_ElectricCableHub02 parkcable2 at 46 -48 ground sit
prop parkcable2 beh.use=
prop parkcable2 if.use=
prop parkcable2 else.use=
prop parkcable2 on.use=
place TP_Moontown_SealedCrate02_Clean - at 40 -47 ground sit
place RT_PowerBox masterswitch at 40 -47 y=0.95 sit yaw=180
place Loot_Crate powercrate at 34 -57 ground sit yaw=15
place Balboa_DirectionSign - at 40 -38 ground yaw=0

# ===== CHAPTER 3 - THE AVIARY AND THE LAGOON =============================================================================
# --- The aviary on the south horn's hilltop: a ring of Balboa's chain-link stretched to 4 m (Tangaroa's dome frame is
# one segment of its dome, no cage on its own), its gate to the south; palms inside; the keeper's platform on four legs
# with a ladder, his notes and locker on it -----------------------------------------------------------------------------
for a 0 252 18
place Balboa_DecorationPrefabBase_Fence_Mid - at {9.5*cos($a)} {-45+9.5*sin($a)} ground yaw={90-$a} sy=1.8
next
for a 288 342 18
place Balboa_DecorationPrefabBase_Fence_Mid - at {9.5*cos($a)} {-45+9.5*sin($a)} ground yaw={90-$a} sy=1.8
next
place Balboa_DecorationPrefabBase_Fence_Sign - at 3 -54.6 y=1 yaw=180
scatter "Pickup_Landmark_Tree_Palm 1" 2 at -4 -48 r=4 seed=81
scatter "Pickup_Landmark_Tree_Palm 3" 2 at 4 -41 r=4 seed=82
place RT_PillarThick - at -1.5 -46.5 ground
place RT_PillarThick - at 1.5 -46.5 ground
place RT_PillarThick - at -1.5 -43.5 ground
place RT_PillarThick - at 1.5 -43.5 ground
place RT_Floor - at 1.6 -43.4 h=18 sx=0.53 sz=0.356
place LandmarkLadder_6m - at 0 -46.75 ground
place RT_Fence - at 0 -43.4 h=18.05
place RT_Fence - at 1.5 -43.4 h=18.05
place RT_Fence - at 1.6 -45 h=18.05 yaw=90
place RT_Fence - at 1.6 -46.5 h=18.05 yaw=90
place RT_Fence - at -1.6 -45 h=18.05 yaw=90
place RT_Fence - at -1.6 -46.5 h=18.05 yaw=90
place Note_Book aviarynotes at 0.4 -44 h=18.1 yaw=200
place Locker aviarylocker at -1 -43.9 h=18.05 sit yaw=180
place Creature_StoneBird aviarybirds at 6 -40 h=20
place Zone_Trigger aviary at 0 -45 h=19

# --- The show lagoon at the bay's head: the grandstand's three steps of benches on its shore, the feeding platform out
# over the deep water with Utopia's crane beside it; the leviathan; on the floor the keeper's satchel and a feed barrel --
line Bench_01 from -2 14 to -2 26.8 step=1.6
line Bench_01 from 1.5 14 to 1.5 26.8 step=1.6
line Bench_01 from 5 14 to 5 19 step=1.6
line Bench_01 from 5 25 to 5 30 step=1.6
push at 6.5 21 h=-11
call boardwalk n=7 wide=2 y=12.5
pop
place UT_ElectricityIsland_Crane02 - at 9 30 ground sit yaw=180
place Creature_AnglerFish leviathan at 24 22 h=-8
place Zone_Trigger lagoonshow at 13 22.5 y=2
place Loot_ChestSmall showtankbox at 25 18 h=-11 drop yaw=30
place Loot_SunkenBarrel lagoonbarrel at 20 26 h=-10 drop

# ===== CHAPTER 4 - THE QUEEN ===============================================================================================
# --- The great gate across the north horn's neck: Utopia's great entrance door (Tangaroa's harbour gate is an open
# frame, and its mesh sits 84 m off its pivot) between double walls of chain-link from shore
# to shore; its panel on a post outside; the Queen in her valley; the keeper lodge at its head with the founder's desk and
# vault --------------------------------------------------------------------------------------------------------------------
place UT_MainEntranceDoor queengate at -12 56 y=-4.7 sit
line Balboa_DecorationPrefabBase_Fence_Mid from -50 56 to -18 56 step=2.98
line Balboa_DecorationPrefabBase_Fence_Mid from -50 57.2 to -18 57.2 step=2.98
line Balboa_DecorationPrefabBase_Fence_Mid from -6 56 to 26 56 step=2.98
line Balboa_DecorationPrefabBase_Fence_Mid from -6 57.2 to 26 57.2 step=2.98
place RT_PillarThick - at 0 52.5 ground sy=0.22
place TP_LaserControlPanel gatepanel at 0 52.15 y=0 yaw=180
place Zone_Trigger queengatezone at -12 66 y=1
place Creature_MamaBear queen at -10 76 ground
place Balboa_Shack - at 2 84 h=3.5
place Placeable_Table_Basic - at 0 84 h=5 drop
place Loot_ChestLarge vault at 1 86.6 h=5 drop yaw=180
# (REACH 10-29: dropped on the desk it ended inside the shack's fridge - laid beside the vault now)
# (REACH 10-29 (2): beside the vault it sank into the shack's floor - dropped onto the vault's lid)
# (REACH 10-29 (3): on the lid it fell through the chest and the floor into the hill (y 3.5) - set on the shack's floor
# by the vault's front at the floor's height, no drop)
place Note_Book farewell at 0 85.3 h=4.22 sit yaw=20

# --- Along the tour road: the road's lights on poles (dark till the power is back), direction signs ------------------
place Antenna_pole - at 14 -21 ground
place RT_Floodlight parklights at 14 -21 y=6.2 yaw=200
place Antenna_pole - at -2 22 ground
place RT_Floodlight parklights at -2 22 y=6.2 yaw=90
place Antenna_pole - at 40 -30 ground
place RT_Floodlight parklights at 40 -30 y=6.2 yaw=180
place Antenna_pole - at -8 50 ground
place RT_Floodlight parklights at -8 50 y=6.2 yaw=0
