# --- Animals: llamas grazing the north horn's shore, goats on the south horn, turtles in the bay, dolphins off the east;
# the jungle's sound -------------------------------------------------------------------------------------------------------
place Creature_Llama llamas at 18 70 ground
prop llamas creature.count=2
place Creature_Goat goats at -25 -45 ground
prop goats creature.count=3
place Creature_Turtle turtles at 40 10 h=-1.5
prop turtles creature.count=2
place Creature_Dolphin dolphins at 95 0 h=-3
prop dolphins creature.count=3
place Zone_Sound jungle at -20 10 y=10

# --- Things to gather, as suits the island (the user, 2026-10-05): flowers, melons, mangoes ----------
scatter "Pickup_Landmark_Flower_Red" 4 at 0 0 r=70.0 seed=4144 free=3
scatter "Pickup_Landmark_Flower_Yellow" 4 at 0 0 r=70.0 seed=4145 free=3
scatter "Pickup_Landmark_WatermelonLandmark" 6 at 0 0 r=70.0 seed=4154 free=3
scatter "Pickup_Landmark_Tree_Mango" 6 at 0 0 r=70.0 seed=4164 free=5

# --- Raft's finds in the shallows round the island and over the bay (lib_sea) -------------------------------------------
call shallows r=125 deep=5 n=2
call shallows x=52 z=30 r=15 deep=4 seed=90

# --- SILVER 10-26 (the user: one hour per island - hills, cliffs, a cave, a house, a wreck, secrets): Fern Knoll ------
# Fern Knoll with the park camera mast on it, Nest Cave, the ruined house where Rosa Okafor waits (four lamps round it: a puzzle), a boat wreck,
# a jump course, a maze, five park tickets about the island (a set), and at the house the hatchery console that wants the camera lens and the hatchery tag gun
call hw_zone x=-41.91 z=65.37 al=pp_trailz id=pp_trail r=5 msg="The trail up Fern Knoll starts here - round and up."
call hw_zone x=-50 z=78 al=pp_summitz id=pp_summit r=8 h=1 msg="The top of Fern Knoll. The whole island below you."
place Creature_Goat pp_goats at -37.91 68.37 ground
prop pp_goats creature.count=2
call hw_mast x=-53 z=80 h0=16 lv=6 a=pp_mast chest=pp_topchest top=Placeable_Flag_01
call ar_cave x=-86 z=-44 h=3 yaw=0 al=pp_caverock chest=pp_cavechest
call hw_zone x=-87 z=-35 al=pp_cavez id=pp_cave r=4 h=1 msg="Nest Cave. Water drips somewhere in the dark."
call ar_ruin x=-60 z=-84 h=3 yaw=0 w=3 d=2 al=pp_ruin
call ss_islander x=-61 z=-88.5 yaw=200 al=pp_isl nm="Rosa Okafor" pose=lean
prop pp_isl talk.text=Shh. Something hears better than you think out here.\n---\nI was the night keeper. When the storm came, they took the boat. I was out at the hatchery.\n---\nThe hatchery console wants the lens off the camera mast on Fern Knoll and my tag gun from Nest Cave. I want to know how many hatched.\n---\nAnd the hedge maze near here was for the visitors' children. Go on - there's a prize.\n---\nThe staff lamps round my house: each one you turn wakes the next. Light all four and look behind the back wall.
call ss_lamp x=-67 z=-85 al=pp_lamp1 nm="Staff lamp 1" grp="Staff lamps" on=1
call ss_lamp x=-61 z=-78 al=pp_lamp2 nm="Staff lamp 2" grp="Staff lamps" on=0
call ss_lamp x=-54 z=-85 al=pp_lamp3 nm="Staff lamp 3" grp="Staff lamps" on=1
call ss_lamp x=-61 z=-92 al=pp_lamp4 nm="Staff lamp 4" grp="Staff lamps" on=0
