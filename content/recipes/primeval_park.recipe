# Primeval Park - a themed island, five times the size (x5)
# Inspiration: the island theme-park-of-ancient-beasts film (a visitor centre, paddock fences, a storm that cuts the power,
#   a river ride, an aviary, a show lagoon, a great gate and the park's queen behind it) - the mood only, never named.
# Island type: Shape 6 (Crescent), Style 0 (tropical), low (Height 14: the generator's crescent at 36 m was one steep
#   ridge with no level ground for a park). A jungle crescent round a shallow bay that opens east: the arrival dock on the
#   bay's south shore, the visitor centre on a terrace at the crescent's middle, the boar paddock north of it, the show
#   lagoon dug at the bay's head, the river ride, the power house and the aviary on the south horn, the great gate across
#   the north horn's neck with the Queen's valley behind it.
# Primeval Park bred its animals big: ironback boars, the aviary's screechers, a leviathan in the show lagoon - and the
# park's crown, a giant bear the keepers called the Queen. A storm blew the park's three fuses and the staff fled on the
# last boat. Bring the power back, cross the park, open the great gate and meet the Queen.
# Quest "Welcome to Primeval Park" (28 steps, 4 chapters): arrival (4), the power (6), the aviary and the lagoon (6), the
# Queen (4) - large crop plot and recycler blueprints, titanium, batteries.
#
# Built by the recipe player (CIRecipe primeval_park) through the editor's own operations.
# SILVER 10-26: the new land - Fern Knoll with the park camera mast, Nest Cave, Rosa Okafor at the ruined house (a lamp puzzle), a boat wreck, a jump course, a maze, a set of five park tickets
include lib_rt
include lib_huts
include lib_relay
include lib_sea
include lib_features
include lib_areas
include lib_highwater
include lib_silver
new
# (nature: a jungle a little denser than Raft's tropical islands; the park's terraces, roads and paddocks cleared)
gen Trees=0.35 Bushes=0.35 Rocks=0.43 Harvest=0.24 BeachThings=0.3
gen Seed=9021 Radius=100 Height=14 Roughness=0.35 Peaks=2 Shape=6 Style=0 BeachWidth=0.5 Cliffs=0.3 PeakShape=0.4
gen SeaFloor=0 Shelf=0.45 Seabed=0
gen Water=0.5 SeaRocks=0.5 SeaFinds=0.5 Sunken=0.4 Hostiles=0
generate
# --- SILVER 10-26 terrain: the new land - pads raised from the sea (joined to the coast), Fern Knoll ------------------------
brush flatten at -60 -84 r=16 s=20 frames=500 h=3
brush smooth at -60 -84 r=21 s=4 frames=40
brush flatten at -60 -84 r=14 s=20 frames=500 h=3
brush flatten from -60 -84 to -50.7 -70.98 r=9 s=20 frames=500 h=3
brush flatten at -86 -40 r=17 s=20 frames=500 h=3
brush smooth at -86 -40 r=22 s=4 frames=40
brush flatten at -86 -40 r=15 s=20 frames=500 h=3
brush flatten at 64 -6 r=12 s=20 frames=500 h=2.5
brush smooth at 64 -6 r=17 s=4 frames=40
brush flatten at 64 -6 r=10 s=20 frames=500 h=2.5
brush flatten at -82 34 r=19 s=20 frames=500 h=1.5
brush smooth at -82 34 r=24 s=4 frames=40
brush flatten at -82 34 r=17 s=20 frames=500 h=1.5
brush flatten at -24 -92 r=14 s=20 frames=500 h=3
brush smooth at -24 -92 r=19 s=4 frames=40
brush flatten at -24 -92 r=12 s=20 frames=500 h=3
# (agent Q 10-30, REACH: the house pad and the Nest Cave pad stood out of the sea on banks 3 m high with no way up for a
# swimmer - a sand spit down into the water off each: the house pad's off the end of its causeway, Nest Cave's before its mouth)
brush flatten from -49.30 -62.18 to -42.82 -66.82 r=2 s=20 frames=60 h=2.3
brush flatten from -48.26 -60.72 to -41.78 -65.36 r=2 s=20 frames=60 h=1.6
brush flatten from -47.21 -59.26 to -40.73 -63.90 r=2 s=20 frames=60 h=0.9
brush flatten from -46.17 -57.81 to -39.69 -62.45 r=2 s=20 frames=60 h=0.2
brush flatten from -45.12 -56.35 to -38.64 -60.99 r=2 s=20 frames=60 h=-0.5
brush flatten from -44.08 -54.89 to -37.60 -59.53 r=2 s=20 frames=60 h=-1.2
brush smooth from -46.06 -64.50 to -40.84 -57.21 r=4 s=10 frames=20
clear from -46.06 -64.50 to -40.84 -57.21 r=5 body
brush flatten from -89.5 -27.0 to -82.5 -27.0 r=2 s=20 frames=60 h=2.3
brush flatten from -89.5 -25.2 to -82.5 -25.2 r=2 s=20 frames=60 h=1.6
brush flatten from -89.5 -23.4 to -82.5 -23.4 r=2 s=20 frames=60 h=0.9
brush flatten from -89.5 -21.6 to -82.5 -21.6 r=2 s=20 frames=60 h=0.2
brush flatten from -89.5 -19.8 to -82.5 -19.8 r=2 s=20 frames=60 h=-0.5
brush flatten from -89.5 -18.0 to -82.5 -18.0 r=2 s=20 frames=60 h=-1.2
brush smooth from -86 -27 to -86 -18 r=4 s=10 frames=20
clear from -86 -27 to -86 -18 r=5 body
call hw_mount x=-50 z=78 b=14 h=16
call hw_trail x=-50 z=78 b=14 h=16 a0=147.34 turn=300 n=40 h0=3

# --- Terrain: the visitor centre's terrace (7 m) cut into the crescent's middle, the maintenance shed on its west end;
# the boar paddock's field (5 m) and the keeper's pad; the river ride's channel cut from the bay into the south horn and
# its station's landing; the power house's yard (6.5 m); the aviary's hilltop (12 m); the show lagoon dug 12 m deep at
# the bay's head and the grandstand's three steps on its shore; the keeper lodge's pad in the Queen's valley ---------------
for vz -14 16 3.75
brush flatten from -30 $vz to 2 $vz r=4 s=20 frames=150 h=7
next
for vz 4 16 4
brush flatten from -37 $vz to -24 $vz r=4 s=20 frames=150 h=7
next
brush smooth from -26 -18 to 4 -18 r=4 s=10 frames=10
brush smooth from 5 -16 to 5 18 r=4 s=10 frames=10
for pz 29 45 4
brush flatten from -20 $pz to 4 $pz r=3.5 s=20 frames=60 h=5
next
brush flatten at 10.25 45.25 r=4 s=20 frames=80 h=3.5
for pass 1 2 1
brush flatten from 50 -21 to 56 -34 r=4 s=20 frames=200 h=-3
brush flatten from 56 -34 to 61 -46 r=4 s=20 frames=200 h=-3
brush flatten from 61 -46 to 60 -58 r=4 s=20 frames=200 h=-3
next
brush smooth from 50 -21 to 56 -34 r=5 s=10 frames=8
brush smooth from 56 -34 to 61 -46 r=5 s=10 frames=8
brush smooth from 61 -46 to 60 -60 r=5 s=10 frames=8
brush flatten at 61 -69.5 r=4 s=20 frames=80 h=1.8
for wz -58 -46 4
brush flatten from 32 $wz to 48 $wz r=3.5 s=20 frames=60 h=6.5
next
for az -53 -37 4
brush flatten from -10 $az to 10 $az r=4 s=20 frames=60 h=12
next
brush flatten at 24 22 r=8 s=20 frames=150 h=-12
for a 0 315 45
brush flatten at {24+9*cos($a)} {22+9*sin($a)} r=6 s=20 frames=100 h=-10
next
for a 0 340 20
brush smooth at {24+15*cos($a)} {22+15*sin($a)} r=4 s=10 frames=10
next
brush flatten from -2 12 to -2 32 r=2 s=20 frames=60 h=4
brush flatten from 1.5 12 to 1.5 32 r=2 s=20 frames=60 h=3
brush flatten from 5 12 to 5 32 r=2 s=20 frames=60 h=2
for lz 78 90 4
brush flatten from -8 $lz to 12 $lz r=4 s=20 frames=60 h=3.5
next
brush grass from -24 -14 to 2 16 r=6 s=20 frames=20
# (the generator's jungle off the park's grounds and roads)
clear from -40 -18 to 6 -18 r=16
clear from -37 10 to -24 10 r=8
clear from -22 37 to 6 37 r=10
clear at 10 45 r=5
clear from 50 -21 to 60 -62 r=6
clear at 61 -69 r=6
clear at 24 22 r=17
clear at 40 -52 r=11
clear at 0 -45 r=13
clear from -4 10 to -4 34 r=6
clear from -50 56 to 26 56 r=4
clear at 2 84 r=11
clear from 20 -24 to 40 -24 r=6
clear from 20 -22 to 2 -14 r=3
clear from -4 -8 to -4 26 r=3
clear from -4 28 to -10 52 r=3
clear from 40 -26 to 40 -50 r=3
clear from 32 -52 to 10 -48 r=3

# ===== CHAPTER 1 - ARRIVAL ===============================================================================================
# --- The arrival dock: a broad boardwalk out into the bay from its south beach, two tour boats at it; the welcome arch -
# two thick pillars and Caravan's banner between them - with the evacuation notice under it; the kiosk on the sand ------
push at 30 -19 h=-2 yaw=-90
call boardwalk n=10 wide=2 y=3.6
pop
place RT_PlasticBoat - at 24.5 -10 h=0.3 yaw=10
place RT_PlasticBoat - at 36 -6 h=0.3 yaw=-20
place RT_PillarThick - at 26 -25 ground
place RT_PillarThick - at 34 -25 ground
place Banner_01 - at 30 -25 y=2.7 sit sx=1.6
place Note_Board evacnotice at 28 -27 ground yaw=180
place Zone_Trigger dock at 30 -17 y=1
push at 38 -30 h=1.5
call stilt_hut y=2.6
place "Box Small" kioskbox at 3.4 3.4 y=2.6 sit yaw=20
pop
place Balboa_DirectionSign - at 21 -23 ground yaw=60

# --- The visitor centre on its terrace: four of the radio tower's rooms in a block - the lobby (its door to the plaza)
# and the gift shop at the front, the restaurant and the control room behind; the founder's statue on the plaza --------
push at -12 -2 h=7.15
push at 0 0
call rt_storey f1=RT_WallDoor1 f2=RT_WallWindow1 l2=RT_WallWindow1 r2=none b2=none
place RT_Floor - at 0 4.5 y=3
pop
push at 6 0
call rt_storey f1=RT_WallWindow1 f2=RT_WallWindow1 l1=none l2=none l3=none r2=RT_WallWindow1 b2=none
place RT_Floor - at 0 4.5 y=3
pop
push at 0 9
call rt_storey f1=none f2=none l2=RT_WallWindow1 b1=RT_WallWindow1 b2=RT_WallWindow1
place RT_Floor - at 0 4.5 y=3
pop
push at 6 9
call rt_storey f1=none f2=none l1=none l2=none l3=none r2=RT_WallWindow1 b1=RT_WallWindow1
place RT_Floor - at 0 4.5 y=3
pop
# (the lobby: banners, plants, a bench)
place Placeable_TangaroaPlant_4 - at -5.4 -3.8 y=0 sit
place Placeable_TangaroaPlant_4 - at -0.6 3.8 y=0 sit
place Bench_01 - at -5.3 0 y=0 sit yaw=90
place Zone_Trigger visitorcentre at -3 0 y=1.5
# (the gift shop: shelves of souvenirs, the stockroom crate)
place Shelf_Empty_02 - at 3 4.2 y=0 sit yaw=180
place Shelf_Empty_02 - at 5.7 1 y=0 sit yaw=270
place Placeable_Figurine_Llama - at 2.35 3.95 y=1.15 sit scale=0.8 yaw=180
place Placeable_Figurine_Goat - at 3.4 4.1 y=1.15 sit yaw=180
place Placeable_Figurine_Chicken - at 5.6 1 y=1.15 sit yaw=270
place Loot_Crate giftshop at 1.2 -3.6 y=0 sit
# (the restaurant: two tables, chairs, the kitchen's fridge)
place Table_Dining_01 - at -3.5 10 y=0 sit
place Table_Dining_01 - at -3.5 14 y=0 sit
place Dinnerchair_01 - at -3.5 9 y=0 sit
place Dinnerchair_01 - at -3.5 11 y=0 sit yaw=180
place Dinnerchair_01 - at -3.5 13 y=0 sit
place Dinnerchair_01 - at -3.5 15 y=0 sit yaw=180
place TangaroaKitchen_Fridge kitchenfridge at -5.4 12.6 y=0 sit yaw=90
# (the control room: the console, a server, the park's map - dark till the power comes back - the engineer's report,
# the ceiling lamps)
place VG_ControlBoard - at 3 12.1 y=0 sit scale=0.5 yaw=180
place TP_Selene_ComputerRoom_Server01 - at 5.1 6.5 y=0 sit yaw=270
place Placeable_Table_Basic - at 1.5 7 y=0 sit
place Note_Papers engreport at 1.5 7 y=2 drop yaw=15
place RadiationMap_Off mapoff at 0.1 9 y=1.6
place RadiationMap_On mapon at 0.1 9 y=1.6
place Stairwell_CeilingLamp parklights at 3 9 y=2.98
place Stairwell_CeilingLamp parklights at -3 0 y=2.98
pop
place TangaroaFounderStatue - at -9 -14 ground yaw=180
place Balboa_DirectionSign - at 3 -14 ground yaw=120

# ===== CHAPTER 2 - THE POWER ==============================================================================================
# --- The maintenance shed at the terrace's west end (a relay-station house, its veranda to the visitor centre): the
# workbench, the storage rack, the spares box ---------------------------------------------------------------------------
push at -24.5 16 h=7.05
call relay_house
place Workbench - at -9 -2 y=0 sit yaw=90
place "VG_DecorationPrefabBase_WorkshopStorage_2 Variant" - at -9 -6.5 y=0 sit yaw=90
place "Box Small" fuse1box at -5.5 -1.6 y=0 sit
pop

# --- The boar paddock north of the centre: Balboa's chain-link round a muddy field, one stretch broken; the ironbacks;
