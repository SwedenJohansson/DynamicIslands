brush sand from -18 37 to 2 37 r=7 s=20 frames=20
line Balboa_DecorationPrefabBase_Fence_Mid from -20 29 to 4 29 step=2.98
line Balboa_DecorationPrefabBase_Fence_Mid from -20 45 to 4 45 step=2.98
line Balboa_DecorationPrefabBase_Fence_Mid from -20 29 to -20 45 step=2.98
