call tzone x=80.18 z=-21.46 al=bssummit id=bs_summit r=4 msg="The peak beside the Old Light. Wind, gulls, and the whole saddle under you." h=1
call notebox x=84.46 z=-18.98 yaw=104.98 al=bscairn
call treasure x=83.04 z=-24.29 r=1.5 n=1 seed=14901
prop treasure14901 treasure.loot=TitaniumOre*2;Battery*1
