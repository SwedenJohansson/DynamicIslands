clear at -16.43 52.79 r=1.5 only=TP_BigRock
clear at -30.27 34.12 r=1.5 only=TP_BigRock
clear at -34.44 -20.65 r=1.5 only=TP_BigRock
clear at -40.56 -14.82 r=1.5 only=TP_BigRock

save Steamvent Harbour
