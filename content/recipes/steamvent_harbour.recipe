call fz_zone x=52 z=48 al=mastnez id=mast_ne r=4 msg="The north-east mast, its cable down in a drift. A bear's den in the lee of it."
call fz_zone x=49 z=3 al=masteastz id=mast_east r=4 msg="The east mast on its rise. The cable box at its foot is still shut."
