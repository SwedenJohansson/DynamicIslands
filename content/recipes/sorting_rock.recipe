# Sorting Rock - an island of the library's plan The Last Post (the Coastal Post's route, the fifth stop)
# A grey rock with a quarried bowl in its top: the Coastal Post's sorting hall in the bowl, a roof on pillars over
# sorting tables, five parcel scales (Caravan Town's scale model, the scales ready piece) in a row on them; the rates
# office's chest under the hall roof, Lise's locker by the back wall; the cistern (Utopia's water tank) on the bowl's
# rim; the landing stair and a short jetty on the south shore; the postal safe buried somewhere on the rock.
# Quest "Weighed and Sorted" (21 steps): the hall door, the rate chart, the sorter's tool rack (detector and spade), the
# buried postal safe (the parcel weights), three parcels weighed, the rates office (four water blueprints), Lise's
# letter in her locker, her reply.
#
# Built by the recipe player (CIRecipe sorting_rock) through the editor's own operations.
include lib_sea
include lib_features
include lib_post
include lib_areas
include lib_highwater
include lib_lastpost
# RESIZE 10-26 (the user: Raft-big, one-hour islands): Radius 46 -> 85; the old island moved 39 m south (push frames), so its south shore stays on the coast and the new land is north
# POST 10-26: the new land - Quarry Crag with quarry mast, Slate Cave, Greta Moberg at the ruined house (a lamp puzzle), a crashed plane, a jump course, a maze, a set of five parcel labels
new
# (nature: a bare rock, Like Raft's rocky islands - few bushes)
gen Trees=0.12 Bushes=0.15 Rocks=0.5 Harvest=0.15 BeachThings=0.25
gen Seed=4501 Radius=85 Height=13 Roughness=0.55 Peaks=1 Shape=0 Style=4 PeakShape=0.35 Cliffs=0.55 BeachWidth=0.25
gen Water=0.5 SeaRocks=0.45 SeaFinds=0.15 Sunken=0.2 Hostiles=0 Friendly=0 SeaLife=0.3
generate
# --- 10-26 relief (no flat plains): hills and ridges first, so the old island's pads cut into them after ---
# Sorting Rock's own look: a quarry in the south-east - a long cut ridge, bare rock face, a bench cut into it
call ar_ridge x1=36 z1=-62 x2=58 z2=-42 h=9 top=6 r=8
brush flatten at 46 -54 r=5 s=20 frames=200 h=5
brush rock from 36 -62 to 58 -42 r=11 s=10 frames=40
call ar_ridge x1=-20 z1=-14 x2=-40 z2=-2 h=5 top=4 r=6
push at 0 -39

# --- Terrain: the bowl (4 m) in the rock's top, the landing stair down to the south shore (1.5 m) -------------------
brush flatten at 0 2 r=13 s=20 frames=160 h=4
brush flatten from 0 -14 to 0 -30 r=4 s=20 frames=100 h=1.6
brush smooth from 0 -8 to 0 -30 r=5 s=8 frames=30
brush rock at 0 2 r=15 s=8 frames=30
pop
origin
# --- POST 10-26 terrain: Quarry Crag, the pads of the new areas ---------------------------------------------------
call hw_mount x=-38 z=46 b=24 h=22
call hw_trail x=-38 z=46 b=24 h=22 a0=131.82 turn=300 n=40 h0=3
brush flatten at 0 12 r=4 s=8 frames=60
clear at 0 12 r=7
# (RESIZE 10-26: the old island, 39 m south)
push at 0 -39
clear at 0 2 r=13
clear from 0 -10 to 0 -34 r=4

# --- The jetty and the landing ------------------------------------------------------------------------------------------
call pier x=0 z1=-30 z2=-52 h=1.45
place Placeable_Lantern_Metal - at 1.2 -51 h=1.6 sit drop

# --- The sorting hall: 6 x 4 cells of roof on pillars, sorting tables, the five scales, the rates office chest --------
push at -4.5 -2 h=4
call openhall w=6 d=4
place Zone_Trigger doorzone at 4.5 0.5 y=0.8
place "Table Office" - at 1.5 2.6 y=1.3 sit drop yaw=0
place "Table Office" - at 3.6 2.6 y=1.3 sit drop yaw=0
place "Table Office" - at 5.7 2.6 y=1.3 sit drop yaw=0
place "Table Office" - at 7.8 2.6 y=1.3 sit drop yaw=0
place TangaroaScaleModel scale1 at 1.1 3 y=2.3 sit drop yaw=0
place TangaroaScaleModel scale2 at 2.6 3 y=2.3 sit drop yaw=0
place TangaroaScaleModel scale3 at 4.1 3 y=2.3 sit drop yaw=0
place TangaroaScaleModel scale4 at 5.6 3 y=2.3 sit drop yaw=0
place TangaroaScaleModel scale5 at 7.4 3 y=2.3 sit drop yaw=0
place Note_Paper ratechart at 8.3 0.8 y=2 sit drop yaw=-80
place Placeable_Cupboard_Small - at 8.3 0.8 y=1.3 sit drop yaw=270
place Loot_Chest ratesoffice at 4.5 5.4 y=1.3 sit drop yaw=180
place Placeable_Cupboard_Medium liselocker at 1 5.3 y=1.3 sit drop yaw=180
place Note_Paper lisereply at 2 5.3 y=1.3 sit drop yaw=10
place Loot_ChestSmall toolrack at 7.6 5.4 y=1.3 sit drop yaw=180
call mailsack x=0.8 z=0.8 yaw=30 al=sacks
call mailsack x=1.6 z=1.1 yaw=-50 al=sacks
pop

# --- The cistern on the bowl's west rim, a rain tank by the hall -----------------------------------------------------
place UT_WaterTank cistern at -16 6 ground sit yaw=90
place Placeable_WaterTank - at 7 6 ground sit yaw=180

# --- The buried postal safe, the reefs, a few things to gather -----------------------------------------------------------
call treasure x=-12 z=-14 r=10 n=1 seed=4511 kind=0
call dirt x=14 z=-12 r=8 n=2 seed=4512
scatter "Pickup_Landmark_Flower_Blue" 2 at 0 16 r=14 seed=4513 free=3
place Creature_Dolphin dolphins at -30 -50 h=-3
prop dolphins creature.count=2
call shallows r=62 deep=5 n=2

pop

# --- POST 10-26 (the user: one hour per island - hills, cliffs, a cave, a house, a wreck, secrets): Quarry Crag ------
# Quarry Crag with quarry mast on it, Slate Cave, the ruined house where Greta Moberg waits (four lamps round it: a puzzle), a crashed plane,
# a jump course, a maze, five parcel labels about the island (a set), and at the hub the parcel crane that wants the crane hook and the crane chain
call hw_zone x=-19.37 z=29.33 al=qr_trailz id=qr_trail r=5 msg="The trail up Quarry Crag starts here - round and up."
call hw_zone x=-38 z=46 al=qr_summitz id=qr_summit r=8 h=1 msg="The top of Quarry Crag. The whole island below you."
call hw_mast x=-41 z=48 h0=22 lv=5 a=qr_mast chest=qr_topchest top=RT_Spotlight
place ZiplinePath_Landmark qr_zip at -34.8 43.4 h=23.35
zipto qr_zip -1.47 16
place Creature_Goat qr_goats at -15.37 32.33 ground
prop qr_goats creature.count=2
call ar_cave x=48 z=46 h=3 yaw=180 al=qr_caverock chest=qr_cavechest
call hw_zone x=49 z=37 al=qr_cavez id=qr_cave r=4 h=1 msg="Slate Cave. Water drips somewhere in the dark."
call ar_ruin x=58 z=-16 h=3 yaw=0 w=3 d=2 al=qr_ruin
call lp_islander x=57 z=-20.5 yaw=200 al=qr_isl nm="Greta Moberg" pose=lean
prop qr_isl talk.text=You climbed the landing stair? Good legs. I drove the parcel crane.\n---\nWhen the Post shut they wanted to take the crane away. I took its hook up the quarry mast on Quarry Crag and its chain into Slate Cave, and they went without it.\n---\nIt was the best crane on the coast. Make it lift once more.\n---\nAnd my lamps: four round the house, each one wakes its neighbour. All four lit, and look behind the back wall.
call lp_lamp x=51 z=-17 al=qr_lamp1 nm="Quarry lamp 1" grp="Quarry lamps" on=0
call lp_lamp x=57 z=-10 al=qr_lamp2 nm="Quarry lamp 2" grp="Quarry lamps" on=1
call lp_lamp x=64 z=-17 al=qr_lamp3 nm="Quarry lamp 3" grp="Quarry lamps" on=0
call lp_lamp x=57 z=-24 al=qr_lamp4 nm="Quarry lamp 4" grp="Quarry lamps" on=1
prop qr_lamp1 on.use=light|Quarry lamp 2|toggle
prop qr_lamp2 on.use=light|Quarry lamp 3|toggle
prop qr_lamp3 on.use=light|Quarry lamp 4|toggle
prop qr_lamp4 on.use=light|Quarry lamp 1|toggle
prop qr_lamp1 on.alllit=show|qr_lampchest\nmessage||All four lamps burn. Behind the back wall a stone has been lifted.
call lp_hidden x=59 z=-11.4 al=qr_lampchest
place Creature_Chicken qr_hens at 66 -10 ground
prop qr_hens creature.count=3
call ar_plane x=-58 z=-26 h=3 yaw=40 al=qr_plane crate=qr_planecrate
place Note_Paper qr_pilot at -59.78 -21.9 ground y=0.1 drop yaw=70
call hw_zone x=-58 z=-26 al=qr_planez id=qr_plane r=6 h=1 msg="A plane, nose down in the grass. Nobody came for it."
# JUMP qr pad=3 at=6 66
push at 6 66
clear at 0 0 r=17 all
brush flatten at 0 0 r=14 s=20 frames=300 h=3
brush smooth at 0 0 r=18 s=4 frames=40
brush flatten at 0 0 r=12 s=20 frames=300 h=3
brush auto at 0 0 r=18 s=10 frames=25
clear at 0 0 r=18
