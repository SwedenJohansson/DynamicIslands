# --- DEEP 10-24 (one-hour pass: a climb, a dive, more to find; RAFT_ISLAND_DESIGN 0b): three ranger relays (fork sign, drawbridge, blighted vines), the timber-port crane on the east bluff (climb), the sunk barge (dive), the gorge hill, the otter den
# the fork sign (RAFT_QUEST_MECHANICS M2): the three relays named where the river splits
place Note_Sign forksign at 4 24 ground sit yaw=200
# Relay Mouth by the landing (its fuse went down with the barge), Relay East over the drawbridge, Relay North behind
# the blighted vines upriver. All three on -> the outpost's map screen shows the route code (M1 + M2 + M3)
place Antenna_pole - at -9 -61 ground sit sy=0.5
place TP_RotatingRedLight relaymlamp at -9 -61 ground y=3.25
place RT_CommRadio relaym at -8.1 -61 ground sit yaw=160
place Antenna_pole - at 36 -44 ground sit sy=0.5
place TP_RotatingRedLight relayelamp at 36 -44 ground y=3.25
place RT_CommRadio relaye at 36.9 -44 ground sit yaw=200
place Antenna_pole - at -20 58.5 ground sit sy=0.5
place TP_RotatingRedLight relaynlamp at -20 58.5 ground y=3.25
place RT_CommRadio relayn at -19.1 58.5 ground sit yaw=20
place ChoppableVines northvines at -20 56 ground yaw=20
place ChoppableVines - at -22 57.5 ground yaw=80
# the east arm's drawbridge: pulled in on the west pad; the lever slides it 8.8 m across onto the east pad
brush flatten from 10 -40 to 16 -40 r=3 s=20 frames=150 h=1.4
brush flatten from 28 -40 to 32 -40 r=3 s=20 frames=150 h=1.4
clear from 9 -40 to 17 -40 r=3
clear from 27 -40 to 33 -40 r=3
