call hut w=3 d=2 y=0.1
place Loot_Chest toolrack at 3.6 2.3 y=0.1 sit yaw=180
pop
place UT_MarketBasket01 - at 4 -12 ground y=0.5 yaw=30
place campfire_1 - at 5 -15 ground sit

