# Riverfork Delta - the third island of the library's plan The Last Green World (SL11, Verdance)
# A jungle delta cut by river arms: the west and east arms run down to the sea and an upper river joins them, so the
# middle of the island is an island of its own. The river people's outpost stands on it with their tool rack; Balboa's
# vines choke the path to the west arm, where a rope ferry's crank wheel stands on a post. Upriver, boars root round a
# fuel cache and a pressing shed. Quest "The Rivers" (13 steps): the river mouth, the river chart, the machete plans in
# the outpost, the vines and the west arm, the ferry crank, upriver (it brings Tracker's Rise), three boars, the fuel
# tank and fuel pipe plans in the fuel cache, the biofuel extractor plans in the pressing shed, Ranger log 4.
#
# Built by the recipe player (CIRecipe riverfork_delta) through the editor's own operations. Points (metres over the
# sea): the river arms 1.2 m under the sea along x -22 and x 22 (z -85..30) and the upper river along z 30; the mouth
# beach at 1.4 m round 0 -52, the outpost x -2..2.5, z -16..-13 at 1.6 m, the vines -11 1, the ferry crank -16 8.5,
# upriver at 2 m round 0 45, the fuel cache -8 48, the pressing shed x 6..10.5, z 42..45.
include lib_sea
include lib_features
include lib_huts
include lib_gravity
include lib_verdance
include lib_ni8
new
gen Trees=0.3 Bushes=0.35 Rocks=0.2 Harvest=0.35 BeachThings=0.3
gen Seed=11031 Radius=85 Height=10 Roughness=0.3 Peaks=1 Shape=0 Style=0 PeakShape=0.4 Cliffs=0.2 BeachWidth=0.6
gen Water=0.5 SeaRocks=0.3 SeaFinds=0.4 Sunken=0.2 Hostiles=0 Friendly=0.2 SeaLife=0.4
generate

# --- Terrain: the river arms (wading depth), then the pads ------------------------------------------------------------
brush flatten from -22 30 to -22 -85 r=4 s=20 frames=300 h=-1.2
brush flatten from 22 30 to 22 -85 r=4 s=20 frames=300 h=-1.2
brush flatten from -22 30 to 22 30 r=4 s=20 frames=300 h=-1.2
brush sand from -22 30 to -22 -80 r=6 s=6 frames=30
brush sand from 22 30 to 22 -80 r=6 s=6 frames=30
brush sand from -22 30 to 22 30 r=6 s=6 frames=30
brush flatten at 0 -52 r=6 s=20 frames=200 h=1.4
brush flatten at 0 -14.5 r=6 s=20 frames=200 h=1.6
brush flatten from -10 2 to -15 7 r=3 s=20 frames=120 h=1.4
brush flatten at 0 45 r=12 s=20 frames=200 h=2
brush flatten at 8.25 43.5 r=4 s=20 frames=200 h=2
origin
clear at 0 -52 r=6
clear at 0 -14.5 r=6
clear from -6 -8 to -16 8 r=3
clear at 0 45 r=10

