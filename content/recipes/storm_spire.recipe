place Block_Foundation_Tier3 jppss at 4.85 -3.53 h=9.668 sy=10.650
place Block_Foundation_Tier3 jppss at 2.54 -5.44 h=10.418 sy=11.749 sx=2 sz=2
prop jpss tint.color=#5d6066
prop jpss tint.amount=0.35
prop jppss tint.color=#5d6066
prop jppss tint.amount=0.35
place Loot_Chest jcss at 1.04 5.91 h=7.35 sit yaw=0
prop jcss loot.refill=0
place Loot_ChestSmall jbss at 2.54 -5.44 h=11.1 sit yaw=0
prop jbss loot.refill=0
pop
call hw_zone x=58 z=40 al=ss_jumpz id=ss_jumps r=6 h=1 msg="Stone stacks, one higher than the next. Something at the top."
push at -19.5 -89.5 h=3
place Block_Wall_Tier3 ss_maze at 0.75 0 y=0.05
place Block_Wall_Tier3 ss_maze at 2.25 0 y=0.05
