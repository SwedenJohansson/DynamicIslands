# Storm Spire - an island of the library's plan Raft 2: The Drowned Frontier (station Seven of the Frontier Corps)
# A needle of rock in the storm belt, its top cut flat for the Corps' weather station (33.5 m): a radio tower room with a
# mast and a turning wind vane on its roof; up the needle's west side the station's lift tower - its car
# stuck at the top, a ladder up the tower with a landing halfway - and a bridge from its top to the station; the shed and
# the meteorologist's tapes at the landing on the west beach; grey storm light, mist and rain round the spire. Quest "Eye
# of the Storm" (17 steps): the tapes, the climb, the storm bird on the mast, the dive for the cove's
# box, three conductor rods (the shed, the tower's landing, the cove), the station's locker (the electric smelter's, the advanced biofuel
# extractor's and the advanced anchor's blueprints).
# RAFT2 10-26 (1-hour pass): the needle's new shore - Thunder Knoll (north) with a lightning mast, Lightning Cave (south-east), the old met hut (east) where Ivo Brand waits (a lamp puzzle), a weather plane down in the south-west shallows, a jump course (north-east), the Corps' storm maze (south), five storm glasses (a set), a buried cache; by the shed the storm siren that wants the mast's rotor and the cave's coil
#
# Built by the recipe player (CIRecipe storm_spire) through the editor's own operations.
include lib_sea
include lib_rt
include lib_features
include lib_highwater
include lib_areas
include lib_raft2
new
# (nature: forest, Like Raft - pines up a rock needle; Whiteout Reach after it is the snowy one)
gen Trees=0.21 Bushes=0.38 Rocks=0.42 Harvest=0.1 BeachThings=0.3
gen Seed=8107 Radius=55 Height=48 Roughness=0.6 Peaks=1 Shape=0 Style=3 PeakShape=0.9 Cliffs=0.6
gen Water=0.5 SeaRocks=0.5 SeaFinds=0.5 Sunken=0.4 Hostiles=0 Friendly=0.2 SeaLife=0.3
generate

# --- Terrain: the needle's top cut flat for the station (33.5 m), the lift tower's pad at its west foot (9.5 m), the
# landing on the west beach (3 m) ---------------------------------------------------------------------------------------
# (the top 16 m across: at 11 m the station's corners hung over its edge; 0.1 m under the bridge and the station's floor)
brush flatten at 1 9 r=8 s=20 frames=90 h=33.4
brush flatten at -11 9 r=3.5 s=20 frames=50 h=9.5
# (a path up to the pad from the beach side - its edge stood as a 2 m bank: 14 m long, rising to the pad's height at
# its west edge; a shorter one ended in a step under the tower's west pillars)
for i 0 12 1
brush flatten at {-28+$i*1.17} 9 r=2.6 s=20 frames=15 h={3.6+$i*0.5}
next
brush smooth from -29 9 to -15.5 9 r=2.6 s=10 frames=12
# (the pad levelled again after the path: its smoothing left the tower's west pillars 0.4-0.6 m over the ground)
brush flatten at -11 9 r=2.6 s=20 frames=40 h=9.5
# (and under the tower's west pillars, where the pad meets the path: their feet stood 0.4 m over the ground)
brush flatten from -12.25 7.5 to -12.25 10.5 r=1.8 s=20 frames=40 h=9.55
brush flatten at -33 8 r=5 s=20 frames=50 h=3
# (the needle's sides and top painted rock: cut flat and widened, it stood as a smooth tan column)
brush rock at 1 9 r=11 s=20 frames=40
origin
# --- RAFT2 10-26 terrain: the land grows (banks first), then the pads of the new areas -------------------------------
# the banks round the needle: north (to Thunder Knoll), east, south-east, south (the maze), south-west, north-east
brush flatten from 10 48 to 14 62 r=11 s=20 frames=500 h=3
brush flatten from 50 0 to 76 -4 r=12 s=20 frames=500 h=3
brush flatten from 36 -40 to 52 -58 r=11 s=20 frames=500 h=3
brush flatten from -10 -50 to -12 -68 r=12 s=20 frames=500 h=3
brush flatten from -40 -36 to -60 -52 r=10 s=20 frames=500 h=2
brush flatten from 36 34 to 54 44 r=12 s=20 frames=500 h=3
brush auto at 14 60 r=14 s=10 frames=25
brush auto at 64 -4 r=18 s=10 frames=25
brush auto at 46 -52 r=14 s=10 frames=25
brush auto at -12 -62 r=14 s=10 frames=25
brush auto at -52 -46 r=14 s=10 frames=25
brush auto at 46 40 r=14 s=10 frames=25
# the pads: the cave (Lightning Cave), the ruined house, the plane
call r2_pad x=56 z=-74 r=14 h=3
brush flatten from 56 -66 to 56 -50 r=6 s=20 frames=300 h=3
call r2_pad x=78 z=-4 r=11 h=3
call r2_pad x=-64 z=-56 r=11 h=2
brush flatten from -12 -68 to -12 -86 r=14 s=20 frames=500 h=3
call r2_pad x=-12 z=-82 r=17 h=3
# Thunder Knoll: summit 18 m, base r 20, the trail from the foot toward the hub
call hw_mount x=18 z=80 b=20 h=18
call hw_trail x=18 z=80 b=20 h=18 a0=-149.22 turn=300 n=34 h0=3
brush flatten at -38 -14 r=4 s=8 frames=60
clear at -38 -14 r=7
clear at 1 9 r=9
clear at -11 9 r=5
clear at -33 8 r=7
clear from -33 8 to -12 9 r=2.5

# --- The landing on the west beach: the shed (Raft's wooden walls, a wooden roof, its door to the spire) with the first
# rod, the meteorologist's tapes on a crate by it ------------------------------------------------------------------------
push at -35.5 5.5 h=3
for fx 0.75 2.25 1.5
for fz 0.75 2.25 1.5
place Block_Floor_Wood - at $fx $fz y=0.2
next
next
place Block_Wall_Wood - at 0.75 0 y=0.2
place Block_Wall_Wood - at 2.25 0 y=0.2
place Block_Wall_Wood - at 0.75 3 y=0.2
place Block_Wall_Wood - at 2.25 3 y=0.2
place Block_Wall_Wood - at 0 0.75 y=0.2 yaw=90
place Block_Wall_Wood - at 0 2.25 y=0.2 yaw=90
place Block_Wall_Wood - at 3 0.75 y=0.2 yaw=90
place Block_Pillar_Wood - at 0 0 y=0.2
place Block_Pillar_Wood - at 3 0 y=0.2
place Block_Pillar_Wood - at 0 3 y=0.2
place Block_Pillar_Wood - at 3 3 y=0.2
roof 2 2 at 0 0 y=0.2 wood
place "Box Small" rodshed at 0.9 2.2 y=0.2 sit yaw=10
pop
place Crate_Big_01 - at -30.5 9.5 ground yaw=15
place Note_Paper tapes at -30.5 9.5 h=8 sit drop yaw=80
place Placeable_Lantern_Metal - at -30.1 9.9 h=8 sit drop
place Zone_Trigger spirefoot at -31 8 h=4

# --- The station's lift tower at the needle's west foot: four storeys of the radio tower's thick pillars, Raft's 6 m
# ladders up its west face, a landing halfway with the second rod, the stuck car on its top, a bridge to the station -----
push at -11 9 h=9.5
for lv 0 18 6
place RT_PillarThick - at -1.25 -1.25 y=$lv
place RT_PillarThick - at 1.25 -1.25 y=$lv
place RT_PillarThick - at -1.25 1.25 y=$lv
place RT_PillarThick - at 1.25 1.25 y=$lv
place LandmarkLadder_6m - at -1.45 0 y=$lv yaw=90
next
place Block_Floor_Wood landing at 0 0 y=12
place "Box Small" rodledge at 0.2 0.3 y=12 sit yaw=35
for fx -0.75 0.75 1.5
for fz -0.75 0.75 1.5
place Block_Floor_Wood - at $fx $fz y=24
next
next
place Block_Wall_Fence_Rope - at -0.75 1.5 y=24
place Block_Wall_Fence_Rope - at 0.75 1.5 y=24
place Block_Wall_Fence_Rope - at -0.75 -1.5 y=24
place Block_Wall_Fence_Rope - at 0.75 -1.5 y=24
# (the bridge to the station's door: five blocks - three ended 2 m short of the top, over a 22 m drop)
for bx 2.25 8.25 1.5
place Block_Floor_Wood - at $bx 0 y=24
place Block_Wall_Fence_Rope - at $bx -0.75 y=24
place Block_Wall_Fence_Rope - at $bx 0.75 y=24
next
pop

# --- The weather station on the needle's top: a radio tower room (its door to the bridge), the instrument panel and the
# locker behind it; on its roof the mast with a wind vane turning in the storm, the storm bird (the radio tower's
# down-pipe as a lightning rod lay flat on the roof - left out) ----------------------------------------------------------
push at 4 9 h=33.5
call rt_storey l2=RT_WallDoor1 f1=RT_WallWindow1 b2=RT_WallWindow1 r2=RT_WallWindow2
place RT_Floor - at 0 4.5 y=3.05
place "Table Office" - at -3 3.4 sit
place RT_RadarScreen - at -2.9 3.85 y=1.08 sit yaw=180 scale=0.5
place Locker stationlocker at -0.55 2.4 sit yaw=270
place Placeable_Lantern_Metal - at -4.2 3.6 y=1.2 sit drop
place RT_PillarThick mast at -1.2 -3.2 y=3.05
# (the vane's foot is wider than the mast: it stands on a 2 x 2 m scaffold platform on the mast's top)
place Scaffolding_2x2m - at -1.2 -3.2 y=9.05
place Placeable_WindTurbine vane at -1.2 -3.2 y=10.05 scale=0.45
place Zone_Trigger spiretop at -3 0 y=1.5
place Creature_StoneBird stormbird at -3 0 y=9
pop

# (box agent 10-24: a generated sand rock grew round the cove box - cleared)
clear at -30 57 r=3 only=Rock|Boulder
# --- The north cove off the north-west shore (3.8 m down, a level spot - CISeaSpots): the third rod's box on its floor --
place "Box Small" rodcove at -30 57 ground yaw=40

# --- The storm round the spire: grey light and mist, the rain's sound -----------------------------------------------------
place Zone_Atmosphere storm at 0 9 h=18
place Zone_Sound rain at 0 9 h=10

# --- RAFT2 10-26 (the user: one hour per island - hills, a cave, a house, a wreck, secrets): the needle's new shore - Thunder Knoll (north) with a lightning mast, Lightning Cave (south-east), the old met hut (east) where Ivo Brand waits (a lamp puzzle), a weather plane down in the south-west shallows, a jump course (north-east), the Corps' storm maze (south), five storm glasses (a set), a buried cache; by the shed the storm siren that wants the mast's rotor and the cave's coil ------
call hw_zone x=7.25 z=61.96 al=ss_trailz id=ss_trail r=5 msg="The trail up Thunder Knoll starts here - round and up."
call hw_zone x=18 z=80 al=ss_summitz id=ss_summit r=8 h=1 msg="The top of Thunder Knoll. The whole island below you."
call hw_mast x=15 z=82 h0=18 lv=5 a=ss_mast chest=ss_topchest top=Placeable_Lantern_Metal
place ZiplinePath_Landmark ss_zip at 21.2 77.4 h=19.35
zipto ss_zip -34 -10
place Creature_Goat ss_goats at 11.25 64.96 ground
prop ss_goats creature.count=2
call ar_cave x=56 z=-74 h=3 yaw=0 al=ss_caverock chest=ss_cavechest
call hw_zone x=55 z=-65 al=ss_cavez id=ss_cave r=4 h=1 msg="Lightning Cave. The thunder sounds far away in here."
call ar_ruin x=78 z=-4 h=3 yaw=0 w=3 d=2 al=ss_ruin
call r2_islander x=77 z=-8.5 yaw=200 al=ss_isl nm="Ivo Brand" pose=sit
prop ss_isl talk.text=Sit down before the wind sits you down.\n---\nI read the glasses for the Corps for nine years. Rain, rain, hail, rain. Then the siren went quiet and the boats stopped coming.\n---\nThe siren wants its rotor from the mast on Thunder Knoll and its coil from Lightning Cave. And if you've time, the storm maze south - the Corps built it to teach recruits not to panic.\n---\nAnd my lamps - four round the house. Each one you turn wakes its neighbour too. Light all four and look behind the back wall.
place Placeable_Chair_Basic - at 77 -8.5 ground sit yaw=200
call r2_lamp x=71 z=-5 al=ss_lamp1 nm="Met lamp 1" grp="Met lamps" on=1
call r2_lamp x=77 z=2 al=ss_lamp2 nm="Met lamp 2" grp="Met lamps" on=0
call r2_lamp x=84 z=-5 al=ss_lamp3 nm="Met lamp 3" grp="Met lamps" on=0
call r2_lamp x=77 z=-12 al=ss_lamp4 nm="Met lamp 4" grp="Met lamps" on=1
prop ss_lamp1 on.use=light|Met lamp 2|toggle
prop ss_lamp2 on.use=light|Met lamp 3|toggle
prop ss_lamp3 on.use=light|Met lamp 4|toggle
prop ss_lamp4 on.use=light|Met lamp 1|toggle
prop ss_lamp1 on.alllit=show|ss_lampchest\nmessage||All four lamps burn. Behind the back wall a stone has been lifted.
call r2_hidden x=79 z=0.6 al=ss_lampchest
place Creature_Chicken ss_hens at 86 2 ground
prop ss_hens creature.count=3
call ar_plane x=-64 z=-56 h=2 yaw=40 al=ss_plane crate=ss_planecrate
place Note_Paper ss_pilot at -65.78 -51.9 ground y=0.1 drop yaw=70
call hw_zone x=-64 z=-56 al=ss_planez id=ss_plane r=6 h=1 msg="A weather plane in the shallows, one wing in the water."
# JUMP ss pad=3 at=58 48
push at 58 48
clear at 0 0 r=17 all
brush flatten at 0 0 r=14 s=20 frames=300 h=3
brush smooth at 0 0 r=18 s=4 frames=40
brush flatten at 0 0 r=12 s=20 frames=300 h=3
brush auto at 0 0 r=18 s=10 frames=25
clear at 0 0 r=18
place Block_Foundation_Tier3 jpss at -4.24 -4.24 h=3.6
place Block_Foundation_Tier3 jpss at -5.77 -1.65 h=4.35
place Block_Foundation_Tier3 jpss at -5.85 1.35 h=5.1
place Block_Foundation_Tier3 jpss at -4.46 4.01 h=5.85
