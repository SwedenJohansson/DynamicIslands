# Temperance Remade - an island of the library's plan Raft Remade (in place of Raft's Temperance)
# Raft's Temperance made anew: a snowy ridge island - an igloo village on the north flats, Selene's station on a terrace
# above it (its reactor tripped in a storm, its inner doors shut), the telescope on a terrace cut into the peak, and a
# snowmobile that went through the ice in the bay. Quest "The Reactor's Last Breath" (10 steps): the village, the
# station chief's note, three cable drums each from its crate (the village store, the sunken snowmobile, the telescope)
# and all three carried, the station, the reactor started and the inner doors passed, the polar bear mother and the
# chief's vault (Temperance's blueprints: the electric smelter, the advanced biofuel refiner, the advanced stationary
# anchor).
# RAFT REMADE 10-26 (1-hour pass): grown to Raft's size (r80 about 75) by land added round it: Frost Ridge (south, 22 m)
# and its weather mast, the ice fishing camp (east), the west crags with a wrecked whaler and an ice cave (a locked
# chest, its key in the whaler: a secret), the supply plane (north-east). The reactor now needs five drums: one more on
# the weather mast, one in the fisherman's locker. Quest 13 -> 18 steps. Design: _ProjectDocs/plans/storylines_old/RAFT_REMADE.md.
#
# Built by the recipe player (CIRecipe temperance_remade) through the editor's own operations (macros from lib_selene).
include lib_sea
include lib_selene
include lib_features
include lib_highwater
include lib_areas
include lib_raft_remade
new
# (nature and the life under water: as on Raft's island itself - Randomize existing measures them)
randomize Temperance like Seed=7107 Radius=62 Height=32 Cliffs=0.2 BeachWidth=0.5 Hostiles=0 Friendly=0 SeaLife=0.3

# --- Terrain: the village's flats (4 m), the station's terrace (9 m), the road between them, the telescope's terrace
# (18 m) cut into the peak and the path up to it -------------------------------------------------------------------
brush flatten from -10 38 to 16 38 r=11 s=20 frames=60 h=4
brush flatten from -22 18 to 6 18 r=9 s=20 frames=90 h=8.85
for i 0 5 1
brush flatten at {-2-$i*2.4} {31-$i*1.0} r=2.8 s=20 frames=30 h={4.2+$i*0.96}
next
brush smooth from -2 31 to -14 26 r=3 s=10 frames=20
brush flatten at -5 -6 r=6 s=20 frames=40 h=18
for i 0 6 1
brush flatten at {8-$i*2.17} {12-$i*2.67} r=2.6 s=20 frames=30 h={9.2+$i*1.47}
next
brush smooth from 8 12 to -5 -4 r=3 s=10 frames=20
origin
clear at 2 38 r=16
clear at -8 18 r=16
clear from -2 31 to -14 26 r=4
clear from 8 12 to -5 -4 r=4
clear at -5 -6 r=7
clear at -6 -9 r=8 only=Rock|Boulder
clear at -32 51 r=5 only=Rock|Boulder|Barrel
# (an ice shore stone the look left buried under the west shelf, X7 2026-10-17)
clear at -49.1 -3.7 r=1.2 only=IceShore
# (the look's antenna stood on the old peak, 5.4 m over the ground the telescope's terrace left: set down on it, X7 2026-10-17)
clear at -7.56 -14.96 r=1.5 only=TelephoneAntenna
place TP_TelephoneAntenna_NoQuestItem - at -7.56 -14.96 ground sit

# --- The igloo village on the north flats: two Moontown igloos, the store, snow vehicles, the chief's note --------------
place TP_Igloo_Small_1 igloo1 at -9 38 yaw=180
place TP_Igloo_Small_2 igloo2 at 13 38.5 yaw=180
place TP_Moontown_SealedCrate02_Clean noteCrate at 2 34 ground yaw=20
place Note_Paper chiefsnote at 2 34 h=6 sit drop yaw=20
place TP_Moontown_TarpCrate02_Clean - at 4.5 33 ground yaw=-10
place TP_Moontown_Barrel02 - at 0 33.2 ground
place TP_SnowVehicle01 - at 1.5 44 ground yaw=70
place TP_SnowShovel02 - at 5.5 36.2 ground yaw=40 tilt=10
place Loot_Crate cable1 at 4.5 40 ground yaw=30
place Zone_Trigger village at 2 38 h=5.2

# --- Selene's station on its terrace (9 m): the entrance hall, the reactor room, the inner doors, the inner hall --------
push at -20 21 h=9
call selene_cell 0 0 n=TP_Selene_Int_Room_Entrance e=none
call selene_cell 6 0 w=none e=TP_Selene_Int_Room_Entrance
call selene_cell 12 0 w=none e=none
call selene_cell 18 0 w=none
# (the inner doors: both leaves pivot on the doorway's middle, the left one reaching north, the right one south)
place TP_Selene_Int_DoorLargeL innerdoorL at 12 -3 yaw=0 sy=1.051
place TP_Selene_Int_DoorLargeR innerdoorR at 12 -3 yaw=0 sy=1.051
place RT_PowerBox reactor at 9 -5.75 y=1.4 yaw=0
place TP_LaboratoryMachine_Large01 - at 7.6 -4.9 sit
place TP_LaboratoryMachine_Large02 - at 10.9 -4.9 sit
place TP_Selene_ComputerRoom_Server01 - at 0.7 -2 sit yaw=90
place TP_Selene_ComputerRoom_Server02 - at 0.7 -4 sit yaw=90
place TP_FoldingTable_Large - at 16 -5.1 sit
place TP_CabinetCharts01 - at 23.3 -1.5 sit yaw=270
place Loot_ChestLarge chiefsvault at 23 -5 sit yaw=270
place Zone_Atmosphere stationair at 12 -3 y=2
# (Selene's rooms are made to be seen from inside: an outer skin of tower walls, stretched to their height, a roof)
for wx 3 24 3
place RT_Wall1 - at $wx -6.15 sy=1.58
next
for wx 7.5 24 3
place RT_Wall1 - at $wx 0.15 sy=1.58
next
place RT_Wall1 - at -0.15 -6 sy=1.58 yaw=90
place RT_Wall1 - at -0.15 -3 sy=1.58 yaw=90
place RT_Wall1 - at 24.15 -6 sy=1.58 yaw=90
place RT_Wall1 - at 24.15 -3 sy=1.58 yaw=90
for rx 6.04 24.16 6.04
place RT_Floor - at $rx 0.2 y=4.76
next
pop
place Zone_Trigger station at -17 24 h=10.2
place Zone_Trigger inner at -2 18 h=10.2
place Creature_PolarBear bearmother at 0 18 h=9.4
# (SL9: Temperance's puffins on the west ledge by the snowy pines - they fly off when players come near)
place Creature_Puffin puffins at -30 6 ground
place Creature_Puffin - at -32 1 ground

# --- The telescope on its terrace cut into the peak (18 m): the survey team's cable drum beside it ---------------------
place TP_Telescope telescope at -6 -8 ground yaw=200
place Loot_Crate cable2 at -2.5 -5 ground yaw=-20
place TP_Moontown_Barrel02 - at -9 -4 ground

# --- A few snowy pines and drifts (Raft's Temperance is near bare) ---------------------------------------------------
scatter TP_PineTreeSnowy 3 at -34 4 r=8 seed=71
scatter TP_SnowDrift01 4 at 20 10 r=10 seed=72

# --- In the bay north-west of the village: the snowmobile that went through the ice (3 m down), the third drum by it ---
place TP_SnowVehicle02 sunksled at -32 52 ground tilt=10 yaw=40
place Loot_Crate cable3 at -34 50 ground yaw=60

# --- RAFT REMADE 10-26 (1-hour pass): the island grows to Raft's size by land added round it (the ridge, the village,
# the station, the telescope and the bay as they were): Frost Ridge (south) and the weather mast on its top, the ice
# fishing camp (east flats), the whaler run aground under the west crags and the ice cave in them, the supply plane
# (north-east). Land bridges first, from the old shore outwards, then each area.
call rr_land x1=6 z1=-40 x2=8 z2=-50 h=3 r=11
call rr_land x1=40 z1=6 x2=56 z2=6 h=3 r=10
call rr_land x1=-42 z1=-10 x2=-56 z2=-16 h=3 r=10
call rr_land x1=32 z1=30 x2=42 z2=40 h=3 r=9
call rr_land x1=30 z1=-30 x2=40 z2=-40 h=3 r=9
# A Frost Ridge (south): summit 22 m, base r 20, the trail from its north-west foot, the weather mast on top
call hw_mount x=10 z=-64 b=20 h=22
call hw_trail x=10 z=-64 b=20 h=22 a0=330 turn=300 n=26 h0=3
brush flatten at 10 -64 r=7 s=20 frames=400 h=22
call hw_mast x=10 z=-64 h0=22 lv=5 a=weathermast chest=weatherbox top=Placeable_Lantern_Metal
# B The ice fishing camp (east flats): the fisherman's hut, his holes in the ice, his sled
call rr_pad x=66 z=6 h=3 r=14
call rr_ruin x=66 z=10 h=3 yaw=0 w=3 d=2 al=fishhut
place TP_Moontown_Barrel02 - at 60 0 ground sit
place TP_Moontown_Barrel02 - at 61 -1.5 ground sit yaw=40
place Loot_Crate icelocker at 70 12 ground sit yaw=180
# C The west crags, the whaler run aground below them, the ice cave in the crags
call ar_ridge x1=-58 z1=-26 x2=-44 z2=-50 h=4 top=7 r=9
call hw_wreck x=-70 z=-12 h=2 yaw=110 obj=BoatStranded al=whaler crate=whalercrate r=9
# 10-27: mouth turned inland (yaw 0): facing the sea, the mouth showed the hollow inside as a cut face
call ar_cave x=-50 z=-40 h=4 yaw=0 al=icecaverock chest=icecavebox
# 10-27 c: the crag built up over the cave - in a world the cave gets its own rock skin (a smooth dome draped over its
# roof on a 1.25 m grid, sides falling 1.5 m per m out to 16 m past it, walled down to the ground where they stop: on
# the coast that wall stood in the sea as steps). The crag's ground now holds the whole skin under it: a top over the
# roof and the passage's arch, then ledges in rings round it (4 m apart, 6 m down each), out to the shelf under the sea; the way in (north)
# left open between two shoulders
brush flatten at -50 -50 r=11 s=20 frames=500 h=23
brush flatten at -50 -42 r=7 s=20 frames=300 h=23
brush flatten from -59 -40 to -59 -26 r=4 s=20 frames=300 h=22
brush flatten from -43 -40 to -43 -26 r=4 s=20 frames=300 h=22
brush flatten from -51 -40 to -51 -29 r=5 s=20 frames=300 h=21
brush flatten from -69 -24 to -69 -52 r=4 s=20 frames=300 h=17
brush flatten from -69 -52 to -60 -61 r=4 s=20 frames=300 h=17
brush flatten from -60 -61 to -40 -61 r=4 s=20 frames=300 h=17
brush flatten from -40 -61 to -31 -52 r=4 s=20 frames=300 h=17
brush flatten from -31 -52 to -31 -21 r=4 s=20 frames=300 h=17
brush flatten from -73 -25 to -73 -53 r=4 s=20 frames=300 h=11
brush flatten from -73 -53 to -61 -65 r=4 s=20 frames=300 h=11
brush flatten from -61 -65 to -39 -65 r=4 s=20 frames=300 h=11
brush flatten from -39 -65 to -27 -53 r=4 s=20 frames=300 h=11
brush flatten from -27 -53 to -27 -30 r=4 s=20 frames=300 h=11
brush flatten from -77 -24 to -77 -55 r=4 s=20 frames=300 h=5
brush flatten from -77 -55 to -63 -69 r=4 s=20 frames=300 h=5
brush flatten from -63 -69 to -37 -69 r=4 s=20 frames=300 h=5
brush flatten from -37 -69 to -23 -55 r=4 s=20 frames=300 h=5
brush flatten from -23 -55 to -23 -34 r=4 s=20 frames=300 h=5
brush flatten from -81 -22 to -81 -56 r=4 s=20 frames=300 h=-1
brush flatten from -81 -56 to -64 -73 r=4 s=20 frames=300 h=-1
brush flatten from -64 -73 to -36 -73 r=4 s=20 frames=300 h=-1
brush flatten from -36 -73 to -19 -56 r=4 s=20 frames=300 h=-1
brush flatten from -19 -56 to -19 -38 r=4 s=20 frames=300 h=-1
brush flatten from -85 -20 to -85 -57 r=4 s=20 frames=200 h=-5
brush flatten from -85 -57 to -65 -77 r=4 s=20 frames=200 h=-5
brush flatten from -65 -77 to -35 -77 r=4 s=20 frames=200 h=-5
brush flatten from -35 -77 to -15 -57 r=4 s=20 frames=200 h=-5
brush flatten from -15 -57 to -15 -42 r=4 s=20 frames=200 h=-5
brush flatten from -69 -24 to -58 -24 r=4 s=20 frames=200 h=12
brush flatten from -42 -21 to -31 -21 r=4 s=20 frames=200 h=12
brush smooth at -50 -46 r=40 s=5 frames=40
# 10-27 d: solid cap over the whole cave box at 23 (chamfered corners), a ledge band at 20 round it, after the smooth, so no skin shows on top.
brush flatten from -72 -27 to -72 -56 r=3.5 s=20 frames=200 h=20
brush flatten from -72 -56 to -66 -62 r=3.5 s=20 frames=200 h=20
brush flatten from -66 -62 to -36 -62 r=3.5 s=20 frames=200 h=20
brush flatten from -36 -62 to -29 -55 r=3.5 s=20 frames=200 h=20
brush flatten from -29 -55 to -29 -27 r=3.5 s=20 frames=200 h=20
brush flatten from -60 -57 to -40 -57 r=5 s=20 frames=200 h=23
brush flatten from -66 -53 to -35 -53 r=5 s=20 frames=200 h=23
