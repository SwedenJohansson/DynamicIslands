brush flatten from -67 -45 to -34 -45 r=5 s=20 frames=200 h=23
brush flatten from -67 -41 to -34 -41 r=5 s=20 frames=200 h=23
brush flatten from -67 -37 to -34 -37 r=5 s=20 frames=200 h=23
brush flatten from -66 -33 to -35 -33 r=5 s=20 frames=200 h=23
brush flatten from -62 -29 to -39 -29 r=5 s=20 frames=200 h=23
brush flatten at -74 -40 r=4 s=20 frames=150 h=15
brush flatten at -71 -52 r=3.5 s=20 frames=150 h=10
brush flatten at -52 -65 r=4 s=20 frames=150 h=13
brush flatten at -32 -50 r=4 s=20 frames=150 h=16
brush flatten at -30 -38 r=3.5 s=20 frames=150 h=9
brush flatten from -51 -15 to -51 -23.5 r=4.5 s=20 frames=60 h=4.4
brush auto at -50 -46 r=40 s=10 frames=25
brush rock at -50 -43 r=15 s=10 frames=30
place TP_IcePillar02 - at -73 -44 ground sit yaw=30
place TP_IcePillar01 - at -67 -59 ground sit yaw=120
place TP_IcePillar04_Snow - at -48 -69 ground sit yaw=200
place TP_IcePillar04_Snow - at -56 -52 ground sit yaw=40
place TP_IcePillar02 - at -40 -61 ground sit yaw=160
place TP_IcePillar01 - at -69 -32 ground sit yaw=250
# D The supply plane (north-east): down on the flats past the village
call ar_plane x=46 z=44 h=3 yaw=210 al=supplyplane crate=planecrate
call rr_pad x=36 z=-38 h=3 r=10
place TP_Moontown_Barrel02 - at 38 -36 ground sit
# The new land's snowy pines, drifts and stones (Raft's Temperance is near bare: a few)
scatter TP_PineTreeSnowy 6 at 10 -64 r=22 seed=26801
scatter TP_PineTreeSnowy 3 at 66 6 r=14 seed=26802
scatter TP_PineTreeSnowy 3 at -74 -22 r=5 seed=26803
scatter TP_SnowDrift01 6 at 10 -50 r=18 seed=26804
scatter TP_SnowDrift01 4 at 60 10 r=12 seed=26805
scatter TP_SnowDrift01 3 at 44 42 r=10 seed=26806
scatter SmallBoulder4 6 at -52 -34 r=16 seed=26807 free=2
scatter "Pickup_Landmark_Tree_Pine" 3 at 36 -38 r=10 seed=26808 free=4
scatter "Pickup_Landmark_BerryBush" 3 at 10 -50 r=12 seed=26809 free=3

# --- Settings, story items, notes, behaviours, quest ----------------------------------------------------------------
# --- Things to gather, as suits the island (the user, 2026-10-05): pines, flowers, berries ----------
scatter "Pickup_Landmark_Tree_Pine" 6 at 0 0 r=43.4 seed=4524 free=5
scatter "Pickup_Landmark_Flower_White" 4 at 0 0 r=43.4 seed=4534 free=3
scatter "Pickup_Landmark_Flower_Blue" 4 at 0 0 r=43.4 seed=4535 free=3
scatter "Pickup_Landmark_BerryBush" 6 at 0 0 r=43.4 seed=4544 free=3
# --- Raft's finds in the shallows round the island (lib_sea) ----------------------------------------
call shallows r=82 deep=5 n=2

# --- RAFT REMADE 10-26: the new areas' zones and notes, the two more cable drums, the secrets ---------------------------
call hw_zone x=4 z=-48 al=ridgefootz id=ridgefoot r=6 msg="Frost Ridge. A path trodden round the hill to the weather mast on its top."
call hw_zone x=10 z=-64 al=ridgetopz id=frostridge r=7 h=1 msg="The top of Frost Ridge. The weather mast's ladder runs up inside it - a box lashed to its deck."
note weatherbox Weather mast box | The weather team's box on the mast deck: a drum of the reactor's cable, hauled up here before the storm.
loot weatherbox story:cable*1;Rope*2;Bolt*2
prop weatherbox loot.refill=0
call hw_zone x=64 z=4 al=fishz id=fishcamp r=9 h=1 msg="The ice fishing camp. A stone hut, a sled, barrels of salted fish - and the holes in the ice frozen over."
place Note_Paper fisherslog at 65.25 10 h=4.45 drop yaw=20
note fisherslog Fisherman's log | ICE CAMP - FISHERMAN'S LOG\n\nThe chief came out herself for the last drum - she wants it kept away from the station in case the reactor goes. It's in my locker by the hut.\nMikkel went the short way over the bay ice. I told him not to.\nThe whalers' old cave key? Still in their wreck under the west crags, if the sea left it.
note icelocker Ice hut locker | The fisherman's locker: hooks, line, salted fish - and the chief's last drum of cable.
loot icelocker story:cable*1;Rope*2;Scrap*2
prop icelocker loot.refill=0
# The whaler, its crate with the old cave key; the ice cave's chest opens only with it (a secret)
story cavekey|Whalers' cave key|Bolt|An iron key on a strap of seal hide, from the wrecked whaler's crate.
note whalercrate Whaler's crate | The whaler's crate: harpoon heads, blubber hooks - and an iron key on a strap of hide.
loot whalercrate story:cavekey*1;Rope*2;Scrap*2
prop whalercrate loot.refill=0
call hw_zone x=-50 z=-35 al=icecavez id=icecave r=4 msg="A cave in the crags, its mouth half drifted shut - an iron-bound chest inside, locked."
note icecavebox Whalers' chest | The whalers' iron-bound chest, kept in the cave out of the weather: their share of the last good season.
loot icecavebox TitaniumIngot*1;TitaniumOre*2;CopperIngot*2;Leather*2
prop icecavebox loot.refill=0
prop icecavebox if.open=has|story:cavekey|1
prop icecavebox else.open=message||Locked - an iron lock, old as the whalers. The fisherman's log said where their key went.
note planecrate Supply plane's crate | The station's supply plane, down short of the strip: tins, candles, spares.
loot planecrate Bolt*3;Glass*2;Wool*2;Scrap*3
call treasure x=10 z=-64 r=14 n=1 seed=26898 kind=0
prop treasure26898 treasure.loot=CopperIngot*2;TitaniumOre*1;Nail*8

info title=Temperance Remade
info author=Custom Islands
info description=Raft's Temperance made anew, on an island as big as Raft's own: an igloo village on a snowy ridge island, Frost Ridge and its weather mast, an ice fishing camp, a wrecked whaler under the west crags, Selene's station on the terrace above it - its reactor tripped, its inner doors shut - the telescope on the peak and a snowmobile under the ice. Five cable drums, a reactor and a polar bear mother. Raft Remade's seventh island.
island on.arrive=message||Snow, two igloos with their lamps out, a dark station on the terrace above - and the wind off the ice.

story cable|Cable drum|quest:Temperance_ElectricalCable|A drum of the reactor's heavy cable - the reactor needs five.

note chiefsnote Station chief's note | TEMPERANCE STATION - CHIEF'S NOTE\n\nThe storm tripped the reactor and tore out every cable run. Three drums of cable are left on the island: one in the village store, one up at the telescope where the survey team left it, and one went through the ice in the bay with Mikkel's snowmobile.\n\nWithout the reactor the inner doors stay shut - and my vault with them: the smelter plans, the refinery, the anchors.\n\nAnd something has moved into the inner hall. The big she-bear. Do not start the reactor unarmed.
note cable1 Village store crate | The village store's crate: tinned fish, candles - and a drum of the reactor's cable.
loot cable1 story:cable*1;Wool*2
prop cable1 loot.refill=0
note cable2 Survey crate | The survey team's crate by the telescope: star charts, a thermos - and a drum of cable.
loot cable2 story:cable*1;Glass*2
prop cable2 loot.refill=0
note cable3 Sled crate | The crate from Mikkel's sled, under the ice: a drum of cable, his gloves.
loot cable3 story:cable*1;Leather*2
prop cable3 loot.refill=0
note chiefsvault Chief's vault | The station chief's vault: the plans she kept for the day the station would run again - an electric smelter, an advanced refinery, an anchor that holds a raft in any storm.
loot chiefsvault Blueprint_SmelterElectric*1;Blueprint_BiofuelExtractorAdvanced*1;Blueprint_AnchorStationaryAdvanced*1;Battery_Advanced*1
prop chiefsvault loot.refill=0

prop reactor obj.name=reactor
prop reactor beh.use=Connect the cables and start the reactor
prop reactor if.use=take|story:cable|5
prop reactor on.use=message||The cables lock in, the reactor wakes with a deep hum - lights run down the hall and the inner doors slide apart. Something big stirs behind them.\nopen|innerdoor\nsound||event:/raft/door/door_selene_open
prop reactor else.use=message||The reactor is dead. Five cable runs are missing - the chief's note said where the drums are.
prop innerdoorL obj.name=innerdoor
prop innerdoorL beh.move=0,0,2.3
prop innerdoorL beh.moveTime=1.5
prop innerdoorL beh.moveMode=switch
prop innerdoorR obj.name=innerdoor
prop innerdoorR beh.move=0,0,-2.3
prop innerdoorR beh.moveTime=1.5
prop innerdoorR beh.moveMode=switch
prop stationair atmo.light=#b8d4ff
prop stationair atmo.lightAmount=0.35
prop stationair zone.radius=13

prop village zone.id=village
prop village zone.radius=8
prop village zone.message=The igloo village: two Moontown igloos, their lamps out, snow drifted against the doors.
prop station zone.id=station
prop station zone.radius=5
prop station zone.message=Selene's station: dark, cold - the reactor room through the hall, the inner doors shut.
prop inner zone.id=inner
prop inner zone.radius=5
prop inner zone.message=The inner hall - and the she-bear rising from her bed of torn insulation!
prop bearmother creature.count=1
prop bearmother creature.size=1.4
prop bearmother creature.health=6
prop bearmother creature.respawn=0
prop bearmother creature.zone=inner

quest title=The Reactor's Last Breath
quest intro=A snowy island, an igloo village with its lamps out and Selene's station dark on the terrace above. Start at the village.
step reach|village|1|Come to the igloo village
step read|Station chief's note|1|Read the station chief's note
step open|Village store crate|1|Open the village store's crate - the first drum of cable
step open|Sled crate|1|Dive to Mikkel's snowmobile under the ice in the bay and open its crate
step open|Survey crate|1|Climb to the telescope on the peak - the survey team left a drum there
step reach|frostridge|1|Climb Frost Ridge, south of the peak, to the weather mast
step open|Weather mast box|1|Climb the weather mast and open the box on its deck - the fourth drum
step reach|fishcamp|1|Cross to the ice fishing camp on the east flats
step read|Fisherman's log|1|Read the fisherman's log in his hut
step open|Ice hut locker|1|Open the fisherman's locker by the hut - the chief's last drum
step collect|story:cable|5|Carry all five cable drums - one for each torn cable run
step reach|station|1|Go up to Selene's station on the terrace
step reach|inner|1|Connect the cables, start the reactor and go through the inner doors
step kill|Polar bear|1|Face the polar bear mother in the inner hall
step open|Chief's vault|1|Open the station chief's vault
step blueprint|Blueprint_SmelterElectric|1|Take the electric smelter plans from the chief's vault
step blueprint|Blueprint_BiofuelExtractorAdvanced|1|Take the advanced biofuel extractor plans from the chief's vault
step blueprint|Blueprint_AnchorStationaryAdvanced|1|Take the advanced stationary anchor plans from the chief's vault
quest done=The vault opens on the chief's plans: an electric smelter, an advanced refinery, an anchor for any storm. Behind you the reactor hums, and the station's lights burn over the snow again.
quest reward=Wool*4;Plank*8;Glass*2

# Buried treasure (one of the story line's last islands): titanium ore on top of Raft's own treasure loot - the metal detector finds it, the shovel digs it
call treasure x=0 z=0 r=30 n=1 seed=8805
prop treasure8805 treasure.loot=TitaniumOre*3

# --- RAFT REMADE 10-27: groundall - rocks the scatters/randomizer left off a slope or edge (CIGroundIslands): taken away by their
# bounds centre (the report's point; "body", as a rock's pivot can stand a metre or more off it)
clear at -60.92 -36.48 r=0.5 all body only=SmallBoulder4

save Temperance Remade
