# The Heart of Green - the ninth island of the library's plan The Last Green World (SL11, Verdance), finale part 1
# The central tree of Verdance: Raft's giant fir grown half as big again on a green plateau 4 m up, pollen drifting in
# its light. Round its roots the Seedkeepers built their Heart: a lab at the trunk's foot, three balconies (decks on
# posts) linked by ziplines, a crown terrace where two valves wait - BURN and SPREAD - and in the west roots the gate
# down to the Rootcore. Blighted boars root among the trunks. Quest "The Heart" (23 steps, three areas): the Roots (the
# trunk door, the lab notice, three boars, the root store, the generator, organism file 1, the first balcony), the
# Balconies (the second balcony, three spore cartridges, the spore press, organism file 2, the third balcony, the
# purpose, the crown keypad, the crown), the Choice (the two valves, one valve turned, the verdict, the lab, the lab
# safe, the Seedkeeper's last letter, the root gate, its lever - it brings The Rootcore). Buried here: titanium.
#
# Built by the recipe player (CIRecipe heart_of_green) through the editor's own operations. Points (metres over the
# sea): the plateau 4 m round 0 0 (r 42), the tree 0 0, the trunk door -0 -12, the generator 6 -14, the store 16 -8;
# balcony 1 x -16..-11.5, z -8..-3.5; balcony 2 x -14..-9.5, z 12..16.5; balcony 3 x 8..12.5, z 14..18.5; the crown
# terrace x -2..2.5, z 24..28.5 with its valves at -3 21 and 4 21; the lab x 14..18.5, z 2..5; the root gate -24 0.
include lib_sea
include lib_features
include lib_huts
include lib_gravity
include lib_verdance
include lib_ni8
new
gen Trees=0.2 Bushes=0.3 Rocks=0.15 Harvest=0.3 BeachThings=0.25
gen Seed=11101 Radius=90 Height=10 Roughness=0.25 Peaks=1 Shape=0 Style=0 PeakShape=0.3 Cliffs=0.2 BeachWidth=0.6
gen Water=0.5 SeaRocks=0.3 SeaFinds=0.4 Sunken=0.2 Hostiles=0 Friendly=0.2 SeaLife=0.3
generate

# --- Terrain: the plateau round the tree, the landing beach ----------------------------------------------------------
brush flatten at 0 0 r=42 s=20 frames=400 h=4
brush grass at 0 0 r=40 s=6 frames=30
brush flatten at 0 -70 r=8 s=20 frames=200 h=1.2
brush sand at 0 -70 r=10 s=10 frames=30
origin
clear at 0 0 r=32
clear at 0 -70 r=7

# --- The tree and its pollen ---------------------------------------------------------------------------------------
place FirTree_Big1_LodGroup hearttree at 0 0 ground yaw=40 scale=1.5
call pollen x=0 z=0 r=40 al=heartair

# --- Area A, the Roots: the trunk door, the lab notice, the root store, the generator, organism file 1, the boars ----
place Zone_Trigger trunkdoor at 0 -12 ground
place Note_Sign labnotice at 3 -13 ground sit yaw=180
place Loot_Chest rootstore at -6 -13 ground sit yaw=180
place "VG_DecorationPrefabBase_EmergencyGenerator Variant" generator at 6 -15 ground sit yaw=180
push at 8.5 -12 h=4
place "Box Small" - at 0 0 y=0 sit
place Note_Paper organism1 at 0 0 y=1.6 drop yaw=20
pop
place Creature_Boar blightboars at -12 -24 ground
prop blightboars creature.count=3
prop blightboars creature.respawn=0
store heartshop at 16 -8 ground

# --- Area B, the Balconies: three decks on posts, ziplines between them; the spore cartridges, the spore press ------
push at -16 -8 h=4
call stilt_hut y=2.6
pop
place Zone_Trigger balcony1 at -13.75 -10 ground
# (zip deck behind balcony 1: the zipline's own floor piece on it)
push at -14.5 -1.5 h=4
call zipdeck y=2.6
pop
place ZiplinePath_Landmark zip12 at -8.03 -1.72 h=8.07
zipto zip12 -16 10
push at -14 12 h=4
call stilt_hut y=2.6
place "Box Small" - at 3.6 3.6 y=2.7 sit
# (REACH 10-28: from y=3.4 it started inside the box (its top 0.9 m over y=2.7) and fell through to the floor under it)
place Note_Paper organism2 at 3.6 3.6 y=4.0 drop yaw=10
pop
place Zone_Trigger balcony2 at -11.75 10 ground
place "Box Small" spore1 at -20 16 ground sit yaw=20
place "Box Small" spore2 at -18 20 ground sit yaw=80
place "Box Small" spore3 at -8 20 ground sit yaw=150
call crank x=-5 z=12 yaw=90 alias=sporepress
# (zip deck beside balcony 2)
push at -8.5 13 h=4
call zipdeck y=2.6
pop
place ZiplinePath_Landmark zip23 at -2.03 12.78 h=8.07
zipto zip23 8 12
push at 8 14 h=4
call stilt_hut y=2.6
place Note_Sign purpose at 2.25 3.9 y=2.7 sit
pop
place Zone_Trigger balcony3 at 10.25 12 ground
place RT_Pillar - at 15 20 ground sy=0.4
place RT_PowerBox crownpad at 15 20 ground y=1.25 yaw=180

# --- Area C, the Choice: the crown terrace, the two valves, the two verdicts, the burn and spread signs ------------
push at -2 24 h=4
call stilt_hut y=2.6
pop
place Zone_Trigger crownzone at 0.25 22 ground
place Note_Sign twovalves at 1 19.5 ground sit yaw=180
call crank x=-3 z=21 yaw=180 alias=burnvalve
call crank x=4 z=21 yaw=180 alias=spreadvalve
place Note_Sign verdictburn at -6 19 ground sit yaw=200
place Note_Sign verdictspread at 7 19 ground sit yaw=160
place campfire_1 burnfires at -10 -2 ground sit
place campfire_1 burnfires at 10 -3 ground sit
place campfire_1 burnfires at -2 9 ground sit
call blight x=-11 z=3 al=sporebloom
call blight x=9 z=8 al=sporebloom

# --- The lab at the trunk's foot (the safe, the last letter); the root gate and its lever ------------------------------
push at 14 2 h=4
call hut w=3 d=2 y=0.1
place Loot_ChestLarge labsafe at 3.6 2.3 y=0.1 sit yaw=180
place "Box Small" - at 0.8 2.3 y=0.1 sit
place Note_Paper lastletter at 0.8 2.3 y=1.7 drop yaw=10
pop
place Zone_Trigger labzone at 14.75 0 ground
place Zone_Trigger rootgate at -24 0 ground
place RT_Pillar - at -24 3 ground sy=0.4
place TP_LaserControlPanel_lever gatelever at -24 3 ground y=1.25 scale=3 yaw=90

# --- Flowers, mango, titanium buried by the lab; the shallows ----------------------------------------------------
scatter Pickup_Landmark_Flower_Yellow 8 at 0 0 r=38 seed=11102 free=2
scatter Pickup_Landmark_Tree_Mango 3 at -30 -30 r=10 seed=11103 free=3
scatter "Pickup_Landmark_Tree_Palm 1" 2 at 20 -60 r=10 seed=11104 free=3
call treasure x=18 z=10 r=14 n=1 seed=11053
prop treasure11053 treasure.loot=TitaniumOre*3
# REDO 10-24 TREASURE2: a second buried treasure on the far side for the detector + shovel
call treasure x=-14.4 z=-8.0 r=12 n=1 seed=11103
prop treasure11103 treasure.loot=TitaniumOre*1;MetalOre*2;TradeToken*2
call shallows x=0 z=0 r=102 deep=5 n=2 seed=11105

# --- REDO 10-24 (optional): the dark root store under a hatch (headlight), a vine-hidden cache (machete), the river
#     people's beach camp with a wrecked canoe-raft
clear at -30 -22 r=2.5
place TangaroaHatchRoom_Hatch rsthatch at -30 -22 ground
beside Loot_ChestSmall rstchest rsthatch d=0.01
call vinecache x=34 z=-30 r=10 seed=11211 chest=dvinechest vines=dvines items=Rope*3;TitaniumOre*1;Leather*2
place Balboa_DecorationPrefabBase_SimpleTent - at -12 -58 ground sit yaw=10
place campfire_1 - at -9 -56 ground sit
place RT_PlasticBoat - at 8 -64 ground sit yaw=300

# --- FILL 10-24 (RESIZE rework): the bigger island's whole area at Raft-like density - trees, bushes, rocks; free= keeps them
#     off the quest's objects and paths
scatter "Pickup_Landmark_Tree_Palm 1" 10 at 0 0 r=80 seed=11212 free=5
scatter "Pickup_Landmark_Tree_Palm 2" 10 at 0 0 r=80 seed=11213 free=5
scatter "Pickup_Landmark_Tree_Palm 4" 6 at 0 0 r=80 seed=11214 free=5
scatter "Pickup_Landmark_Tree_Mango" 6 at 0 0 r=80 seed=11215 free=5
scatter "Balboa_Bush_01 Variant" 30 at 0 0 r=80 seed=11216 free=2.5
scatter "Balboa_Bush_03 Variant" 30 at 0 0 r=80 seed=11217 free=2.5
scatter CaravanIsland_SmallRock_1 14 at 0 0 r=80 seed=11218 free=3 ground y=-0.6
scatter "Pickup_Landmark_PineappleLandmark" 6 at 0 0 r=80 seed=11219 free=3
scatter "Pickup_Landmark_Flower_Red" 8 at 0 0 r=80 seed=11220 free=2

# --- DEEP 10-24 (one-hour pass: a climb, a dive, more to find; RAFT_ISLAND_DESIGN 0b): the pollen watch on the north-west hill (climb, zipline to the root gate), the Seedkeepers' lab van off the east shore (dive), the seed vault on the north-east slope, the east cave
# the north-west hill (STORY 10-24: no tower or zipline - an optional walk up to the pollen watch post, its box;
# no quest step)
call vd_mount x=-55 z=45 top=22 r=20 a0=300 turns=1.25 hb=3
place RT_Pillar - at -55 45 h=22 sy=0.5
place Loot_ChestSmall hhbox at -53.6 46 h=22 sit yaw=200
place Placeable_Flag_05 - at -56.4 43.8 h=22 sit
call vd_spot x=-55 z=45 al=hhtopz id=hh_top r=4 msg="The pollen watch post. From here the Heart's crown is level with your eyes, and its pollen drifts past like snow."
note hhbox Pollen watch box | SEEDKEEPERS - POLLEN WATCH. Count the drift each dawn. If the drift turns gold, the growth is spreading: take the sample to the vault, and seal it.
loot hhbox Rope*3;Bolt*2;Battery*1
prop hhbox loot.refill=0
# the dive: Van_1 on the sea floor 10 m down, its crate, an air pocket
call vd_dive x=70 z=-68 h=-10 yaw=250 obj="Van_1" al=hhwreck crate=hhcrate zal=hhwz zid=hh_wreck msg="The Seedkeepers' lab van, off the end of the old shore road. Its sample fridge is still sealed." air=hhair bub=hhbub
note hhcrate Lab van's sample fridge | One sealed sample tube, gold dust inside, labelled HEART - FIRST BLOOM.
loot hhcrate story:sample*1;Scrap*3;Battery*1
# the seed vault on the north-east slope: a sealed vault box on a stone pad; the van's sample opens it and its ledger
# shows what the Seedkeepers kept back
clear at 55 45 r=5
brush flatten at 55 45 r=4 s=20 frames=150
place ReefHuts_Pillar3 - at 53 43 ground sit sy=0.5
place ReefHuts_Pillar3 - at 57 43 ground sit sy=0.5
place "Box Big" seedvault at 55 46 ground sit yaw=200
place Loot_ChestSmall vaultchest at 55 43.6 ground sit yaw=200
call ni8cave x=70 z=0 h=3.8 yaw=180 al=hhcavecave
place Loot_ChestSmall hhcavecavebox at 72.5 -5 h=4.25 sit yaw=200
place Placeable_Lantern_Metal - at 67.4 -4 h=4.25 sit
note hhcavecavebox East cave chest | A dry cave on the shore: the river people's spare paddles and a jar of seeds.
loot hhcavecavebox Rope*2;Plank*3;Seed_Flower_Yellow*1
prop hhcavecavebox loot.refill=0
# the north knoll (secret): a low hill with a lookout box
call vd_mount x=0 z=68 top=14 r=12 a0=180 turns=1 n=30 hb=3
place Loot_ChestSmall hhknoll at 0 68 h=14 sit yaw=180
note hhknoll North knoll box | A ranger's box. Scratched in the lid: THE HEART WAS SMALL ONCE. I SAW IT.
loot hhknoll Rope*2;Leather*2;Coconut*2
prop hhknoll loot.refill=0
call vd_spot x=0 z=69.5 al=hhknollz id=hh_knoll r=3 msg="From the knoll the Heart fills half the sky."
place Creature_Chicken hhhens at -40 -20 ground
prop hhhens creature.count=3

# --- STORY 10-24: zipline and crown signs (the mechanics, off the notes), Jonas's kitchen note in the lab
place Note_Sign zipsign1 at -12.4 -4.4 ground sit yaw=0
note zipsign1 Zipline sign | BALCONY 1 - ZIPLINE TO BALCONY 2.\nHook on at the deck behind the hut.
place Note_Sign zipsign2 at -9.2 15.8 ground sit yaw=90
note zipsign2 Zipline sign | BALCONY 2 - ZIPLINE TO BALCONY 3.\nThen the crown keypad by the pillar.
place Note_Sign crownsign at 13.6 18.4 ground sit yaw=180
note crownsign Crown keypad sign | CROWN DOOR\n\nFour digits: the day the sea reached the lab, day first, then month.\nAsk Teodor. Do not ask Teodor before coffee.
place Note_Paper jonaskitchen at 15.6 -0.6 ground y=0.3 drop
note jonaskitchen Kitchen note | JONAS - HEART LAB KITCHEN\n\nDay 1 up here: made toast. Everybody ate it. Success.\nDay 2: made toast. Marit ate it on the balconies, counting them out loud, one two three, like she always does. Teodor did not eat it.\nDay 3: Teodor said, "Jonas, you are the kindest man I know, so I will tell you first." Then he told me. All of it. The river, the marsh, the river people singing in the roots.\n\nI did not make toast on day 4.\n\nToday he went down to the oldest root with his tape recorder. I am taking him soup. You cannot leave a man alone with the worst thing he ever did and no soup. That is not a rule anywhere, but it should be.

# --- Settings, story items, notes, behaviours, quest ----------------------------------------------------------------
info title=The Heart of Green
info author=Custom Islands
info description=The central tree of Verdance: a lab at its foot, three balconies, a crown terrace with two valves - BURN and SPREAD - and a gate in the roots. The finale of The Last Green World, part 1.
island on.arrive=message||The biggest tree in the world. Pollen falls off it like snow. At its foot, a door - and the smell of the marsh, faint, from the roots.

story power|Heart powered|Note_Paper|The Heart's generator, running.
story spore|Spore cartridge|Placeable_Lantern_Metal|A glass cartridge of green spores, labelled HEART - BATCH 7.
story pressed|Spores pressed|Note_Paper|The spore press, loaded and wound.
story crown|Crown unlocked|Note_Paper|The crown terrace's keypad, unlocked.
story choice|The choice|Note_Paper|One valve turned. The Heart will BURN or SPREAD.
story burnway|The Heart set to BURN|Note_Paper|The BURN valve turned on the crown terrace. The core must burn too.
story spreadway|The Heart set to SPREAD|Note_Paper|The SPREAD valve turned on the crown terrace. The core must open too.
story gate|Root gate open|Note_Paper|The root gate, open. The way down to the Rootcore.

prop blightboars tint.color=#8a3ac0
prop blightboars tint.amount=0.45
prop sporebloom tint.color=#60d060
prop sporebloom tint.amount=0.7
prop sporebloom beh.hidden=1
prop burnfires beh.hidden=1
prop verdictburn beh.hidden=1
prop verdictspread beh.hidden=1

prop generator obj.name=generator
prop generator beh.use=Start the generator
prop generator if.use=!signal|power
prop generator on.use=signal||power\ngive||story:power*1\nmessage||The generator coughs, catches and roars. Lights come on all round the tree.
prop generator else.use=message||The generator is running.
prop spore1 obj.name=spore1
prop spore1 beh.use=Take the spore cartridge
prop spore1 on.use=give||story:spore*1\nhide|\nmessage||A glass cartridge, green dust inside. It is warm.
prop spore2 obj.name=spore2
prop spore2 beh.use=Take the spore cartridge
prop spore2 on.use=give||story:spore*1\nhide|\nmessage||A glass cartridge, green dust inside. It is warm.
prop spore3 obj.name=spore3
prop spore3 beh.use=Take the spore cartridge
prop spore3 on.use=give||story:spore*1\nhide|\nmessage||A glass cartridge, green dust inside. It is warm.
prop sporepress beh.use=Load the cartridges and wind the press
prop sporepress if.use=has|story:spore|3\n!signal|pressed
prop sporepress on.use=signal||pressed\ngive||story:pressed*1\nmessage||The press takes the three cartridges and grinds them. A green puff goes up the trunk, toward the crown.
prop sporepress else.use=message||The press wants three spore cartridges - or it has already run.
prop crownpad obj.name=crownpad
prop crownpad beh.use=Type the crown code
prop crownpad lock.code=2611
prop crownpad on.use=give||story:crown*1\nsignal||crown\nmessage||The keypad chirps. Up on the crown terrace a bolt slides back.\nsound||event:/exploring/obstacles/keypad/keypad_correct
prop burnvalve beh.use=Turn the BURN valve
prop burnvalve if.use=signal|crown\n!signal|chosen
prop burnvalve on.use=signal||burn\nsignal||chosen\ngive||story:choice*1\ngive||story:burnway*1\nshow|burnfires\nshow|verdictburn\nmessage||BURN. Fire pots flare at every root. The tree shudders - and the purple at its roots begins to blacken.
prop burnvalve else.use=message||The valves are locked - or the choice is made.
prop spreadvalve beh.use=Turn the SPREAD valve
prop spreadvalve if.use=signal|crown\n!signal|chosen
prop spreadvalve on.use=signal||spread\nsignal||chosen\ngive||story:choice*1\ngive||story:spreadway*1\nshow|sporebloom\nshow|verdictspread\nmessage||SPREAD. The vents open and green spore clouds roll down the trunk. Everywhere the roots touch, something begins to grow.
prop spreadvalve else.use=message||The valves are locked - or the choice is made.
prop gatelever obj.name=gatelever
prop gatelever beh.use=Pull the root gate lever
prop gatelever if.use=signal|chosen\n!signal|below
prop gatelever on.use=signal||below\ngive||story:gate*1\nmessage||Deep in the roots a gate grinds open. Warm air rushes up. Below the Heart is the Rootcore.
prop gatelever else.use=message||The gate stays shut until a valve is turned - or it is already open.

note labnotice Heart lab notice | HEART LAB - SEEDKEEPERS ONLY\n\nGenerator by the door. Power first.\nThe roots below are CLOSED.\n\n(Under it, in chalk, in Jonas's capitals: KITCHEN IS ALSO CLOSED. I MEAN IT THIS TIME. WELL, SOUP AT SIX.)
note organism1 Organism file 1 | ORGANISM FILE 1 - T. LIND\n\nV-1 seeded into the oldest root, day 1. I only meant it to clean the water. The river was dying; the sea had already taken everything else.\n\nIt cleaned the water. Then it went into the root network and fed every tree it touched. Growth +40% in a month. The whole land greening. Marit cried when she saw the balconies flower. So did I.\n\nIt does not stop at the shore. That is the part I did not write in the report for a long time. If it reaches the sea, it will green every rock and raft out there - or eat them. I can model it either way. The model does not help.\n\nI cannot be the one to decide. I made it. I love it. I am the worst person to ask.
note organism2 Organism file 2 | ORGANISM FILE 2 - T. LIND\n\nIt feeds on the roots now, not the other way. The marsh is lost. The grove next. I have stopped pretending to the others that this is a good sign.\n\nCrown valves fitted: BURN and SPREAD. One turn each, and then the root gate opens.\n\nI need someone from outside: someone who has not loved Verdance for years like Oda, or helped me build it like Marit. Oda would burn it before breakfast. Marit would hide it in a jar. Neither of them would be choosing; they would be grieving.\n\nI have set the crown door to the day the sea reached the lab. 26 November. Marit says it is morbid. Marit counted the balconies out loud as she climbed them, every time, like a little girl. One. Two. Three.
note purpose The purpose | THE PURPOSE - a board the Seedkeepers kept by the crown\n\nIt was meant to clean the water. Then to feed the network. Then to green the world.\n\nThe flood took everything. Verdance was going to give it back - every coast, every rock, green again.\n\nIt still could. If it does not eat everything first.\n\n(Someone has written under it, very small: OR WE COULD JUST GROW TOMATOES. - J.)
note twovalves Two valves | TWO VALVES\n\nBURN: fire down every root. The growth dies. So does Verdance's network - the grove, the canopy, the Heart.\nSPREAD: the vents open. It goes out on the wind, to every coast. It may green the world. It may eat it.\n\nOne turn. Then the gate opens.
note verdictburn The verdict | THE VERDICT - BURN\n\nThe fires run down the roots. Verdance will be a smaller green, and a safe one.\nThe core below must be burnt too.
note verdictspread The verdict | THE VERDICT - SPREAD\n\nThe spores are on the wind. What they make of the world is not ours to say any more.\nThe core below must be opened too.
note labsafe Lab safe | The lab safe: the Seedkeepers' seed bank, and Marit's last letter beside it.
note lastletter Seedkeeper's last letter | Marit's last letter -\n\nWe could not choose. You have. Thank you, and I am sorry it was you; Teodor never asked if you wanted it.\n\nWhatever you turned, the core under the tree must follow, or it will grow back from the oldest root. The gate is down among the roots.\n\nTeodor has gone below to the oldest root. He said he wanted to be there when it ends, either way. Jonas went after him with soup. I am staying up here, on the top balcony, with the lamp on, because Oda will come, and someone should be here when she does.\n\nThe Ringwave is cut on that root. We did not cut it. It was there before us.
note rootstore Root store | The root store's chest: lamp oil, rope and a coil of wire.
loot rootstore Rope*3;CopperIngot*2;Battery*1
prop rsthatch obj.name=rsthatch
prop rsthatch on.use=hide|\nshow|rstchest\nmessage||The hatch opens on the old root store. Pitch black - a lamp would help.
note rstchest Dark root store | The Seedkeepers' first root store, sealed when the blight came: seeds and a titanium bar.
loot rstchest TitaniumIngot*1;Seed_Flower_Blue*2;Seed_Watermelon*2;Bolt*3
prop rstchest loot.refill=0
prop rstchest obj.name=rstchest
prop rstchest beh.hidden=1
prop rstchest if.open=wears|HeadLight*
prop rstchest else.open=message||Pitch black down there. You can hear seeds rattle in jars, but you can't see a thing - wear a headlight.
prop rootstore loot.refill=0
loot labsafe Seed_Mango*2;Seed_Pineapple*2;Seed_Watermelon*2;TitaniumOre*1
prop labsafe loot.refill=0

prop trunkdoor zone.id=trunk_door
prop trunkdoor zone.radius=4
prop trunkdoor zone.message=The trunk door. A lab notice, a generator, and the marsh smell from the roots.
prop balcony1 zone.id=balcony_1
prop balcony1 zone.radius=3
prop balcony1 zone.message=Balcony 1. A zipline runs on to balcony 2.
prop balcony2 zone.id=balcony_2
prop balcony2 zone.radius=3
prop balcony2 zone.message=Balcony 2. Spore cartridges dropped round the press.
prop balcony3 zone.id=balcony_3
prop balcony3 zone.radius=3
prop balcony3 zone.message=Balcony 3. A keypad on a post for the crown.
prop crownzone zone.id=crown
prop crownzone zone.radius=3
prop crownzone zone.message=The crown terrace. Two valves: BURN and SPREAD.
prop labzone zone.id=lab
prop labzone zone.radius=3
prop labzone zone.message=The Heart lab.
