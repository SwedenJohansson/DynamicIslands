# The Sunken Archive - an island of the library's plan Raft 2: The Drowned Frontier (station Four of the Frontier Corps)
# Five palm islets on a shallow coral bank, and in a basin in the middle the Corps' archive, two of its three floors under
# the sea: the reading room on top with its jetty and the index desk, the flooded stacks below (broken windows to swim in
# by, air under the reading room's floor and a pocket of it in the deepest room), the rare book vault and its keeper.
# Quest "Card Catalogue" (21 steps): the reading room, the archivist's letter, the shelf's and the floor's card boxes in
# the flooded stacks, the deepest room's air pocket, the vault, the angler there, the deep card box, the three cards, the
# index desk and the vault opened (the engine controls', the metal detector's, the firework's and the zipline's
# blueprints).
# RAFT2 10-26 (1-hour pass): new islets on the coral bank - Reading Hill (north) with a reading mast, Binding Cave (south-east), the bindery ruin (east) where Ines Varga waits (a lamp puzzle), a book plane down on the south-west islet, a jump course (north-east), five bookplates (a set), a buried cache
#
# Built by the recipe player (CIRecipe sunken_archive) through the editor's own operations.
include lib_sea
include lib_rt
include lib_highwater
include lib_areas
include lib_features
include lib_raft2
new
# (nature: Like Raft - Raft's islands as the generator's Like Raft has them, CIGenLikeRaft)
gen Trees=0.28 Bushes=0.28 Rocks=0.43 Harvest=0.24 BeachThings=0.3
gen Seed=8104 Radius=70 Height=6 Roughness=0.3 Shape=2 Style=0
gen Water=0.5 SeaRocks=0.5 SeaFinds=0.5 Sunken=0.4 Hostiles=0 Friendly=0.2 SeaLife=0.3
generate

# --- Terrain: the basin in the bank where the archive stands (5.7 m down) -------------------------------------------
brush flatten at -7 -8 r=12 s=20 frames=80 h=-5.7
origin
# --- RAFT2 10-26 terrain: the land grows (banks first), then the pads of the new areas -------------------------------
# new islets on the bank: north (Reading Hill), east, south-east (to the cave), south-west, north-east
brush flatten from 43 -30 to 56 -52 r=10 s=20 frames=500 h=3
brush flatten from -43 -30 to -56 -50 r=10 s=20 frames=500 h=3
brush flatten from 54 0 to 70 12 r=12 s=20 frames=500 h=3
brush auto at 60 6 r=18 s=10 frames=25
brush auto at 50 -42 r=14 s=10 frames=25
brush auto at -50 -40 r=14 s=10 frames=25
# the pads: the cave (Binding Cave), the ruined house, the plane
call r2_pad x=56 z=-62 r=14 h=3
brush flatten from 56 -54 to 56 -38 r=6 s=20 frames=300 h=3
call r2_pad x=68 z=10 r=11 h=3
call r2_pad x=-60 z=-54 r=11 h=3
# Reading Hill: summit 16 m, base r 18, the trail from the foot toward the house
call hw_mount x=-6 z=66 b=18 h=16
call hw_trail x=-6 z=66 b=18 h=16 a0=-137.94 turn=300 n=34 h0=3
clear at -7 -8 r=14

# --- The archive: three of the radio tower's rooms stacked, turned to face north; the flooded stacks below (broken
# windows), the reading room on top, a roof ----------------------------------------------------------------------------
push at -8 -12 h=-5.6 yaw=180
call rt_storey f1=RT_WallWindowBroken f2=RT_WallWindowBroken l2=RT_WallWindowBroken r2=RT_WallWindowBroken b1=RT_WallWindowBroken
place "VP_DecorationPrefabBase_Bookshelf Filled 1" - at -0.7 -1.5 sit yaw=-90
place "VP_DecorationPrefabBase_Bookshelf Filled 2" - at -0.4 1.5 sit yaw=-90
place VG_Safe rarebookvault at -5.3 3.6 sit yaw=90
place "Box Small" cardbox3 at -3 3.6 sit yaw=10
place Zone_Trigger vault at -3 0 y=1.5
place Zone_Trigger deepair at -1.5 -2.5 y=1.6
place Creature_AnglerFish keeper at -3 1 y=1.5
push at 0 0 y=3.05
call rt_storey f1=RT_WallWindowBroken r2=RT_WallWindowBroken l2=RT_WallWindowBroken b2=RT_WallWindowBroken
place "VP_DecorationPrefabBase_Bookshelf Filled 3" - at -5.6 -1.5 sit yaw=90
place "VP_DecorationPrefabBase_Bookshelf Filled 1" - at -5.3 1.5 sit yaw=90
place "Box Small" cardbox1 at -1 3.6 sit yaw=-15
place "Box Small" cardbox2 at -4.6 -3.6 sit yaw=30
push at 0 0 y=3.05
call rt_storey f2=RT_WallDoor1 f1=RT_WallWindow1 l2=RT_WallWindow1 r2=RT_WallWindow1 b1=RT_WallWindow2 b2=RT_WallWindow2
place RT_Floor - at 0 4.5 y=3.05
place "Table Office" indexdesk at -3 2.6 sit yaw=180
place RT_RadarScreen indexterminal at -3 2.35 y=1.08 sit yaw=180 scale=0.5
place "Chair Office" - at -3 1.6 sit yaw=10
place Table_Common_01 - at -4.6 -2 sit yaw=90
place Note_Book archivistsletter at -4.6 -2 y=1.6 sit drop yaw=20
place "VP_DecorationPrefabBase_Bookshelf Filled 2" - at -5.3 2.5 sit yaw=90
place Zone_Trigger readingroom at -3 0 y=1.5
pop
pop
pop

# --- The jetty at the reading room's door (0.55 m), a ladder down to the water, the archivist's boat ------------------
place RT_Floor jetty at -3 1.5 h=0.55
place LandmarkLadder_6m jettyladder at -6 1.62 h=-5.75 yaw=180
place RT_PlasticBoat archivistsboat at 1.5 -2 h=-0.3 yaw=10

# --- Friendly animals (placed: the generator's Friendly and SeaLife are whole numbers - the 0.2 and 0.3 above gave none;
# the user, 2026-10-03: "add some friendly animals to some of the islands"): turtles on the coral bank, dolphins outside it -
place Creature_Turtle turtles at 30 2 h=-1.3
prop turtles creature.count=2
place Creature_Dolphin dolphins at 0 90 h=-3
prop dolphins creature.count=2

# --- RAFT2 10-26 (the user: one hour per island - hills, a cave, a house, a wreck, secrets): new islets on the coral bank - Reading Hill (north) with a reading mast, Binding Cave (south-east), the bindery ruin (east) where Ines Varga waits (a lamp puzzle), a book plane down on the south-west islet, a jump course (north-east), five bookplates (a set), a buried cache ------
call hw_zone x=-18.73 z=51.89 al=sa_trailz id=sa_trail r=5 msg="The trail up Reading Hill starts here - round and up."
call hw_zone x=-6 z=66 al=sa_summitz id=sa_summit r=8 h=1 msg="The top of Reading Hill. The whole island below you."
call hw_mast x=-9 z=68 h0=16 lv=5 a=sa_mast chest=sa_topchest top=Placeable_Flag_01
place Creature_Goat sa_goats at -14.73 54.89 ground
prop sa_goats creature.count=2
call ar_cave x=56 z=-62 h=3 yaw=0 al=sa_caverock chest=sa_cavechest
call hw_zone x=55 z=-53 al=sa_cavez id=sa_cave r=4 h=1 msg="Binding Cave. It smells of glue and old paper."
call ar_ruin x=68 z=10 h=3 yaw=0 w=3 d=2 al=sa_ruin
call r2_islander x=67 z=5.5 yaw=200 al=sa_isl nm="Ines Varga" pose=stand
prop sa_isl talk.text=Quietly, please. This is still a library.\n---\nI bound the books for the Corps' archive before the sea came up the stairs. I moved what I could to the islets.\n---\nThe binders kept their best work in Binding Cave, in the rocks by the water. And climb Reading Hill - the readers flew a flag from its mast when a book came back.\n---\nAnd my lamps - four round the house. Each one you turn wakes its neighbour too. Light all four and look behind the back wall.
call r2_lamp x=61 z=9 al=sa_lamp1 nm="Reading lamp 1" grp="Reading lamps" on=0
call r2_lamp x=67 z=16 al=sa_lamp2 nm="Reading lamp 2" grp="Reading lamps" on=0
call r2_lamp x=74 z=9 al=sa_lamp3 nm="Reading lamp 3" grp="Reading lamps" on=1
call r2_lamp x=67 z=2 al=sa_lamp4 nm="Reading lamp 4" grp="Reading lamps" on=1
prop sa_lamp1 on.use=light|Reading lamp 2|toggle
prop sa_lamp2 on.use=light|Reading lamp 3|toggle
prop sa_lamp3 on.use=light|Reading lamp 4|toggle
prop sa_lamp4 on.use=light|Reading lamp 1|toggle
prop sa_lamp1 on.alllit=show|sa_lampchest\nmessage||All four lamps burn. Behind the back wall a stone has been lifted.
call r2_hidden x=69 z=14.6 al=sa_lampchest
place Creature_Chicken sa_hens at 76 16 ground
prop sa_hens creature.count=3
call ar_plane x=-60 z=-54 h=3 yaw=40 al=sa_plane crate=sa_planecrate
place Note_Paper sa_pilot at -61.78 -49.9 ground y=0.1 drop yaw=70
call hw_zone x=-60 z=-54 al=sa_planez id=sa_plane r=6 h=1 msg="A small plane on the islet, crates of books in its hold."
# JUMP sa pad=3 at=52 52
push at 52 52
clear at 0 0 r=17 all
brush flatten at 0 0 r=14 s=20 frames=300 h=3
brush smooth at 0 0 r=18 s=4 frames=40
brush flatten at 0 0 r=12 s=20 frames=300 h=3
brush auto at 0 0 r=18 s=10 frames=25
clear at 0 0 r=18
place Block_Foundation_Tier3 jpsa at 4.24 4.24 h=3.6
place Block_Foundation_Tier3 jpsa at 5.77 1.65 h=4.35
place Block_Foundation_Tier3 jpsa at 5.85 -1.35 h=5.1
place Block_Foundation_Tier3 jpsa at 4.46 -4.01 h=5.85
place Block_Foundation_Tier3 jpsa at 1.95 -5.67 h=6.6
place Block_Foundation_Tier3 jpsa at -1.04 -5.91 h=7.35
place Block_Foundation_Tier3 jpsa at -3.78 -4.66 h=8.1
place Block_Foundation_Tier3 jpsa at -5.56 -2.25 h=8.85
place Block_Foundation_Tier3 jpsa at -5.96 0.73 h=9.6
place Block_Foundation_Tier3 jpsa at -4.85 3.53 h=10.35
place Block_Foundation_Tier3 jpsa at -2.54 5.44 h=11.1 sx=2 sz=2
# JUMP end
place Block_Foundation_Tier3 jppsa at 5.77 1.65 h=3.668 sy=1.861
place Block_Foundation_Tier3 jppsa at 5.85 -1.35 h=4.418 sy=2.959
place Block_Foundation_Tier3 jppsa at 4.46 -4.01 h=5.168 sy=4.058
place Block_Foundation_Tier3 jppsa at 1.95 -5.67 h=5.918 sy=5.157
place Block_Foundation_Tier3 jppsa at -1.04 -5.91 h=6.668 sy=6.255
place Block_Foundation_Tier3 jppsa at -3.78 -4.66 h=7.418 sy=7.354
place Block_Foundation_Tier3 jppsa at -5.56 -2.25 h=8.168 sy=8.453
place Block_Foundation_Tier3 jppsa at -5.96 0.73 h=8.918 sy=9.552
place Block_Foundation_Tier3 jppsa at -4.85 3.53 h=9.668 sy=10.650
place Block_Foundation_Tier3 jppsa at -2.54 5.44 h=10.418 sy=11.749 sx=2 sz=2
prop jpsa tint.color=#8a7f70
prop jpsa tint.amount=0.35
prop jppsa tint.color=#8a7f70
prop jppsa tint.amount=0.35
place Loot_Chest jcsa at -1.04 -5.91 h=7.35 sit yaw=0
prop jcsa loot.refill=0
place Loot_ChestSmall jbsa at -2.54 5.44 h=11.1 sit yaw=0
prop jbsa loot.refill=0
pop
call hw_zone x=52 z=44 al=sa_jumpz id=sa_jumps r=6 h=1 msg="Stone stacks, one higher than the next. Something at the top."
call r2_piece x=-43 z=28 al=sa_piece1 set="Bookplates"
call r2_piece x=40 z=-26 al=sa_piece2 set="Bookplates"
call r2_piece x=8 z=58 al=sa_piece3 set="Bookplates"
call r2_piece x=62 z=-2 al=sa_piece4 set="Bookplates"
call r2_piece x=-56 z=-46 al=sa_piece5 set="Bookplates"
prop sa_piece1 on.set=show|sa_setchest\nmessage||All five bookplates found.
call r2_hidden x=73 z=17 al=sa_setchest kind=Loot_Chest
call treasure x=-42 z=-22 r=5 n=1 seed=26878 kind=0
prop treasure26878 treasure.loot=CopperOre*2;MetalOre*2;TradeToken*1
call ar_plants_tropical x=-6 z=66 r=16 seed=26891
call ar_plants_tropical x=62 z=8 r=10 seed=26892
call ar_plants_tropical x=-56 z=-48 r=8 seed=26893

# RAFT2 10-26: scattered rocks that came out floating on the new slopes (CIGroundIslands)
clear at -16.72 60.11 r=1.5 all only=SmallBoulder2
clear at 65.56 6.29 r=1.5 all only=SmallBoulder2
clear at 59.27 -1.74 r=1.5 all only=SmallBoulder2
clear at 59.87 2.51 r=1.5 all only=SmallBoulder2
clear at -61.46 -46.50 r=1.5 all only=SmallBoulder2
clear at -54.56 -44.75 r=1.5 all only=SmallBoulder2
# --- Settings, story items, notes, behaviours, quest ----------------------------------------------------------------
# --- Things to gather, as suits the island (the user, 2026-10-05): mangoes, palms, pineapples ----------
scatter "Pickup_Landmark_Tree_Mango" 6 at 0 0 r=49.0 seed=4545 free=5
scatter "Pickup_Landmark_Tree_Palm 1" 4 at 0 0 r=49.0 seed=4555 free=5
scatter "Pickup_Landmark_Tree_Palm 3" 4 at 0 0 r=49.0 seed=4556 free=5
scatter "Pickup_Landmark_PineappleLandmark" 6 at 0 0 r=49.0 seed=4565 free=3
# RAFT2 10-26 b: no plants on the hills' steep rock faces
call r2_bareflank x=-6 z=66 b=18 h=16
# --- Raft's finds in the shallows round the island (lib_sea) ----------------------------------------
call shallows r=90 deep=5 n=2

info title=The Sunken Archive
info author=Custom Islands
info description=Station Four of the Frontier Corps: five palm islets on a coral bank, and in a basin between them the Corps' archive, two of its floors flooded - the stacks full of books and fish, the rare book vault at the bottom. The fourth island of Raft 2: The Drowned Frontier.
island on.arrive=message||Palm islets on a bank of coral - and in the middle, a square building standing in the sea, water to its top floor's windows.

story card|Catalogue card|quest:Tangaroa_KeyCard|A catalogue card from the archive's flooded stacks - the index desk needs three.

note archivistsletter Archivist's letter | FRONTIER CORPS - STATION FOUR - THE ARCHIVE\n\nThe sea came up two floors in one winter. The stacks are under water now, and the rare book vault at the bottom with them.\n\nThe vault opens to the index: put the three catalogue cards from the stacks through the index desk up here and its lock lets go. There is air under the reading room's floor, and a pocket of it in the deepest room.\n\nSomething with a lamp on its head has moved into the vault. The Corps went on to Hightide Harbor - the map is in the vault.
note cardbox1 Shelf card box | A box of catalogue cards on a shelf of the stacks, swollen with water - one still readable.
loot cardbox1 story:card*1;Plastic*2
prop cardbox1 loot.refill=0
note cardbox2 Floor card box | A box of catalogue cards on the stacks' floor - one still readable.
loot cardbox2 story:card*1;Rope*1
prop cardbox2 loot.refill=0
note cardbox3 Deep card box | The last box of catalogue cards, in the deepest room - one still readable.
loot cardbox3 story:card*1;Scrap*2
prop cardbox3 loot.refill=0
note rarebookvault Rare book vault | The archive's vault: the Corps' rarest plans - engine controls, a metal detector, fireworks, a zipline - and their map to Hightide Harbor.
loot rarebookvault Blueprint_EngineControls*1;Blueprint_MetalDetector*1;Blueprint_Firework*1;Blueprint_ZiplineBase*1;Blueprint_BatteryCharger*1;Blueprint_ZiplineTool*1;Battery*1
prop rarebookvault loot.refill=0
prop rarebookvault if.open=signal|indexed
prop rarebookvault else.open=message||The vault's lock is wired to the index desk upstairs - it wants the three catalogue cards first.

prop indexterminal obj.name=indexterminal
prop indexterminal beh.use=Feed the catalogue cards through the index
prop indexterminal if.use=quest|9\ntake|story:card|3
prop indexterminal on.use=message||The index whirrs through the three cards - far below, under the water, a heavy lock clunks open.\nsignal||indexed
prop indexterminal else.use=message||The index desk wants three catalogue cards. The archivist's letter said they are in the flooded stacks.

prop readingroom zone.id=readingroom
prop readingroom zone.radius=4
prop readingroom zone.message=The reading room: dry, dusty - and under its floor, the sea.
prop vault zone.id=vault
prop vault zone.radius=4
prop vault zone.message=The deepest room - and a lamp swinging in the dark by the vault.
prop deepair zone.id=deepair
prop deepair zone.radius=1.6
prop deepair zone.air=1
prop keeper creature.count=1
prop keeper creature.size=1.4
prop keeper creature.health=3
prop keeper creature.respawn=0
prop keeper creature.zone=vault

loot sa_topchest Rope*2;Scrap*2;Plank*3
loot sa_cavechest CopperIngot*2;Glass*2;Nail*6
prop sa_cavechest loot.refill=0
note sa_topchest Reading mast deck box | A box lashed to the deck rail at the top of the reading mast.
note sa_cavechest Binding Cave chest | A chest at the back of Binding Cave, dry under the rock.
note sa_lampchest Ines's bindery box | Ines's bindery box: thread, brass corners and the money from the last book sale.
loot sa_lampchest CopperIngot*2;TradeToken*2;Rope*2
note sa_setchest Ex libris chest | Every bookplate of the archive back together - and what the chest kept under them.
loot sa_setchest Glass*3;Bolt*4;MetalIngot*1
note sa_planecrate Book plane's crate | The book plane's crate: books in oilcloth, sealed tins and tools.
loot sa_planecrate Plastic*3;Scrap*3;Nail*6
prop sa_planecrate loot.refill=0
note sa_pilot Book pilot's slip | LOAN RUN - The Sunken Archive. Twelve crates of books for Station Four. Too low over the bank, caught the palms. Books are dry. Tell the archivist.
note jcsa Shelver's ledge | The shelvers climbed these stones to watch for the loan boats.
loot jcsa Rope*3;Plank*4;MetalIngot*1
note jbsa Top of the shelf stack | Somebody's stash at the very top.
loot jbsa CopperIngot*1;Bolt*2;TradeToken*1

quest title=Card Catalogue
quest intro=Palm islets on a coral bank and a building standing in the sea. Station Four: make for the big building standing in the sea and start in its reading room.
step reach|readingroom|1|Make for the building in the sea; climb the jetty into its reading room
step read|Archivist's letter|1|Read the archivist's letter
step open|Shelf card box|1|Dive into the flooded stacks: a card box waits on a shelf
step open|Floor card box|1|Find the second card box on the stacks' floor
step reach|deepair|1|Swim down to the deepest room and breathe in its air pocket
step reach|vault|1|Find the lamp swinging in the dark by the vault
step kill|Angler fish|1|Face the vault's keeper, the angler with the lamp on its head
step open|Deep card box|1|Take the last catalogue card from the deep room's box
step collect|story:card|3|Carry the three catalogue cards up to the index desk
step talk|Ines Varga|1|Talk to Ines Varga at the ruined house on the palm islet
step reach|sa_trail|1|Find the foot of the trail up Reading Hill, the hill with the reading mast
step reach|sa_summit|1|Climb the trail to the top of Reading Hill
step reach|sa_cave|1|Find Binding Cave, the cave mouth in the rocks by the water
step open|Binding Cave chest|1|Open the chest at the back of Binding Cave
step open|Rare book vault|1|Feed the cards through the index, then open the rare book vault
step blueprint|Blueprint_EngineControls|1|Take the engine controls plans from the rare book vault
step blueprint|Blueprint_MetalDetector|1|Take the metal detector plans from the rare book vault
step blueprint|Blueprint_Firework|1|Take the firework plans from the rare book vault
step blueprint|Blueprint_ZiplineBase|1|Take the zipline plans from the rare book vault
step blueprint|Blueprint_BatteryCharger|1|Take the battery charger plans from the rare book vault
step blueprint|Blueprint_ZiplineTool|1|Take the zipline tool plans from the rare book vault
quest done=The vault gives up the Corps' rarest plans - and their map: Hightide Harbor, a fishing town on stilts, where the fleet went.
quest reward=Plank*6;Plastic*6;Rope*2

save The Sunken Archive
