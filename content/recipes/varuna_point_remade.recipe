# Varuna Point Remade - an island of the library's plan Raft Remade (in place of Raft's Varuna Point)
# Raft's Varuna Point made anew: a long rocky point, a construction site cut into its east end - the half-built tower
# (Varuna's elevator shaft in its scaffolding), the site office, the machines - and the floodlight tower over the north
# water, its light knocked out in a storm. Quest "Floodlight Down" (6 steps): the foreman's log at the site, the bulb's
# crate under the tower, the floodlight's four parts from crates sunk on the reef, the floodlight lit again from its
# tower, the giant angler in the deep under the point and the foreman's strongbox it guards (Varuna's blueprints: the
# wind turbine, the advanced battery, the advanced head light, the electric grill).
# RAFT REMADE 10-26 (1-hour pass): grown to Raft's size (r80 about 75) with relief, by land added round the point:
# Varuna's Back (a 24 m hill south of the site) and its tower crane, the surveyors' camp (west point: survey lamps, a
# puzzle), the north-west ridge and a gravel barge, a hidden cave, the company plane, the slab stacks (a jump course).
# Quest 10 -> 14 steps: the surveyors' camp and the floodlight's fuse from the crane cab before the parts; the floodlight
# needs the fuse too. Design: _ProjectDocs/plans/storylines_old/RAFT_REMADE.md.
#
# Built by the recipe player (CIRecipe varuna_point_remade) through the editor's own operations.
include lib_sea
include lib_rt
include lib_features
include lib_highwater
include lib_areas
include lib_raft_remade
new
# (nature and the life under water: as on Raft's island itself - Randomize existing measures them)
randomize VarunaPoint like Seed=7106 Radius=48 Height=18 Cliffs=0.3 BeachWidth=0.5 Hostiles=0 Friendly=0 SeaLife=0.3 Trees=0.4 Bushes=0.5 Rocks=0.75 Harvest=0.7

# --- Terrain: the site cut into the ridge's east end (10 m), a ramp down to the landing on the north-east sand shelf ---
brush flatten from 6 -3 to 26 -3 r=10 s=20 frames=60 h=10
brush flatten from 6 -10 to 14 -10 r=6.5 s=20 frames=40 h=10
brush flatten at 27.5 -9.5 r=6.5 s=20 frames=40 h=10
brush flatten at 1 0 r=6 s=20 frames=40 h=10
# (the yard under the excavator, the rubble and the dumpster made level: the hill rose 1.2 m under the excavator's tracks and
# over the dumpster's lid - the ground check, 2026-10-20)
brush flatten from -1 -3 to 4.5 3 r=4.5 s=20 frames=60 h=10
brush flatten at -0.5 3.5 r=3 s=20 frames=60 h=10
for i 0 5 1
brush flatten at {38-$i*2.6} {14-$i*2} r=2.8 s=20 frames=30 h={3.2+$i*1.36}
next
brush smooth from 38 14 to 25 4 r=3 s=10 frames=20
origin
clear at 15 -4 r=18
clear from 38 14 to 25 4 r=4
clear at 44 19 r=5
# (the generator's look pieces kept off the landing and the ramp by their bodies, not their pivots: the elevator shaft
# stood on the landing once the generator spaced its pieces wider - SL6, 2026-10-19)
clear from 44 20 to 38 14 r=1.5 body
clear from 38 14 to 25 4 r=1.5 body
# (no boulders strewn over the sand - Raft's beaches have few)
clear at 0 0 r=90 only=Rock|Boulder on=sand above=0.2
# (no boulders through the reef's crates or the strongbox)
clear at 40 30 r=3 only=Rock|Boulder
clear at 24 30 r=3 only=Rock|Boulder
clear at 72 -12 r=3 only=Rock|Boulder
clear at 16 -30 r=3 only=Rock|Boulder
clear at 18 70 r=3 only=Rock|Boulder

# --- The floodlight tower at the site's north edge: the radio tower's legs, a deck at 6.3 m, a ladder up its south face
push at 19 3 h=10
for lx -5.9 -0.1 5.8
for lz -4.4 4.4 8.8
place RT_PillarThick - at $lx $lz y=0
place RT_PillarThick - at $lx $lz y=-6
next
next
place RT_Floor lightdeckfloor at 0 4.5 y=6.3
call rt_railing y=6.37 fm=none
place LandmarkLadder_6m towerladder at -1.5 -4.62 y=0
# (Raft's radio tower floodlight, not Varuna Point's own spotlight: placed on an island that one shoots any player it
# sees, 2026-10-04)
place RT_Floodlight floodlight at -3 3 y=6.37 sit scale=2.2 yaw=0
place VP_Cable_Roll01 - at -5 -3 y=6.37
place Zone_Trigger lightdeck at -3 0 y=7.5
pop

# --- The half-built tower: Varuna's elevator shaft, scaffolding three storeys up its west and north faces --------------
place VP_ElevatorShaft shaft at 24 -6 h=10
for sy 0 6 3
place VP_Scaffolding_M_Open - at 23.2 -9.65 h={10+$sy} yaw=90
place VP_Scaffolding_M_Open - at 27.5 -5.5 h={10+$sy}
next
place VP_Skylift_Extended - at 33.5 1.5 ground yaw=20
place VP_PortableToilet - at 34 -11 ground yaw=-90
# (the bricks on the yard by the north scaffold: at 34 -5 they stood on the yard's east cliff, a 1 m-in-1 m slope, set down
# at its foot and their middle buried, CIGroundIslands)
place VP_BrickStack01 - at 27.4 -3 ground yaw=0

# --- The site office (Varuna's break room on its stilts) and the yard: machines, pipes, beams, crates ---------------------
place "Varuna BreakRoomBuilding" siteoffice at 6 -8 h=10 yaw=0
# (the break room is one solid block: the foreman works at a desk out by its steps)
place "Table Office" foremansdesk at 13.5 -2.6 ground yaw=180
place VP_DecorationPrefabBase_OfficeChair - at 13.5 -1.7 ground yaw=170
place Note_Paper foremanslog at 13.3 -2.6 h=12 sit drop yaw=80
# (the excavator's tracks 0.5 m lower, their bottom at 10.3 m: set down by the lowest ground under its box at 10.81 m, its base
# stood up to 0.79 m over the slope under its tracks - the ground check, IG2, 2026-10-12)
place VP_Excavator - at 4.5 3 h=10.05 sit yaw=-80
place VP_Forklift - at 10 4 ground yaw=80
place VP_Dumpster01 - at -1 -3 ground yaw=90
place VP_ConcretePipe01 - at 18 -12 ground yaw=90
place VP_ConcretePipe02 - at 20.8 -13 ground yaw=80
place VP_SteelBeam02 - at 19.5 -8.5 ground yaw=5
place VP_SteelBeam02 - at 19.5 -8.5 y=0.65 ground yaw=8
place VP_StorageCrate02 - at 0 -11 ground yaw=10
place VP_MetalCrate01 - at -0.5 -7.5 ground yaw=-5
# (the rubble under the excavator's bucket, half size, on the yard at the hill's foot: at -3 4, full size, it lay on the
# hillside, set down at the foot and its middle 2 m under the hill, CIGroundIslands)
place Zone_Trigger site at 14 -1 h=11.2

# --- Round the point: four crates the storm washed off the tower, 4 to 8 m down on the few level spots of its steep sea
# floor (north, north-east, the east tip, south) --------------------------------------------------------------------
place "Box Small" partcrate1 at 40 30 ground yaw=20
place "Box Small" partcrate2 at 24 30 ground yaw=-40
place "Box Small" partcrate3 at 72 -12 ground yaw=75
place "Box Small" partcrate4 at 16 -30 ground yaw=10

# --- The deep under the point, north of the tower: the foreman's strongbox where the storm threw it - and its keeper ---
# (box agent 10-25: at 12 29 the point is now land 3 m up - the box sat 14 m in it; the deep is off the north shore, 14 m down)
place VG_Safe strongbox at 18 70 ground sit yaw=180
place Zone_Trigger deep at 18 70 ground y=2
place Creature_AnglerFish angler at 18 74 ground y=3

# --- RAFT REMADE 10-26 (1-hour pass): the point grows to Raft's size - and gets its relief - by land added round it
# (the point, the site, the floodlight tower, the crates and the deep as they were; the north water stays open):
# Varuna's Back, a hill south of the site, and the tower crane on its top; the surveyors' camp on the west point; the
# north-west ridge and a gravel barge; a hidden cave (south-west); the company plane (south-east); the slab stacks (a
# jump course, east). Land bridges first, from the old shore outwards, then each area.
call rr_land x1=-10 z1=-26 x2=-10 z2=-36 h=3 r=10
call rr_land x1=-54 z1=2 x2=-68 z2=4 h=3 r=10
call rr_land x1=-36 z1=22 x2=-38 z2=34 h=3 r=9
call rr_land x1=-40 z1=-22 x2=-46 z2=-36 h=3 r=9
call rr_land x1=40 z1=-24 x2=46 z2=-40 h=3 r=9
call rr_land x1=60 z1=-30 x2=64 z2=-40 h=3 r=8
# A Varuna's Back (south): summit 24 m, base r 22, the trail from its north-east foot, the tower crane on top
call hw_mount x=-10 z=-54 b=22 h=24
call hw_trail x=-10 z=-54 b=22 h=24 a0=30 turn=300 n=28 h0=3
brush flatten at -10 -54 r=8 s=20 frames=400 h=24
call hw_mast x=-10 z=-54 h0=24 lv=6 a=cranetower chest=cranebox top=Placeable_Lantern_Metal
# B The surveyors' camp (west point): their hut, a tent, their survey lamps
call rr_pad x=-78 z=4 h=3 r=14
call rr_ruin x=-78 z=8 h=3 yaw=0 w=3 d=2 al=surveyhut
place Balboa_DecorationPrefabBase_SimpleTent - at -71 -1 h=3 sit yaw=200
place campfire_1 - at -74 -2 ground sit
place "Box Big" - at -84 2 ground sit yaw=30
# C The north-west ridge and the gravel barge run aground below it
call ar_ridge x1=-52 z1=36 x2=-26 z2=48 h=5 top=6 r=8
call hw_wreck x=-62 z=50 h=2 yaw=50 obj=BoatStranded al=barge crate=bargecrate r=9
# D The hidden cave (south-west): a rock with a hole, its mouth to the sea
call ar_cave x=-50 z=-46 h=3 yaw=180 al=caverock chest=cavebox
place SmallBoulder4 - at -51 -65 ground yaw=40 scale=0.9
place SmallBoulder4 - at -47.5 -67 ground yaw=110 scale=0.8
# E The company plane (south-east): down on the shore field
call ar_plane x=46 z=-52 h=3 yaw=120 al=companyplane crate=planecrate
# --- JUMP COURSE vp (Raft Remade pass 10-26): kz-style hop course of floor slabs on its own pad ---
# JUMP vp pad=3 at=74 -42
push at 74 -42
clear at 0 0 r=17 all
brush flatten at 0 0 r=14 s=20 frames=300 h=3
brush smooth at 0 0 r=18 s=4 frames=40
brush flatten at 0 0 r=12 s=20 frames=300 h=3
brush auto at 0 0 r=18 s=10 frames=25
clear at 0 0 r=18
place Block_Foundation_Tier3 jpvp at 0.10 5.64 h=3.60
place Block_Foundation_Tier3 jpvp at 2.92 5.64 h=4.10
place Block_Foundation_Tier3 jpvp at 5.93 5.64 h=4.50
place Block_Foundation_Tier3 jpvp at 5.93 3.03 h=5.40
place Block_Foundation_Tier3 jpvp at 5.93 -1.21 h=5.90 sx=0.3 sz=3
place Block_Foundation_Tier3 jpvp at 5.93 -5.64 h=6.70
place Block_Foundation_Tier3 jpvp at 3.02 -5.64 h=7.60
place Block_Foundation_Tier3 jpvp at 0.40 -5.64 h=6.60
place Block_Foundation_Tier3 jpvp at -2.41 -5.64 h=7.55
place Block_Foundation_Tier3 jpvp at -5.12 -5.64 h=8.50
place Block_Foundation_Tier3 jpvp at -5.12 -2.02 h=9.40 sx=2 sz=2
# JUMP from 11
place Block_Foundation_Tier3 jpvp at 1.30 -2.02 h=9.70 sx=2 sz=2
place Block_Foundation_Tier3 jpvp at 1.30 3.21 h=10.00
# JUMP end
# (each slab on one solid column of its own footprint, from under the pad up to the slab; the first rests on the pad)
place Block_Foundation_Tier3 jppvp at 2.92 5.64 h=3.418 sy=1.493
place Block_Foundation_Tier3 jppvp at 5.93 5.64 h=3.818 sy=2.079
place Block_Foundation_Tier3 jppvp at 5.93 3.03 h=4.718 sy=3.399
place Block_Foundation_Tier3 jppvp at 5.93 -1.21 h=5.218 sy=4.132 sx=0.3 sz=3
place Block_Foundation_Tier3 jppvp at 5.93 -5.64 h=6.018 sy=5.305
place Block_Foundation_Tier3 jppvp at 3.02 -5.64 h=6.918 sy=6.625
place Block_Foundation_Tier3 jppvp at 0.40 -5.64 h=5.918 sy=5.158
place Block_Foundation_Tier3 jppvp at -2.41 -5.64 h=6.868 sy=6.551
place Block_Foundation_Tier3 jppvp at -5.12 -5.64 h=7.818 sy=7.944
place Block_Foundation_Tier3 jppvp at -5.12 -2.02 h=8.718 sy=9.264 sx=2 sz=2
place Block_Foundation_Tier3 jppvp at 1.30 -2.02 h=9.018 sy=9.704 sx=2 sz=2
place Block_Foundation_Tier3 jppvp at 1.30 3.21 h=9.318 sy=10.144
prop jpvp tint.color=#8a8070
prop jpvp tint.amount=0.35
prop jppvp tint.color=#8a8070
prop jppvp tint.amount=0.35
place Loot_Chest jcvp at -5.12 -2.02 h=9.40 sit yaw=0
note jcvp Slab stack chest | On top of the stacked slabs: the site's good tools, put out of the crew's reach.
loot jcvp CopperIngot*2;TitaniumOre*1;Bolt*3
prop jcvp loot.refill=0
place Loot_ChestSmall jbvp at 1.30 3.21 h=10.00 sit yaw=0
note jbvp Concrete gang's tin | Wedged on a slab half-way: the concrete gang's tea money.
loot jbvp Nail*6;Scrap*3;MetalIngot*1
prop jbvp loot.refill=0
place Zone_Trigger jyvp at 1.30 3.21 h=11.00
prop jyvp zone.id=jump_vp_finale
prop jyvp zone.radius=1.8
prop jyvp zone.repeat=never
prop jyvp zone.message=You topped the slab stacks.
pop
# --- end of jump course vp ---
# The new land planted (palms, mangoes, bamboo as on the point)
call ar_plants_hill x=-10 z=-54 r=24 seed=26601
call ar_plants_tropical x=-10 z=-32 r=8 seed=26611
call ar_plants_tropical x=-62 z=3 r=8 seed=26621
call ar_plants_tropical x=-78 z=4 r=14 seed=26631
call ar_plants_hill x=-39 z=42 r=16 seed=26641
call ar_plants_tropical x=-43 z=-30 r=7 seed=26651
call ar_plants_tropical x=43 z=-34 r=8 seed=26661
call ar_plants_tropical x=46 z=-52 r=12 seed=26671

# --- Settings, story items, notes, behaviours, quest ----------------------------------------------------------------
# --- Things to gather, as suits the island (the user, 2026-10-05): mangoes, pineapples, bananas ----------
scatter "Pickup_Landmark_Tree_Mango" 3 at 0 0 r=33.6 seed=4155 free=5
scatter "Pickup_Landmark_PineappleLandmark" 3 at 0 0 r=33.6 seed=4165 free=3
scatter "Banana_Bush_2" 3 at 0 0 r=33.6 seed=4175 free=3
# --- Raft's finds in the shallows round the island (lib_sea) ----------------------------------------
call shallows r=68 deep=5 n=2

# --- RAFT REMADE 10-26: the new areas' zones, notes, the fuse in the crane's cab, the survey lamps, the secrets -------
# The surveyors' camp: the zone, their report on the hut's table, three survey lamps; all lit shows their cache
call hw_zone x=-76 z=2 al=surveyz id=surveycamp r=9 h=1 msg="The surveyors' camp. A hut of stone, a tent, a cold fire - and three survey lamps on posts, dark."
place Note_Paper surveyreport at -78.75 8 h=4.45 drop yaw=20
call rr_lamp x=-84 z=-6 al=slamp1 nm="Survey lamp 1" grp="Survey lamps" on=0
call rr_lamp x=-78 z=-9 al=slamp2 nm="Survey lamp 2" grp="Survey lamps" on=1
call rr_lamp x=-72 z=-6 al=slamp3 nm="Survey lamp 3" grp="Survey lamps" on=0
prop slamp1 on.use=light|Survey lamp 2|toggle
prop slamp2 on.use=light|Survey lamp 1|toggle\nlight|Survey lamp 3|toggle
prop slamp3 on.use=light|Survey lamp 2|toggle
prop slamp1 on.alllit=show|surveycache\nmessage||All three survey lamps burn - lined up on a stone by the fire, a tin with the surveyors' mark.
call rr_hidden x=-76 z=-3 al=surveycache
note surveycache Surveyors' cache | The surveyors' tin: their pay and the good instruments, hidden from the site crew.
loot surveycache CopperIngot*2;MetalIngot*2;Battery*1;TradeToken*2
# Varuna's Back: the zone at its foot and on top, the floodlight's fuse in the crane cab's box
call hw_zone x=8 z=-36 al=backfootz id=backfoot r=5 msg="Varuna's Back. A track cut round the hill to the tower crane on its top."
call hw_zone x=-10 z=-54 al=backtopz id=craneback r=8 h=1 msg="The top of Varuna's Back. The tower crane's ladder goes up inside its mast - the cab box hangs open at the top."
note cranebox Crane cab box | The crane driver's box in the cab: the floodlight's spare fuse, kept dry up here as the foreman ordered.
loot cranebox story:fuse*1;Rope*2;Bolt*2
# Hard hats: five of the crew's hard hats, blown about the island in the storm (a set: a secret)
call rr_piece x=-66 z=8 al=hat1 set="Hard hats" nm="Hard hat 1"
call rr_piece x=6 z=-38 al=hat2 set="Hard hats" nm="Hard hat 2"
call rr_piece x=-36 z=44 al=hat3 set="Hard hats" nm="Hard hat 3"
call rr_piece x=52 z=-44 al=hat4 set="Hard hats" nm="Hard hat 4"
call rr_piece x=-44 z=-30 al=hat5 set="Hard hats" nm="Hard hat 5"
prop hat1 on.set=give||TitaniumIngot*1;CopperIngot*2\nmessage||All five hard hats: the whole storm crew is accounted for.
# The cave, the plane, the barge and the hill's buried box
note cavebox Cave strongbox | A box in the hole in the south-west rock: the site crew's still and their poker winnings.
loot cavebox TitaniumOre*2;CopperIngot*2;Bolt*3
prop cavebox loot.refill=0
call hw_zone x=-50 z=-50 al=cavez id=hiddencave r=4 msg="A hole in the rock, boulders across its mouth - and a smell of cheap spirit."
note planecrate Company plane's crate | The company plane's crate: spares for the site, never unloaded.
loot planecrate Bolt*4;MetalIngot*1;Scrap*3;Rope*2
note bargecrate Gravel barge's crate | A crate from the gravel barge's hold: rope, chain, shovels' heads.
loot bargecrate Rope*3;Plank*4;Scrap*2
call treasure x=-10 z=-54 r=6 n=1 seed=26698 kind=0
prop treasure26698 treasure.loot=CopperIngot*2;TitaniumOre*1;Nail*8

info title=Varuna Point Remade
info author=Custom Islands
info description=Raft's Varuna Point made anew, on an island as big as Raft's own: a construction site cut into a long rocky point - the half-built tower in its scaffolding, the site office, the machines - Varuna's Back and its tower crane, the surveyors' camp, a hidden cave, the company plane - and the floodlight over the north water, knocked out in a storm. Raft Remade's sixth island.
island on.arrive=message||A long rocky point, a construction site cut into its end: a concrete shaft in scaffolding, an excavator, a red site office - and a floodlight tower, dark.

story fuse|Floodlight fuse|Battery|The floodlight's spare fuse, from the crane cab's box on Varuna's Back.
note surveyreport Surveyors' report | SURVEY REPORT - VARUNA POINT\n\nThe point is too low and too narrow for the tower they want: we told the company. They built it anyway.\nThe foreman's fuse is in the crane cab - the crane is the only dry place on this island in a storm.\nOur lamps: one and three on, the middle one minds itself. The tin goes where the light falls.
story part|Floodlight part|quest:Varuna_SpotlightPart|One of the floodlight's four parts - lens, bulb, reflector, cable - from a crate on the reef.

note foremanslog Foreman's log | SITE LOG - VARUNA POINT\n\nDay 41. Storm. The floodlight went over the rail - lens, bulb, reflector and the cable drum, each in its own crate, all into the sea - the current has spread them round the point. The reef has them now.\nDay 42. Without the light we can't work the north water at night. And something down there likes the dark: the night crew saw its lure glowing under the tower.\nDay 43. My strongbox went over with the light - the turbine plans, the batteries, all of it. It's down in the deep under the point. Nobody dives there until that light is back on.\nDay 44. The light's spare fuse is up in the tower crane's cab on Varuna's Back. The surveyors on the west point know the rest.
note partcrate1 Lens crate | A crate on the sea floor off the north-east shelf: the floodlight's lens, wrapped in sacking.
loot partcrate1 story:part*1;Plastic*3
prop partcrate1 loot.refill=0
note partcrate2 Bulb crate | A crate on the sea floor below the floodlight tower: the floodlight's bulb, unbroken.
loot partcrate2 story:part*1;Scrap*3
prop partcrate2 loot.refill=0
note partcrate3 Reflector crate | A crate off the point's east tip: the floodlight's reflector, barnacled but whole.
loot partcrate3 story:part*1;Rope*2
prop partcrate3 loot.refill=0
note partcrate4 Cable crate | A crate on the sand off the south shore: the floodlight's cable drum.
loot partcrate4 story:part*1;Nail*6
prop partcrate4 loot.refill=0
note strongbox Foreman's strongbox | The foreman's strongbox, thrown into the deep by the storm: the site's plans - a wind turbine, batteries, a head lamp, a grill.
loot strongbox Blueprint_WindTurbine*1;Blueprint_BatteryAdvanced*1;Blueprint_HeadLight_Advanced*1;Blueprint_ElectricGrill*1;CopperIngot*2
prop strongbox loot.refill=0
prop strongbox if.open=signal|floodlight
prop strongbox else.open=message||Too dark down here to find the lock - the floodlight is still out.

prop floodlight obj.name=floodlight
prop floodlight beh.use=Fit the parts and light the floodlight
prop floodlight if.use=has|story:fuse|1\ntake|story:part|4
prop floodlight on.use=message||Lens, bulb, reflector, cable - the floodlight hums and throws its beam down into the north water. Something deep below turns away from it.\nsignal||floodlight
prop floodlight else.use=message||The floodlight is missing its lens, bulb, reflector and cable. The foreman's log said they are on the reef - and without its fuse from the crane cab it won't light at all.

prop site zone.id=site
prop site zone.radius=10
prop site zone.message=The construction site: a concrete shaft in scaffolding, machines, a red site office - nobody at work.
prop lightdeck zone.id=lightdeck
prop lightdeck zone.radius=3
prop lightdeck zone.message=The floodlight's deck: the light on its mount, dark, the north water far below.
prop deep zone.id=deep
prop deep zone.radius=6
prop deep zone.message=The deep under the point - and a lure glowing in the dark.
prop angler creature.count=1
prop angler creature.size=2
prop angler creature.health=4
prop angler creature.respawn=0
prop angler creature.zone=deep

quest title=Floodlight Down
quest intro=A construction site on a rocky point, its floodlight dark since the storm. Go up to the site.
step read|Foreman's log|1|Come up to the site and read the foreman's log on his desk by the office
step reach|surveycamp|1|Go out to the surveyors' camp on the west point
step read|Surveyors' report|1|Read the surveyors' report in their hut
step reach|craneback|1|Climb Varuna's Back, the hill south of the site, to the tower crane
step collect|story:fuse|1|Climb the crane's mast and take the floodlight's fuse from the cab box
step open|Bulb crate|1|Dive below the floodlight tower for the crate with the bulb
step collect|story:part|4|Find the other three parts on the reef: the lens, the reflector, the cable drum
step reach|lightdeck|1|Climb the floodlight tower
step kill|Angler fish|1|Light the floodlight, then face the giant angler in the deep under the point
step open|Foreman's strongbox|1|Open the foreman's strongbox in the deep
step blueprint|Blueprint_WindTurbine|1|Take the wind turbine plans from the foreman's strongbox
step blueprint|Blueprint_BatteryAdvanced|1|Take the advanced battery plans from the foreman's strongbox
step blueprint|Blueprint_HeadLight_Advanced|1|Take the advanced headlamp plans from the foreman's strongbox
step blueprint|Blueprint_ElectricGrill|1|Take the electric grill plans from the foreman's strongbox
quest done=The strongbox gives up the site's plans: a wind turbine, advanced batteries, a head lamp, an electric grill. Up on the tower the floodlight still burns over the north water.
quest reward=Plank*8;Scrap*8;Bolt*4

# Buried treasure (one of the story line's last islands): titanium ore on top of Raft's own treasure loot - the metal detector finds it, the shovel digs it
call treasure x=0 z=0 r=30 n=1 seed=8804
prop treasure8804 treasure.loot=TitaniumOre*3

save Varuna Point Remade
