prop spire tint.amount=0.55
# (G2 10-30: the outside stairs laid as one climb round the spire - the old three hung in the air and ran into its walls
# (pictures g2_cs2). RT_Stair's pivot is its low end, its high end 7.5 m along local -x, 1.5 m wide along local +z,
# 2.9 m rise at sy=0.68. 1: up the east wall going north to the second storey's open east side, a landing there;
# 2: up the north wall going west past the third storey's open back; a landing at the north-west corner; 3: up
# the west wall going south to the roof's open west side)
# (G2 10-30 (2): reach - the walker stuck at the first stair's foot, sunk 1 m in the path's slope (a step too high),
# and the first landing ended where the second stair began. The climb moved 2.5 m north, its foot on the 3 m yard;
# the first landing deep enough to hold the second stair's foot)
place RT_Stair spirestair at 7.55 -2.32 h=3.05 yaw=90 sy=0.68
# (G2 10-31: reach - the second stair's foot lay at the first landing's east edge, so only its side could be stepped
# onto: the landing 1.55 m wider to the east, a player walking round onto the stair's foot end-on)
place RT_Floor spirestair at 10.6 8.3 h=6 sx=0.523 sz=0.356
place RT_Stair spirestair at 9.02 6.8 h=6 yaw=0 sy=0.68
place RT_Floor spirestair at 1.55 8.3 h=9 sx=0.278 sz=0.328
place RT_Stair spirestair at 1.38 5.42 h=9 yaw=270 sy=0.68
# (G2 10-31: reach - the third stair ended beside the roof with nothing at its top: a landing level with the roof
# beyond its top end, the roof's open west side next to it, on two posts from the yard)
place RT_Floor spirestair at 1.43 -2.0 h=12 sx=0.257 sz=0.178
place RT_Pillar spirestair at 0 -3.45 h=2.7 sy=3.077
place RT_Pillar spirestair at 1.15 -3.45 h=2.7 sy=3.077
# (G2 10-30 (3): the two landings stand off the spire's north wall with nothing under them (the save's posts took the
# stairs for their holders) - inner posts from 0.3 m into the 3 m yard, the outer pair past the yard's edge from the sea floor
# (8 m down) up to each landing's underside, as the trader's stilts)
place RT_Pillar spirestair at 7.6 5.35 h=2.7 sy=1.077
place RT_Pillar spirestair at 8.95 5.35 h=2.7 sy=1.077
place RT_Pillar spirestair at 7.6 8.2 h=-8 sy=4.643
place RT_Pillar spirestair at 8.95 8.2 h=-8 sy=4.643
place RT_Pillar spirestair at 10.5 5.2 h=-8 sy=4.643
place RT_Pillar spirestair at 10.5 8.2 h=-8 sy=4.643
place RT_Pillar spirestair at 0 5.45 h=2.7 sy=2.077
place RT_Pillar spirestair at 1.35 5.45 h=2.7 sy=2.077
place RT_Pillar spirestair at 0 8.2 h=-8 sy=5.643
place RT_Pillar spirestair at 1.35 8.2 h=-8 sy=5.643
prop spirestair tint.color=#c9d0d6
