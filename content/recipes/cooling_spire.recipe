place "Box Big" - at -1 3.5 y=0.1 sit yaw=-10
pop
push at 7.43 -0.35 h=6
call rt_storey r3=none a=spire
place Loot_Chest landingchest at -5 3.5 y=0.1 sit yaw=180
# (G2 10-31: reach found the log on the ground floor - dropped from 0.1 m its ray began under the landing's floor top
# and fell through to the storey below: dropped from 0.3 m)
place Note_Paper inescs at -2.2 3.2 y=0.3 drop yaw=200
place "Box Small" - at -3.5 3.5 y=0.1 sit yaw=30
pop
push at 7.43 -0.35 h=9
call rt_storey b1=none r1=RT_WallWindow1 r2=RT_WallWindow1 l2=RT_WallWindow1 a=spire
pop
push at 7.43 -0.35 h=12
place RT_Floor spire at 0 4.5
# (G2 10-30: the roof's west side open over its south half, where the third stair arrives - the railing laid out by hand)
place RT_Fence - at -4.5 4.5 y=0
place RT_Fence - at -3 4.5 y=0
place RT_Fence - at -1.5 4.5 y=0
place RT_Fence - at 0 4.5 y=0
place RT_Fence - at -4.5 -4.5 y=0
place RT_Fence - at -3 -4.5 y=0
place RT_Fence - at -1.5 -4.5 y=0
place RT_Fence - at 0 -4.5 y=0
place RT_Fence - at -6.0 0 y=0 yaw=90
place RT_Fence - at -6.0 1.5 y=0 yaw=90
place RT_Fence - at -6.0 3 y=0 yaw=90
place RT_Fence - at 0 -4.5 y=0 yaw=90
place RT_Fence - at 0 -3 y=0 yaw=90
place RT_Fence - at 0 -1.5 y=0 yaw=90
place RT_Fence - at 0 0 y=0 yaw=90
place RT_Fence - at 0 1.5 y=0 yaw=90
place RT_Fence - at 0 3 y=0 yaw=90
