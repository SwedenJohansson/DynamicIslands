# --- Unique layer (10-24): cooling_spire device - see SL14_progress.md UNIQUE ISLANDS
call mirrors x1=20 z1=46 yaw1=200 x2=-12.5 z2=-72 yaw2=20 a1=sunmirror1 a2=sunmirror2 chest=sunchest cx=54.7 cz=-8.5 cyaw=20 items=TitaniumOre*3;Glass*3;Battery*1 title="Sun-locked chest"
prop sunchest loot.refill=0
prop dunecavechest if.open=has|story:raft-Vasagatan_BoltCutter|1
prop dunecavechest else.open=message||The cellar chest is chained shut. Bolt cutters would get through the chain.
loot dunecavechest Glass*2;Bolt*2;Scrap*3;Rope*1;TitaniumOre*2

# --- Deep (10-24, SL14 DEEP 1-HOUR PASS): the climb - a 36 m scaffold tower on its pad beside a raised peak, a plank
# bridge from landing 3 to the summit, the top locker, a stash on landing 2, a cairn and buried tin on the peak; the
# dive - a flooded pit with a wreck, an air bell, a chest and a sunk secret, a ramp out (lib_deep14)
call dp_ground tx=32 tz=-64 hb=4.2 sx=37.81 sz=-75.63 hs=25.8
call dp_tower ox=28.98 oz=-62.99 hb=4.2 yaw=63.43 al=cstower top=cstop stash=csstash zal=cstopzone zid=cs_top msg="The top of the ice tower. The spire's steam leans south below you, towards the Engine."
call tzone x=36.24 z=-72.5 al=cssummit id=cs_summit r=4 msg="The frost peak beside the ice tower." h=1
call notebox x=40.94 z=-74.06 yaw=153.43 al=cscairn
call treasure x=36.02 z=-76.52 r=1.5 n=1 seed=14971
prop treasure14971 treasure.loot=TitaniumOre*2;Battery*1
# (G2 10-30: pivot moved so the near end's floor sits on the tower's deck, between the lantern and the ladder hole)
place ZiplinePath_Landmark cszip at 37.93 -63.01 h=41.55
zipto cszip 11.88 -23.75
place Creature_Goat csgoats at 33.34 -53.27 ground
prop csgoats creature.count=2
# (REACH 10-28: the ramp out rose 8.5 m in 8 m - too steep to walk up: now 15 m long on the same line)
call dp_sink x=-31 z=-43 d=-20 ex1=-24.57 ez1=-34.08 ex2=-15.8 ez2=-21.9 eh=8.96
# (G2 10-31: reach - still a trap: the first step lies under the water against the pit's sheer side, too high to climb
# onto out of depth. Terrain shelves there (1.15/0.65 m down) took the swim spots and shut the pond off: a pool ladder
# instead, on the ramp's line at the step's edge, its foot in the water, its top 1.2 m over the surface)
place Block_Ladder csdiveladder at -26.18 -36.31 h=-1.1 yaw=35.79
place Caravan_Green_02 cswreck at -31 -43 ground sit yaw=-54.21
place Loot_Chest csdivechest at -33.76 -41.01 ground sit yaw=35.79
call dp_air x=-28.24 z=-44.99 id=cs_air al=csair msg="Air trapped under the wreck - breathe."
place Loot_ChestSmall csdivesecret at -33.92 -47.06 ground sit yaw=-54.21
call tzone x=-31 z=-43 al=csdivezone id=cs_dive r=7 msg="The bottom of the cooling pond. Hedda's old caravan lies here." h=1
call tzone x=-19.89 z=-27.59 al=csrim id=cs_rim r=5 msg="The cooling pond's rim." h=1
call treasure x=-17.55 z=-24.34 r=12 n=1 seed=14972
prop treasure14972 treasure.loot=MetalIngot*2;CopperIngot*2;Bolt*2

# --- Settings, story items, notes, behaviours, quest ----------------------------------------------------------------
info title=Cooling Spire
info author=Custom Islands
info description=A pale iron tower four storeys high, steam rolling off it and frost round its foot: the Concord Engine's cooling spire. Hedda camps at its foot with a store; from its roof a cable runs down to a lookout over the ring.
island on.arrive=message||A pale tower in its own cold fog, steaming like a kettle. At its foot, a campfire - lit.

note hedda1 Hedda's welcome | HEDDA - on a sheet of the Fleet's paper\n\nYou came after all. Sit by the fire - it is the only warm thing on this rock, and I built it, so be grateful.\n\nI carried the smelter people's tools up from the Stormworks and kept them for whoever came next. Take them. The rats on the second floor bite. The bear on the roof is worse; it has opinions about stairs.\n\nInes is up there somewhere with her radio, listening to the old man. She will not come down to eat. I take her soup and she says thank you without looking up, and the soup goes cold, and I take her more.\n\nFrom the roof a cable runs down to the shore. Ride it and look south. Then you will understand why I stopped here. The store is mine. Trade if you like.
note hedda2 What Hedda saw | WHAT HEDDA SAW - painted on a board at the lookout\n\nA ring on the sea, wider than any island. Three waves cut across it: the surface, the deep and the ice. It turns. Very slowly. It has turned since before the rafts.\n\nIn the middle, the Engine Court: iron yards on the water, and under them the Command Well, chained shut. Five chains, five keys - the ones you carry. The old man knew you would bring them.\n\nTeo says it is the end of the ocean. Ines says it is a machine like any other. I say: whoever goes there decides what it is. We go in the morning. All three of us, and you, if you will.
note heddachest Hedda's chest | Hedda's chest: titanium tool plans from the smelter crew, wrapped in a scarf.
note landingchest Second landing | A locker on the second landing, gnawed: an advanced backpack's plans.
note topchest Spire top | A chest on the spire's roof, frosted shut: an electric zipline handle's plans.
note mushcrate Cold store | The spire's cold store: mushrooms from the caves under the island, still good.
loot heddachest Blueprint_TitaniumTools*1;TitaniumOre*1;Rope*2
prop heddachest loot.refill=0
loot landingchest Blueprint_BackpackAdvanced*1;Leather*2;Wool*2
prop landingchest loot.refill=0
loot topchest Blueprint_ZiplineToolElectric*1;Battery*1;ZiplineTool*1
prop topchest loot.refill=0
loot mushcrate CaveMushroom*3
prop mushcrate loot.refill=0

note coldstore Cold store | A cold store dug into the slope: food kept fresh by the spire's chill.
loot coldstore Cooked_GenericMeat*2;PlasticBottle_Water*2;Wool*2;Rope*2
note gaugereadings Steam gauge readings | GAUGE READINGS - a clipboard, damp\n\nCoolant 4 deg. Pressure normal. Engine load: 2 percent.\nCoolant 4 deg. Pressure normal. Engine load: 2 percent.\nCoolant 4 deg. Pressure normal. Engine load: 2 percent.\n\nUnderlined three times: WHY KEEP IT COLD IF IT NEVER RUNS?\n\nAnswered underneath, in another hand: Because the Well said so, Lars, and the Well hears Station 1, and Station 1 is never wrong. Now stop underlining things.\n\nAnd under that, last of all, faded: Station 1 has gone quiet. Engine load 0. We keep it cold anyway. In case they wake it. In case they do not.
note dunecavechest Cellar chest | A chest in the cold cave, its lid beaded with drips.
prop dunecavechest loot.refill=0
note pumpmenlog Pumpmen's log | PUMPMEN'S LOG - in a tin under the fallen wall\n\nThe spire must never run dry. If it does, the Engine runs hot. We never saw the Engine. We only saw the pipe, going south under the sand, and felt it hum in our teeth at night.\n\nHedda came through asking about it. We told her what we knew: nothing. She said that was more honest than most harbour masters and gave us a tin of fish.\n\nThe steam leans south because the Engine draws it. The pumpmen kept their best chest by the water plane, behind a sun-lock: one mirror on the dune ridge, one at this house. They liked a puzzle more than a lock.
note waterplanelog Water plane log | WATER PLANE LOG\n\nSpare cooling coils for the spire. The steam from the top of it leans south, whatever the wind does. The needle agrees.\n\nLanded short in the dunes. The coils are in the crate. I have landed short three times this year; the dunes are getting used to me.\n\nSomething big flew under me on the way in, low over the water - grey, with lamps along its side - and turned round to look at me before it went south. I did not know drones could look. This one did.
# (deep pass 10-24: the climb and the dive)
story frostvalve|Frost valve|Hinge|A frost valve from the cooling pond, white with old ice. The ice tower's locker opens with it.
note csdivechest Pond caravan | Hedda's old caravan. In its chest: a frost valve, still cold.
loot csdivechest story:frostvalve*1;Rope*2;Scrap*3;Bolt*2
prop csdivechest loot.refill=0
note cstop Ice tower locker | The frost valve turns the lock: the cooling crew's spares.
loot cstop TitaniumOre*2;Battery*1;CircuitBoard*1
prop cstop loot.refill=0
prop cstop obj.name=cstop
prop cstop if.open=has|story:frostvalve|1
prop cstop else.open=message||The ice tower's locker. A valve socket in place of a lock.
note csstash Ice tower stash | A frozen bag on the second landing.
loot csstash Battery*1;CircuitBoard*1;Nail*6
prop csstash loot.refill=0
note csdivesecret Pond strongbox | Hedda's paint box, and a brush gone stiff.
loot csdivesecret MetalIngot*2;Bolt*3;Rope*1
prop csdivesecret loot.refill=0
note cscairn Frost cairn | A cairn on the frost peak:\n\nThe steam leans south. It always leans to the Engine. - Hedda
note keepercs Keeper's log: Spire | KEEPER'S LOG. The Cooling Spire, on a gauge card, pinned at the lookout:\n\nThey kept her cold. Forty years of men on this rock keeping an engine cold that never ran, because Station 1 said so. I have shaken every one of their hands in my head.\n\nTomorrow I go into the Court. The drone goes before me. It clears the yards of anything that might hurt my pilgrims, the way it was built to clear the ring. I will open the chains I can and leave the rest for the young ones, and when the Engine wakes, the Well will open, and Mara will answer.\n\nShe will be cross with me. She always was when I was late. Forty years is very late.\n\nCalling. Calling.\n\n- Silas
note inescs Ines's radio log: the spire | A page of Ines's radio log, held down by a cold mug on the second landing:\n\nNight fourteen. Hedda brings soup. I am a bad friend; I will be a better one after.\n\nI have the old man's voice clean now. He is not following the pulse. The pulse comes out of him. There is a hiss on it, the kind a reel makes, and a click at the end of every call, like a tape being rewound. And the woman under it - Station 1, crew to posts, standby - is always the same woman saying the same words in the same breath.\n\nTeo came on the set tonight from the shoals, faint, to say the masts are still lit and his tobacco is gone. I cried. I do not know which part made me.\n\nTomorrow, the Court.
note teocs Teo on the radio | TEO ON THE RADIO - taken down by Hedda in pencil, on the back of a stores list\n\nTeo here. Static Shoals. The masts are lit. The boats are not back. I have run out of tobacco and started talking to the screechers. One of them answers. Its name is Gerald.\n\nListen. The old man passed the shoals again last night, going south fast, with that drone behind him like a hound. He waved. I waved back. I do not know why.\n\nIf you go into the Court, Hedda, go slow. If the drone comes for you, run, and do not stop to be brave. Being brave is my job and I am very bad at it.\n\nTell Ines I said the pulse is a liar. She will know what I mean. Teo out.
quest title=The Cold Spire
quest intro=A steaming tower and a lit campfire at its foot. Go to the camp.
step reach|hedda_camp|1|Go to the campfire at the spire's foot
step read|Hedda's welcome|1|Read Hedda's welcome by the fire
step blueprint|Blueprint_TitaniumTools|1|Take the titanium tool plans from Hedda's chest
step reach|landing_2|1|Climb the outside stair to the second landing
step kill|Rat|3|Drive the ice-rats off the second landing
step blueprint|Blueprint_BackpackAdvanced|1|Take the backpack plans from the landing's locker
step reach|spire_top|1|Climb to the top of the spire
step kill|Polar bear|1|Drive the polar bear off the roof
step blueprint|Blueprint_ZiplineToolElectric|1|Take the electric zipline plans from the chest on the roof
step read|Pumpmen's log|1|Read the pumpmen's log in the ruined pump house on the flat
step reach|coolridge|1|Climb the dune ridge, the highest dunes behind the spire
step read|Water plane log|1|Read the log at the plane wreck in the dunes
step open|Sun-locked chest|1|Turn both mirrors and open the sun-locked chest by the water plane
step reach|court_view|1|Ride the cable down to the lookout on the shore
step read|What Hedda saw|1|Read what Hedda painted at the lookout
quest done=South over the sea: the ring, turning. The Engine Court is waiting.
quest reward=TitaniumOre*2;Rope*4;CaveMushroom*2

call tzone x=14.43 z=-2.35 al=campzone id=hedda_camp r=5 msg="Hedda's camp. A fire, a tent, a store - and her handwriting on a sheet by the fire."

