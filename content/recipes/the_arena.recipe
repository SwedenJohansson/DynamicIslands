place TP_Selene_ComputerRoom_Server01 - at -5.1 -1.6 y=0 sit yaw=90
place TP_Selene_ComputerRoom_Server02 - at -5.1 0 y=0 sit yaw=90
place TP_Selene_ComputerRoom_Server01 - at -5.1 1.6 y=0 sit yaw=90
place Placeable_Table_Basic - at -2.5 -2 y=0 sit
place Balboa_DecorationPrefabBase_Flatscreen - at -3.2 -2.2 y=2 drop
place Balboa_DecorationPrefabBase_Flatscreen - at -2.4 -2.2 y=2 drop
place Balboa_DecorationPrefabBase_Flatscreen - at -1.6 -2.2 y=2 drop
place Note_Paper wardenlog at -2.5 -1.6 y=2 drop yaw=10
place RT_RadarScreen - at -5.3 4.6 y=0 sit yaw=90
place Loot_ChestLarge prizevault at -1 4.4 y=0 sit yaw=-90
place Zone_Trigger controlroom at -3 3 y=1.5
macro slab x1 x2 z1 z2
place RT_Floor - at $x2 $z2 y=4.8 sx={($x2-$x1)/6.04} sz={($z2-$z1)/9}
end
call slab -7.5 0.6 -3.6 3
call slab -7.5 0.6 3 9.6
place SmallBoulder2 - at 2.4 -4.8 ground scale=0.55
place SmallBoulder2 - at 2.4 4.8 ground scale=0.55 yaw=180
pop

# --- The sponsors' gifts: one among the rocks on the northern upland, one in a hollow by the beach trail, one sunk in the
# lake -------------------------------------------------------------------------------------------------------------------
place "Box Small" cache1 at -8 58 ground sit yaw=30
place SmallRock_01 - at -6.8 58.6 ground
place "Box Small" cache2 at 9 -62 ground sit yaw=-20
place Loot_SunkenBarrel lakecache at -29 -48 h=-2.3 drop

# --- Shore: the landing on the south beach --------------------------------------------------------------------------------
place Zone_Trigger shore at 15 -66 y=1

# --- The forest's sound; animals: goats on the northern upland, a turtle in the lake, dolphins off the north coast -------
place Zone_Sound forest at 0 10 y=10
place Creature_Goat goats at -10 50 ground
prop goats creature.count=3
place Creature_Turtle turtles at -30 -40 h=-1.5
prop turtles creature.count=1
place Creature_Dolphin dolphins at 0 92 h=-3
prop dolphins creature.count=2

# --- Raft's finds in the shallows round the island and in the lake (lib_sea) --------------------------------------------
call shallows r=96 deep=5 n=1
call shallows x=-22 z=-44 r=12 deep=3 seed=90

# --- SILVER 10-26 (the user: one hour per island - hills, cliffs, a cave, a house, a wreck, secrets): Victor's Rock ------
# Victor's Rock with the wardens' camera mast on it, Hideout Cave, the ruined house where Cassia Venn waits (four lamps round it: a puzzle), a plane wreck,
# a jump course, a maze, five tribute tokens about the island (a set), and at the house the sponsors' gate that wants the camera relay and the gate key
call hw_zone x=67.32 z=-12.52 al=ta_trailz id=ta_trail r=5 msg="The trail up Victor's Rock starts here - round and up."
call hw_zone x=86 z=-16 al=ta_summitz id=ta_summit r=8 h=1 msg="The top of Victor's Rock. The whole island below you."
place Creature_Goat ta_goats at 71.32 -9.52 ground
prop ta_goats creature.count=2
call hw_mast x=83 z=-14 h0=16 lv=6 a=ta_mast chest=ta_topchest top=Placeable_Flag_01
call ar_cave x=-80 z=-50 h=3 yaw=0 al=ta_caverock chest=ta_cavechest
call hw_zone x=-81 z=-41 al=ta_cavez id=ta_cave r=4 h=1 msg="Hideout Cave. Water drips somewhere in the dark."
call ar_ruin x=68 z=22 h=2.1 yaw=0 w=3 d=2 al=ta_ruin
call ss_islander x=67 z=17.5 yaw=200 al=ta_isl nm="Cassia Venn" pose=sit
prop ta_isl talk.text=Another one off the sea. They used to bring us by boat too, in the dark.\n---\nI won, you know. Two years ago. Nobody came to take me home - the wardens had already gone.\n---\nThe sponsors' gate wants its relay off the camera mast on Victor's Rock and the gate key I hid in Hideout Cave. Bring them, and see what the sponsors kept.\n---\nThe lodge lamps: four, each wakes the next. Light them all and look behind the back wall. And the maze by the woods - that was round zero. Nobody liked round zero.
place Placeable_Chair_Basic - at 67 17.5 ground sit yaw=200
call ss_lamp x=61 z=21 al=ta_lamp1 nm="Lodge lamp 1" grp="Lodge lamps" on=0
call ss_lamp x=67 z=28 al=ta_lamp2 nm="Lodge lamp 2" grp="Lodge lamps" on=1
call ss_lamp x=74 z=21 al=ta_lamp3 nm="Lodge lamp 3" grp="Lodge lamps" on=1
call ss_lamp x=67 z=14 al=ta_lamp4 nm="Lodge lamp 4" grp="Lodge lamps" on=0
prop ta_lamp1 on.use=light|Lodge lamp 2|toggle
prop ta_lamp2 on.use=light|Lodge lamp 3|toggle
prop ta_lamp3 on.use=light|Lodge lamp 4|toggle
prop ta_lamp4 on.use=light|Lodge lamp 1|toggle
prop ta_lamp1 on.alllit=show|ta_lampchest\nmessage||All four lamps burn. Behind the back wall a stone has been lifted.
call ss_hidden x=69 z=26.6 al=ta_lampchest
place Creature_Chicken ta_hens at 76 28 ground
prop ta_hens creature.count=3
call ar_plane x=-2 z=-90 h=3 yaw=250 al=ta_plane crate=ta_planecrate
place Note_Paper ta_pilot at -2.51 -94.44 ground y=0.1 drop yaw=280
call hw_zone x=-2 z=-90 al=ta_planez id=ta_plane r=6 h=1 msg="A plane, nose down in the grass. Nobody came for it."
# JUMP ta pad=3 at=66 62
push at 66 62
clear at 0 0 r=17 all
brush flatten at 0 0 r=14 s=20 frames=300 h=3
brush smooth at 0 0 r=18 s=4 frames=40
brush flatten at 0 0 r=12 s=20 frames=300 h=3
brush auto at 0 0 r=18 s=10 frames=25
