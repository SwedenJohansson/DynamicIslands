clear at -21.6 -22.7 r=1.5 all only=^BigRock_2
clear at -21.6 76.2 r=3 all body only=^BigRock_3
clear at -43.1 11.1 r=1.5 all only=^SmallRock_03
clear at -19.5 75.6 r=1.5 all only=^SmallRock_01
clear at -51.9 -61.0 r=3 all body only=^BigRock_Low1_Sand
clear at -1.8 -28.8 r=1.5 all only=^SmallBoulder2
clear at -1.4 -19.2 r=1.5 all only=^SmallBoulder2

save The Arena
