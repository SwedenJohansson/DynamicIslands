# Utopia Remade - an island of the library's plan Raft Remade (in place of Raft's Utopia) - the end of the voyage
# Raft's Utopia made anew: the docks on its north beach with Utopia's market stalls, the warden's prison house (Utopia's
# own prison on its stilts) on the east flats, and on the summit the warden's yard behind a thatch palisade - its gate
# locked with two keys, his hyena pack and their alpha inside, his table and his chest. Quest "The Warden's Gate"
# (20 steps, in three chapters as the plan's finale): the docks - Olof's last message, his crate, the empty cage, the
# fisherman's crate, the market's stores and the trader's stack box (six pages), the dock master's crate and key; the
# prison house - the clerk's yard, the rats, his desk and key, his crate (nine pages); the summit - the gate unlocked
# with both keys, the hyenas and their alpha, the warden's table, his pot and his jar (twelve pages) and his chest
# (Utopia's blueprints: the electric zipline tool, the big backpack, the titanium tools) - its quest-done text is the end of the world plan Raft Remade.
# RAFT REMADE 10-26 (1-hour pass): grown to Raft's size (r80 about 85, the finale) by land added round it: Lighthouse
# Head (south, 26 m) and its old lighthouse mast, Olof's crew camp (west), the quarry ridge and cave (east), the warden's
# plane, the cargo yard, the slab stacks (a jump course). The gate now has three locks: the third key is the lighthouse
# keeper's. Crew tokens (six, a set) are a secret. Quest 23 -> 28 steps. Design: _ProjectDocs/plans/storylines_old/RAFT_REMADE.md.
#
# Built by the recipe player (CIRecipe utopia_remade) through the editor's own operations.
include lib_sea
include lib_rt
include lib_features
include lib_highwater
include lib_areas
include lib_raft_remade
new
# (nature and the life under water: as on Raft's island itself - Randomize existing measures them)
randomize Utopia like Seed=7108 Radius=55 Height=22 Cliffs=0.25 BeachWidth=0.5 Hostiles=0 Friendly=0 SeaLife=0.3 Trees=0.4 Bushes=0.5 Rocks=0.75 Harvest=0.7 Water=0.5

# --- Terrain: the quay on the north beach (1.8 m), the prison house's flats (6 m), the warden's yard on the summit
# (18 m) and the path from the quay up to its gate ----------------------------------------------------------------------
brush flatten from -2 45 to 18 45 r=5 s=20 frames=60 h=1.8
# (the quay's edge up to the pier: the beach fell away under the pier's first plate and stopped a player 0.5 m short)
brush flatten from 2 49.5 to 11 49.5 r=2.5 s=20 frames=40 h=1.75
brush flatten at 22 12 r=17 s=20 frames=80 h=6
brush flatten from 15 29.5 to 29 29.5 r=4.5 s=20 frames=40 h=6
brush flatten at -6.5 -6.5 r=12 s=20 frames=80 h=18
for i 0 10 1
brush flatten at {4-$i*1.05} {41-$i*3.6} r=2.8 s=20 frames=30 h={2.5+$i*1.51}
next
brush smooth from 4 41 to -6.5 5 r=3 s=10 frames=20
origin
clear from -2 45 to 18 45 r=8
clear at 22 12 r=20
clear at -6.5 -6.5 r=15
# (the open ground before the warden's gate: palms crowded its approach)
clear at -6.5 8 r=9
clear from 4 41 to -6.5 5 r=4
# (the generator's look pieces kept off the summit path by their bodies, not their pivots: a tower's frame stood on it
# once the generator spaced its pieces wider - SL6, 2026-10-19)
clear from 4 41 to -6.5 5 r=1.5 body
clear from -6.5 5 to -6.5 -3.5 r=1.5 body
clear from 14 44 to 22 31 r=3
# (no boulders strewn over the sand - Raft's beaches have few)
clear at 0 0 r=90 only=Rock|Boulder on=sand above=0.2

# --- The docks: a pier of the radio tower's floor plates, Utopia's market on the quay, Olof's message ------------------
place RT_Floor pier at 6 59 h=1.8
place RT_Floor - at 12 59 h=1.8
place UT_CoveredCrate02 olofscrate at 4 44 ground yaw=10
place Note_Paper olofsmessage at 4 44 h=4.5 sit drop yaw=80
place UT_CoveredCrate03 marketstores at 14 46 ground yaw=-15
place UT_CoveredCrate01 fishcrate at 16.5 44 ground yaw=30
place UT_MarketBasket01 - at 8 43.5 ground
place UT_MarketBasket03_Banana - at 9.2 43.2 ground
place UT_MarketCrateSmall02 - at 10.5 44 ground yaw=20
place UT_MarketStackBox01 stackbox at 1 46 ground yaw=-20
# (SL9: Utopia's market goods to take - a sack of potatoes to plant, a basket of bananas, a crate of mackerel - and a
# butler bot still rolling about the quay)
place "Pickup_Landmark_MarketGood_Banana_Sack" bananas at 6 45 ground yaw=10
place "Pickup_Landmark_MarketGood_Banana_Basket01" - at 11.8 45.2 ground
place "Pickup_Landmark_MarketGood_Banana_CrateSmall01" - at 9 43.5 ground yaw=-30
place Creature_ButlerBot butler at 7 48 ground
place TangaroaBenchSilver - at 0.5 48 ground yaw=180
place Tangaroa_OutdoorFurnitureSilver_Table - at 12 48 ground
place Tangaroa_OutdoorFurnitureSilver_Chair - at 11 48.3 ground yaw=90
place Tire_01 - at -1 43.5 ground
place UT_DogCage_Medium02 cage at 18 47.5 ground yaw=200
place Loot_Crate dockcrate at 9.5 57.2 h=1.8 yaw=15
place Zone_Trigger docks at 8 46 h=3

# --- The warden's prison house on the east flats: Utopia's prison on its stilts (its mesh 11.4 m east and 33.9 m north
# of its pivot), the prison clerk's desk out in front of it - where the rats have moved in -----------------------------
place UT_Set_Prison prisonhouse at 10.6 -21.9 h=6
place "Table Office" clerksdesk at 22 28.6 ground yaw=180
place "Chair Office" - at 22 27.5 ground yaw=190
place UT_MarketCrateSmall01 clerkscrate at 24.5 30.5 ground yaw=40
place Zone_Trigger clerkyard at 22 29 h=7.2
place Creature_Rat rats at 23 27 h=6.5

# --- The warden's yard on the summit (18 m): a palisade of thatch walls, its gate in the north side (two leaves that
# slide aside), his table, his pots, his chest - and his hyenas -----------------------------------------------------
for wx -13.25 -8.75 1.5
place Block_Wall_Thatch - at $wx 1 ground
next
for wx -4.25 0.25 1.5
place Block_Wall_Thatch - at $wx 1 ground
next
for wx -13.25 0.25 1.5
place Block_Wall_Thatch - at $wx -14 ground
next
for wz -13.25 0.25 1.5
place Block_Wall_Thatch - at -14 $wz ground yaw=90
place Block_Wall_Thatch - at 1 $wz ground yaw=90
next
place Block_Wall_Thatch gateL at -7.25 1 ground
place Block_Wall_Thatch gateR at -5.75 1 ground
place UT_EndRoom_Table wardenstable at -6.5 -9 ground yaw=0
place UT_EndRoom_Chair - at -8 -11 ground yaw=0
place UT_EndRoom_Chair - at -5 -11 ground yaw=0
place UT_EndRoom_Pot01 wardenspot at -12 -12 ground
place UT_EndRoom_Pot02 - at -1 -12 ground
place UT_EndRoom_Pot03 wardensjar at -12 -1.5 ground
place Loot_ChestLarge wardenschest at -6.5 -12.6 ground yaw=0
place Zone_Trigger yard at -6.5 -3.5 h=19.2
place Creature_Hyena alpha at -6.5 -6 h=18.5
place Creature_Hyena pack at -3 -4 h=18.5

# --- RAFT REMADE 10-26 (1-hour pass): the finale island grows to Raft's size by land added round it (the docks, the
# prison house, the summit and its yard as they were): Lighthouse Head (south, 26 m) and the old lighthouse mast on it,
# Olof's crew camp (west), the quarry ridge and its cave (east), the warden's plane (north-west), the cargo yard (south-
# east), the slab stacks (a jump course, north-east). Land bridges first, from the old shore outwards, then each area.
call rr_land x1=0 z1=-44 x2=0 z2=-56 h=3 r=12
call rr_land x1=-44 z1=0 x2=-58 z2=2 h=3 r=10
call rr_land x1=44 z1=-8 x2=56 z2=-14 h=3 r=10
call rr_land x1=-34 z1=32 x2=-44 z2=42 h=3 r=9
call rr_land x1=30 z1=-36 x2=40 z2=-48 h=3 r=9
call rr_land x1=44 z1=26 x2=56 z2=30 h=3 r=8
# (10-27: a generated glass tower stood in the head's hill - its pieces cleared before the head is built)
clear at 0 -74 r=30 all body
# A Lighthouse Head (south): summit 26 m, base r 24, the trail from its north foot, the old lighthouse mast on top
call hw_mount x=0 z=-74 b=24 h=26
call hw_trail x=0 z=-74 b=24 h=26 a0=0 turn=300 n=30 h0=3
brush flatten at 0 -74 r=8 s=20 frames=400 h=26
call hw_mast x=0 z=-74 h0=26 lv=6 a=lighthousemast chest=keeperbox top=Placeable_Lantern_Metal
# B Olof's crew camp (west): their stone hut, a tent, a fire, their boxes
call rr_pad x=-72 z=4 h=3 r=14
call rr_ruin x=-72 z=8 h=3 yaw=0 w=3 d=2 al=crewhut
place Balboa_DecorationPrefabBase_SimpleTent - at -64 -2 ground sit yaw=160
place campfire_1 - at -68 -3 ground sit
place "Box Big" - at -79 0 ground sit yaw=20
# C The quarry ridge (east) and the quarrymen's cave in it, its mouth to the south
call ar_ridge x1=60 z1=-4 x2=68 z2=-30 h=4 top=8 r=9
call ar_cave x=62 z=-36 h=3 yaw=180 al=quarryrock chest=quarrybox
# D The warden's plane (north-west), down short of the beach
call ar_plane x=-48 z=46 h=3 yaw=150 al=wardenplane crate=planecrate
# E The cargo yard (south-east): containers the storm threw up, the yard's crate
call rr_containers x=42 z=-54 h=3 yaw=-20 n=3 al=yardcontainer
place Loot_Crate yardcrate at 34 -46 ground sit yaw=10
# --- JUMP COURSE ut (Raft Remade pass 10-26): kz-style hop course of floor slabs on its own pad ---
# JUMP ut pad=3 at=66 32
push at 66 32
clear at 0 0 r=17 all
brush flatten at 0 0 r=14 s=20 frames=300 h=3
brush smooth at 0 0 r=18 s=4 frames=40
brush flatten at 0 0 r=12 s=20 frames=300 h=3
brush auto at 0 0 r=18 s=10 frames=25
clear at 0 0 r=18
place Block_Foundation_Tier3 jput at 0.10 5.64 h=3.60
place Block_Foundation_Tier3 jput at 2.92 5.64 h=4.10
place Block_Foundation_Tier3 jput at 5.93 5.64 h=4.50
place Block_Foundation_Tier3 jput at 5.93 3.03 h=5.40
place Block_Foundation_Tier3 jput at 5.93 -1.21 h=5.90 sx=0.3 sz=3
place Block_Foundation_Tier3 jput at 5.93 -5.64 h=6.70
place Block_Foundation_Tier3 jput at 3.02 -5.64 h=7.60
place Block_Foundation_Tier3 jput at 0.40 -5.64 h=6.60
place Block_Foundation_Tier3 jput at -2.41 -5.64 h=7.55
place Block_Foundation_Tier3 jput at -5.12 -5.64 h=8.50
place Block_Foundation_Tier3 jput at -5.12 -2.02 h=9.40 sx=2 sz=2
# JUMP from 11
place Block_Foundation_Tier3 jput at 1.30 -2.02 h=9.70 sx=2 sz=2
place Block_Foundation_Tier3 jput at 1.30 3.21 h=10.00
# JUMP end
# (each slab on one solid column of its own footprint, from under the pad up to the slab; the first rests on the pad)
place Block_Foundation_Tier3 jpput at 2.92 5.64 h=3.418 sy=1.493
place Block_Foundation_Tier3 jpput at 5.93 5.64 h=3.818 sy=2.079
place Block_Foundation_Tier3 jpput at 5.93 3.03 h=4.718 sy=3.399
place Block_Foundation_Tier3 jpput at 5.93 -1.21 h=5.218 sy=4.132 sx=0.3 sz=3
place Block_Foundation_Tier3 jpput at 5.93 -5.64 h=6.018 sy=5.305
place Block_Foundation_Tier3 jpput at 3.02 -5.64 h=6.918 sy=6.625
place Block_Foundation_Tier3 jpput at 0.40 -5.64 h=5.918 sy=5.158
place Block_Foundation_Tier3 jpput at -2.41 -5.64 h=6.868 sy=6.551
place Block_Foundation_Tier3 jpput at -5.12 -5.64 h=7.818 sy=7.944
place Block_Foundation_Tier3 jpput at -5.12 -2.02 h=8.718 sy=9.264 sx=2 sz=2
place Block_Foundation_Tier3 jpput at 1.30 -2.02 h=9.018 sy=9.704 sx=2 sz=2
place Block_Foundation_Tier3 jpput at 1.30 3.21 h=9.318 sy=10.144
prop jput tint.color=#857a68
prop jput tint.amount=0.35
prop jpput tint.color=#857a68
prop jpput tint.amount=0.35
place Loot_Chest jcut at -5.12 -2.02 h=9.40 sit yaw=0
note jcut Stack-top chest | On top of the slab stacks: what the warden's guards hid from him.
loot jcut CopperIngot*2;TitaniumOre*1;Bolt*3
prop jcut loot.refill=0
place Loot_ChestSmall jbut at 1.30 3.21 h=10.00 sit yaw=0
note jbut Guards' tin | Wedged on a slab half-way: the guards' dice money.
loot jbut Nail*6;Scrap*3;MetalIngot*1
prop jbut loot.refill=0
place Zone_Trigger jyut at 1.30 3.21 h=11.00
prop jyut zone.id=jump_ut_finale
prop jyut zone.radius=1.8
prop jyut zone.repeat=never
prop jyut zone.message=You topped the slab stacks.
pop
# --- end of jump course ut ---
# The new land planted (mangoes, bananas, palms as on the island)
call rr_plants_hill x=0 z=-74 r=26 seed=27001
call rr_plants_tropical x=0 z=-50 r=9 seed=27011
call rr_plants_tropical x=-52 z=1 r=8 seed=27021
call rr_plants_tropical x=-72 z=4 r=14 seed=27031
call rr_plants_hill x=64 z=-17 r=14 seed=27041
call rr_plants_tropical x=-42 z=40 r=10 seed=27051
call rr_plants_tropical x=36 z=-44 r=8 seed=27061
call rr_plants_tropical x=50 z=-10 r=7 seed=27071

# --- Settings, story items, notes, behaviours, quest ----------------------------------------------------------------
# --- Things to gather, as suits the island (the user, 2026-10-05): mangoes, bananas, palms ----------
scatter "Pickup_Landmark_Tree_Mango" 3 at 0 0 r=38.5 seed=4191 free=5
scatter "Banana_Bush_2" 3 at 0 0 r=38.5 seed=4201 free=3
scatter "Pickup_Landmark_Tree_Palm 1" 2 at 0 0 r=38.5 seed=4211 free=5
scatter "Pickup_Landmark_Tree_Palm 3" 2 at 0 0 r=38.5 seed=4212 free=5
# --- Raft's finds in the shallows round the island (lib_sea) ----------------------------------------
call shallows r=75 deep=5 n=2

# --- RAFT REMADE 10-26: the new areas' zones and notes, the gate's third key, the secrets ------------------------------
call hw_zone x=-70 z=2 al=crewz id=crewcamp r=9 h=1 msg="Olof's crew camp. A stone hut, a tent, a fire long cold - they waited here for the warden to fall."
place Note_Paper crewjournal at -72.75 8 h=4.45 drop yaw=20
note crewjournal Crew's journal | OLOF'S CREW - THE JOURNAL\n\nThe warden had a third lock put on his gate after we tried it the first time. The third key went to the old lighthouse keeper - he'd never come down.\nThe keeper's box is up the lighthouse mast on Lighthouse Head, the hill with the old mast.\nThe rest of us are marking our tokens round the island. Find all six and you'll know we were here.
call hw_zone x=0 z=-56 al=headfootz id=headfoot r=6 msg="Lighthouse Head. A path cut round the hill to the old lighthouse mast on its top."
call hw_zone x=0 z=-74 al=headtopz id=lighthouse r=8 h=1 msg="The top of Lighthouse Head. The mast's ladder runs up inside it - the keeper's box hangs on the deck."
story keeperkey|Lighthouse keeper's key|quest:Utopia_KeyEntrance|The third key to the warden's gate - the old lighthouse keeper's.
note keeperbox Keeper's box | The lighthouse keeper's box on the mast deck: the warden's third key, a lamp wick, his pipe.
loot keeperbox story:keeperkey*1;Rope*2;Bolt*2
prop keeperbox loot.refill=0
# Crew tokens: six tokens Olof's crew left round the island (a set: a secret)
call rr_piece x=-66 z=10 al=token1 set="Crew tokens" nm="Crew token 1"
call rr_piece x=-6 z=-52 al=token2 set="Crew tokens" nm="Crew token 2"
call rr_piece x=52 z=-12 al=token3 set="Crew tokens" nm="Crew token 3"
call rr_piece x=-40 z=38 al=token4 set="Crew tokens" nm="Crew token 4"
call rr_piece x=30 z=-40 al=token5 set="Crew tokens" nm="Crew token 5"
call rr_piece x=52 z=30 al=token6 set="Crew tokens" nm="Crew token 6"
prop token1 on.set=give||TitaniumIngot*2;CopperIngot*2\nmessage||All six crew tokens: Olof's crew were all here, to the last one.
# The quarry cave, the plane, the cargo yard
note quarrybox Quarrymen's strongbox | The quarrymen's strongbox in the cave under the ridge: their pay from the warden, never spent.
loot quarrybox TitaniumOre*3;CopperIngot*2;Bolt*3
prop quarrybox loot.refill=0
call hw_zone x=62 z=-40 al=quarryz id=quarrycave r=4 msg="A cave cut into the quarry ridge - picks, a lamp, a strongbox."
note planecrate Warden's plane crate | The crate in the warden's plane: what he meant to fly out with.
loot planecrate CopperIngot*2;MetalIngot*2;Bolt*3;Rope*2
note yardcrate Cargo yard crate | The cargo yard's crate: rivets, rope, sheet metal.
loot yardcrate Nail*8;Rope*2;MetalIngot*1;Scrap*3
call treasure x=0 z=-74 r=14 n=1 seed=27098 kind=0
prop treasure27098 treasure.loot=CopperIngot*2;TitaniumOre*2;Nail*8

info title=Utopia Remade
info author=Custom Islands
info description=Raft's Utopia made anew - the end of the voyage, on an island as big as Raft's own: docks with Utopia's market, Lighthouse Head, Olof's crew camp, a quarry, the warden's prison house on its stilts, and on the summit his yard behind a thatch palisade, its gate locked with two keys. His hyenas wait inside. Raft Remade's eighth and last island.
island on.arrive=message||Docks, market stalls, a prison house on stilts - and on the summit a thatch palisade, its gate shut. Somewhere behind it, hyenas laugh.

story dockkey|Dock master's key|quest:Utopia_KeyEntrance|One of the two keys to the warden's gate - the dock master's.
story prisonkey|Prison clerk's key|quest:Utopia_KeyPrison|One of the two keys to the warden's gate - the prison clerk's.

note olofsmessage Olof's last message | To whoever comes after us,\n\nThis is Utopia - or what the warden left of it. He took the summit for himself, fenced it with thatch and keeps his hyenas inside. His gate takes two keys: the dock master kept one in his crate at the end of the pier, the prison clerk the other in his desk by the prison house.\n\nWe never got through that gate. Maybe you will. Whatever he hoarded up there - the plans, the tools - it was meant for all of us.\n\n- Olof
note olofscrate Olof's crate | Olof's covered crate, left for whoever came after: rope, a few planks - "for your raft, not his", chalked on the lid.
loot olofscrate Rope*2;Plank*4
prop olofscrate loot.refill=0
note cage Empty cage | The cage on the quay, its door hanging open: hyena hair on the bars, a gnawed bone - the warden's pack was kept here once.
loot cage Scrap*2;Rope*1
prop cage loot.refill=0
# (scenery: its door hangs open; it wanted bolt cutters - the ready piece's lock taken off)
prop cage beh.use=
prop cage if.use=
prop cage else.use=
prop cage on.use=
note fishcrate Fisherman's crate | A fisherman's covered crate: line, hooks, a net half mended - he left in a hurry.
loot fishcrate Rope*2;Scrap*1
prop fishcrate loot.refill=0
note stackbox Trader's stack box | The trader's stack box by the bench: his tally of the last boats in - and one word on the lid, "WARDEN", scratched out.
loot stackbox Nail*4;Plank*2
prop stackbox loot.refill=0
note marketstores Market stores | The market's stores under their cover: what the traders left when the warden took the summit.
loot marketstores Plank*4;Nail*6
prop marketstores loot.refill=0
note dockcrate Dock master's crate | The dock master's crate at the end of the pier: his ledger, his pipe - and one of the keys to the warden's gate.
loot dockcrate story:dockkey*1;Rope*3;Plank*4
prop dockcrate loot.refill=0
note clerksdesk Prison clerk's desk | The prison clerk's desk, gnawed by rats: his lists of prisoners - and the other key to the warden's gate.
loot clerksdesk story:prisonkey*1;Nail*6;Scrap*3
prop clerksdesk loot.refill=0
note clerkscrate Clerk's crate | The crate beside the clerk's desk: his ink, his seal - and the rats' nest of shredded prisoner lists.
loot clerkscrate Scrap*3;Nail*4
prop clerkscrate loot.refill=0
note wardenstable Warden's table | The warden's table: his ledger of everyone who reached Utopia - each name, and what he took from them.
loot wardenstable Scrap*4;TitaniumIngot*1
prop wardenstable loot.refill=0
note wardenspot Warden's pot | A pot in the warden's yard: the hyenas' scraps - and, under them, a bundle of things he took at the docks.
loot wardenspot Scrap*3;Rope*1
prop wardenspot loot.refill=0
note wardensjar Warden's jar | The warden's jar by the palisade: his own last note - "Two keys, two men I trusted. If the gate opens, it wasn't them."
loot wardensjar Nail*4;TitaniumIngot*1
prop wardensjar loot.refill=0
note wardenschest Warden's chest | The warden's chest: everything he took from those who reached Utopia - the plans for an electric zipline, a big backpack, titanium tools.
loot wardenschest Blueprint_ZiplineToolElectric*1;Blueprint_BackpackAdvanced*1;Blueprint_TitaniumTools*1;TitaniumIngot*3
prop wardenschest loot.refill=0

prop gateL obj.name=wardensgate
prop gateL beh.move=-1.6,0,0.3
prop gateL beh.moveTime=2
prop gateL beh.moveMode=switch
prop gateL beh.use=Unlock the warden's gate
prop gateL if.use=quest|19\ntake|story:dockkey|1\ntake|story:prisonkey|1\ntake|story:keeperkey|1
prop gateL on.use=message||All three keys turn. The gate's leaves grind aside - and behind them, the hyenas rise.\nopen|wardensgate
prop gateL else.use=message||The warden's gate has three locks - the dock master's, the prison clerk's and a third, newer one. Olof's message and his crew's journal said where the keys are.
prop gateR obj.name=wardensgate
prop gateR beh.move=1.6,0,0.3
prop gateR beh.moveTime=2
prop gateR beh.moveMode=switch
prop gateR beh.use=Unlock the warden's gate
prop gateR if.use=quest|19\ntake|story:dockkey|1\ntake|story:prisonkey|1\ntake|story:keeperkey|1
prop gateR on.use=message||All three keys turn. The gate's leaves grind aside - and behind them, the hyenas rise.\nopen|wardensgate
prop gateR else.use=message||The warden's gate has three locks - the dock master's, the prison clerk's and a third, newer one. Olof's message and his crew's journal said where the keys are.

prop docks zone.id=docks
prop docks zone.radius=8
prop docks zone.message=Utopia's docks: market stalls, empty baskets - and a cage, its door hanging open.
prop clerkyard zone.id=clerkyard
prop clerkyard zone.radius=5
prop clerkyard zone.message=The prison clerk's desk - and rats boiling out from under the prison house!
prop yard zone.id=yard
prop yard zone.radius=7
prop yard zone.message=The warden's yard. His table, his chest - and his hyenas, the alpha in front.
