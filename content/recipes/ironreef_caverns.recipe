scatter "Pickup_Landmark_Tree_Palm 1" 4 at 0 0 r=77.0 seed=4590 free=5
scatter "Pickup_Landmark_Tree_Palm 3" 4 at 0 0 r=77.0 seed=4591 free=5
scatter "Pickup_Landmark_WatermelonLandmark" 6 at 0 0 r=77.0 seed=4600 free=3
