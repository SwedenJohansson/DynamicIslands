brush flatten from 22.2 5 to 22 -1 r=3.5 s=20 frames=40 h=34.5
brush flatten from 23.5 6 to 23 -2 r=3 s=20 frames=60 h=34.8
brush flatten from 23.5 6 to 23 -2 r=3 s=20 frames=60 h=34.8
# (and its south-east lip, 1.6 m off at 300 degrees round, local 27 -2)
brush flatten from 24 -1.8 to 26.5 -1.8 r=3 s=20 frames=60 h=31.8
# (the generated palm and bush the flattening left 4 and 1.7 m in the air - CIFloating, 2026-10-20)
clear at 23.7 6 r=9 only=Bush|Fern|Plant|Palm|Flower|Grass
place CaveVine1 - at 41 4 h=13.2
place CaveVine2 - at 43.5 3.5 h=13
place CaveVine3 - at 38.8 5 h=12.8
