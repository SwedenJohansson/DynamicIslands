prop vinedark atmo.fogAmount=0.7
prop vinedark atmo.light=#26301c
prop vinedark atmo.lightAmount=0.85
prop vinedark atmo.particles=fireflies
prop vinedark zone.radius=16
prop halldark atmo.fog=#060505
prop halldark atmo.fogAmount=0.85
