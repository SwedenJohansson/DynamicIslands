# Squall Shelf - the side island of the library's plan The Frozen Horizon (storyline SL12, side)
# A low ice shelf the storms keep pushing back into the lanes: one tent, its guy-lines iced, a stranded traveller's
# things inside and a llama that broke its tether, a polar bear that has found the smell of food. Snow and fog. It comes
# back every nine days until its quest is done. Quest "The Stranded Tent" (8 steps; DEEP 10-24: the weather mast): the tent, the stranded note, the
# polar bear, the tent cache, the llama (the net is in the cache), the weather log.
#
# Built by the recipe player (CIRecipe squall_shelf) through the editor's own operations. Points (metres over the sea):
# the tent's pad at 2 m (r 7 round 0 0), the path up from the south beach at 0 -20; the llama's patch round 10 8.
# (Adapted: the design's "each return a new note" needs a visit counter the editor has not got; the shelf comes back
# with the same tent until its quest is done, as The Returning Islet does without its plate chain.)
include lib_features
include lib_sea
include lib_frozen
include lib_areas
# RESIZE 10-24: Radius 28 -> 60 (Height 4 -> 4), the old content moved 0 -17.6 as one frame (push) so its sea side stays at the coast; the island grows behind it.
new
gen Trees=0 Bushes=0.1 Rocks=0.3 Harvest=0.1 BeachThings=0.2 Grass=0.1
gen Seed=13101 Radius=60 Height=4 Roughness=0.3 Peaks=1 Shape=0 Style=1 BeachWidth=0.35 Cliffs=0.2 PeakShape=0.4
gen Water=0.5 SeaRocks=0.2 SeaFinds=0.3 Sunken=0.1 Hostiles=0 Friendly=0 SeaLife=0.3
generate
push at 0 -17.6

# --- Terrain: the tent's pad, the path up from the beach --------------------------------------------------------------
brush flatten at 0 0 r=7 s=20 frames=200 h=2
brush flatten from 0 -20 to 0 -7 r=2 s=20 frames=80 h=1.4
pop
brush flatten at -9.7 25.2 r=5 s=8 frames=40
origin
clear at -9.7 25.2 r=6
push at 0 -17.6
clear at 0 0 r=7
clear from 0 -20 to 0 -7 r=2.5
# RESIZE 10-24 retest: at the new coast the generator's shore ice (TP_IceShore_Small1, about 1 m over the pad) buried the tent
clear at 0 0 r=24 only=TP_IceShore_Small1
clear from 0 -22 to 0 -7 r=5 only=TP_IceShore_Small1

# --- The tent, its cache, the notes; the llama's patch; ice and snow ----------------------------------------------------
place Balboa_DecorationPrefabBase_SimpleTent tent at 0 1 ground sit yaw=180
place Zone_Trigger tentzone at 0 -2 ground y=1
place Loot_Chest tentcache at 1.4 2.2 ground sit yaw=200
place Note_Paper strandednote at -1.2 -1.4 ground y=0.1 drop yaw=30
place Note_Paper qslcard at 0.9 -1.7 ground y=0.1 drop yaw=150
# (DEEP 10-24: the weather log moved to the weather mast on the hill)
place Placeable_Lantern_Metal - at -2 -1.8 ground drop
place "Box Big" - at 2.6 -1 ground sit yaw=15
place Creature_Llama llama at 10 8 ground
place Creature_PolarBear bear at -16 10 ground
call icerock x=-6 z=6 s=1.6 yaw=30
call icerock x=7 z=-5 s=1.3 yaw=200
call icerock x=-9 z=-8 s=1.1 yaw=95
call icetint al=ice
scatter TP_SnowDrift02 3 at 0 0 r=10 seed=13111 free=3
scatter TP_SnowDrift03 2 at 0 0 r=10 seed=13112 free=3
scatter "Pickup_Landmark_Flower_White" 3 at 8 8 r=4 seed=13113 free=2
call shallows x=0 z=17.6 r=60 deep=4 n=1 seed=13130
scatter VP_CoralBulb04 3 at -42.86 -20.97 r=4 seed=13121 wet free=1
call snowfall x=0 z=0 r=32 al=snow fog=#d0dbe4 fa=0.6
pop

# --- DEEP 10-24 (side island, world frame; before the DISCOVERIES and the FILL so they sit on the new ground): the
# weather hill (N, 20 m) with the traveller's weather mast on it (3 ladders: the weather log is read where it was
# written), the ice cave (NW), the shuttle to the pillar ledge (W, M27 fallback), a second buried treasure.
call fz_mount x=20 z=40 h=20 r=6
call ar_plants_snowy x=20 z=40 r=20 seed=13141
call fz_tower x=20 z=42 h=20 n=3 al=weathermast chest=mastchest zal=mastzone zid=mast_top msg="The weather mast. The anemometer still turns; the whole shelf below you, and the grey lanes it drifts in."
place Note_Book weatherlog at 19.1 39 h=27.35 drop yaw=120
# the ice cave (NW): its mouth south
call ar_cave x=-30 z=40 h=4 yaw=180 al=icecave chest=icecavechest
place Note_Paper cavemark at -29.2 34.6 h=4.5 drop yaw=20
call fz_zone x=-30 z=35 al=icecavezone id=ice_cave r=3 y=1.4 msg="An ice cave out of the wind. The traveller slept here one night - his initials in the ice."
# the shuttle to the pillar ledge (W) - M27 FALLBACK: Raft's snow vehicle (3 bolts: the driver's box + the hatch
# chest) carries the player 24 m out over the lead to a ledge on posts with a cache.
# UPGRADE-AFTER-MECH (M39 drive - still not in ce82976 - / M27 jump): make it a drivable snowmobile and the ledge a jump from the lead's lip.
brush flatten at -46 6 r=12 s=20 frames=300 h=-4
brush seabed at -46 6 r=12 s=10 frames=20
clear at -46 6 r=13
brush flatten at -27 6 r=5 s=20 frames=300 h=4
clear at -27 6 r=5
place TP_SnowVehicle01 shuttle at -28 6 h=4 sit yaw=270
prop shuttle obj.name=shuttle
prop shuttle tint.color=#8a9aa6
prop shuttle tint.amount=0.5
for fx -53.5 -49 1.5
for fz 4.5 7.5 1.5
place Block_Floor_Tier3 pillarledge at $fx $fz h=3.9
next
next
# the ledge's four posts from the lead's bed (-4) to under the floor (3.9) - RETEST post height
place RT_PillarThick pillarledge at -53.8 4.2 h=-4 sy=1.4
place RT_PillarThick pillarledge at -53.8 7.8 h=-4 sy=1.4
place RT_PillarThick pillarledge at -48.7 4.2 h=-4 sy=1.4
place RT_PillarThick pillarledge at -48.7 7.8 h=-4 sy=1.4
place Block_Wall_Fence_Rope pillarledge at -54.25 6 h=3.95 yaw=90
place Loot_Chest stackcache at -53.4 7.7 h=3.95 sit yaw=90
place Placeable_Lantern_Metal - at -53.5 4.3 h=3.95 sit
prop pillarledge tint.color=#4a4038
prop pillarledge tint.amount=0.35
place Note_Sign shuttlesign at -25.6 4.2 ground sit yaw=270
call snowfall x=10 z=30 r=40 al=snow2 fog=#d0dbe4 fa=0.6
call treasure x=40 z=-6 r=6 n=1 seed=13196

# --- DISCOVERIES 10-24 (optional, no quest needs them): camp + note; TP_SnowVehicle02 + chest; hatch with a chest; viewpoint ---
place campfire_1 - at -9.7 25.2 ground sit
place Balboa_DecorationPrefabBase_SimpleTent - at -6.7 27.2 ground sit yaw=177
place "Box Small" - at -11.7 27.7 ground sit
place Note_Paper dnote at -11.7 27.7 ground y=1.6 drop yaw=20
note dnote Sealer's note | (on the furs box, in big careful letters)\n\nSparks -\nThe council says nobody helps you, so this is not help. These are some furs I lost, and some tea that fell out of my boat, and a box they happened to land in.\nThe whole of Saga misses the seven o'clock show. My mother asks every morning why the radio is quiet, and I can't tell her it's because the council is frightened of the Warden. She thinks the penguins took you.\nIf you are cold, the fire pit still takes driftwood. If you get the set going again, play the song about the seal. Not for me. For my mother.\n- Nils, of Saga Drift
place TP_SnowVehicle02 dvan at 23.1 13.9 ground yaw=297
prop dvan tint.color=#7a8a96
prop dvan tint.amount=0.5
place Loot_ChestSmall dwreckchest at 19.1 16.9 ground sit yaw=237
note dwreckchest Driver's box | The driver's box under the seat: bolts, glass, leather.
loot dwreckchest Bolt*2;Glass*2;Leather*2
prop dwreckchest loot.refill=0
call hatchcache x=8.8 z=25.5 r=15 seed=13191 alias=dhatch chest=dhatchchest items=MetalIngot*2;Wool*3;Bolt*2
call vinecache x=25.5 z=-8.8 r=15 seed=13193 chest=dvinechest vines=dvines items=Rope*3;Wool*2;Bolt*3
place Zone_Trigger dview at -23.6 13.1 ground
prop dview zone.id=squall_shelf_view
prop dview zone.radius=7
# REDO 10-24: the traveller buried his tea money where the detector finds it (the detector, from the Floelane, used again)
call treasure x=-30 z=-28 r=12 n=1 seed=13195
prop treasure13195 treasure.loot=TitaniumOre*2;TradeToken*3;MetalOre*2
# DEEP 10-24 (STOPPED 10-24 order issue): the hatch can come before the Decks' headlight - a lantern burns inside it
beside Placeable_Lantern_Metal dhatchlamp dhatchchest d=0.6
prop dhatchlamp obj.name=dhatchlamp
prop dhatchlamp beh.hidden=1
prop dhatch on.use=hide|\nshow|dhatchchest\nshow|dhatchlamp\nmessage||The hatch lifts on a dark hole - a storm lantern still burns on a hook inside, over a chest.
prop dview zone.repeat=never
prop dview zone.message=One tent on the whole shelf, its lines iced - and the wind does not stop for a moment.

# --- FILL 10-24 (RESIZE rework): the bigger island's whole area at Raft-like density - trees, bushes, rocks; free= keeps them
#     off the quest's objects and paths
scatter TP_PineTreeSnowy 22 at 0 0 r=55 seed=13300 free=5
scatter "Pickup_Landmark_Tree_Pine" 10 at 0 0 r=55 seed=13301 free=5
scatter CaravanIsland_SmallRock_1 24 at 0 0 r=55 seed=13302 free=3 ground y=-0.6
scatter "Pickup_Landmark_BerryBush" 6 at 0 0 r=55 seed=13303 free=3

# --- Settings, notes, behaviours, quest ----------------------------------------------------------------------------------
info title=Squall Shelf
info author=Custom Islands
info description=A low ice shelf the storms keep pushing back into the lanes: one tent, a stranded traveller's cache, a llama off its tether and a bear that smells food. It comes back every nine days. The side island of The Frozen Horizon.
island on.arrive=message||A tent on a scrap of ice, guy-lines white with frost. Nobody answers.

note strandednote Stranded note | (pinned to the tent flap, in a hand that loops on every letter)\n\nGood morning, ice! This is Tor Hallen, "Sparks", broadcasting to nobody from the Squall Shelf.\nThe council of Saga Drift put me on a raft for breaking the Warden's silence. One broadcast. Three minutes. I played a song and read out the ice for the woman on 700, and they said that was three minutes too many.\nThe squall took my raft on the third night. I have the tent, the cache, and Bramble - the llama - when she stays.\nA bear comes round at dusk. I go in and keep still. Hardest thing I have ever done, keeping still and quiet.\nIf the shelf drifts near you: the cache is yours. Take Bramble too. She likes being scratched behind the left ear only.
note weatherlog Weather log | WEATHER LOG - SQUALL SHELF (T. Hallen)\n\nDay 1: north wind, snow. Bramble unimpressed.\nDay 3: squall. Raft gone. Bramble still unimpressed.\nDay 6: fog. The shelf turns with the current, nine days round, near as I can count. Built the mast from the raft's last spar to keep my hands busy.\nDay 8: picked up the woman on 700 on the mast's wire. Just a few seconds. "Ice holding at the Whale. Still here." I said "Still here" back, out loud, to nobody. Felt better than a week of soup.\nDay 9: the same lanes again, past Saga Drift. Leaving on foot while the ice holds, out over the ice toward the Whale. If they won't let me talk, I'll go and stand next to someone who does.
note tentcache Tent cache | The cache: hides, wool, eggs, goo - and a net launcher.
loot tentcache Leather*2;Wool*2;Feather*4;Egg*2;ExplosiveGoo*1;NetGun*1;NetCanister*3
prop tentcache loot.refill=0

# --- DEEP 10-24: the mast, the ice cave, the shuttle, the dark hatch's lantern ---
note mastchest Weather mast chest | Sparks' chest by the anemometer: spare vanes, a flask, socks.
loot mastchest Rope*2;Wool*2;MetalIngot*1
prop mastchest loot.refill=0
note cavemark Initials in the ice | (cut in the cave wall)\n\nT.H. - DAY 4. WIND TOO STRONG TO WALK.\nThe old sled on the lip of the shelf runs if you feed it bolts. There's a ledge out over the lead with the sealers' cache on it.\nCaller 1 of the day: a gull. Said a great deal. All of it rude.
note icecavechest Ice cave chest | A sealer's chest frozen into the cave floor.
loot icecavechest Leather*2;Feather*3;Raw_GenericMeat*2
prop icecavechest loot.refill=0
note shuttlesign Old sled | SEALERS' SLED - RUNS TO THE LEDGE AND BACK\nFeed her bolts.
note stackcache Ledge cache | The sealers' cache over the lead: furs and the season's metal.
note qslcard A QSL card for you | (a postcard tucked in the tent cache's lid, a cartoon penguin in headphones on it)\n\nQSL - CONFIRMING OUR CONTACT\nTo: whoever found my tent. From: SQUALL SHELF (temporary studio), Tor Hallen, "Sparks". Band: none. Signal: you, reading this.\n\nThat counts. Contact is contact.\nThank you for taking Bramble. She will pretend she doesn't like you for about a day, and then she will follow you into the sea if you let her. Don't let her.\nIf you see the Warden, tell him there's a man on an ice shelf who still says good morning to it. If you see the woman on 700, tell her somebody heard.\n- Sparks, 73
loot stackcache MetalIngot*3;Leather*3;CopperIngot*2
prop stackcache loot.refill=0
prop treasure13196 treasure.loot=MetalOre*3;CopperOre*2
prop tentzone zone.id=tent
prop tentzone zone.radius=4
prop tentzone zone.message=The tent. Frost on the flap, a note pinned to it.
prop bear creature.count=1
prop bear creature.respawn=0
prop bear creature.zone=tent
prop llama creature.count=1

quest title=The Stranded Tent
quest intro=A tent on the ice shelf. Make for the weather mast on the hill and go and look.
step reach|tent|1|Make for the weather mast on the hill; the tent is on the ice shelf
step read|Stranded note|1|Read the note pinned to the tent
step kill|Polar bear|1|Drive off the polar bear that comes round at dusk
step open|Tent cache|1|Open the tent's cache
step read|A QSL card for you|1|Read the postcard tucked in the cache's lid
step catch|Llama|1|Net Bramble, the traveller's llama
step reach|mast_top|1|Climb the weather hill to the traveller's weather mast
step read|Weather log|1|Read the traveller's weather log at the mast
quest done=Sparks walked out over the ice toward the Whale. The tent, the cache and Bramble are yours now; the shelf will drift on without you.
quest reward=Leather*2;Wool*2;CopperIngot*2

save Squall Shelf
