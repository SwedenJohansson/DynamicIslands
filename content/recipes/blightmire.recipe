# the heron hummock in the north (secret): a low hill, a heron-watcher's box on top
call vd_mount x=-10 z=70 top=12 r=14 a0=250 turns=1 n=30 hb=3
place Loot_ChestSmall bmheron at -10 70 h=12 sit yaw=160
