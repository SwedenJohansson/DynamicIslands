# Blightmire - the seventh island of the library's plan The Last Green World (SL11, Verdance)
# A marsh where the jungle's roots surface and rot: green fog over black pools, grey stumps, black flowers, and on three
# roots a purple growth (Varuna's corals, tinted) that the hyenas and boars will not leave. The Seedkeepers' smelter
# camp stands on a dry hummock in the south. Burn the three roots in the order the blight map marks them; when the last
# goes up, the marsh is cleansed and the root it grew on opens. Quest "The Poisoned Marsh" (11 steps): the hummock, the
# blight map, the electric smelter plans in the camp, three hyenas, the west root burnt, the north root burnt, the
# advanced biofuel extractor plans in the marsh station by it, two boars, the east root burnt (the marsh cleansed), the
# advanced anchor plans in the root cache, the Seedkeeper's confession. Buried in the marsh: titanium.
#
# Built by the recipe player (CIRecipe blightmire) through the editor's own operations. Points (metres over the sea):
# the hummock 2.2 m round 0 -32 (the camp x -3..0, z -36..-33), the roots west -30 0, north 8 22, east 34 -6 (their
# pads 0.8 m), the marsh station by the north root 12 26, the pools 0.4 m under the sea round -12 12 and 20 4.
include lib_sea
include lib_features
include lib_huts
include lib_verdance
new
gen Trees=0.1 Bushes=0.2 Rocks=0.1 Harvest=0.2 BeachThings=0.2
gen Seed=11081 Radius=72 Height=5 Roughness=0.2 Peaks=1 Shape=0 Style=0 PeakShape=0.3 Cliffs=0.1 BeachWidth=0.7
gen Water=0.5 SeaRocks=0.3 SeaFinds=0.4 Sunken=0.2 Hostiles=0 Friendly=0.1 SeaLife=0.3
generate

# --- Terrain: the hummock, the root pads, the black pools -------------------------------------------------------------
brush flatten at 0 -32 r=8 s=20 frames=200 h=2.2
brush flatten at -30 0 r=5 s=20 frames=150 h=0.8
brush flatten from 8 22 to 12 26 r=5 s=20 frames=150 h=0.8
brush flatten at 34 -6 r=5 s=20 frames=150 h=0.8
brush flatten at -12 12 r=7 s=20 frames=150 h=-0.4
brush flatten at 20 4 r=6 s=20 frames=150 h=-0.4
brush sand at -12 12 r=9 s=8 frames=30
brush sand at 20 4 r=8 s=8 frames=30
origin
clear at 0 -32 r=8
clear at -30 0 r=5
clear from 8 22 to 12 26 r=5
clear at 34 -6 r=5
clear at -12 12 r=7
clear at 20 4 r=6

# --- The smelter camp on the hummock: a shelter, the camp chest, the fire, the blight map, the confession (hidden) ----
push at -3 -36 h=2.2
call shelter w=2 d=2 y=0.1
place Loot_Chest smeltercamp at 1.5 2.2 y=0.1 sit yaw=180
place "Box Small" - at 0.7 0.8 y=0.1 sit
place Note_Paper confession at 0.7 0.8 y=0.8 drop yaw=15
pop
place campfire_1 - at 4 -30 ground sit
place Note_Sign blightmap at -5 -27 ground sit yaw=200
place Zone_Trigger hummockzone at 0 -32 ground
place Zone_Atmosphere marshfog at 0 0 ground y=2

# --- The three poisoned roots: a rotten log under purple growth, a fire hidden in each until it is burnt -------------
place Log root1log at -30 0 ground sit yaw=30 scale=1.6
call blight x=-30 z=0 al=root1
place campfire_1 fire1 at -30 0 ground sit
place Log root2log at 8 22 ground sit yaw=120 scale=1.6
call blight x=8 z=22 al=root2
place campfire_1 fire2 at 8 22 ground sit
place Log root3log at 34 -6 ground sit yaw=75 scale=1.6
call blight x=34 z=-6 al=root3
place campfire_1 fire3 at 34 -6 ground sit
place Loot_Chest rootcache at 36.5 -4 ground sit yaw=220

# --- The marsh station by the north root; the hyenas and boars; Burr by a vine-choked cache ---------------------------
place Loot_Crate marshstation at 12 26 ground sit yaw=200
place "Box Big" - at 13.5 24 ground sit yaw=30
place Creature_Hyena hyenas at -14 -12 ground
prop hyenas creature.count=3
prop hyenas creature.respawn=0
place Creature_Boar boars at 26 12 ground
prop boars creature.count=2
prop boars creature.respawn=0
call vinecache x=-30 z=-30 r=8 seed=11082 chest=burrchest vines=burrvines items=Seed_Flower_Black*2;ExplosiveGoo*1;Rope*2
place Creature_Goat burr at -26 -26 ground
prop burr creature.count=1
prop burr creature.respawn=0

# --- Grey stumps, black flowers, clay pits; titanium buried in the marsh; the shallows ------------------------------
scatter Tree_Stump 6 at 0 0 r=40 seed=11083 free=3 as=stumps
scatter Pickup_Landmark_Flower_Black 8 at 0 4 r=36 seed=11084 free=2
scatter "Pickup_Landmark_Clay 1" 2 at -20 -18 r=6 seed=11085 free=2
scatter "Pickup_Landmark_Clay 2" 2 at 22 -24 r=6 seed=11086 free=2
call treasure x=10 z=-6 r=14 n=1 seed=11051
prop treasure11051 treasure.loot=TitaniumOre*3
call shallows x=0 z=0 r=84 deep=5 n=2 seed=11087

# --- Settings, story items, notes, behaviours, quest ----------------------------------------------------------------
info title=Blightmire
info author=Custom Islands
info description=A rotting marsh of black pools and grey stumps, where a purple growth covers three surfaced roots. Burn them in order. The seventh island of The Last Green World.
island on.arrive=message||Green fog over black water. The roots here have surfaced, and something purple grows on them.

story burnt|Root burnt|Note_Paper|A poisoned root of the marsh, burnt clean.

prop stumps tint.color=#8a8a84
prop stumps tint.amount=0.5
prop root1 tint.color=#8a3ac0
prop root1 tint.amount=0.75
prop root2 tint.color=#8a3ac0
prop root2 tint.amount=0.75
prop root3 tint.color=#8a3ac0
prop root3 tint.amount=0.75
prop root1log tint.color=#3a2a30
prop root1log tint.amount=0.6
prop root2log tint.color=#3a2a30
prop root2log tint.amount=0.6
prop root3log tint.color=#3a2a30
prop root3log tint.amount=0.6
prop marshfog atmo.fog=#6a8a40
prop marshfog atmo.fogAmount=0.25
prop marshfog atmo.light=#c0e080
prop marshfog atmo.lightAmount=0.2
prop marshfog atmo.particles=mist
prop marshfog zone.radius=60

prop fire1 beh.hidden=1
prop fire2 beh.hidden=1
prop fire3 beh.hidden=1
prop rootcache beh.hidden=1
prop confession beh.hidden=1

prop root1 obj.name=root1
prop root1 beh.use=Set the growth alight
prop root1 if.use=!signal|root1
prop root1 on.use=signal||root1\ngive||story:burnt*1\nhide|root1\nshow|fire1\nmessage||The growth hisses, curls and burns down to the wood. The fog thins a little.
prop root2 obj.name=root2
prop root2 beh.use=Set the growth alight
prop root2 if.use=signal|root1\n!signal|root2
prop root2 on.use=signal||root2\ngive||story:burnt*1\nhide|root2\nshow|fire2\nmessage||The second root burns. Somewhere out in the marsh, something squeals.
prop root2 else.use=message||The growth only smoulders. The map says: west root first.
prop root3 obj.name=root3
prop root3 beh.use=Set the growth alight
prop root3 if.use=signal|root2\n!signal|cleansed
prop root3 on.use=signal||cleansed\ngive||story:burnt*1\nhide|root3\nshow|fire3\nshow|rootcache\nshow|confession\nmessage||The last root goes up with a roar. The fog lifts off the marsh - and the burnt root splits open over a chest.
prop root3 else.use=message||The growth only smoulders. The map says: west, then north, then east.
prop burrvines on.use=hide|\nshow|burrchest\nmessage||Burr butts through the vines - he found it: a Seedkeeper's stash.

note blightmap Blight map | BLIGHT MAP - MARSH STATION\n\nThree roots up through the marsh, all three grown over.\nBurn them in order or the growth runs back along the root:\n  1. WEST   2. NORTH   3. EAST\n\nThe dogs nest on the west side. Boars on the east.
note confession Seedkeeper's confession | To whoever burns the last root -\n\nWe made it. The growth. It was meant to feed the trees through the roots, to green the whole land faster than the flood could drown it.\n\nIt fed on the roots instead.\n\nThe Heart is where it started. Forgive us. - M.
note smeltercamp Smelter camp chest | The smelter camp's chest: the plans of a smelter that runs on power.
note marshstation Marsh station locker | The marsh station's locker: an advanced extractor's plans and the root samples, sealed.
note rootcache Root cache | A chest the root had grown round: an anchor's plans, and the Seedkeepers' mark on the lid.
loot smeltercamp Blueprint_SmelterElectric*1;MetalIngot*2;CopperIngot*1
prop smeltercamp loot.refill=0
loot marshstation Blueprint_BiofuelExtractorAdvanced*1;ExplosiveGoo*1
prop marshstation loot.refill=0
loot rootcache Blueprint_AnchorStationaryAdvanced*1;MetalIngot*2
prop rootcache loot.refill=0

prop hummockzone zone.id=hummock
prop hummockzone zone.radius=6
prop hummockzone zone.message=The hummock. Dry ground, a cold smelter camp, a map nailed to a post.

quest title=The Poisoned Marsh
quest intro=Green fog and dead wood. The Seedkeepers' camp is on the dry hummock to the south.
step reach|hummock|1|Go to the dry hummock
step read|Blight map|1|Read the blight map
step blueprint|Blueprint_SmelterElectric|1|Take the electric smelter plans from the camp chest
step kill|Hyena|3|Drive off the three hyenas
step collect|story:burnt|1|Burn the west root
step collect|story:burnt|2|Burn the north root
step blueprint|Blueprint_BiofuelExtractorAdvanced|1|Take the advanced extractor plans from the marsh station
step kill|Warthog|2|Drive off the two boars
step collect|story:burnt|3|Burn the east root
step blueprint|Blueprint_AnchorStationaryAdvanced|1|Take the advanced anchor plans from the root cache
step read|Seedkeeper's confession|1|Read the Seedkeeper's confession in the camp
quest done=The growth started at the Heart. The Seedkeepers' last camp is on the climb to it - band 900.
quest reward=TitaniumOre*1;Seed_Flower_Black*2

# names for the show/hide actions (actions find objects by obj.name)
prop burrchest obj.name=burrchest
prop confession obj.name=confession
prop fire1 obj.name=fire1
prop fire2 obj.name=fire2
prop fire3 obj.name=fire3
prop rootcache obj.name=rootcache
save Blightmire
