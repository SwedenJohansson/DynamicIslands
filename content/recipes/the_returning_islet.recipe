# The Returning Islet - the side island of the library's plan The Lullaby Frequency (SL1, horror)
# One small grey rock, one palm, no reef: a fisherman's hut on stilts with one door, and inside a table set for four -
# chairs, plates, a candle. It comes back every two days until its quest is done. Each time a plate holds a note it did
# not hold before: each note is hidden at the start and the one before it shows it a little later. Quest "Supper for
# Four" (5 steps): the notes on plates 1 to 4, then the hatch in the floor and the box under the hut.
# RESIZE + DEEP 10-25 (deep pass, The Lullaby Frequency): Radius 26 -> 58, still a bare grey rock with one palm and no
# reef; the hut stays in the middle, its path runs on down to the south beach. New: the Watch Rock in the north-west (a
# 20 m climb to the fisherman's ruined watch hut; his pry bar is up there, and the floor hatch is nailed down, so it only
# opens once you have climbed for it), the family's net shed drowned in a hole off the south-east shore (an air pocket;
# the net mender's note), the children's cave in the north-east, two buried treasures. Quest 5 -> 11 steps. Voices:
# fisherman Tobias Grey, net mender Hanne Grey, their boy Ned.
#
# Built by the recipe player (CIRecipe the_returning_islet) through the editor's own operations.
include lib_sea
include lib_huts
include lib_features
include lib_areas
include lib_highwater
new
# (nature: an empty rock - no trees but one palm, Rocks Like Raft, nothing to gather)
gen Trees=0 Bushes=0.08 Rocks=0.43 Harvest=0 BeachThings=0.2
gen Seed=1204 Radius=58 Height=5 Roughness=0.3 Peaks=1 Shape=0 Style=0 PeakShape=0.3 Cliffs=0.1 BeachWidth=0.5
gen Water=0.5 SeaRocks=0.3 SeaFinds=0.3 Sunken=0.2 Hostiles=0 Friendly=0 SeaLife=0.2
generate

# --- Terrain: the hut's pad at 2.5 m, the path up from the south beach ---------------------------------------------
brush flatten at 0 0 r=6 s=20 frames=80 h=2.5
brush smooth from 0 -4 to 0 -16 r=3 s=6 frames=20
# --- DEEP 10-25 terrain: the path on down to the south beach, the Watch Rock (north-west, summit 20 m, base r 16) and
# its path, the net shed's hole (south-east, -12 m); the cave's and the watch hut's pads come with their macros
brush smooth from 0 -16 to 0 -50 r=3 s=6 frames=40
call hw_mount x=-26 z=22 b=16 h=20
call hw_trail x=-26 z=22 b=16 h=20 a0=130.24 turn=300 n=30 h0=3
brush flatten at -26 22 r=9 s=20 frames=400 h=20
call hw_basin x=30 z=-28 r=12 h=-12
# (agent Q 10-30, REACH: the basin's rim stood 1.7 m over the water all round - divers to the net shed had no way back out:
# a shelf of steps up its south lip, from 1 m under the water up to the bank, 0.6 m a step)
brush flatten at 32.5 -38.6 r=2.2 s=20 frames=200 h=-1.0
brush flatten at 32.5 -39.6 r=2.2 s=20 frames=200 h=-0.4
brush flatten at 32.5 -40.6 r=2.2 s=20 frames=200 h=0.2
brush flatten at 32.5 -41.6 r=2.2 s=20 frames=200 h=0.8
brush flatten at 32.5 -42.6 r=2.2 s=20 frames=200 h=1.4
clear from 32.5 -38.6 to 32.5 -42.6 r=3.2 body
origin
clear at 0 0 r=7
clear from 0 -4 to 0 -18 r=2.5
clear from 0 -18 to 0 -50 r=2.5
call ar_cave x=28 z=30 h=3 yaw=180 al=childrock chest=childchest
call ar_ruin x=-26 z=22 h=20 yaw=0 w=3 d=2 al=watchhut

# --- The hut on stilts (deck 2.6 m over the pad), its ladder to the south; the table for four ----------------------
push at -2.25 -2.25 h=2.5
call stilt_hut y=2.6
place "Table Office" - at 2.25 2.7 y=3.6 sit drop yaw=0
place Placeable_Chair_Wood - at 1.7 1.75 y=3.4 sit drop yaw=0
place Placeable_Chair_Wood - at 2.8 1.75 y=3.4 sit drop yaw=0
place Placeable_Chair_Wood - at 1.7 3.65 y=3.4 sit drop yaw=180
place Placeable_Chair_Wood - at 2.8 3.65 y=3.4 sit drop yaw=180
place Plate_01 - at 1.7 2.45 y=4.2 sit drop
place Plate_01 - at 2.8 2.45 y=4.2 sit drop
place Plate_01 - at 1.7 2.95 y=4.2 sit drop
place Plate_01 - at 2.8 2.95 y=4.2 sit drop
place Candle_03 - at 2.25 2.7 y=4.2 sit drop
place Note_Paper plate1 at 1.7 2.45 y=4.4 sit drop yaw=5
place Note_Paper plate2 at 2.8 2.45 y=4.4 sit drop yaw=-10
place Note_Paper plate3 at 1.7 2.95 y=4.4 sit drop yaw=170
place Note_Paper plate4 at 2.8 2.95 y=4.4 sit drop yaw=185
place TangaroaHatchRoom_Hatch floorhatch at 3.6 0.9 y=2.62 yaw=0
place Loot_Chest hatchbox at 3.4 1.6 y=0.6 sit drop yaw=0
pop
place "Pickup_Landmark_Tree_Palm 2" - at 7 5 ground
call shallows r=66 deep=5 n=2 seed=30808

# --- DEEP 10-25: the Watch Rock - its foot and top as zones, the fisherman's ruined watch hut on top (the pry bar) ------
call hw_zone x=-13.02 z=11.02 al=hillfootz id=hillfoot r=5 msg="The Watch Rock. Steps cut in the grey stone go up to a little hut on the top, where a fisherman could watch for his boat."
call hw_zone x=-26 z=22 al=hilltopz id=hilltop r=8 h=1 msg="The top of the Watch Rock, and the watch hut, its roof gone. From here the sea is empty in every direction. A candle stub on the sill is still warm."
place Note_Paper tobiasnote at -26.75 22 h=21.1 drop yaw=10
# (agent Q 10-30, REACH: the chest stood hard in the hut's corner - out of reach from inside: a step out of the corner)
place Loot_Chest tobiaschest at -25.3 22.6 h=20.1 drop yaw=180
loot tobiaschest story:prybar*1;Rope*2;Nail*4;Cooked_Mackerel*1
note tobiaschest Watch hut chest | The fisherman's chest in the watch hut: rope, nails, dried fish - and a short iron pry bar, its end bent from lifting deck planks.
prop tobiaschest loot.refill=0
place Zone_Sound watchhum at -26 22 h=22
prop watchhum sound.event=event:/raft/radar/radar_humm
prop watchhum sound.volume=0.3
prop watchhum zone.radius=10
scatter "Pickup_Landmark_Rock 1" 4 at -26 22 r=16 seed=30803 free=2
scatter Bush 2 at -26 22 r=16 seed=30804 free=1
scatter "Pickup_Landmark_Rock 1" 3 at 0 -30 r=14 seed=30805 free=2
call treasure x=-21 z=17 r=14 n=1 seed=30806 kind=0
prop treasure30806 treasure.loot=TitaniumOre*2;Scrap*2;Bolt*1
# --- The net shed (south-east), drowned in a hole 12 m down, an air pocket: Hanne's note, the back room's chest -------
call hw_sunkhouse x=30 z=-28 h=-12 yaw=0 a=netshed chest=netchest air=netair bub=netbub dal=netdoor
call hw_zone x=30 z=-28 al=netzone id=netshed r=7 h=1 msg="The family's net shed, 12 m down. Nets on hooks, mended and folded, floats in a basket. Its front room still holds air."
place Note_Paper hannenote at 30.6 -30.2 h=-11.7 drop yaw=20
loot netchest Rope*3;Nail*6;MetalIngot*1;Plastic*2
prop netchest loot.refill=0
note netchest Net shed chest | The net mender's chest: twine, nails, floats and an iron ingot for the weights.
place Creature_PufferFish netpuffers at 24 -22 h=-8
prop netpuffers creature.count=1
# --- The children's cave (north-east): a secret -------------------------------------------------------------------------
call hw_zone x=28 z=25 al=cavez id=childcave r=4 msg="A little cave in the rock, the children's den. Shells in rows on a ledge, and two small pairs of boots, dry."
# (agent Q 10-30, REACH: the note lay where nobody could stand by it: on the den's floor)
place Note_Paper nednote at 28 25.4 h=3.45 drop yaw=180
loot childchest Scrap*2;Rope*1;Battery*1;CopperOre*2
prop childchest loot.refill=0
note childchest Den box | A tin in the den: string, scrap, a torch battery and two lumps of copper ore - a boy's treasures.
call treasure x=34 z=21 r=14 n=1 seed=30807 kind=0
prop treasure30807 treasure.loot=MetalOre*3;CopperOre*2;Hinge*1

# --- Settings, story items, notes, behaviours, quest ----------------------------------------------------------------
info title=The Returning Islet
info author=Custom Islands
info description=A grey rock with one palm and a fisherman's hut on stilts, a table inside set for four; a watch hut on the rock above it, a net shed drowned off the shore, the children's cave. It keeps coming back. The side island of The Lullaby Frequency.
island on.arrive=message||The same small rock. The same hut. A candle is lit inside, and no one is there.

story prybar|Fisherman's pry bar|Bolt|A short iron pry bar from the watch hut on the Watch Rock, its end bent from lifting deck planks.
story crystal|Spare Receiver crystal|Placeable_Lantern_Metal|A Receiver crystal wrapped in a napkin, from the box under the hut. It hums faintly at night.

note plate1 Plate 1 | We waited supper for you.
note plate2 Plate 2 | You came back. We knew you would. Your chair is the one facing the sea.
note plate3 Plate 3 | The soup went cold three nights ago. We keep it warm for you anyway.
note plate4 Plate 4 | Sit down. She's singing.\n\n(Under the plate, scratched in the wood: THE HATCH. FATHER'S BAR IS ON THE WATCH ROCK)
note tobiasnote Fisherman Tobias Grey's note | T. GREY - THE WATCH HUT\n\nI nailed the hatch down myself. What is in the tin is for the children, after, and I will not have her take it.\n\nEvery night now the boat comes in on its own with no one at the oars, and every night the table is laid when I get down from here, four plates, the candle lit, and Hanne smiling at me as if I had been away a long time.\n\nThe children say the lady under the sea is singing them to sleep. They say we are all going to her, the whole rock, and coming back, and going again, and that it does not hurt.\n\nI am leaving my bar up here. If you are reading this, you have come back too. Take it down and open the hatch, and take the tin away with you, a long way away.
note hannenote Net mender Hanne Grey's note | (Written on the back of a tide table, dry in the air pocket)\n\nThe shed went under on a calm night with no wind at all. The sea just rose up round the rock, slow, like a blanket being pulled up.\n\nI was mending. I am still mending. There is air enough under the roof, and the nets want doing, and the children will be hungry when they come in.\n\nI can hear Tobias up on the Watch Rock, calling for the boat. He does not understand yet. We are not lost. We are only being kept.\n\nWhen the rock comes up again I will lay the table. Four plates. One for each of us, and none for you. You will have to bring your own.
note nednote Ned Grey's note | (Pencil, a boy's big letters, on the inside of a biscuit tin lid)\n\nthis is our den. no grownups.\n\nthe lady sings to us from under the rock. molly can hear her best. she says the lady has a light on her head and she is lonely and she is our new mother when we go under.\n\nmother says dont be silly and lays the table.\n\nwe go under every two days. it is cold for a bit and then it is warm.\n\nwhen we come back up our boots are always dry. that is how you know it is magic.
note hatchbox Floor hatch | Under the hatch, in a tin box, wrapped in a napkin: the family's savings - and a spare Receiver crystal.
loot hatchbox story:crystal*1;TitaniumIngot*1;MetalIngot*3;CopperIngot*2;Canteen_Water*1
prop hatchbox loot.refill=0
prop hatchbox obj.name=hatchbox
prop hatchbox beh.hidden=1

prop plate1 obj.name=plate1
prop plate1 if.read=!signal|ri_p1
prop plate1 on.read=signal||ri_p1\nwait|20\nshow|plate2
prop plate2 obj.name=plate2
prop plate2 beh.hidden=1
prop plate2 if.read=!signal|ri_p2
prop plate2 on.read=signal||ri_p2\nwait|20\nshow|plate3
prop plate3 obj.name=plate3
prop plate3 beh.hidden=1
prop plate3 if.read=!signal|ri_p3
prop plate3 on.read=signal||ri_p3\nwait|20\nshow|plate4
prop plate4 obj.name=plate4
prop plate4 beh.hidden=1
prop plate4 on.read=signal||ri_p4
prop floorhatch obj.name=floorhatch
prop floorhatch if.use=signal|ri_p4\nhas|story:prybar|1
prop floorhatch on.use=hide|\nshow|hatchbox\nsound||event:/amb/wreck_creaks\nmessage||The hatch lifts. Under the deck, on the sand between the stilts, a tin box.
prop floorhatch else.use=message||The hatch is nailed down. Not yet - and you would need a bar to prise it up.

quest title=Supper for Four
quest intro=A hut on stilts and a table set for four. Climb up and look at the plates.
step read|Plate 1|1|Climb into the stilt hut and read the first plate on the table
step read|Plate 2|1|Come back for the second plate
step read|Plate 3|1|Come back for the third plate
step read|Plate 4|1|Come back for the fourth plate
step reach|hillfoot|1|Find the steps up the Watch Rock, the rock with the watch hut
step reach|hilltop|1|Climb the Watch Rock to the fisherman's watch hut
step read|Fisherman Tobias Grey's note|1|Read the fisherman's note in the watch hut
step collect|story:prybar|1|Take the fisherman's pry bar from his chest
step reach|netshed|1|Dive to the family's drowned net shed in the water by the islet
step read|Net mender Hanne Grey's note|1|Breathe in the net shed's front room and read the net mender's note
step open|Floor hatch|1|Open the hatch in the floor and the box under the hut
quest done=The table is empty now. The islet will not come back.
quest reward=TitaniumIngot*1;Cooked_Mackerel*2

save The Returning Islet
