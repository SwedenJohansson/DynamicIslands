# The Lockkeeper's Isle - a new island of the library, small: an island to learn from (GUIDE chapter 17)
# A low green island with one flat top (3 m): the keeper's hut, his strongbox shed with a keypad code lock, a goat pen
# and a lookout. Each place has a sign that names the editor feature it shows and where to look for it in the editor.
# Features shown here and on no other library island: a keypad code lock (lock.code), several quests on one island
# (quest2, quest3), the island rules (regrow days, comes after km, level up) and an island the quest brings
# (questbring: Lantern Spire, the flying island, comes in the north when the main quest is done).
# Quests: "The Keeper's Strongbox" (3 steps: land, read the keeper's note, open the strongbox behind the code lock);
# "Strays" (catch the two goats with the net launcher from the tack chest); "The Keeper's Log" (read his three pages).
#
# Built by the recipe player (CIRecipe lockkeepers_isle) through the editor's own operations. Points: the landing beach
# at 0 -33 (0.8 m) and its path up to the top (3 m, r 20 round 0 0); the keeper's hut (Balboa's shack) at -10 6; the
# strongbox shed x 5..8, z 2..5, its door at 7.25 2; the goat pen x 9..18, z -15..-6; the lookout at 0 15.
include lib_huts
include lib_sea
new
gen Trees=0.12 Bushes=0.3 Rocks=0.25 Harvest=0.1 BeachThings=0.3
gen Seed=9171 Radius=38 Height=7 Roughness=0.25 Peaks=1 Shape=0 Style=3 BeachWidth=0.45 Cliffs=0.1 PeakShape=0.3
gen Water=0.5 SeaRocks=0.3 SeaFinds=0.3 Sunken=0.3 Hostiles=0 Friendly=0 SeaLife=0
generate

# ===== Terrain: the flat top at 3 m, the landing beach in the south and the path up ===================================
for sx -16 16 8
for sz -16 16 8
brush flatten at $sx $sz r=7 s=20 frames=60 h=3
next
next
brush flatten at 0 -33 r=4 s=20 frames=40 h=0.8
for i 0 8
brush flatten at 0 {-32+$i*1.6} r=2.6 s=20 frames=25 h={0.8+$i*0.275}
next
brush grass at 0 0 r=19 s=20 frames=20
brush sand from 0 -31 to 0 -19 r=1.4 s=20 frames=20
clear at 0 0 r=21
clear from 0 -33 to 0 -19 r=3

# ===== The landing: mooring post, the first log page, the welcome sign ================================================
place ReefHuts_Pillar1 - at -2.5 -34 ground
place Note_Papers log1 at -2.5 -33 h=1 drop yaw=10
place Note_Sign welcome at 2.5 -31 ground sit yaw=180
place Zone_Trigger landing at 0 -33 h=1.8

# ===== The keeper's hut: his note on the board by the door, a table with the second log page ==========================
place Balboa_Shack keepershut at -10 6 h=2.65
place Note_Sign keepersnote at -5 1 ground sit yaw=180
place Placeable_Table_Basic - at -4 9 ground sit yaw=90
place Note_Papers log2 at -4 9 h=4.1 drop yaw=25
place Note_Sign sign_quests at -3 -3 ground sit yaw=180

# ===== The strongbox shed: four walls with a door, the keypad by the door inside, the strongbox (shown by the code) ====
push at 5 2 h=3
call floors w=2 d=2 y=0.1
place Block_Wall_Wood - at 0.75 0 y=0.1
place Block_Wall_Wood - at 0.75 3 y=0.1
place Block_Wall_Wood - at 2.25 3 y=0.1
place Block_Wall_Wood - at 0 0.75 y=0.1 yaw=90
place Block_Wall_Wood - at 0 2.25 y=0.1 yaw=90
place Block_Wall_Wood - at 3 0.75 y=0.1 yaw=90
place Block_Wall_Wood - at 3 2.25 y=0.1 yaw=90
call corners w=2 d=2
roof 2 2 at 0 0 y=0.1 wood
place RT_PowerBox keypad at 2.6 0.6 y=0.1 sit yaw=270
place Loot_Chest strongbox at 1.2 2.4 y=0.1 sit yaw=180
pop
place Note_Sign sign_lock at 9.5 1 ground sit yaw=180

# ===== The goat pen (quest 2): fences, the tack chest with the net launcher, two goats loose on the top ================
line Balboa_DecorationPrefabBase_Fence_Mid from 9 -15 to 18 -15 step=2.98
line Balboa_DecorationPrefabBase_Fence_Mid from 9 -6 to 13 -6 step=2.98
line Balboa_DecorationPrefabBase_Fence_Mid from 9 -15 to 9 -6 step=2.98
line Balboa_DecorationPrefabBase_Fence_Mid from 18 -15 to 18 -6 step=2.98
place Loot_Chest tackchest at 6 -9 ground sit yaw=90
place "Box Small" feedbin at 16.5 -13.5 ground sit
place Note_Sign sign_quest2 at 6 -12.5 ground sit yaw=180
place Creature_Goat goats at -10 -12 ground

# ===== The lookout (island rules, the island it brings): a bench, the third log page, the signs =======================
place Bench_01 - at 0 15 ground sit
place Note_Papers log3 at 0.6 15 h=3.6 drop yaw=-20
place Note_Sign sign_rules at -3 13 ground sit yaw=180
place Note_Sign sign_bring at 3 13 ground sit yaw=180
place Zone_Trigger lookout at 0 15 h=4

# ===== Friendly animals, Raft's finds in the shallows ==================================================================
place Creature_Dolphin dolphins at 34 -34 h=-2
call shallows r=44 deep=5 n=1
prop goats creature.count=2
prop dolphins creature.count=2

# --- Things to gather: palms and flowers on the slopes, berries by the hut ------------------------------------------------
scatter "Pickup_Landmark_Tree_Palm" 3 at 0 0 r=30 seed=7101 free=5
scatter "Pickup_Landmark_Flower_White" 2 at 0 0 r=24 seed=7102 free=3
scatter "Pickup_Landmark_Flower_Blue" 2 at 0 0 r=24 seed=7103 free=3
scatter "Pickup_Landmark_BerryBush" 3 at -10 -6 r=8 seed=7104 free=3

# ===== Settings, island rules, notes, behaviours, three quests, the island it brings =================================
info title=The Lockkeeper's Isle
info author=Custom Islands
info description=An island to learn from. The old lockkeeper left his strongbox behind a keypad - the code is on his note. Three quests on one island, a code lock, island rules and an island the quest brings, each place with a sign that says what it shows and where to find it in the editor.
island on.arrive=message||A low green island with a tidy hut, a shed and a goat pen. Signs everywhere - someone wanted visitors to understand this place.
island rules.regrow=3
island rules.notbefore=8
island rules.levels=on

note welcome Welcome - an island to learn from | Every place on this island has a sign like this one. Each sign names an editor feature and says where to see how it is made.\n\nOpen this island in the editor (download it from the island library, then EDITOR - Open), click a thing to select it and read its settings in the object panel.\n\nThis sign: a Note_Sign. Its title and text are in the object panel when you select it.
note keepersnote Keeper's note | (pinned by the hut door)\n\nGone to the mainland for the winter. The strongbox is in the shed - the keypad code is 2741. Take what you need.\n\nThe goats are loose again. The net launcher is in the tack chest by the pen.\n- Aldo, lockkeeper
note sign_quests Sign: three quests on one island | This island has three quests: the main one (The Keeper's Strongbox) and two more (Strays, The Keeper's Log). The quest bar shows the one you are on; the journal lists all three.\n\nIn the editor: Island tab - Edit quest... - the buttons at the top switch between the quests. Each quest has its own steps, reward and story items.
note sign_lock Sign: keypad code lock | The shed's power box is locked with a keypad code. Use it, type the code, and its "use" event runs: here it shows the strongbox.\n\nIn the editor: select the power box in the shed. Behaviour & events...: the Keypad code field (2741) and the use event (show strongbox). The strongbox itself starts hidden.
note sign_quest2 Sign: catch quest | Quest 2, Strays: catch the two goats with the net launcher from the tack chest. A catch step counts the island's own animals of one kind.\n\nIn the editor: select the goats (a creature spot, count 2), then Island tab - Edit quest... - its second quest.
note sign_rules Sign: island rules | This island has three island rules (Island tab - Rules): its finds grow back after 3 days; it only comes after 8 km of sailing; and it keeps the island levels on (the island levels up with the world).\n\nNone of these show here - they change when and how the island comes.
note sign_bring Sign: an island the quest brings | Finish the main quest and look north: Lantern Spire, a flying island, comes about 400 m away.\n\nIn the editor: Island tab - Edit quest... - When the quest is done, bring a new island: a saved island (Lantern Spire), how far (400 m) and which way (north).
note log1 Keeper's log, page 1 | Day 1. The new strongbox arrived. A keypad on it, four digits. I picked my mother's birthday and wrote it on the note by the door, because I will forget it.
note log2 Keeper's log, page 2 | Day 40. The goats have learnt to open the pen. I have not learnt to close it.
note log3 Keeper's log, page 3 | Day 90. From the lookout I saw a light in the sky to the north, high over the water, where nothing should be. Some nights it is there and some nights not.
note strongbox Keeper's strongbox | The keeper's strongbox: his savings, his tools - and a lantern wick, still oiled.
loot strongbox Nail*12;Scrap*6;MetalIngot*3;TradeToken*6;Placeable_Lantern_Basic*1
prop strongbox loot.refill=0
note tackchest Tack chest | Rope, a feed sack - and the net launcher.
loot tackchest NetGun*1;NetCanister*4;Rope*2

prop keypad obj.name=keypad
prop keypad beh.use=Type the code
prop keypad lock.code=2741
prop keypad on.use=sound||event:/exploring/obstacles/keypad/keypad_correct\nmessage||The keypad beeps twice and the lid of a strongbox clicks open behind it.\nshow|strongbox
prop strongbox obj.name=strongbox
prop strongbox beh.hidden=1

prop landing zone.id=landing
prop landing zone.radius=4
prop landing zone.message=The landing. A mooring post - with a page tied to it - and a sign.
prop lookout zone.id=lookout
prop lookout zone.radius=4
prop lookout zone.message=The lookout: a bench, and the whole island below you. To the north, only sea.

quest title=The Keeper's Strongbox
quest intro=A tidy island with signs everywhere. The keeper left a note by his hut door.
step reach|landing|1|Land on the Lockkeeper's Isle
step read|Keeper's note|1|Read the keeper's note by his hut
step open|Keeper's strongbox|1|Open the strongbox in the shed - the keypad wants a code
quest done=The strongbox is open. From the lookout, a light shows in the north, high over the water.
quest reward=Nail*6;Plank*6

quest2 title=Strays
quest2 intro=The keeper's two goats are loose on the island.
step2 catch|Goat|2|Catch the two goats with the net launcher from the tack chest
quest2 done=Both goats are back in the pen - for now.
quest2 reward=Wool*2;Rope*2

quest3 title=The Keeper's Log
quest3 intro=The keeper's log is scattered over the island, one page at a time.
step3 read|Keeper's log, page 1|1|Read the first log page, at the landing
step3 read|Keeper's log, page 2|1|Read the second log page, by the hut
step3 read|Keeper's log, page 3|1|Read the third log page, at the lookout
quest3 done=You know the keeper a little now - and his light in the north.
quest3 reward=Cooked_GenericMeat*2

questbring quest-done | island:Lantern Spire | quest:self | near:self:400:north | High over the water to the north, a light burns on an island that floats in the air. | Lantern Spire

save The Lockkeeper's Isle
