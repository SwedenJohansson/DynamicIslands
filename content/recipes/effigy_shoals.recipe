# Effigy Shoals - the third island of the library's plan The Lullaby Frequency (SL1, horror), unlocked on day eight
# Three low sandbars in a ring round a sandy middle, cut apart by three shallow channels. Thirty straw effigies of the
# Quiet Choir stand on them, every one facing the middle; there are no buildings at all. Each effigy is there twice: the
# second set faces the landing beach and is hidden - stepping into the circle swaps the sets once, so the effigies have
# all turned to face you. Quest "Count Them Again" (5 steps): the landing, the tide marker, the circle, the choir hymn
# sheet at the tallest effigy's feet (a story item Gannet Rock's pit gate asks for), "Who made them" (note 3: the plan's
# done-when).
# RESIZE + DEEP 10-25 (deep pass, The Lullaby Frequency): Radius 48 -> 80, as big as Raft's own big islands. The ring of
# bars and the circle stay in the middle; the three channels now run on out to the sea, cutting the outer dunes into
# three wedges. New: the Pyre Dune in the north-west (a 22 m climb to the pyre the Choir built to burn the effigies; the
# warden left the reliquary key in her chest by it), the Choir's boathouse drowned in a deep hole off the north-east
# shore (an air pocket; the boatman's note), the Choir's cave in the north-east with its locked reliquary (the quest's
# end), two buried treasures. Quest 5 -> 13 steps (the plan's done-when stays note:3 and zone:effigy:circle).
# Voices: warden Hester Vane, boatman Silas Crewe, novice Lise Marren.
# OLDER4 10-26: relief on the flat south and east wedges - the Whistling Dune (south-west, 10 m), the Ash Dunes
# (south-east, 8 m) and the Seal Bank (east, 5 m), each a named area; and Lise's five straw dolls hidden round the
# island (a set): all five found show her box on the Whistling Dune (a secret off the quest).
#
# Built by the recipe player (CIRecipe effigy_shoals) through the editor's own operations.
include lib_sea
include lib_features
include lib_sl1
include lib_areas
include lib_highwater
include lib_lastpost
# o4_dune: a dune or low hill along x1 z1 - x2 z2, h m over the sea at its crest: three rings of flatten (the outer one
# no lower than the plain it stands on), lightly smoothed into one slope, painted by slope, the generator's plants cleared
macro o4_dune x1=0 z1=0 x2=10 z2=0 h=8 r=4
brush flatten from $x1 $z1 to $x2 $z2 r={$r*2.4} s=20 frames=700 h={$h*0.4}
brush flatten from $x1 $z1 to $x2 $z2 r={$r*1.5} s=20 frames=700 h={$h*0.75}
brush flatten from $x1 $z1 to $x2 $z2 r={$r*0.7} s=20 frames=600 h={$h+1.5}
brush smooth from $x1 $z1 to $x2 $z2 r={$r*2.8} s=5 frames=40
brush auto from $x1 $z1 to $x2 $z2 r={$r*2.8} s=10 frames=25
clear from $x1 $z1 to $x2 $z2 r={$r*2.6}
end
new
# (nature: bare sand - few trees (0.08), Rocks Like Raft)
gen Trees=0.08 Bushes=0.12 Rocks=0.43 Harvest=0.1 BeachThings=0.45
gen Seed=1203 Radius=80 Height=3 Roughness=0.2 Peaks=1 Shape=0 Style=0 PeakShape=0.2 Cliffs=0 BeachWidth=0.9
gen Water=0.5 SeaRocks=0.4 SeaFinds=0.5 Sunken=0.3 Hostiles=0 Friendly=0.1 SeaLife=0.35
generate

# --- Terrain: the whole shoal levelled low (1.2 m), three channels cut between the bars, the middle kept -------------
brush flatten at 0 0 r=36 s=20 frames=150 h=1.2
# --- DEEP 10-25 terrain: the Pyre Dune (north-west, summit 22 m, base r 20) and its path, the boathouse's hole
# (north-east, -14 m), the cave's pad
call hw_mount x=-50 z=29 b=20 h=22
call hw_trail x=-50 z=29 b=20 h=22 a0=120.11 turn=300 n=30 h0=1.5
brush flatten at -50 29 r=9 s=20 frames=400 h=22
call hw_basin x=38 z=66 r=14 h=-14
brush flatten at 50 40 r=12 s=20 frames=300 h=2
origin
for ca 90 330 120
brush flatten from {13*cos($ca)} {13*sin($ca)} to {84*cos($ca)} {84*sin($ca)} r=4 s=16 frames=60 h=-1.6
next
brush smooth at 0 0 r=40 s=3 frames=10
clear at 0 0 r=36
call ar_cave x=50 z=40 h=2 yaw=180 al=choirrock chest=reliquary
# --- OLDER4 10-26 terrain: dunes on the flat south and east wedges, clear of the channels -------------------------------
call o4_dune x1=-44 z1=-48 x2=-24 z2=-58 h=10 r=3
call o4_dune x1=14 z1=-58 x2=36 z2=-48 h=7 r=3
call o4_dune x1=62 z1=-8 x2=58 z2=14 h=5 r=2.5

# --- The effigies: three bars (centred on 30, 150 and 270 degrees), an inner row of five at 20 m and an outer row of
# five at 28 m on each. Set "effin" faces the middle; set "effout" (hidden) faces the landing beach (0 -38). ----------
for bar 30 270 120
for off -30 30 15
call effigy x={20*cos($bar+$off)} z={20*sin($bar+$off)} yaw={270-$bar-$off} alias=effin
next
for off -32 32 16
call effigy x={28*cos($bar+$off)} z={28*sin($bar+$off)} yaw={270-$bar-$off} alias=effin
next
next
# (set "effout": its yaws worked out beforehand - each faces the landing beach at 0 -38)
call effigy x=20.00 z=0.00 yaw=-152.2 alias=effout
call effigy x=19.32 z=5.18 yaw=-155.9 alias=effout
call effigy x=17.32 z=10.00 yaw=-160.2 alias=effout
call effigy x=14.14 z=14.14 yaw=-164.8 alias=effout
call effigy x=10.00 z=17.32 yaw=-169.8 alias=effout
call effigy x=27.98 z=-0.98 yaw=-142.9 alias=effout
call effigy x=27.17 z=6.77 yaw=-148.8 alias=effout
call effigy x=24.25 z=14.00 yaw=-155.0 alias=effout
call effigy x=19.45 z=20.14 yaw=-161.5 alias=effout
call effigy x=13.15 z=24.72 yaw=-168.2 alias=effout
call effigy x=-10.00 z=17.32 yaw=169.8 alias=effout
call effigy x=-14.14 z=14.14 yaw=164.8 alias=effout
call effigy x=-17.32 z=10.00 yaw=160.2 alias=effout
call effigy x=-19.32 z=5.18 yaw=155.9 alias=effout
call effigy x=-20.00 z=0.00 yaw=152.2 alias=effout
call effigy x=-13.15 z=24.72 yaw=168.2 alias=effout
call effigy x=-19.45 z=20.14 yaw=161.5 alias=effout
call effigy x=-24.25 z=14.00 yaw=155.0 alias=effout
call effigy x=-27.17 z=6.77 yaw=148.8 alias=effout
call effigy x=-27.98 z=-0.98 yaw=142.9 alias=effout
call effigy x=-10.00 z=-17.32 yaw=154.2 alias=effout
call effigy x=-5.18 z=-19.32 yaw=164.5 alias=effout
call effigy x=-0.00 z=-20.00 yaw=180.0 alias=effout
call effigy x=5.18 z=-19.32 yaw=-164.5 alias=effout
call effigy x=10.00 z=-17.32 yaw=-154.2 alias=effout
call effigy x=-14.84 z=-23.75 yaw=133.9 alias=effout
call effigy x=-7.72 z=-26.92 yaw=145.2 alias=effout
call effigy x=-0.00 z=-28.00 yaw=180.0 alias=effout
call effigy x=7.72 z=-26.92 yaw=-145.2 alias=effout
call effigy x=14.84 z=-23.75 yaw=-133.9 alias=effout

# --- The tallest effigy in the middle (it faces south both ways), the hymn sheet at its feet ------------------------
place Placeable_Scarecrow_Advanced - at 0 6 ground sit yaw=180 scale=1.5
place Note_Paper hymnsheet at 0.8 4.6 ground sit yaw=10
place Zone_Trigger circlezone at 0 0 ground y=1

# --- The landing on the south bar, its tide-marker post; the Choir's basket and note on the east bar ---------------
place Note_Sign tidemarker at -3 -32 ground sit yaw=180
place Zone_Trigger landingzone at 0 -34 ground y=1
place Crate_Big_01 - at 22 8 ground sit yaw=60
place Note_Paper whomade at 22 8 ground y=0.6 sit drop yaw=30
place Loot_Chest offerings at 24.5 6 ground sit yaw=240
place Zone_Sound windsound at 0 0 ground y=2

# --- Things to gather, two tight reefs in the channels -------------------------------------------------------------
scatter "Pickup_Landmark_PineappleLandmark" 2 at 0 0 r=30 seed=1231 free=4
call shallows x=-52 z=-30 r=8 deep=4 n=1 seed=1232
call shallows x=52 z=-30 r=8 deep=4 n=1 seed=1233
call shallows r=92 deep=5 n=3 seed=30208
call hw_reef x=46 z=76 r=3 seed=30201
call hw_reef x=28 z=76 r=3 seed=30202

# --- DEEP 10-25: the Pyre Dune - its foot and top as zones; the Choir's pyre on top, the warden's chest (the reliquary key)
call hw_zone x=-31.83 z=18.47 al=hillfootz id=hillfoot r=5 msg="The Pyre Dune. A path trodden into the sand winds up it, and at the top, against the sky, a stack of wood."
call hw_zone x=-50 z=29 al=hilltopz id=hilltop r=8 h=1 msg="The top of the Pyre Dune. The pyre was built and never lit. Three effigies stand on top of it, facing the sea."
place Loot_Chest pyrechest at -52 31 h=22.1 drop yaw=120
loot pyrechest story:reliquarykey*1;Rope*2;Plank*4;Canteen_Water*1
note pyrechest Pyre chest | The warden's chest by the pyre: rope, planks for the fire, water - and an iron key on a string of straw: RELIQUARY.
prop pyrechest loot.refill=0
place Note_Paper hesternote at -47 27 h=22.1 drop yaw=200
place Placeable_Scarecrow_Advanced - at -51.5 29.5 h=22 sit yaw=300
place Placeable_Scarecrow_Advanced - at -50 29.5 h=22 sit yaw=300
place Placeable_Scarecrow_Advanced - at -48.5 29.5 h=22 sit yaw=300
place Zone_Sound pyrewind at -50 29 h=24
prop pyrewind sound.event=event:/amb/wreck_creaks
prop pyrewind sound.volume=0.35
prop pyrewind zone.radius=12
scatter Bush 4 at -50 29 r=20 seed=30203 free=1
scatter Bush2 3 at -50 29 r=20 seed=30204 free=1
scatter "Pickup_Landmark_Rock 1" 3 at -50 29 r=20 seed=30205 free=2
# --- The Choir's boathouse (north-east), drowned in a hole 14 m down, an air pocket: Silas's note, the back room's chest -
call hw_sunkhouse x=38 z=66 h=-14 yaw=0 a=boathouse chest=boatchest air=boatair bub=boatbub dal=boatdoor
call hw_zone x=38 z=66 al=boatzone id=boathouse r=7 h=1 msg="The Choir's boathouse, 14 m down. Oars racked on the wall, straw floating under the ceiling. Its front room still holds air."
place Note_Paper silasnote at 38.6 63.8 h=-13.7 drop yaw=20
loot boatchest Rope*3;Nail*8;MetalIngot*1;Cooked_Mackerel*2
prop boatchest loot.refill=0
note boatchest Boathouse chest | The boatman's chest: rope, nails, an iron ingot and two tins of mackerel, sealed.
place Creature_PufferFish boatpuffers at 32 74 h=-9
prop boatpuffers creature.count=2
# --- The Choir's cave (north-east): the reliquary, locked; the novice's note -------------------------------------------
call hw_zone x=50 z=35 al=cavez id=choircave r=4 msg="The Choir's cave. Candle stubs in every niche, and at the back an iron-bound box with a padlock."
place Note_Paper lisenote at 48.5 34.5 h=2.45 drop yaw=180
loot reliquary CopperIngot*2;MetalIngot*2;Battery*1;Glass*2
prop reliquary loot.refill=0
prop reliquary if.open=quest|12\nhas|story:reliquarykey|1
prop reliquary else.open=message||The reliquary is padlocked. The warden kept its key by the pyre, on top of the Pyre Dune.
note reliquary Choir's reliquary | What the Quiet Choir's nets brought up and nobody would keep at home: copper and iron bars, glass, a battery that is still warm - and a brass tuning fork that hums the lullaby on its own when you lift it.
call treasure x=58 z=28 r=7 n=1 seed=30206 kind=0
prop treasure30206 treasure.loot=Scrap*3;Bolt*2;Hinge*1
call treasure x=-20 z=-60 r=7 n=1 seed=30207 kind=0
prop treasure30207 treasure.loot=MetalOre*3;CopperOre*2;Rope*1
# --- OLDER4 10-26: the new dunes as areas, sparse dune plants; Lise's five straw dolls (a set) and her box ------------
call hw_zone x=-34 z=-53 al=ef_whistlez id=ef_whistling r=8 h=1 msg="The Whistling Dune. The wind sings in the grass up here - almost a hymn."
call hw_zone x=25 z=-53 al=ef_ashz id=ef_ashdunes r=8 h=1 msg="The Ash Dunes. Grey sand: the wind brought the pyre's ash down here."
call hw_zone x=60 z=3 al=ef_sealz id=ef_sealbank r=6 h=1 msg="The Seal Bank. Seals hauled out here, before the Choir came."
call lp_hidden x=-34 z=-53 al=ef_setchest kind=Loot_Chest
scatter Bush 4 at -34 -53 r=16 seed=30210 free=2
scatter Bush2 3 at -34 -53 r=16 seed=30211 free=2
scatter "Pickup_Landmark_Tree_Palm 3" 1 at -34 -53 r=12 seed=30212 free=3
scatter SmallBoulder4 3 at -34 -53 r=16 seed=30213 free=2
scatter Bush 3 at 25 -53 r=15 seed=30214 free=2
scatter Bush2 2 at 25 -53 r=15 seed=30215 free=2
scatter SmallBoulder4 3 at 25 -53 r=15 seed=30216 free=2
scatter Bush2 3 at 60 3 r=12 seed=30217 free=2
call lp_piece x=-24 z=52 al=ef_doll1 set="Straw dolls"
call lp_piece x=60 z=6 al=ef_doll2 set="Straw dolls"
call lp_piece x=28 z=-51 al=ef_doll3 set="Straw dolls"
call lp_piece x=-6 z=-60 al=ef_doll4 set="Straw dolls"
call lp_piece x=-56 z=-4 al=ef_doll5 set="Straw dolls"
prop ef_doll1 on.set=show|ef_setchest\nmessage||Five straw dolls, small as a hand, each one facing the same way: out to sea. On the Whistling Dune a box has come up out of the sand.
note ef_setchest Lise's box | Lise Marren's box: "They made me make the dolls too. I hid them where the Choir would not count. If you found all five, you count better than they do." Inside, her things.
loot ef_setchest CopperIngot*2;MetalIngot*2;Rope*3;Glass*2

# --- Settings, story items, notes, behaviours, quest ----------------------------------------------------------------
info title=Effigy Shoals
info author=Custom Islands
info description=Three low sandbars in a ring and thirty straw effigies on them, all facing the middle, inside dunes as big as Raft's own big islands: the Pyre Dune, the Choir's drowned boathouse, their cave and its locked reliquary. No houses, no people. The third island of The Lullaby Frequency.
island on.arrive=message||Figures stand on the sandbars - dozens of them, still as posts. Straw. Effigies. All of them looking inward.

story reliquarykey|Reliquary key|Placeable_Lantern_Metal|An iron key on a string of straw, from the warden's chest by the pyre on the Pyre Dune.
story hymn|Choir hymn sheet|Note_Paper|The Quiet Choir's hymn, written out by hand. "Only those who know the hymn may listen."

note tidemarker Tide marker | Carved into the post, deep:\n\nCOUNT THEM.\nTHEN COUNT AGAIN.
note hymnsheet Choir hymn sheet | THE LISTENING HYMN\n\nHush now, the water is listening,\nhush now, the lantern is low,\nshe sings at the hour of twelve past three,\nand all of the drowned ones know.\n\n- to be learned by heart before the pit. The Quiet Choir.
note whomade Who made them | We made them so she would have someone to sing to who could not walk into the sea.\n\nThirty of us, thirty of them. When the song stops we will burn them.\n\nCome to Gannet Rock if you hear her too. Bring the hymn - the Listener will not let you near the pit without it.\n\n- the Quiet Choir
note hesternote Choir warden Hester Vane's count | THE COUNT - H. VANE, WARDEN\n\nWe made thirty. I made them myself with the others, one each, our own old coats on them so she would think they were us.\n\nMorning count: thirty. Noon: thirty. At dusk I counted thirty-one, and the new one was standing in the middle of the circle where there had been nothing, looking at me.\n\nI came up the dune and built the pyre, to burn the lot of them before the song comes again. I could not light it. Every match I struck went out as if somebody close by had blown on it, gently, the way you blow out a child's candle.\n\nThe reliquary key stays here with me, by the fire that will not burn. Nobody opens that box in the cave without the hymn in their mouth.
note silasnote Boatman Silas Crewe's note | (Pencil on the back of a tide table, dry in the air pocket)\n\nI rowed the straw across from Gannet Rock, forty bales, at night, because the Choir said she should not see us carrying it.\n\nThe boathouse went down on the calmest night of the year. No storm. The sea just came up the slip and in through the door and kept coming, as if it wanted to look inside.\n\nI am under the roof now with the oars. Through the window the boats are sitting on the bottom in a ring, every bow turned to face the middle of the shoals.\n\nLike the effigies. Like they are listening too.\n\nIf you get out, tell Hester she was right not to light it. Fire is loud.
note lisenote Novice Lise Marren's note | LISE, NOVICE, AGE 12\n\nThe Warden says I must not count them any more because I always get a different number.\n\nThe thirty-first one has my brother's coat on. He drowned last spring off the Hollin coast. I know it is his coat because I sewed the patch on the elbow myself, badly, with green thread.\n\nI asked it where he was. It did not say anything, but the straw in its sleeve moved, the way his hand used to when he was asleep and heard me come in.\n\nI am going to sit here in the cave where it cannot see me and sing the hymn very quietly until morning.
note offerings Choir's offering basket | A basket of food left for whoever comes to count them.
loot offerings Cooked_Mackerel*3;Coconut*2;Watermelon*2;Canteen_Water*1
prop offerings loot.refill=0

prop hymnsheet if.read=!signal|ef_hymn
prop hymnsheet on.read=signal||ef_hymn\ngive||story:hymn*1

prop effin obj.name=effin
prop effout obj.name=effout
prop effout beh.hidden=1
prop circlezone zone.id=circle
prop circlezone zone.radius=5
prop circlezone zone.repeat=never
prop circlezone on.enter=hide|effin\nshow|effout\nplaysound||event:/amb/wreck_creaks|0.8|once|near\nmessage||A creak of straw, all round you at once. You did not see them move.

prop landingzone zone.id=landing
prop landingzone zone.radius=5
prop landingzone zone.message=Effigy Shoals. Thirty of them - you think. Count them.
prop windsound sound.event=event:/amb/wreck_creaks
prop windsound sound.volume=0.25
prop windsound zone.radius=40

quest title=Count Them Again
quest intro=Sandbars, and straw figures on them. Come ashore on the sandbar by the tide marker; the tallest effigy stands in the middle of the ring.
step reach|landing|1|Come ashore by the tide marker; the tallest effigy marks the middle
step read|Tide marker|1|Read the tide marker
step reach|circle|1|Walk into the middle of the circle
step read|Choir hymn sheet|1|Read the hymn sheet at the tallest effigy's feet
step read|Who made them|1|Find out who made them (paper by the offerings chest)
step reach|hillfoot|1|Find the path up the Pyre Dune, the dune with the Choir's pyre
step reach|hilltop|1|Climb the Pyre Dune to the Choir's pyre
step read|Choir warden Hester Vane's count|1|Read the warden's count by the pyre
step collect|story:reliquarykey|1|Take the reliquary key from the warden's chest
step reach|boathouse|1|Dive to the Choir's drowned boathouse in the water off the sandbars
step read|Boatman Silas Crewe's note|1|Breathe in the boathouse's front room and read the boatman's note
step reach|choircave|1|Find the Choir's cave in the dunes by the water
step open|Choir's reliquary|1|Open the Choir's reliquary with the warden's key
quest done=They all face you now. The Quiet Choir is on Gannet Rock - and the hymn will get you in.
quest reward=Cooked_Mackerel*2;Rope*3;Plank*4

save Effigy Shoals
