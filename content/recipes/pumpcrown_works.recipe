prop pc_goats creature.count=2
place Creature_Goat pc_summitgoat at -29.05 -10.54 ground
prop pc_summitgoat creature.count=1
scatter "Pickup_Landmark_Copper 1" 2 at -32 -10 r=20 seed=13582 free=2
scatter "Pickup_Landmark_Clay 1" 2 at -32 -10 r=22 seed=13583 free=2
scatter "Pickup_Landmark_Rock 1" 2 at -32 -10 r=18 seed=13584 free=2
call hw_sunkhouse x=-68 z=-38 h=-16 yaw=0 a=pc_sunk chest=pc_deepchest air=pc_air bub=pc_airbub dal=pc_sunkdoor
call hw_zone x=-68 z=-38 al=pc_deepz id=pc_deep r=7 h=1 msg="The flooded intake chamber, 16 metres down. The front room still holds a pocket of air."
place RT_PlasticBoat pc_sunkboat at -60 -36 ground sit yaw=35
prop pc_sunkboat tint.color=#5a5048
prop pc_sunkboat tint.amount=0.45
place Loot_Crate pc_boatcrate at -61 -42 ground sit yaw=10
prop pc_boatcrate loot.refill=0
call hw_reef x=-75 z=-33 r=3 seed=13586
place Creature_PufferFish pc_puffers at -74 -45 h=-12
prop pc_puffers creature.count=2
call hw_note x=-37.81 z=-55.92 yaw=30.3 al=pc_hint
# the shorted breaker: the pump house's cable still runs live into the drowned water by the sunk house;
# three rolls of tape (the deck box, the linesman's locker, the climber's cache) make it safe to switch off
call hw_hazard x=-68 z=-38 al=pc_shock kind=shock r=8 dmg=8 safe=none msg="The water bites - a live cable from the pump house runs into it." h=1
place RT_Pillar - at -44.92 -53.11 ground sit sy=0.4
place RT_PowerBox pc_breaker at -44.92 -53.11 ground y=1.25 yaw=72.65
prop pc_breaker obj.name=pc_breaker
prop pc_breaker beh.use=Tape and switch off the shorted breaker
prop pc_breaker if.use=quest|9\n!signal|pc_breaker\ntake|story:tape|3
prop pc_breaker on.use=signal||pc_breaker\nhide|pc_shock\ngive||story:pc_breaker*1\nsound||event:/exploring/obstacles/keypad/keypad_correct\nmessage||Three rolls of tape round the bare ends - the breaker clunks off. The water by the sunk house goes quiet.
prop pc_breaker else.use=message||Bare copper, sparking. It needs three rolls of insulating tape before anyone touches it.
place Loot_Chest pc_locker at -35.53 -57.35 ground sit yaw=252.65
prop pc_locker loot.refill=0
story pc_top|Dobbs's measuring stick|Bolt|Wilmer Dobbs's brass-tipped measuring stick, taken from his desk and hung at the top of the old water tower.
story pc_deep|Intake gauge|Bolt|The intake chamber's flow gauge, unscrewed from the wall - its needle jammed at FLOW REVERSED.
story tape|Insulating tape|Bolt|A roll of the Union linesmen's insulating tape. Three of them would make a dead breaker safe.
story pc_breaker|Breaker taped|Bolt|The shorted breaker, taped and switched off - no current in the drowned water any more.
note pc_hint Dobbs's warning | Painted on a board, in big letters, by somebody who has been ignored before -\n\nDO NOT TOUCH THE WATER BY THE SUNK HOUSE. The pump house cable runs live into it and I have reported this in Complaints 140, 162, 197 and 233.\n\nIf you must go down to the intake chamber - and if you've read my desk, you must - then tape the breaker on the pillar first. Three rolls. One for each bare end and one for luck. The Union linesman keeps a roll in his locker; there's another on the water tower and one more on the ledge by the trail, where I dropped it running from a goat.\n\nThen look at the intake gauge. Look at which way the needle points. Then you'll know I am not mad, or we will both be mad together, which is more company than I've had in years.\n\n- W. Dobbs, Foreman
prop pc_deepchest on.open=message||The intake gauge, still ticking. Its needle is jammed hard past zero, into the red: FLOW REVERSED. The Lowstreet main is not draining the street. It is pumping the sea into it - and has been for years.
note pc_topchest Old water tower deck box | A box lashed to the deck rail at the top of the old water tower.
loot pc_topchest story:pc_top*1;story:tape*1;Rope*2
note pc_deepchest Flooded intake chamber strongbox | A strongbox in the back room of the flooded intake chamber.
loot pc_deepchest story:pc_deep*1;MetalIngot*1;CircuitBoard*1
note pc_ledge Climber's cache | A climber's cache on a ledge off the trail - rope, a flask, a few bolts.
loot pc_ledge story:tape*1;Rope*2;Bolt*2
prop pc_ledge loot.refill=0
loot pc_boatcrate Plastic*3;Scrap*2;MetalIngot*1
note pc_locker Linesman's locker | The Union linesman's locker: his tape, his gloves, nothing else.
loot pc_locker story:tape*1;Rope*1;CopperIngot*1

# --- Settings, story items, notes, behaviours, quests -----------------------------------------------------------------
info title=Pumpcrown Works
info author=Custom Islands
info description=The Harbor Authority's waterworks on three drowned towers' roofs: water tanks, pipes along the bridges, a purifier hall that only opens to an Authority coat, and an outfall into the drowned city. The fifth island of The City That Never Sank.
island on.arrive=message||Pumps thump on three tower roofs. Pipes run along the bridges into a hall with the Authority's crest on the door. Every sentry box is empty.

story authcoat|Authority coat|Placeable_Storage_Small|A Harbor Authority guard's coat, off the laundry line - the crest still on the sleeve.
story boomwinch|Boom winch wound|Bolt|The boom tower's winch, wound up again - the boom closes the channel.

prop works tint.color=#8e9496
prop works tint.amount=0.35
prop skyline tint.color=#7a8088
prop skyline tint.amount=0.4
prop screechers creature.count=3
prop screechers creature.respawn=0
prop receipt obj.name=receipt
prop receipt beh.hidden=1
prop receipt on.read=signal||authfriend

prop hallgate obj.name=hallgate
prop hallgate beh.use=Open the purifier hall
prop hallgate if.use=has|story:authcoat|1
prop hallgate on.use=hide|\nmessage||In the coat you are just another guard. The door's reader blinks green.
prop hallgate else.use=message||AUTHORITY STAFF ONLY. The reader looks at your clothes, not your face.

prop boomwinch beh.use=Wind the boom winch
prop boomwinch if.use=!signal|boomwound
prop boomwinch on.use=signal||boomwound\ngive||story:boomwinch*1\nshow|receipt\nsound||event:/raft/radar/lever\nmessage||The winch groans round. Out in the channel the boom swings shut - and the screechers nesting on the tower come off it shrieking.
prop boomwinch else.use=message||The boom is shut.

note hallsign Purifier hall | HARBOR AUTHORITY - PURIFIER HALL\nAuthority staff only. Coats on.
note roster Authority duty roster | DUTY ROSTER - PUMPCROWN\n\nDawn: the pumps. Noon: the boom. Dusk: the boom.\nNight: nobody.\n\nThe boom tower's winch has rusted. Nobody has wound it in a month. The Fleet's boats come and go as they please.\n\nAny hand that winds it is paid - ask at the tower.
note receipt Authority receipt | HARBOR AUTHORITY - RECEIPT\n\nFor winding the boom winch and clearing the tower. Paid.\n\nThe Authority remembers its friends. - the duty clerk
note coatline Laundry basket | The guards' laundry basket. A coat with the Authority's crest on the sleeve is nearly dry.
note hallchest Purifier hall | The purifier hall's locker: a gauge log, filters, and an Authority keycard on a hook. Authority lockers all over the city open to it.
note purifierbench Purifier bench | The purifier bench: the electric purifier's plans, pinned under a spanner.
note tankhouse Tank house locker | The tank house locker: the water tank's plans.
note pipegallery Pipe gallery | The pipe gallery's chest: the water pipe's plans, a coil of hose.
note stores Authority stores | The Authority's stores: the large storage's plans. Filters, stacked and stamped.
note seedbox Planter box | Seeds for the guards' planters.
loot coatline story:authcoat*1;Leather*1
prop coatline loot.refill=0
loot hallchest MetalIngot*2;Glass*2;Bolt*2;story:raft-Tangaroa_KeyCard*1
prop hallchest loot.refill=0
loot purifierbench Blueprint_ElectricPurifier*1;CircuitBoard*1
prop purifierbench loot.refill=0
loot tankhouse Blueprint_WaterTank*1;Plastic*4
prop tankhouse loot.refill=0
loot pipegallery Blueprint_Pipe_Water*1;Plastic*4;MetalIngot*1
prop pipegallery loot.refill=0
loot stores Blueprint_Storage_Large*1;Plank*6;Nail*10
prop stores loot.refill=0
loot pumphive HoneyComb*3
prop pumphive note.title=Wild beehive
loot seedbox Raw_Potato*2;Raw_Beet*2
prop seedbox loot.refill=0

prop outfallzone zone.id=outfall
prop outfallzone zone.radius=4
prop outfallzone zone.message=The outfall. The pipe's water pours on down into a drowned street.
prop boomzone zone.id=boom_tower
prop boomzone zone.radius=3
prop boomzone zone.message=The boom tower. A table, a cold stove, and a winch outside that nobody winds.

note patrolcrate Patrol van's lockbox | AUTHORITY PATROL - lockbox\n\nConfiscated: one water filter (home-made), one ration book (forged).\nThe van has not run since the Authority stopped buying fuel for the poor districts' patrols.\n\n(On the back of the form, in a guard's tidy hand: The filter was made from a tea strainer, charcoal and a sock. The old woman who made it gave me a cup of what came through. It was the best water I have had in a year. I have confiscated it as ordered. I have not confiscated the recipe, which I have memorised. - Constable R. Ames)
note dobbsdesk Dobbs's complaints | The foreman's desk, buried in carbon copies. The top few -\n\nNo. 244: The Lowstreet pumps run backwards at night. I can hear it. A pump running backwards sounds like a man trying to whistle while drinking.\nNo. 251: I have measured it. They run backwards.\nNo. 266: The Council's barges tie up here before they go to the Piles. They arrive low and leave lower. Iron does not grow on a barge.\nNo. 280: Someone has taken my measuring stick.\nNo. 281: I have seen my measuring stick. It is at the top of the old water tower. I am fifty-eight and I do not climb.\nNo. 299: Is anyone reading these?\n\nYours, ever, W. Dobbs, Foreman
note cranememo Councillor's memo | FROM THE OFFICE OF COUNCILLOR A. CRANE\nTo: W. Dobbs, Foreman, Pumpcrown Works\n\nMr Dobbs,\n\nThe Council thanks you for your two hundred and ninety-nine complaints. Every one of them has been read, by me, personally, and filed.\n\nThe Lowstreet pumps run as the Council directs. You are not to measure them. You are not to measure anything. If you are cold at night, the Council will send you a blanket; if you hear the pumps, the Council will send you two.\n\nYour tin of grease has been forwarded to the boom.\n\n- A.C.\n\n(Dobbs has written across it, very small: Read. By him. Personally. Then why are they still running backwards?)
note complaint300 Complaint No. 300 | COMPLAINT No. 300 - not to the Council this time. To whoever got my stick back.\n\nThank you. Nobody has done a thing for me in nine years, and you climbed a water tower.\n\nYou've seen the gauge. Lowstreet didn't flood. Lowstreet was flooded, by my own pumps, on the Council's orders, and kept flooded. Two thousand people lived on that street. They got out with what they could carry, and the Council called it the rising sea.\n\nThe outfall runs into Lowstreet. The Union's divers went down it - Marlowe's team - and chalked hooks on the walls to mark the way back. Follow the hooks. Find out why somebody wanted a whole street full of water.\n\nI'll keep complaining. It's what I'm good at.\n\n- W. Dobbs
loot patrolcrate Plastic*2;Glass*2;CopperIngot*1
note filternotice Filter house notice | NOTICE - FILTER HOUSE CLOSED\n\nBy order of the Harbor Authority this filter house is closed. Its water went to the Rookery free of charge.\nThe new purifier hall sells the same water. The Rookery cannot pay.\n\n(Chalked under it, in a careful old hand: We could pay in songs. We have a great many songs. We had a great many children too, before the brown water. Somebody in a nice coat might think on that. - Maud Penn, the Rookery)
prop hazmatbox obj.name=hazmatbox
prop hazmatbox beh.use=Put on a hazmat suit
prop hazmatbox on.use=suit||120\nmessage||A hazmat suit from the box: two minutes before the filter clogs. The sludge can't touch you in it.
note sludgechest Sludge-bed chest | A chest sunk in the sludge, its lock eaten away: a sampler's kit the Authority never came back for.
loot sludgechest Battery*1;CopperIngot*2;Glass*2
prop sludgechest loot.refill=0
quest title=The Authority's Water
quest intro=The Authority rules Highwater's water from Pumpcrown. Get inside - and find Wilmer Dobbs, the foreman who never stops complaining.
step collect|story:authcoat|1|Take an Authority coat from the chest by the laundry line, next to the purifier hall
step open|Purifier hall|1|Wear the coat through the purifier hall's door and open its locker
step read|Dobbs's complaints|1|Read the carbon copies on the foreman's desk
step read|Councillor's memo|1|Read the Councillor's answer beside them
step reach|pc_trail|1|Find the foot of the trail up Standpipe Hill, the hill with the old water tower
step reach|pc_summit|1|Climb the trail to the top of Standpipe Hill
step collect|story:pc_top|1|Climb the old water tower and get Dobbs's measuring stick back from its deck
step collect|story:tape|3|Gather three rolls of tape: the water tower's deck box, the climber's chest, the linesman's locker
step read|Dobbs's warning|1|Read Dobbs's warning by the shorted breaker, the power box by the shore
step collect|story:pc_breaker|1|Tape the shorted breaker and switch the live water off
step reach|pc_deep|1|Dive to the flooded intake chamber, sunk off the shore by the breaker
step collect|story:pc_deep|1|Read the intake gauge in its back room and bring it up
step blueprint|Blueprint_WaterTank|1|Take the water tank's plans from the tank house
step blueprint|Blueprint_Pipe_Water|1|Take the water pipe's plans from the pipe gallery
step blueprint|Blueprint_ElectricPurifier|1|Take the electric purifier's plans from the purifier bench
step blueprint|Blueprint_Storage_Large|1|Take the large storage's plans from the Authority's stores
step reach|reservoir_bank|1|Climb the reservoir bank, the long raised bank behind the works
step read|Filter house notice|1|Read the notice at the old ruined filter house
step open|Patrol van's lockbox|1|Open the lockbox in the Authority's wrecked patrol van on the shore
step reach|sludge_beds|1|Go to the edge of the green sludge beds, where the hazmat box stands
step read|Complaint No. 300|1|Read the complaint nailed up by the outfall
step reach|outfall|1|Dive into the outfall where the pipe meets the sea
quest done=The outfall runs on, down into the drowned city. The Union's divers went down there - into Lowstreet.
quest reward=HoneyComb*2;Plastic*4

quest2 title=Keep the Boom
quest2 intro=The Authority pays for any hand that winds the boom.
step2 read|Authority duty roster|1|Read the duty roster in the purifier hall
step2 reach|boom_tower|1|Go to the boom tower at the end of the point
step2 collect|story:boomwinch|1|Wind the boom winch
step2 kill|Screecher|3|Drive off the three screechers circling the boom tower
step2 read|Authority receipt|1|Read the Authority's receipt in the boom tower
quest2 done=The Authority remembers its friends. When the city breaks, it will remember you.
quest2 reward=MetalIngot*3;Glass*2

# (the waterworks' forklift by the hall, the boom tower's ore wagons)
place VP_Forklift - at 8 7 ground sit yaw=200
place VP_Wagon02 - at 20 -8 ground sit yaw=90
place VP_Wagon01 - at 20 -12 ground sit yaw=90

# --- 10-25: the open sand filled - hills where nothing stands, a ruin on the biggest, a wreck, plants over all
# (plan.py from the built island: every hill at least 8 m clear of anything the recipe placed; frame = the land centre)
origin
