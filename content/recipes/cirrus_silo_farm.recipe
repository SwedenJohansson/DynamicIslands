place Block_Foundation_Tier3 jppcs at -4.85 3.53 h=9.668 sy=10.650
place Block_Foundation_Tier3 jppcs at -2.54 5.44 h=10.418 sy=11.749 sx=2 sz=2
prop jpcs tint.color=#8a7f70
prop jpcs tint.amount=0.35
prop jppcs tint.color=#8a7f70
prop jppcs tint.amount=0.35
place Loot_Chest jccs at -1.04 -5.91 h=7.35 sit yaw=0
prop jccs loot.refill=0
place Loot_ChestSmall jbcs at -2.54 5.44 h=11.1 sit yaw=0
prop jbcs loot.refill=0
pop
call hw_zone x=4 z=58 al=cs_jumpz id=cs_jumps r=6 h=1 msg="Stone stacks, one higher than the next. Something at the top."
call rn_pad x=16 z=38 r=12 h=3
push at 8.5 30.5 h=3
