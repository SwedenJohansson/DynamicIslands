place Block_Foundation_Tier3 jpcs at -4.85 3.53 h=10.35
place Block_Foundation_Tier3 jpcs at -2.54 5.44 h=11.1 sx=2 sz=2
# JUMP end
place Block_Foundation_Tier3 jppcs at 5.77 1.65 h=3.668 sy=1.861
place Block_Foundation_Tier3 jppcs at 5.85 -1.35 h=4.418 sy=2.959
place Block_Foundation_Tier3 jppcs at 4.46 -4.01 h=5.168 sy=4.058
place Block_Foundation_Tier3 jppcs at 1.95 -5.67 h=5.918 sy=5.157
