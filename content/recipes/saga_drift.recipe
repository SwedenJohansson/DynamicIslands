# the net loft (west): a roofless ruin, its crate; the West Ridge behind it
call ar_ruin x=-62 z=-20 h=3 yaw=0 al=netloft
place Note_Paper netnote at -62.75 -20 h=4.05 drop yaw=10
place Loot_Crate netcrate at -59.6 -23.6 ground sit yaw=30
call ar_ridge x1=-80 z1=0 x2=-62 z2=36 h=6 top=8 r=7
