brush flatten at -25.75 -14.5 r=5 s=20 frames=200 h=0.6
brush flatten at -25.75 13.5 r=5 s=20 frames=200 h=0.6
brush flatten at 26.4 32.6 r=5 s=8 frames=40
origin
clear at 26.4 32.6 r=6
clear at 0 0 r=38
