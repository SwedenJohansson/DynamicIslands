prop $al obj.name=$al
prop $al beh.hidden=1
end
call hiddenpart al=verdict_re
call hiddenpart al=verdict_off
call hiddenpart al=verdict_redir
call hiddenpart al=gift_re
call hiddenpart al=gift_off
call hiddenpart al=gift_redir
