call zipdeck y=4.7
pop
place ZiplinePath_Landmark zipmiddle at 6 26 h=10.07
zipto zipmiddle 0 17
call tzone x=0 z=17 al=middlezone id=middle_ring r=3 msg="The middle ring. A tent against the wall - Hedda's - and a crew locker."
call camp x=-6 z=16 yaw=200 fire=campfire_1
call notebox x=3 z=17.5 yaw=200 al=heddawatch
place Loot_Chest crewlocker at -2.5 18.5 ground sit yaw=180
call wheel x=2 z=19 yaw=180 al=middlecrank

# --- Area B, the Inner Ring: the second cable, Ines's watch, the drone bay, the drone, its log, the keypad, the inner crank --
push at -12.47 14.22 h=3.9
call zipdeck y=4.7
pop
place ZiplinePath_Landmark zipinner at -6 14 h=10.07
zipto zipinner 0 8.5
call tzone x=0 z=8.5 al=innerzone id=inner_ring r=2.5 msg="The inner ring. Ines's lamp is lit by the wall - and to the east, something hums in a bay."
call notebox x=3 z=9 yaw=200 al=ineswatch
place Placeable_Lantern_Metal - at 3 9 ground y=1.2 drop
call tzone x=16 z=0 al=dronezone id=drone_bay r=3 msg="The drone bay. A maintenance drone lifts off its cradle - and turns its lights on you."
place "Box Big" - at 17.5 2 ground sit yaw=20
place Creature_StoneBird_Caravan drone at 16 0 ground y=3
prop drone creature.count=1
prop drone creature.respawn=0
prop drone creature.zone=drone_bay
prop drone creature.health=6
prop drone boss.phase=0.5
prop drone boss.summon=1
prop drone boss.summonKind=Creature_StoneBird_Caravan
prop drone tint.color=#8a8f96
prop drone tint.amount=0.7
prop drone on.phase=give||story:dronehurt*1\nmessage||The drone shrieks - and a second one lifts off the cradle to help it.
prop drone on.defeat=signal||drone\ngive||story:dronehurt*1\ngive||story:dronedown*1\nmessage||The drone drops onto its cradle and its lights go out. A paper slides out of its belly.\nsound||event:/exploring/temperence/selene/cryotube_engine
place Note_Sign dronelog at 17.5 -2 ground sit yaw=270
call relaymast x=14 z=-6 yaw=270 al=courtpad
call wheel x=13 z=4 yaw=270 al=innercrank

# --- Area C, the Choice: the verdict notes and the engine's gifts (hidden until a lever is pulled), the goodbyes ----------
