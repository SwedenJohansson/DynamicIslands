# The Kite Meadow - an island of the library's plan The Rainmakers (Nimbus Works' third station, large)
# A high meadow over sea cliffs where Nimbus Works flew its seeding kites: twelve winch masts of antenna poles along the
# ridge, the torn kites - Caravan Town's great banners - slack between them; the path up from the beach overgrown with
# vines; the kite crew's hut half-way up; on top the launch shed (a roof on posts) with its winch engine and its bell.
# Quest "Kites Over the Ridge" (22 steps): the cliff path, the crew roster, the crew hut chest (the machete), the upper
# meadow behind the vines, the warthogs dug in under the masts, the logs of winches 2, 7 and 11 (a digit each), the
# shed's keypad, the winch engine (the kites lift), the fuel store, the biofuel press, the shed bell (Rouhi, the crew's
# youngest flyer, joins you as a character).
#
# Built by the recipe player (CIRecipe the_kite_meadow) through the editor's own operations.
include lib_sea
include lib_features
include lib_areas
include lib_highwater
include lib_rain
# RESIZE 10-26 (the user: Raft-big, one-hour islands): Radius 78 -> 88; the old island moved 10 m south (push frames), so its south shore stays on the coast and the new land is north
# RAIN 10-26: the new land - Gull Crown with kite spotter's tower, Wind Cave, Ivar Brekke at the ruined house (a lamp puzzle), a crashed plane, a jump course, a set of five kite tails
new
# (nature: tropical slopes Like Raft's own: Trees 0.28, Bushes 0.28, Rocks 0.43, Harvest 0.24; the meadow on top cleared)
gen Trees=0.28 Bushes=0.28 Rocks=0.43 Harvest=0.24 BeachThings=0.3
gen Seed=9501 Radius=88 Height=26 Roughness=0.35 Peaks=1 Shape=0 Style=0 PeakShape=0.25 Cliffs=0.6 BeachWidth=0.4
gen Water=0.5 SeaRocks=0.5 SeaFinds=0.5 Sunken=0.3 Hostiles=0 Friendly=0.2 SeaLife=0.3
generate
push at 0 -10

# --- Terrain: the meadow on top (20 m), the cliff path up from the south beach in steps, the crew hut's ledge --------
brush flatten from -30 14 to 30 14 r=16 s=20 frames=160 h=20
brush flatten from 0 -24 to 0 30 r=14 s=20 frames=120 h=20
brush flatten at 0 -60 r=6 s=20 frames=40 h=3
brush flatten at 0 -52 r=5 s=20 frames=40 h=7
brush flatten at 0 -44 r=5 s=20 frames=40 h=11
brush flatten at 0 -36 r=5 s=20 frames=40 h=15
brush flatten at 0 -29 r=5 s=20 frames=40 h=18
brush flatten at 9 -50 r=5 s=20 frames=40 h=8
brush smooth from 0 -64 to 0 -24 r=6 s=6 frames=30
brush grass from -34 14 to 34 14 r=16 s=8 frames=60
brush grass from 0 -24 to 0 30 r=14 s=8 frames=40
pop
origin
# --- RAIN 10-26 terrain: Gull Crown, the pads of the new areas ---------------------------------------------------
call rn_pad x=-50 z=52 r=6 h=10
brush flatten at -52 0 r=4 s=8 frames=60
clear at -52 0 r=7
# (RESIZE 10-26: the old island, 10 m south)
push at 0 -10
clear from -34 14 to 34 14 r=17
clear from 0 -24 to 0 32 r=15
clear from 0 -64 to 0 -24 r=4
clear at 9 -50 r=5

# --- The winch masts along the ridge (z 16): twelve antenna poles 4.6 m apart, the slack kites between them ---------
for m -25.3 25.3 4.6
place Antenna_pole masts at $m 16 ground sit scale=1.5
next
for k -23 23 4.6
place Banner_01 kitesdown at $k 16 ground y=2.2 yaw=0
place Banner_01 kitesup at $k 16 ground y=6.8 yaw=0 tilt=-25
next
prop kitesdown obj.name=kitesdown
prop kitesup obj.name=kitesup
prop kitesup beh.hidden=1
# the winch logs at the feet of masts 2, 7 and 11 (from the west)
place Note_Paper winch2 at -20.7 14.8 ground sit yaw=20
place Note_Paper winch7 at 2.3 14.8 ground sit yaw=-15
place Note_Paper winch11 at 20.7 14.8 ground sit yaw=40
place "Box Big" - at -21.6 14.6 ground yaw=15
place "Box Big" - at 21.8 14.4 ground yaw=-20

# --- The kite crew's hut on its ledge half-way up: wooden walls, a hip roof; the roster on the table ----------------
push at 7 -52 h=8
for fx 0.75 2.25 1.5
for fz 0.75 2.25 1.5
place Block_Floor_Wood - at $fx $fz y=0.05
next
next
place Block_Wall_Wood - at 0.75 3 y=0.2
place Block_Wall_Window_Wood - at 2.25 3 y=0.2
place Block_Wall_Wood - at 0 0.75 y=0.2 yaw=90
place Block_Wall_Wood - at 0 2.25 y=0.2 yaw=90
place Block_Wall_Wood - at 3 0.75 y=0.2 yaw=90
place Block_Wall_Wood - at 3 2.25 y=0.2 yaw=90
place Block_Wall_Wood - at 2.25 0 y=0.2
place Block_Pillar_Wood - at 0 0 y=0.2
place Block_Pillar_Wood - at 3 0 y=0.2
place Block_Pillar_Wood - at 0 3 y=0.2
place Block_Pillar_Wood - at 3 3 y=0.2
roof 2 2 at 0 0 y=0.2 wood
place Loot_Chest crewchest at 2.3 2.3 y=0.25 yaw=180
place "Table Office" crewtable at 0.9 1.9 y=0.54 yaw=90
place Note_Paper roster at 0.9 1.9 y=2 sit drop yaw=10
pop

# --- The vines over the path between the hut's ledge and the meadow ---------------------------------------------------
place ChoppableVines kitevines1 at -2.6 -38 ground yaw=0
place ChoppableVines kitevines2 at 0 -38 ground yaw=0
place ChoppableVines kitevines3 at 2.6 -38 ground yaw=0
place Zone_Trigger cliffpath at 0 -58 ground y=1
place Zone_Trigger uppermeadow at 0 -18 ground y=1

# --- The launch shed on top: a wooden floor, a roof on its four posts, the winch engine, the keypad and its gate, the
# bell on its post ------------------------------------------------------------------------------------------------------
push at -4.5 24 h=20
for fx 0.75 8.25 1.5
for fz 0.75 3.75 1.5
place Block_Floor_Wood - at $fx $fz y=0.05
next
next
place Block_Pillar_Wood - at 0 0 y=0.2
place Block_Pillar_Wood - at 9 0 y=0.2
place Block_Pillar_Wood - at 0 4.5 y=0.2
place Block_Pillar_Wood - at 9 4.5 y=0.2
place Block_Pillar_Wood - at 4.5 4.5 y=0.2
place Block_Pillar_Wood - at 4.5 0 y=0.2
roof 6 3 at 0 0 y=0.2 wood
place Block_Wall_Wood - at 0.75 4.5 y=0.2
place Block_Wall_Wood - at 2.25 4.5 y=0.2
place Block_Wall_Wood - at 3.75 4.5 y=0.2
place Block_Wall_Wood - at 5.25 4.5 y=0.2
place Block_Wall_Wood - at 6.75 4.5 y=0.2
place Block_Wall_Wood - at 8.25 4.5 y=0.2
place Block_Wall_Fence_Tier3 shedgate at 3.75 0 y=0.2
place Block_Wall_Fence_Tier3 shedgate2 at 5.25 0 y=0.2
place "VG_DecorationPrefabBase_Engine Variant" winchengine at 4.5 3 y=0.25 sit yaw=180
place Loot_ChestLarge fuelstore at 1.5 3.2 y=0.25 yaw=180
place Loot_Chest biopress at 7.5 3.2 y=0.25 yaw=180
pop
place Block_Pillar_Wood - at -6 23 ground
place RT_PowerBox shedkeypad at -6 22.75 ground sit yaw=180
place Block_Pillar_Wood - at 6 22 ground sy=0.9
place TangaroaBucket shedbell at 6 22 ground y=2.75 rot=180,0,0 scale=1.4
place Loot_Chest fuelcan at -10 26 ground sit yaw=120

# --- The warthogs dug in under the masts; birds' nests? none - a meadow of kites -----------------------------------
place Creature_Boar hogs at 6 8 ground
prop hogs creature.count=5
prop hogs creature.respawn=0

# --- Things to gather -------------------------------------------------------------------------------------------------
scatter "Pickup_Landmark_Tree_Mango" 2 at 0 -10 r=50 seed=9511 free=5
scatter "Pickup_Landmark_PineappleLandmark" 3 at 0 -10 r=50 seed=9512 free=3
scatter "Pickup_Landmark_Flower_Red" 3 at 0 10 r=30 seed=9513 free=3
call dirt x=18 z=-20 r=12 n=3 seed=9514
call shallows r=108 deep=6 n=2

pop

# --- RAIN 10-26 (the user: one hour per island - hills, cliffs, a cave, a house, a wreck, secrets): Gull Crown ------
# Gull Crown with kite spotter's tower on it, Wind Cave, the ruined house where Ivar Brekke waits (four lamps round it: a puzzle), a crashed plane,
# a jump course, five kite tails about the island (a set), and at the hub the reserve winch that wants the spotter's reel and the winch governor
call hw_zone x=-46 z=52 al=km_hillz id=km_hill r=8 h=1 msg="Gull Crown. The whole island below you."
call hw_mast x=-50 z=52 h0=10 lv=6 a=km_mast chest=km_topchest top=Placeable_Flag_01
call ar_cave x=54 z=54 h=5 yaw=180 al=km_caverock chest=km_cavechest
call hw_zone x=55 z=45 al=km_cavez id=km_cave r=4 h=1 msg="Wind Cave. Water drips somewhere in the dark."
call ar_ruin x=58 z=-40 h=3.5 yaw=0 w=3 d=2 al=km_ruin
call rn_islander x=57 z=-44.5 yaw=200 al=km_isl nm="Ivar Brekke" pose=lean
prop km_isl talk.text=Careful at the cliff edge - the wind up here takes people.\n---\nI flew kite twelve. When they shut the meadow down, I took its governor into the Wind Cave so nobody could fly it again without me.\n---\nThe reserve winch wants the governor and the spotter's reel from the tower on Gull Crown. Bring them both and fly one for me.\n---\nThe crew's lamps round my house - each one wakes its neighbour. Light all four and look behind the house.
call rn_lamp x=51 z=-41 al=km_lamp1 nm="Crew lamp 1" grp="Crew lamps" on=1
call rn_lamp x=57 z=-34 al=km_lamp2 nm="Crew lamp 2" grp="Crew lamps" on=0
call rn_lamp x=64 z=-41 al=km_lamp3 nm="Crew lamp 3" grp="Crew lamps" on=0
call rn_lamp x=57 z=-48 al=km_lamp4 nm="Crew lamp 4" grp="Crew lamps" on=1
prop km_lamp1 on.use=light|Crew lamp 2|toggle
prop km_lamp2 on.use=light|Crew lamp 3|toggle
prop km_lamp3 on.use=light|Crew lamp 4|toggle
prop km_lamp4 on.use=light|Crew lamp 1|toggle
prop km_lamp1 on.alllit=show|km_lampchest\nmessage||All four lamps burn. Behind the back wall a stone has been lifted.
call rn_hidden x=59 z=-35.4 al=km_lampchest
place Creature_Chicken km_hens at 66 -34 ground
prop km_hens creature.count=3
call ar_plane x=-58 z=-46 h=13 yaw=40 al=km_plane crate=km_planecrate
place Note_Paper km_pilot at -59.78 -41.9 ground y=0.1 drop yaw=70
call hw_zone x=-58 z=-46 al=km_planez id=km_plane r=6 h=1 msg="A plane, nose down in the grass. Nobody came for it."
# JUMP km pad=3.5 at=58 10
push at 58 10
clear at 0 0 r=17 all
brush flatten at 0 0 r=14 s=20 frames=300 h=3.5
brush smooth at 0 0 r=18 s=4 frames=40
brush flatten at 0 0 r=12 s=20 frames=300 h=3.5
brush auto at 0 0 r=18 s=10 frames=25
clear at 0 0 r=18
place Block_Foundation_Tier3 jpkm at -4.24 -4.24 h=4.1
place Block_Foundation_Tier3 jpkm at -5.77 -1.65 h=4.85
place Block_Foundation_Tier3 jpkm at -5.85 1.35 h=5.6
place Block_Foundation_Tier3 jpkm at -4.46 4.01 h=6.35
place Block_Foundation_Tier3 jpkm at -1.95 5.67 h=7.1
place Block_Foundation_Tier3 jpkm at 1.04 5.91 h=7.85
place Block_Foundation_Tier3 jpkm at 3.78 4.66 h=8.6
place Block_Foundation_Tier3 jpkm at 5.56 2.25 h=9.35
place Block_Foundation_Tier3 jpkm at 5.96 -0.73 h=10.1
# JUMP from 10
place Block_Foundation_Tier3 jpkm at 4.85 -3.53 h=10.85
place Block_Foundation_Tier3 jpkm at 2.54 -5.44 h=11.6 sx=2 sz=2
# JUMP end
place Block_Foundation_Tier3 jppkm at -5.77 -1.65 h=4.168 sy=1.861
place Block_Foundation_Tier3 jppkm at -5.85 1.35 h=4.918 sy=2.959
place Block_Foundation_Tier3 jppkm at -4.46 4.01 h=5.668 sy=4.058
place Block_Foundation_Tier3 jppkm at -1.95 5.67 h=6.418 sy=5.157
place Block_Foundation_Tier3 jppkm at 1.04 5.91 h=7.168 sy=6.255
place Block_Foundation_Tier3 jppkm at 3.78 4.66 h=7.918 sy=7.354
place Block_Foundation_Tier3 jppkm at 5.56 2.25 h=8.668 sy=8.453
place Block_Foundation_Tier3 jppkm at 5.96 -0.73 h=9.418 sy=9.552
place Block_Foundation_Tier3 jppkm at 4.85 -3.53 h=10.168 sy=10.650
place Block_Foundation_Tier3 jppkm at 2.54 -5.44 h=10.918 sy=11.749 sx=2 sz=2
prop jpkm tint.color=#8a7f70
prop jpkm tint.amount=0.35
prop jppkm tint.color=#8a7f70
prop jppkm tint.amount=0.35
place Loot_Chest jckm at 1.04 5.91 h=7.85 sit yaw=0
prop jckm loot.refill=0
place Loot_ChestSmall jbkm at 2.54 -5.44 h=11.6 sit yaw=0
prop jbkm loot.refill=0
pop
call hw_zone x=58 z=2 al=km_jumpz id=km_jumps r=6 h=1 msg="Stone stacks, one higher than the next. Something at the top."
call rn_piece x=-36 z=32 al=km_piece1 set="Kite tails"
call rn_piece x=-50 z=-37 al=km_piece2 set="Kite tails"
call rn_piece x=48 z=28 al=km_piece3 set="Kite tails"
call rn_piece x=44 z=4 al=km_piece4 set="Kite tails"
call rn_piece x=72 z=-24 al=km_piece5 set="Kite tails"
prop km_piece1 on.set=show|km_setchest\nmessage||All five kite tails found.
call rn_hidden x=-47 z=-4 al=km_setchest kind=Loot_Chest
call treasure x=0 z=74 r=5 n=1 seed=26378 kind=0
prop treasure26378 treasure.loot=CopperOre*2;MetalOre*2;TradeToken*1
call ar_plants_hill x=-30 z=64 r=14 seed=26391
call ar_plants_hill x=30 z=64 r=14 seed=26392
call ar_plants_hill x=-60 z=26 r=12 seed=26393
call ar_plants_hill x=40 z=-64 r=12 seed=26394
call ar_plants_hill x=-36 z=-66 r=12 seed=26395
call rn_scope x=-46 z=6 yaw=90 al=km_scope path=km_view
call rn_cam x=-70 z=0 h=30 al=km_cam1 path=km_view order=1 look=km_machine speed=9 hold=2
call rn_cam x=-40 z=60 h=40 al=km_cam2 path=km_view order=2 look=km_mast speed=9 hold=0
call rn_cam x=30 z=30 h=45 al=km_cam3 path=km_view order=3 look=km_isl speed=9 hold=0
call rn_cam x=60 z=0 h=35 al=km_cam4 path=km_view order=4 look=km_lampchest speed=9 hold=0
call rn_cam x=60 z=50 h=25 al=km_cam5 path=km_view order=5 look=km_caverock speed=9 hold=2
call hw_machine x=-52 z=0 yaw=90 al=km_machine nm="Reserve winch" obj=TP_LaserControlPanel_lever sc=3 a=km_top b=km_cave done=km_fixed rew=km_rewchest rnote=km_rewnote msg="It works." hint="It wants the spotter's reel from Gull Crown and the winch governor from Wind Cave."
call hw_note x=-54.6 z=1.2 yaw=110 al=km_hint

# RAIN 10-26: rocks left hanging by the new hills
clear at -5.89 -70.58 r=1.5 only=SmallBoulder2
clear at 30.65 76.7 r=1.5 only=SmallBoulder1
# --- Settings, story items, notes, behaviours, quest ----------------------------------------------------------------
info title=The Kite Meadow
info author=Custom Islands
info description=Nimbus Works' third station: a high meadow over sea cliffs, twelve winch masts along the ridge with their torn seeding kites slack between them, the path up grown over with vines, and the launch shed with its winch engine on top. The third island of The Rainmakers. Raft-sized: high ground, a cave, a ruined house where Ivar Brekke still lives, a crashed plane and secrets off the path.
island on.arrive=message||Cliffs, a green top - and along the ridge a row of masts with great torn kites hanging slack between them.

story shedopen|Launch shed open|Placeable_Lantern_Metal|The keypad of the kite crew's launch shed took the winch code.
story kitesup|Kites up|Banner_01|The winch engine runs and the seeding kites are up over the ridge again - for the last time.
story bellrung|The shed bell rung|Placeable_Lantern_Metal|You rang the launch shed's bell: the crew's call to the kites.

note roster Kite crew roster | NIMBUS WORKS - KITE MEADOW - CREW ROSTER\n\nWinch 1-4: Halvard, Ilse. Winch 5-8: Bram, Odile. Winch 9-12: Kasimir.\nLaunch: Rouhi (youngest flyer on the coast - do not let him near winch 7 unsupervised).\n\nNote from the foreman: the vines are over the path again. The machete is in the crew chest. Each winch keeper writes his digit of the shed code in his log, as ever.
note crewchest Crew hut chest | The kite crew's chest: a machete for the vines on the path, the company's plans for it, rope.
loot crewchest Machete*1;Blueprint_Machete*1;Rope*3
prop crewchest loot.refill=0
note winch2 Winch 2 log | WINCH 2 - Halvard\n\nLine snapped twice today. The kites pull like they want to go home.\n\nMy digit of the shed code: the first one, FOUR.
note winch7 Winch 7 log | WINCH 7 - Odile\n\nRouhi climbed my mast again. I told him: one day the kites will lift you right off this island.\n\nMy digit of the shed code: the second one, ONE.
note winch11 Winch 11 log | WINCH 11 - Kasimir\n\nThe pigs are digging under the masts again. The masts lean.\n\nMy digit, the last one: NINE.
note fuelcan Winch fuel can | A dented can of the winch engine's fuel, under a tarp.
loot fuelcan story:raft-Vasagatan_GasTank*1;Plastic*2
prop fuelcan loot.refill=0
note fuelstore Fuel store | The launch shed's fuel store: Nimbus Works' plans for a fuel tank and the pipes that feed an engine from it.
loot fuelstore Blueprint_Fueltank*1;Blueprint_Pipe_Fuel*1;MetalIngot*2;Bolt*2
prop fuelstore loot.refill=0
prop fuelstore if.open=signal|engine
prop fuelstore else.open=message||The fuel store's lid is chained to the winch engine's drive. Start the engine.
note biopress Biofuel press | The crew's biofuel press, cold: the plans for an extractor that makes winch fuel out of leaves and fish.
loot biopress Blueprint_BiofuelExtractor*1;Plank*4;Scrap*3
prop biopress loot.refill=0
prop biopress if.open=signal|engine
prop biopress else.open=message||The biofuel press is bolted to the engine's drive shaft. Start the engine.

prop kitevines1 obj.name=kitevines
prop kitevines2 obj.name=kitevines
prop kitevines3 obj.name=kitevines
prop kitevines1 on.use=hide|kitevines\nmessage||The machete bites through the vines. The path to the meadow is open.
prop kitevines2 on.use=hide|kitevines\nmessage||The machete bites through the vines. The path to the meadow is open.
prop kitevines3 on.use=hide|kitevines\nmessage||The machete bites through the vines. The path to the meadow is open.

prop shedkeypad obj.name=shedkeypad
prop shedkeypad beh.use=Type the winch code
prop shedkeypad lock.code=419
prop shedkeypad on.use=sound||event:/exploring/obstacles/keypad/keypad_correct\nmessage||The keypad beeps four-one-nine and the shed's gate swings aside.\nhide|shedgate\nhide|shedgate2\ngive||story:shedopen*1
prop shedgate obj.name=shedgate
prop shedgate2 obj.name=shedgate2

prop winchengine obj.name=winchengine
prop winchengine on.use=message||The winch engine coughs, catches and roars. Along the ridge the winches haul - and the great torn kites rise off the grass and stand in the wind again.\nsignal||engine\nhide|kitesdown\nshow|kitesup\ngive||story:kitesup*1

prop shedbell obj.name=shedbell
prop shedbell beh.use=Ring the bell
prop shedbell if.use=signal|engine
prop shedbell on.use=sound||event:/raft/radar/lever\nmessage||The bell clangs over the meadow - the crew's call to the kites. From under the shed's floor a boy crawls out, grinning: Rouhi, the youngest flyer on the coast. He has been waiting for someone to ring it. Next station: the Fogworks, on 1000.\ncharacter||Rouhi\ngive||story:bellrung*1
prop shedbell else.use=message||The bell hangs still. Nobody rings it while the kites are down.

prop cliffpath zone.id=cliff_path
prop cliffpath zone.radius=5
prop cliffpath zone.message=The cliff path: steps cut up to the kite crew's hut, and higher, a row of masts against the sky.
prop uppermeadow zone.id=upper_meadow
prop uppermeadow zone.radius=6
prop uppermeadow zone.message=The upper meadow: twelve winch masts in a row, and something grunting under them.

story km_top|Spotter's reel|Bolt|The spotter's line reel from the tower top, its line still wound tight.
story km_cave|Winch governor|Bolt|The governor from winch twelve, hidden in the Wind Cave.
story km_fixed|Reserve winch working|Bolt|The reserve winch, working again.
note km_hint Kite crew's notice | RESERVE WINCH: needs the spotter's reel (tower on Gull Crown) and winch twelve's governor (in the Wind Cave). Ivar at the old house knows where. The telescope by the tower shows the whole ridge.
note km_topchest Kite spotter's tower deck box | A box lashed to the deck rail at the top of the kite spotter's tower.
loot km_topchest story:km_top*1;Rope*3;Feather*4
note km_cavechest Wind Cave chest | A chest at the back of Wind Cave, dry under the rock.
loot km_cavechest story:km_cave*1;Bolt*3;Scrap*3
note km_rewnote Reserve winch card | The reserve winch spins up and a last kite climbs into the cloud. Under its lid: a crew card - 'Twelve kites, twelve crews. Eleven years. Nobody asked us if the rain was wanted.'
note km_rewchest Reserve winch reward | What the reserve winch kept.
loot km_rewchest MetalIngot*2;Rope*3;TradeToken*2
note km_lampchest Ivar's kit bag | Ivar's kit bag behind the house: his flying gloves, line and pay.
loot km_lampchest Rope*3;Leather*2;TradeToken*2
note km_setchest Kite crew chest | The crew chest: every kite tail back, and the crew's last pay packet.
loot km_setchest MetalIngot*2;Rope*4;TradeToken*2
note km_planecrate Spotter plane's crate | The spotter plane's crate: kite cord, a radio, cloud charts.
loot km_planecrate Rope*3;Scrap*3;Plastic*2
prop km_planecrate loot.refill=0
note km_pilot Spotter's note | KITE SPOTTER, LAST FLIGHT. Twelve kites up, all lines holding. Then the wind turned. Coming down by the old crew house - the meadow's too steep.
note jckm Gull perch | The crew's perch, where they watched the kites.
loot jckm Rope*3;Plank*4;Feather*3
note jbkm Perch top | A crew stash at the very top.
loot jbkm CopperIngot*1;Bolt*2;TradeToken*1

quest title=Kites Over the Ridge
quest intro=A row of winch masts on a high meadow, kites slack between them. Climb the cliff path.
step reach|cliff_path|1|Climb the cliff path from the beach
step read|Kite crew roster|1|Read the crew roster in the hut on the ledge
step open|Crew hut chest|1|Open the crew hut chest
step blueprint|Blueprint_Machete|1|Take the machete plans from the crew hut chest
step reach|upper_meadow|1|Cut through the vines to the upper meadow
step kill|Warthog|5|Drive off the five warthogs dug in under the masts
step pages||4|Read the logs at the feet of winches 2, 7 and 11 (the roster is the first page)
step collect|story:shedopen|1|Open the launch shed with the winch code
step collect|story:kitesup|1|Start the winch engine (its fuel is under a tarp by the shed)
step open|Fuel store|1|Open the fuel store in the shed
step blueprint|Blueprint_Fueltank|1|Take the fuel tank plans from the fuel store
step blueprint|Blueprint_Pipe_Fuel|1|Take the fuel pipe plans from the fuel store
step open|Biofuel press|1|Open the biofuel press in the shed
step blueprint|Blueprint_BiofuelExtractor|1|Take the biofuel extractor plans from the biofuel press
step read|Kite crew's notice|1|Read the kite crew's notice by the reserve winch
step talk|Ivar Brekke|1|Talk to Ivar Brekke at the ruined house in the south-east
step reach|km_hill|1|Climb to Gull Crown in the north-west
step collect|story:km_top|1|Climb the kite spotter's tower and take the spotter's reel from its deck
