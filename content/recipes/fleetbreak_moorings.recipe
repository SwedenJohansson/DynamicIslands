call ar_plants_tropical x=-50 z=20 r=12 seed=13341
beside Loot_ChestLarge pressvault press d=2.8 yaw=90

# --- DEEP 10-24 (the user: one hour per island - real height, a big climb, a deep dive): Mastback Fell: a forty-metre fell with the Fleet's signal mast, the flagship's deckhouse sunk at the moorings, and a foghorn that wakes the harbour. ------
# the climb: the trail spirals up from the north-east foot; on the summit the Fleet's signal mast (10 storeys, a ladder inside), its deck chest
# and a zipline down to the hub (the shortcut back); the dive: the flagship's deckhouse on a basin floor -12 m down, an air pocket
# in its front room; the hub: the Foghorn lever that wants both, the notice; secrets: the trail ledge cache, the summit treasure,
# the sunk boat's crate
call hw_zone x=-24.58 z=-22.45 al=fb_trailz id=fb_trail r=5 msg="The trail up Mastback Fell starts here - cut into the slope, round and up."
call hw_zone x=-46 z=-42 al=fb_summitz id=fb_summit r=8 h=1 msg="The top of Mastback Fell. The whole island below, the city beyond it, and the Fleet's signal mast still higher."
call hw_mast x=-43.54 z=-45.16 h0=40 lv=10 a=fb_mast chest=fb_topchest top=Placeable_Flag_01
place ZiplinePath_Landmark fb_zip at -44.98 -40.12 h=41.35
zipto fb_zip -71.54 -9.16
place Loot_ChestSmall fb_ledge at -50.26 -55.44 ground sit yaw=17.6
call treasure x=-42.84 z=-39.54 r=5 n=1 seed=13378 kind=0
prop treasure13378 treasure.loot=CopperOre*2;MetalOre*2;TradeToken*1
place Creature_Goat fb_goats at -20.64 -19.38 ground
prop fb_goats creature.count=2
place Creature_Goat fb_summitgoat at -48.37 -43.84 ground
prop fb_summitgoat creature.count=1
scatter "Pickup_Landmark_Copper 1" 2 at -46 -42 r=24 seed=13382 free=2
scatter "Pickup_Landmark_Clay 1" 2 at -46 -42 r=26 seed=13383 free=2
scatter "Pickup_Landmark_Rock 1" 2 at -46 -42 r=22 seed=13384 free=2
call hw_sunkhouse x=-76 z=26 h=-12 yaw=0 a=fb_sunk chest=fb_deepchest air=fb_air bub=fb_airbub dal=fb_sunkdoor
call hw_zone x=-76 z=26 al=fb_deepz id=fb_deep r=7 h=1 msg="The flagship's deckhouse, 12 metres down. The front room still holds a pocket of air."
place RT_PlasticBoat fb_sunkboat at -68 28 ground sit yaw=35
prop fb_sunkboat tint.color=#5a5048
prop fb_sunkboat tint.amount=0.45
place Loot_Crate fb_boatcrate at -69 22 ground sit yaw=10
prop fb_boatcrate loot.refill=0
call hw_reef x=-83 z=31 r=3 seed=13386
place Creature_PufferFish fb_puffers at -82 19 h=-8
prop fb_puffers creature.count=2
call hw_machine x=-74 z=-6 yaw=142.13 al=fb_machine nm="Foghorn lever" obj=TP_LaserControlPanel_lever sc=3 a=fb_top b=fb_deep done=fb_fixed rew=fb_rewchest rnote=fb_rewnote msg="It works." hint="It needs the signal pennant from the top of Mastback Fell and the flagship's bell from the flagship's deckhouse."
call hw_note x=-76.89 z=-6.35 yaw=162.13 al=fb_hint
story fb_top|Signal pennant|Bolt|The Free Fleet's long signal pennant, rolled up at the top of the mast.
story fb_deep|Flagship's bell|Bolt|The ship's bell from the sunk flagship's deckhouse.
story fb_fixed|Foghorn lever working|Bolt|The foghorn lever, working again.
story tape|Insulating tape|Bolt|A roll of the Union linesmen's insulating tape. Three of them would make a dead breaker safe.
note fb_hint Harbourmaster's notice | The Fleet's foghorn won't sound until its pennant flies and its bell is hung: the pennant is rolled up on the signal mast atop Mastback Fell, the bell is still in the flagship's deckhouse, sunk off the west moorings.
note fb_topchest Fleet's signal mast deck box | A box lashed to the deck rail at the top of the Fleet's signal mast.
loot fb_topchest story:fb_top*1;Scrap*2;Bolt*2
note fb_deepchest Flagship's deckhouse strongbox | A strongbox in the back room of the flagship's deckhouse.
loot fb_deepchest story:fb_deep*1;story:tape*1;MetalIngot*1;Plastic*2
note fb_rewnote Foghorn chart | The foghorn booms across the moorings. Behind the lever: the old flagship's chart - the safe channel through the drowned city, and where the Fleet hides its spare fuel.
note fb_rewchest Foghorn lever reward | What the foghorn lever kept.
loot fb_rewchest GasTank*1;TradeToken*2;Rope*2
note fb_ledge Climber's cache | A climber's cache on a ledge off the trail - rope, a flask, a few bolts.
loot fb_ledge Rope*2;Bolt*2;Scrap*2
prop fb_ledge loot.refill=0
loot fb_boatcrate Plastic*3;Scrap*2;MetalIngot*1

# --- Settings, story items, notes, behaviours, quests -----------------------------------------------------------------
info title=Fleetbreak Moorings
info author=Custom Islands
info description=The Free Fleet's harbour: a ring of moored hulks round a drowned office block, its roof gone wild into a jungle garden. Machete, fuel, a forged pass - and a contract to run filters past the Authority's boom. The third island of The City That Never Sank.
island on.arrive=message||A ring of rusted hulks, moored bow to stern, makes a harbour wall. In the middle an office block's roof has turned into a jungle. A gull flag flies over the biggest hulk.

story authpass|Authority pass|Note_Paper|A Harbor Authority pass - forged by the Fleet, good enough for a guard who doesn't look twice.
story filtercrate|Filter crate|Placeable_Storage_Small|A crate of water filters off a Fleet hulk, for the Rookery's poor roofs.

prop hull tint.color=#5a4a40
prop hull tint.amount=0.4
prop boars creature.count=3
prop boars creature.respawn=0
prop puffers creature.count=3

prop gardenzone obj.name=gardenzone
prop gardenzone beh.hidden=1
prop gardenvines obj.name=gardenvines
prop gardenvines on.use=hide|gardenvines\nhide|gardenvines2\nhide|gardenvines3\nshow|gardenzone\nmessage||The machete bites through the vines. The stair to the roof garden is open - and something grunts among the trees.
prop gardenvines2 obj.name=gardenvines2
prop gardenvines2 on.use=hide|gardenvines\nhide|gardenvines2\nhide|gardenvines3\nshow|gardenzone\nmessage||The machete bites through the vines. The stair to the roof garden is open.
prop gardenvines3 obj.name=gardenvines3
prop gardenvines3 on.use=hide|gardenvines\nhide|gardenvines2\nhide|gardenvines3\nshow|gardenzone\nmessage||The machete bites through the vines. The stair to the roof garden is open.

prop contract obj.name=contract
prop contract beh.hidden=1
prop strongbox on.open=show|contract\nmessage||Goo, leather - and a pass with the Harbor Authority's seal, the ink still fresh. Under it a folded offer.
prop crate1 obj.name=crate1
prop crate1 beh.hidden=1
prop crate2 obj.name=crate2
prop crate2 beh.hidden=1
prop crate3 obj.name=crate3
prop crate3 beh.hidden=1
prop contract on.read=show|crate1\nshow|crate2\nshow|crate3\nshow|dropzone
prop dropzone obj.name=dropzone
prop dropzone beh.hidden=1
prop receipt obj.name=receipt
prop receipt beh.hidden=1
prop fleetreward obj.name=fleetreward
prop fleetreward beh.hidden=1
prop dropzone on.enter=show|receipt\nshow|fleetreward
prop dropzone if.enter=has|story:filtercrate|3
prop dropzone else.enter=message||The Rookery's drop. The Fleet wants three crates here, not fewer.
prop fleetreward on.open=signal||fleetfriend\nmessage||The Fleet's thanks. Word goes round the moorings: the Fleet owes you one.

note articles Free Fleet articles | ARTICLES OF THE FREE FLEET\n\nThe sea is nobody's.\nWhat floats is shared.\nNo boom, no toll, no permit.\nA captain is chosen and can be unchosen.\n\nSigned, for the Fleet: Teo Varga, captain.
note teoslog Teo's log | Teo Varga's log -\n\nRan forty filters past the boom last night. The Authority's lamp swept twice and missed us twice.\n\nThe bazaar says filters are short. They aren't short. Somebody holds them back.\n\nThe Rookery drinks rain. We'll keep running them.
note contract Fleet contract offer | FROM THE FLEET - A JOB\n\nThree crates of filters wait on our outer hulks.\nTake them past the boom to the Rookery's drop, the raft with our flag east of the ring.\n\nDo it and the Fleet owes you. - T.V.
note receipt Fleet receipt | RECEIVED AT THE DROP: three crates of filters.\nThe Rookery drinks clean tonight.\n\nThe Fleet won't forget. - T.V.
note bosunlocker Bosun's locker | The bosun's locker: the machete's plans, the bosun's own old machete on a whetstone, a rope.
note fueltankchest Fuel tank crate | A crate on the hulk's deck: the fuel tank's plans, drums half full.
note fuelstore Fuel store | The hulk's fuel store: the fuel pipe's plans, a coil of pipe, a leaking can - and two full gas tanks. Old engines all over the city still run on them.
note presschest Biofuel press | The roof garden's press box: the biofuel extractor's plans, sticky with pulp.
note strongbox Fleet strongbox | The Fleet's strongbox.
note crate1 Filter crate | Fleet filters, crated for a run.
note crate2 Filter crate | Fleet filters, crated for a run.
note crate3 Filter crate | Fleet filters, crated for a run.
note fleetreward Fleet reward | The Fleet's thanks, under the gull flag.
loot bosunlocker Blueprint_Machete*1;Machete*1;Rope*2;Nail*8
prop bosunlocker loot.refill=0
loot fueltankchest Blueprint_Fueltank*1;MetalIngot*2
prop fueltankchest loot.refill=0
loot fuelstore Blueprint_Pipe_Fuel*1;Plastic*3;story:raft-Vasagatan_GasTank*2
prop fuelstore loot.refill=0
loot presschest Blueprint_BiofuelExtractor*1;Mango*2;Banana*2
prop presschest loot.refill=0
loot strongbox ExplosiveGoo*2;Leather*2;story:authpass*1
prop strongbox loot.refill=0
loot crate1 story:filtercrate*1
prop crate1 loot.refill=0
loot crate2 story:filtercrate*1
prop crate2 loot.refill=0
loot crate3 story:filtercrate*1
prop crate3 loot.refill=0
loot fleetreward ExplosiveGoo*2;Leather*3;TradeToken*2
prop fleetreward loot.refill=0

prop chartzone zone.id=chart_room
prop chartzone zone.radius=3
prop chartzone zone.message=The Fleet's chart room. Charts of the drowned streets, pinned over charts of the open sea.
prop gardenzone zone.id=roof_garden
prop gardenzone zone.radius=6
prop gardenzone zone.message=The roof garden. Once an office block's terrace; now a jungle with boars in it.
prop boomzone zone.id=boom
prop boomzone zone.radius=5
prop boomzone zone.message=The boom. The Authority's lamp sweeps it from Pumpcrown - but not often.
prop dropzone zone.id=rookery_drop
prop dropzone zone.radius=3
prop dropzone zone.repeat=1
prop dropzone zone.message=The Rookery's drop. You stack the crates under the gull flag.

prop press beh.use=Start the press's old engine
prop press on.use=message||The old engine coughs on the gas, then roars. The press shakes - and the rusted locker beside it springs open.\nsignal||engine\nshow|pressvault
prop pressvault obj.name=pressvault
prop pressvault beh.hidden=1
note pressvault Press engine locker | The engine's locker, rusted shut for years: the mechanic's spares.
loot pressvault MetalIngot*3;Bolt*4;CopperIngot*2
prop pressvault loot.refill=0
prop ridgevinechest note.title=Gull nest cache
note seaplanelog Seaplane log | FREE FLEET SEAPLANE 'GULL' - last entry\n\nFlew the Fleet's mail to the far moorings. Authority guns at Pumpcrown fired on us.\nNo engine, no radio - glided in onto the north shore.\nThe filters are still in the crate. Somebody take them where they're needed.
note seaplanecrate Seaplane's crate | The seaplane's cargo crate: water filters and the Fleet's mail, never delivered.
loot seaplanecrate Plastic*3;Rope*2;Leather*2
note harbourledger Harbourmaster's ledger | HARBOURMASTER'S LEDGER\n\nThe Fleet's hulks: forty-one boats, all scuttled in a ring to break the storms.\nThe Authority wants a mooring fee for each. The Fleet says a wreck pays no fee.\nI resigned. Someone has to count the boats nobody owns.
note bosuncavechest Bosun's cache | The bosun's cache, under a tarpaulin: goo, rope and a spare compass.
loot bosuncavechest ExplosiveGoo*1;Rope*3;Scrap*4
prop bosuncavechest loot.refill=0
quest title=The Free Fleet
quest intro=The Free Fleet finds things, the bazaar said. Their chart room is on the biggest hulk.
step reach|chart_room|1|Go into the Fleet's chart room on the biggest hulk
step read|Free Fleet articles|1|Read the Free Fleet's articles
step blueprint|Blueprint_Machete|1|Take the machete's plans from the bosun's locker
step reach|roof_garden|1|Cut the vines on the stair and climb to the roof garden
step kill|Warthog|3|Drive the three boars out of the roof garden
step blueprint|Blueprint_Fueltank|1|Take the fuel tank's plans from the east hulk's deck
step blueprint|Blueprint_Pipe_Fuel|1|Take the fuel pipe's plans from the west hulk's fuel store
step read|Teo's log|1|Read Teo's log in the chart room
step blueprint|Blueprint_BiofuelExtractor|1|Take the biofuel extractor's plans from the press in the roof garden
step open|Fleet strongbox|1|Open the Fleet's strongbox
step reach|gull_ridge|1|Climb Gull Ridge in the north-west
step read|Harbourmaster's ledger|1|Read the harbourmaster's ledger in his house on the west shore
step open|Seaplane's crate|1|Open the crate in the Fleet's crashed seaplane on the north-east shore
step reach|bosuns_cave|1|Find the bosun's cave in the east
step read|Harbourmaster's notice|1|Read the harbourmaster's notice by the foghorn lever in the west
step reach|fb_trail|1|Find the foot of the trail up Mastback Fell, in the south-west
step reach|fb_summit|1|Climb the trail to the top of Mastback Fell
step collect|story:fb_top|1|Climb the Fleet's signal mast and take the signal pennant from its deck
step reach|fb_deep|1|Dive to the flagship's deckhouse off the west shore
step collect|story:fb_deep|1|Find the flagship's bell in its back room
step read|Foghorn chart|1|Bring both to the foghorn lever and read what it shows
step read|Fleet contract offer|1|Read the Fleet's offer
quest done=The pass is forged and the Fleet trusts you. The Salvagers' Union works the cranes at Hookline Stack - band 800.
quest reward=Mango*2;Banana*2;Leather*2

quest2 title=Filters Past the Boom
quest2 intro=Three crates of filters for the Rookery's poor roofs, past the Authority's boom.
step2 reach|boom|1|Go to the boom across the north channel
step2 collect|story:filtercrate|3|Take the three filter crates off the outer hulks
step2 reach|rookery_drop|1|Bring the crates to the Rookery's drop under the gull flag
step2 read|Fleet receipt|1|Read the Fleet's receipt
