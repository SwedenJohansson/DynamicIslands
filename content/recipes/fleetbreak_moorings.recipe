clear at -50.26 -55.44 r=3
call hw_basin x=-76 z=26 r=14 h=-12
brush flatten at -74 -6 r=4 s=8 frames=60
clear at -74 -6 r=6
origin
push at 0 -49
clear at 0 -21 r=5
clear from 0 -24 to 0 -44 r=6

