prop hctrip1 zone.radius=2
prop hctrip1 zone.repeat=1
prop hctrip1 on.enter=show|hcspike1\nmessage||A wire snaps under you - spikes shoot up out of the flat stones!\nwait|5\nhide|hcspike1\nmessage||The spikes sink back into the stones.
