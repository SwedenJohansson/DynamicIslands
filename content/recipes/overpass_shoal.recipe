# Overpass Shoal - an island of the library's plan The Sunken Kingdom (sea level, its lane sunk to -8; chapter 2)
# A drowned highway: its lane climbs out of the sea from the east, crosses a grassy embankment (pines, birches, goats
# and llamas) and runs on west over stone pillars - and ends in the air. Rusted car shells (Caravan vans, tinted) sit on
# the sunken lane; one of them shelters an air pocket. The toll booth at the top of the ramp (a hut, its roof on its
# corner posts) keeps a strongbox only the booth key opens. Sandbars with clay to the south. Quest "The Drowned Highway"
# (15 steps): the ramp top, the toll booth log, the sunken lane, the van's glovebox (the booth key), the motor wheel
# plans in the booth's strongbox, the steering wheel plans in the bus locker.
#
# Points (metres over the sea): the road (3 lanes, z -2.25..2.25) on the embankment at 3 m from x -6 to 10; down the
# sunken lane to -8 m at x 40; the overpass on pillars from x -6 west to -20 (its broken end); the toll booth x 2..5,
# z 3.2..6.2; the van air pocket at 30 3.2; the bus at 37 0.
include lib_huts
include lib_gravity
include lib_sea
include lib_sunken
# RESIZE 10-24: Radius 36 -> 86 (x2.4). The road keeps its shape stretched along x (lanes, the booth and the vans at
# x*2.4, the road's width and side offsets as they were); the embankment, trees and animals at x*2.4, z*2.4.
include lib_features
new
gen Trees=0.25 Bushes=0.32 Rocks=0.3 Harvest=0.15 BeachThings=0.2
gen Seed=10201 Radius=86 Height=12 Roughness=0.35 Peaks=2 Shape=0 Style=0 BeachWidth=0.25 Cliffs=0.2 PeakShape=0.5
gen Water=0.5 SeaRocks=0.3 SeaFinds=0.3 Sunken=0.2 Hostiles=0 Friendly=0 SeaLife=0.3
generate
elevation 0

# --- Terrain: the embankment at 2.7 m, the lane's bed sloping into the sea, shallow water under the overpass ---------
brush flatten at -2.4 0 r=26 s=20 frames=400 h=2.7
for lx 26 98 4
brush flatten at $lx 0 r=4 s=20 frames=90 h={2.6-11*($lx-24)/72}
next
brush flatten from -18 0 to -47 0 r=8 s=20 frames=160 h=-2.5
brush flatten at 30 -78 r=8 s=20 frames=100 h=0.3
brush grass at -4.8 0 r=28 s=20 frames=30
brush sand at 30 -78 r=6 s=20 frames=20
# discoveries: level spots for the drivers' camp and the road crew's digger
brush flatten at 40 42 r=5 s=8 frames=40
brush flatten at -32 48 r=6 s=8 frames=40
origin
clear at 4.8 0 r=22
clear from 24 0 to 98 0 r=8
clear from -14 0 to -47 0 r=7
clear at 40 42 r=6
clear at -32 48 r=7

# --- The road on the embankment and down the sunken lane (stone floor) -------------------------------------------------
ramp Block_Floor_Tier3 from -12.75 -1.5 3 to 23.25 -1.5 3 len=1.5 top=0
ramp Block_Floor_Tier3 from -12.75 0 3 to 23.25 0 3 len=1.5 top=0
ramp Block_Floor_Tier3 from -12.75 1.5 3 to 23.25 1.5 3 len=1.5 top=0
ramp Block_Floor_Tier3 from 24.75 -1.5 2.6 to 95.25 -1.5 -7.9 len=1.5 top=0
ramp Block_Floor_Tier3 from 24.75 0 2.6 to 95.25 0 -7.9 len=1.5 top=0
ramp Block_Floor_Tier3 from 24.75 1.5 2.6 to 95.25 1.5 -7.9 len=1.5 top=0

# --- The overpass: the road on west over stone pillars, ending in the air ---------------------------------------------
for px -18 -46 -4
place RT_PillarThick - at $px -1.8 h=-3
place RT_PillarThick - at $px 1.8 h=-3
next
ramp Block_Floor_Tier3 from -14.25 -1.5 3 to -46.25 -1.5 3 len=1.5 top=0
ramp Block_Floor_Tier3 from -14.25 0 3 to -46.25 0 3 len=1.5 top=0
ramp Block_Floor_Tier3 from -14.25 1.5 3 to -45.5 1.5 3 len=1.5 top=0
ramp Block_Wall_Fence_Tier3 - from -14.25 -2.25 3 to -46.25 -2.25 3 len=1.5 top=-0.1
ramp Block_Wall_Fence_Tier3 - from -14.25 2.25 3 to -44.75 2.25 3 len=1.5 top=-0.1
