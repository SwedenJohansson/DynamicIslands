# Overpass Shoal - an island of the library's plan The Sunken Kingdom (sea level, its lane sunk to -8; chapter 2)
# A drowned highway: its lane climbs out of the sea from the east, crosses a grassy embankment (pines, birches, goats
# and llamas) and runs on west over stone pillars - and ends in the air. Rusted car shells (Caravan vans, tinted) sit on
# the sunken lane; one of them shelters an air pocket. The toll booth at the top of the ramp (a hut, its roof on its
# corner posts) keeps a strongbox only the booth key opens. Sandbars with clay to the south. Quest "The Drowned Highway"
# (6 steps): the ramp top, the toll booth log, the sunken lane, the van's glovebox (the booth key), the motor wheel
# plans in the booth's strongbox, the steering wheel plans in the bus locker.
#
# Points (metres over the sea): the road (3 lanes, z -2.25..2.25) on the embankment at 3 m from x -6 to 10; down the
# sunken lane to -8 m at x 40; the overpass on pillars from x -6 west to -20 (its broken end); the toll booth x 2..5,
# z 3.2..6.2; the van air pocket at 30 3.2; the bus at 37 0.
include lib_huts
include lib_gravity
include lib_sea
new
gen Trees=0.2 Bushes=0.3 Rocks=0.2 Harvest=0.15 BeachThings=0.2
gen Seed=10201 Radius=36 Height=4 Roughness=0.35 Peaks=1 Shape=0 Style=0 BeachWidth=0.25 Cliffs=0.2 PeakShape=0.5
gen Water=0.5 SeaRocks=0.3 SeaFinds=0.3 Sunken=0.2 Hostiles=0 Friendly=0 SeaLife=0.3
generate
elevation 0

# --- Terrain: the embankment at 2.7 m, the lane's bed sloping into the sea, shallow water under the overpass ----------
brush flatten at -1 0 r=11 s=20 frames=220 h=2.7
for lx 12 40 4
brush flatten at $lx 0 r=4 s=20 frames=90 h={2.6-11*($lx-10)/30}
next
brush flatten at -15 0 r=6 s=20 frames=120 h=-2.5
brush flatten at 14 -20 r=6 s=20 frames=80 h=0.3
brush grass at -2 0 r=12 s=20 frames=20
brush sand at 14 -20 r=5 s=20 frames=20
origin
clear at 2 0 r=9
clear at 26 0 r=15
clear at -14 0 r=7

# --- The road on the embankment and down the sunken lane (stone floor) -----------------------------
ramp Block_Floor_Tier3 from -5.25 -1.5 3 to 9.75 -1.5 3 len=1.5 top=0
ramp Block_Floor_Tier3 from -5.25 0 3 to 9.75 0 3 len=1.5 top=0
ramp Block_Floor_Tier3 from -5.25 1.5 3 to 9.75 1.5 3 len=1.5 top=0
ramp Block_Floor_Tier3 from 11.25 -1.5 2.6 to 39.75 -1.5 -7.9 len=1.5 top=0
ramp Block_Floor_Tier3 from 11.25 0 2.6 to 39.75 0 -7.9 len=1.5 top=0
ramp Block_Floor_Tier3 from 11.25 1.5 2.6 to 39.75 1.5 -7.9 len=1.5 top=0

# --- The overpass: the road on west over stone pillars, ending in the air ---------------------------------------------
for px -9 -17 -4
place RT_PillarThick - at $px -1.8 h=-3
place RT_PillarThick - at $px 1.8 h=-3
next
ramp Block_Floor_Tier3 from -6.75 -1.5 3 to -19.25 -1.5 3 len=1.5 top=0
ramp Block_Floor_Tier3 from -6.75 0 3 to -19.25 0 3 len=1.5 top=0
ramp Block_Floor_Tier3 from -6.75 1.5 3 to -18.5 1.5 3 len=1.5 top=0
ramp Block_Wall_Fence_Tier3 - from -6.75 -2.25 3 to -19.25 -2.25 3 len=1.5 top=-0.1
ramp Block_Wall_Fence_Tier3 - from -6.75 2.25 3 to -17.75 2.25 3 len=1.5 top=-0.1
place Note_Sign endsign at -18.5 0 h=3 sit yaw=90

# --- The toll booth at the top of the ramp: the log, the strongbox (the booth key opens it) ---------------------------
push at 2 3.2 h=2.7
call hut w=2 d=2 y=0.1
place "Box Small" - at 0.9 2.2 y=0.1 sit
place Note_Paper boothlog at 0.9 2.2 y=0.8 drop yaw=10
place Loot_ChestSmall boothbox at 2.2 2.2 y=0.1 sit yaw=270
pop
place Zone_Trigger rampzone at 4 0 h=4

# --- The sunken lane: rusted cars, the van's glovebox, the air pocket, the bus and its locker -------------------------
place Van_2 cars at 17 0 h=-0.3 sit yaw=90
place Van3 cars at 26.5 -1 h=-3.2 sit yaw=0
place Van_1 cars at 37 0 h=-6.6 sit yaw=0
# the jam that never moved: a caravan parked by the booth, a van left on the overpass, a trailer rolled off the lane
place Caravan_Yellow_01 wrecks at 8 -1 h=3 sit yaw=90
# (on the overpass deck, lengthways: at -13 its front hung 5 m over the shallows, and turned across the deck its ends
# stood past both edges, 2026-10-23)
place Van_4 wrecks at -10 0 h=3 sit yaw=0
place Caravan_Green_02 wrecks at 22 -7 ground yaw=20
prop cars tint.color=#6b4a32
prop cars tint.amount=0.55
prop wrecks tint.color=#8a6a4e
prop wrecks tint.amount=0.3
place Loot_ChestSmall glovebox at 24 1.6 h=-1.4 drop yaw=0
call airpocket x=30 z=3.2 id=sunken_lane al=laneair bub=lanebub r=2.5 msg="An air pocket trapped by the van's tailgate. Breathe."
place Loot_Chest buslocker at 31.5 2 h=-4 drop yaw=270
scatter "Pickup_Landmark_Scrap 1_OceanBottom" 3 at 28 -4 r=4 seed=10202 free=1

# --- The embankment: pines, birches, goats and llamas; the sandbar with clay; a reef along the lane ----------------
scatter Pickup_Landmark_Tree_Pine 3 at -6 -9 r=5 seed=10203 free=2
scatter Pickup_Landmark_Tree_Birch 3 at -4 9 r=5 seed=10204 free=2
scatter Pickup_Landmark_BerryBush 2 at 6 -8 r=3 seed=10205 free=1
place Creature_Goat goats at -6 -6 ground
place Creature_Llama llamas at -2 8 ground
scatter "Pickup_Landmark_Clay 1" 2 at 14 -20 r=4 seed=10206 free=1
scatter "Pickup_Landmark_Clay 2" 2 at 14 -20 r=4 seed=10207 free=1
scatter Pickup_Landmark_Sand 3 at 14 -20 r=4 seed=10208 free=1
scatter VP_CoralDigitate03 5 at 30 -7 r=3 seed=10209 free=1
scatter VP_CoralBulb03 4 at 30 -7 r=3 seed=10210 free=1
scatter TinyCoral 6 at 34 7 r=3 seed=10211 free=1
scatter SeaVine3 18 at 26 0 r=14 seed=10212 free=2
call shallows x=0 z=0 r=46 deep=6 n=1 seed=10213

# --- Settings, story items, notes, behaviours, quest ----------------------------------------------------------------
info title=Overpass Shoal
info author=Custom Islands
info description=A highway that climbs out of the sea over a grassy embankment and ends in the air - its lower half under water, rusted cars still on it. The second island of The Sunken Kingdom.
island on.arrive=message||A road comes up out of the sea, crosses a green bank - and stops in mid-air.

story boothkey|Toll booth key|Placeable_Lantern_Metal|The toll booth's key, from a van's glovebox on the sunken lane.

note endsign Road's end | ROAD CLOSED\n\nThe sign is bolted to the last good slab. Past it, the road just stops.
note boothlog Toll booth log | TOLL BOOTH 4 - LOG\n\nWater over lane 3 since Tuesday. Cars still trying to get up the ramp.\nLast van down: the Network's lab shuttle, headed for the tower. Driver left my spare key in his glovebox - "back tonight".\nHe wasn't. Strongbox stays locked.
note glovebox Van glovebox | The van's glovebox: a booth key on a red tag, a fuel can's receipt, a little scrap.
note boothbox Toll booth strongbox | The booth's strongbox: the day's takings and a set of motor wheel plans, "for the maintenance boat".
note buslocker Bus locker | The bus driver's locker, rusted shut but it gives: steering wheel plans and a tool roll.
loot glovebox story:boothkey*1;BioFuel*1;Scrap*2
prop glovebox loot.refill=0
loot boothbox Blueprint_MotorWheel*1;TradeToken*2
prop boothbox loot.refill=0
loot buslocker Blueprint_SteeringWheel*1;Bolt*3;Scrap*2
prop buslocker loot.refill=0

prop boothbox if.open=has|story:boothkey|1
prop boothbox else.open=message||The strongbox is locked. The log says the spare key went down the lane in a van.
prop rampzone zone.id=ramp_top
prop rampzone zone.radius=4
prop rampzone zone.message=The top of the ramp. One way the road runs into the sea, the other way into the sky.
prop goats creature.count=2
prop llamas creature.count=2

quest title=The Drowned Highway
quest intro=The caretaker followed the road. Climb the ramp to the toll booth.
step reach|ramp_top|1|Climb to the top of the ramp
step read|Toll booth log|1|Read the log in the toll booth
step reach|sunken_lane|1|Dive down the lane to the air pocket by the vans
step open|Van glovebox|1|Open the glovebox of the van on the lane
step blueprint|Blueprint_MotorWheel|1|Open the booth's strongbox with the key: motor wheel plans
step blueprint|Blueprint_SteeringWheel|1|Take the steering wheel plans from the bus locker
quest done=The road goes on, under water, towards the lab tower. The Receiver picks it up on band 800.
quest reward=Rope*3;Nail*10

save Overpass Shoal
