call sk_zone x=24 z=-47 al=op_cave id=op_cave r=4 msg="A cave under the rock -a road crew's store, its door long gone."
call sk_ruin x=66 z=50 h=3 al=op_ruin
call sk_notebox x=68.5 z=45.5 yaw=10 al=op_ruinnote
call sk_wreck x=-66 z=-24 h=3 yaw=30 v=Caravan_Blue_01 al=op_wreck crate=op_wreckcrate scale=1
