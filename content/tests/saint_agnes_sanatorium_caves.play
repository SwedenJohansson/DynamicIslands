walk -15.5 30.5 to -18.1 33.6 to -19.7 35.5 to -22.8 38.1 to -25.1 40 to -27.4 41.9 to -29.3 43.5 below=10
picture sa_cave_in -22.8 9.5 38.1 -29.3 8.5 43.5 light=20
walk -29.3 43.5 to -27.4 41.9 to -25.1 40 to -22.8 38.1 to -19.7 35.5 to -18.1 33.6 to -15.5 30.5 below=10
