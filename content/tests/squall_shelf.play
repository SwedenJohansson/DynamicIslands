# Squall Shelf (CIPlay squall_shelf): the tent, the stranded note, the bear, the tent cache (the net), the llama, the
# weather log.
island Squall Shelf
offset 0 0
expect step 0
expect title The Stranded Tent
zone tent
expect step 1
read Stranded note
expect step 2
kill Polar bear
expect step 3
open Tent cache
wait 3
expect step 4
catch Llama 1
expect step 5
read Weather log
expect done
