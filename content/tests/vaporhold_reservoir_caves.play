# Vaporhold Reservoir's intakes and the fallen-in service passage (CIPlay vaporhold_reservoir_caves, 11-13 w11; in a
# test world 'CI ...'). Points as in its recipe: the long intake leaves the reservoir floor (-7) at -10 -37 and climbs
# 12 deg (kit_st yaw 250, len 41.6: six pieces) under the embankment to the dry valve chamber about -56.5 -54 (the
# store at -57.5 -55.5); the service passage dug from the west slope at -82 -50 east to its rat den at -70 -50.
# (w11b: swim 2 m over the tunnel's floor - the lake floor and the culvert floors stood higher than reckoned; walk
# starts below the tunnel's roof, or the walk began on the embankment over it)
island Vaporhold Reservoir keep
offset -7.2692 -10.0553
hour 11
weather Calm
picture vr_intake_out 6 9 -22 -8 -5 -36
picture vr_sump_out -3 6 -42 -10.4 -1 -48.4
# (w11c: the first joint, 8 m in, has a step - swimming up, the next piece's floor; swimming down, this piece's roof:
# rise early on the way in, keep low on the way out - the w11b way out, which got through)
swim -4 -34.5 -1 to -6.5 -35.7 -3 to -10 -37 -5 to -14 -38.5 -3.6 to -17.5 -39.7 -3.3 to -25 -42.5 -1.9 to -32.6 -45.2 -0.5
walk -38.2 -47.3 to -45.2 -49.8 to -50.1 -51.6 to -55.5 -53.6 below=2.5
air vr_valvechamber here
picture vr_valve_in -47.6 3.6 -50.7 -56.5 2 -54 light=20
open Intake valve store
wait 2
expect item Rope 2
walk -55.5 -53.6 to -50.1 -51.6 to -45.2 -49.8 to -38.2 -47.3 below=6
swim -32.6 -45.2 -0.9 to -25 -42.5 -2.5 to -17.5 -39.7 -4.1 to -10 -37 -5.8 to -6.5 -35.7 -3 to -4 -34.5 -1

picture vr_service_out -95 10 -55 -83 5 -50
expect animals Rat 2
expect animalsinside Rat 2
walk -83.5 -50 to -79 -50 below=8.5
picture vr_rats -79 5.8 -50 -70 4.8 -50 aim=Rat light=20
kill Rat
expect animals Rat 0
walk -79 -50 to -75 -50 to -70.5 -50 below=8.5
walk -70.5 -50 to -75 -50 to -79 -50 to -83.5 -50 below=8.5
