# Pendulum Isle's bob-cutters' drift (CIPlay pendulum_isle_caves, 11-11 w06, dug 11-12; in a test world 'CI ...').
# Points as in the recipe: the mouth in Bob Hill's foot step at -49.4 -23.5, the drift to -52.5 -15, the
# working room to -53.5 -12.3 with the cutters' box at -54.3 -14.3. Walk in from the sand, open the box, walk out.
island Pendulum Isle keep
offset 0 0
hour 11
weather Calm
# (a CI world's bag emptied first: a full bag drops the loot)
empty

picture pi_cut_out -47.6 +2 -28.5 -49.4 5 -23.5
walk -48.4 -26.3 to -49.4 -23.5 to -49.8 -21 to -51.1 -18.3 to -52.5 -15 to -53 -13.6 below=12
picture pi_cut_in -51.3 6.6 -18.3 -53.6 5.8 -13 light=20
open Bob-cutters' box
wait 2
expect item Nail 6
picture pi_cut_back -53.3 6.6 -13 -49.4 5 -23.5 light=20
walk -53 -13.6 to -52.5 -15 to -51.3 -18.3 to -49.4 -23.5 to -48.4 -26.3 below=12
