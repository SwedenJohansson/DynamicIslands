# Breakwater Customs' smugglers' tunnel (CIPlay breakwater_customs_caves, 11-11; in a test world 'CI ...'). Points as in
# its recipe (the origin frame): the mouth on the sea floor at 60 -80 (5 m down) off the east shore, the flooded tunnel
# climbing north-north-west under the big east hill to the dry room round 45 -40 (air zone bw_smugglers, the contraband
# chest at 45.9 -34). Swim in, breathe, take the contraband, walk down to the water and swim out.
island Breakwater Customs keep
offset 0 0
hour 11
weather Calm

# Outside: the east hill from the sea, the mouth from the water
picture bw_cave_out 68 2 -96 56 6 -66
picture bw_cave_mouth 63 -3.5 -89 60 -4 -80

# In: from the sea floor up the tunnel into the room, and breathe there
walk 62.1 -85.6 to 60 -80 to 56.6 -70.6 to 53.2 -61.2 to 49.7 -51.8 to 47.3 -45.2 to 45.6 -40.5 below=-2
air bw_smugglers here
picture bw_cave_in 51 3.5 -56 45 3 -38 light=20
picture bw_room_back 44 4 -33 48 2.5 -48 light=20
open Contraband
wait 2
expect item MetalIngot 2
air bw_smugglers

# Out: set back in the room, walked down the tunnel to the water, swum out of the mouth (every swim point under the sea,
# ~1 m over the floor)
at 45.6 -40.5 h=3
wait 1
walk 45.6 -40.5 to 47.3 -45.2 to 49.7 -51.8 to 53.2 -61.2 to 56.6 -70.6 below=5
swim 57.9 -74.4 -3.3 to 60 -80 -4.2 to 62.1 -85.6 -4.2 to 63.4 -89.4 -2
