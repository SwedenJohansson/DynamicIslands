# Breakwater Customs' wreckers' cave (CIPlay breakwater_customs_caves, 11-11; in a test world 'CI ...'). Points as in
# its recipe (the origin frame): the dug tunnel's mouth at the waterline at hill 2's south foot at 53 -65, climbing
# north in under the summit to its dry room round 53 -50 (the contraband chest at 53.4 -47.3, past its end). Walk in, take the
# contraband, walk back out to the beach.
island Breakwater Customs keep
offset 0 0
hour 11
weather Calm

# Outside: the hill and the mouth from the beach
picture bw_cave_out 53 3 -76 53 3 -60
picture bw_cave_mouth 53 2.4 -69 53 2.4 -60

# In: up the tunnel into the room
at 53 -65.4
walk 53 -65.4 to 53 -61 to 53 -55 to 53.2 -48.8
picture bw_cave_in 53 3.6 -60 53.3 5 -49 light=20
picture bw_room_back 53.3 4.6 -48.6 53 3 -60 light=20
open Contraband
wait 2
expect item MetalIngot 2

# Out: back down the tunnel to the beach
walk 53.2 -48.8 to 53 -55 to 53 -61 to 53 -65.4
